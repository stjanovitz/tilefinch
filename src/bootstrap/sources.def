BOOTSTRAP_DIAGNOSTIC(browser_dpu_diagnostic, "dpu-diagnostic.js",
                     "<dpu-diagnostic>")
BOOTSTRAP_DIAGNOSTIC(browser_eval_source_diagnostic,
                     "eval-source-diagnostic.js", "<eval-source-diagnostic>")
/* The modules every realm evaluates when it is created (the unconditional
   evaluate steps of runtime_bootstrap_sequence). The generator pins the
   atoms they name, so they run from ROM in place (README.md). Other modules
   share those atoms and relocate only their own: listing one here would
   keep its atoms resident in every realm whether it loads or not. The
   exceptions are modules moved out of an eager module for source headroom
   (frame-clone.js, validation.js and detached-documents.js from
   platform.js, geometry.js from dom.js): their atoms were the eager
   module's, so pinning them costs no resident heap, and pinned they run
   from ROM (frame-clone.js loads in about 9 KiB instead of 13 KiB;
   2026-11-14). */
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_cssom)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_frames)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_platform)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_custom_elements)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_compat)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_scheduler)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_hardening)
/* Lazy; see above. */
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_frame_clone)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_geometry)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_validation)
BOOTSTRAP_PINNED_ATOMS(browser_bootstrap_detached_documents)
#undef BOOTSTRAP_PINNED_ATOMS
