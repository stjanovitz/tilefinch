static Bytes webp_alpha_no_transform_fixture(bool padded)
{
    Bytes out = {0};
    if (!padded) {
        bytes_append(&out, webp_alpha_no_transform_bytes,
                     sizeof(webp_alpha_no_transform_bytes));
        return out;
    }
    /* An unknown chunk before VP8 makes incremental input checkpoint before
       decoding, without changing image pixels or decoder semantics. */
    bytes_append(&out, webp_alpha_no_transform_bytes, 52u);
    static const unsigned char junk_header[8] = {
        'J', 'U', 'N', 'K', 0, 16, 0, 0
    };
    static const unsigned char junk[4096] = {0};
    bytes_append(&out, junk_header, sizeof(junk_header));
    bytes_append(&out, junk, sizeof(junk));
    bytes_append(&out, webp_alpha_no_transform_bytes + 52u,
                 sizeof(webp_alpha_no_transform_bytes) - 52u);
    unsigned riff = (unsigned)(out.length - 8u);
    for (unsigned i = 0; i < 4u; i++)
        out.data[4u + i] = (unsigned char)(riff >> (i * 8u));
    return out;
}

static uint64_t webp_alpha_pixel_hash(const unsigned char *pixels, size_t bytes)
{
    uint64_t hash = UINT64_C(14695981039346656037);
    for (size_t i = 0; i < bytes; i++)
        hash = (hash ^ pixels[i]) * UINT64_C(1099511628211);
    return hash;
}

static bool webp_alpha_cancel(void *context, const char *phase, size_t units)
{
    size_t *calls = context;
    (void)units;
    if (strcmp(phase, "image-webp-decode") != 0) return true;
    (*calls)++;
    return false;
}

static int test_webp_alpha_byte_history(Budget *budget)
{
    CHECK(budget->current == 0);
    const int source = 512, target = 256;
    const size_t target_bytes = (size_t)target * target * 4u;
    const size_t limit = budget->limit;
    Bytes webp = webp_alpha_no_transform_fixture(false);
    DecodeRun run = decode_at(budget, &webp, source, source, target, target);
    CHECK(run.status == IMAGE_DECODE_SUCCEEDED && run.pixels != NULL);
    CHECK(run.output_bytes == target_bytes);
    CHECK(webp_alpha_pixel_hash(run.pixels, target_bytes)
          == UINT64_C(0x30f619fca2243385));
    for (size_t i = 3u; i < target_bytes; i += 4u)
        CHECK(run.pixels[i] == 73u);
    /* Byte history with the duplicate frame alpha reservation peaks near
       1.1 MiB. The independent filtered plane remains; omitting only the
       unused frame reservation keeps this complete decode below 1 MiB. */
    printf("webp-alpha: complete decode peak=%zu bytes\n", run.peak_delta);
    CHECK(run.peak_delta < 1024u * 1024u);
    image_resource_free_decoded(budget, run.pixels);
    CHECK(budget->current == 0);

    budget->limit = 1024u * 1024u;
    run = decode_at(budget, &webp, source, source, target, target);
    budget->limit = limit;
    CHECK(run.status == IMAGE_DECODE_SUCCEEDED && run.pixels != NULL);
    CHECK(webp_alpha_pixel_hash(run.pixels, target_bytes)
          == UINT64_C(0x30f619fca2243385));
    image_resource_free_decoded(budget, run.pixels);
    CHECK(budget->current == 0);

    size_t failures = budget->failure_count;
    budget->limit = target_bytes + 64u * 1024u;
    run = decode_at(budget, &webp, source, source, target, target);
    budget->limit = limit;
    CHECK(run.status == IMAGE_DECODE_TRANSIENT_FAILURE && run.pixels == NULL);
    CHECK(budget->failure_count > failures && budget->current == 0);
    free(webp.data);

    webp = webp_alpha_no_transform_fixture(true);
    size_t cancelled_calls = 0;
    TilefinchPlatformServices services = {
        .context = &cancelled_calls, .cooperate = webp_alpha_cancel
    };
    tilefinch_platform_set_services(&services);
    run = decode_at(budget, &webp, source, source, target, target);
    tilefinch_platform_set_services(NULL);
    CHECK(cancelled_calls != 0);
    CHECK(run.status == IMAGE_DECODE_TRANSIENT_FAILURE && run.pixels == NULL);
    CHECK(budget->current == 0);
    run = decode_at(budget, &webp, source, source, target, target);
    CHECK(run.status == IMAGE_DECODE_SUCCEEDED && run.pixels != NULL);
    CHECK(webp_alpha_pixel_hash(run.pixels, target_bytes)
          == UINT64_C(0x30f619fca2243385));
    image_resource_free_decoded(budget, run.pixels);
    free(webp.data);
    CHECK(budget->current == 0);
    return 0;
}

/* All residuals are one. Row reconstruction is independent of libwebp's
   filter helpers and checks wraparound and gradient clamping explicitly. */
static int test_webp_alpha_filters(Budget *budget)
{
    const int source = 512;
    for (unsigned filter = 1u; filter <= 3u; filter++) {
        CHECK(budget->current == 0);
        Bytes webp = webp_alpha_no_transform_fixture(false);
        webp.data[38] = (unsigned char)(1u | (filter << 2u));
        /* The first literal occupies bits 6..13 of the ALPH stream.
           Keep its eight-bit encoding and set its value to one. */
        for (unsigned bit = 0; bit < 8u; bit++) {
            size_t at = 39u + (6u + bit) / 8u;
            unsigned char mask = (unsigned char)(1u << ((6u + bit) % 8u));
            webp.data[at] &= (unsigned char)~mask;
            if (bit == 0u) webp.data[at] |= mask;
        }
        DecodeRun run = decode_at(budget, &webp, source, source,
                                  source, source);
        CHECK(run.status == IMAGE_DECODE_SUCCEEDED && run.pixels != NULL);
        unsigned char previous[512] = {0};
        for (int y = 0; y < source; y++) {
            int left = y == 0 ? 0 : previous[0];
            int top_left = left;
            for (int x = 0; x < source; x++) {
                int top = previous[x];
                int predictor;
                if (y == 0 || filter == 1u) {
                    predictor = left;
                } else if (filter == 2u) {
                    predictor = top;
                } else {
                    predictor = left + top - top_left;
                    if (predictor < 0) predictor = 0;
                    if (predictor > 255) predictor = 255;
                }
                unsigned char alpha = (unsigned char)(predictor + 1);
                CHECK(run.pixels[((size_t)y * source + (size_t)x) * 4u + 3u]
                      == alpha);
                previous[x] = alpha;
                left = alpha;
                top_left = top;
            }
        }
        image_resource_free_decoded(budget, run.pixels);
        free(webp.data);
        CHECK(budget->current == 0);
    }
    return 0;
}
