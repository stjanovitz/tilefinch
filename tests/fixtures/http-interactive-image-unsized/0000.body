<!doctype html><title>Unsized image priority</title><style>body{margin:4px}.sized{display:inline;width:64px;height:48px}#below{position:absolute;top:900px}</style><body><div id=masthead><img id=logo alt="Site logo" src=/tail.svg></div><div id=bar><img id=icon src=/last.svg></div><p>Useful article content.</p><div id=below><img class=sized id=far src=/hero.svg><img class=sized id=further src=/changed.svg></div><p style='height:1800px'>Long page</p><script>setInterval(function(){},1000)</script></body>