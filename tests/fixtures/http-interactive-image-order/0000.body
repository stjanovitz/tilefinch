<!doctype html><title>Image priority journey</title><style>body{margin:4px}a{display:block;height:32px}img{display:inline;width:64px;height:48px}#hero{position:absolute;top:1200px}#tail{position:absolute;top:100px}#last{position:absolute;top:160px}#lazy{position:absolute;top:1550px}</style><body><a id=next href=/next>Next section</a><details><summary id=toggle>History</summary><p>Useful article content.</p></details><svg width=8 height=8><rect width=8 height=8 fill=blue /></svg><div id=first><img id=hero src=/hero.svg></div><div id=hidden-parent style='display:none'><img id=hidden src=/hero.svg></div><img id=tail src=/tail.svg><img id=last src=/last.svg><img id=lazy loading=lazy src=/changed.svg><p style='height:1800px'>Long page</p><script>setInterval(function(){},1000)</script></body>
