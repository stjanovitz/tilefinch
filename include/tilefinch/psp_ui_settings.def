/*
 * The PSP chrome's setting identifiers in PspUiSettingId order, each with the
 * name the input-script harness logs for it. Define
 * PSP_UI_SETTING(ID, "script-name") before including this file; it expands
 * once per setting.
 *
 * Append new settings at the end so that existing values never change.
 */
PSP_UI_SETTING(NONE, "none")
PSP_UI_SETTING(BROWSER_UI_SCALE, "browser-ui-scale")
PSP_UI_SETTING(PAGE_FONT_PERCENT, "page-font-percent")
PSP_UI_SETTING(READER_FONT, "reader-font")
PSP_UI_SETTING(REMEMBER_READER_SITE_SCALE, "remember-reader-site-scale")
PSP_UI_SETTING(READER_AUTO_MODE, "reader-auto-mode")
PSP_UI_SETTING(CUSTOM_HOMEPAGE, "custom-homepage")
PSP_UI_SETTING(HISTORY, "history")
PSP_UI_SETTING(RESTORE_LAST_PAGE, "restore-last-page")
PSP_UI_SETTING(TAB_HIBERNATION, "tab-hibernation")
PSP_UI_SETTING(EXPERIMENTAL_VOICE, "experimental-voice")
PSP_UI_SETTING(ADAPTIVE_VOICE_MEMORY, "adaptive-voice-memory")
PSP_UI_SETTING(ANALOG_CURSOR, "analog-cursor")
PSP_UI_SETTING(TEXT_ENTRY_MODE, "text-entry-mode")
PSP_UI_SETTING(PERSISTENT_CACHE_MB, "persistent-cache-mb")
PSP_UI_SETTING(LIVE_CACHE_KIB, "live-cache-kib")
PSP_UI_SETTING(PERSIST_LOCAL_STORAGE, "persist-local-storage")
PSP_UI_SETTING(SEARCH_ENGINE, "search-engine")
PSP_UI_SETTING(COLOR_MODE, "color-mode")
PSP_UI_SETTING(CHROME_THEME, "chrome-theme")
PSP_UI_SETTING(GLYPH_LANGUAGE, "glyph-language")
PSP_UI_SETTING(COLOR_EMOJI, "color-emoji")
PSP_UI_SETTING(YOUTUBE_QUALITY, "youtube-quality")
PSP_UI_SETTING(VIDEO_LANGUAGE, "video-language")
PSP_UI_SETTING(SUBTITLE_LANGUAGE, "subtitle-language")
PSP_UI_SETTING(ALTERNATE_LANGUAGE, "alternate-language")
PSP_UI_SETTING(SUBTITLE_SIZE, "subtitle-size")
PSP_UI_SETTING(SUBTITLE_BACKGROUND, "subtitle-background")
PSP_UI_SETTING(YOUTUBE_COMPACT_RESULTS, "youtube-compact-results")
PSP_UI_SETTING(YOUTUBE_AUDIO_ONLY, "youtube-audio-only")
PSP_UI_SETTING(VIDEO_SCALING, "video-scaling")
PSP_UI_SETTING(VIDEO_STARTUP_BUFFERING, "video-startup-buffering")
PSP_UI_SETTING(RESUME_OFFLINE_DOWNLOADS, "resume-offline-downloads")
PSP_UI_SETTING(CONTENT_BLOCKER_MODE, "content-blocker-mode")
PSP_UI_SETTING(CONTENT_BLOCKER_SITE_ALLOWED, "content-blocker-site-allowed")
PSP_UI_SETTING(CONTENT_BLOCKER_COSMETIC_HIDING, "content-blocker-cosmetic-hiding")
PSP_UI_SETTING(COOKIE_BANNER_HIDDEN, "cookie-banner-hidden")
PSP_UI_SETTING(UPDATE_CHECK, "update-check")
PSP_UI_SETTING(WAVE_BACKGROUND, "wave-background")
PSP_UI_SETTING(JAVASCRIPT, "javascript")
PSP_UI_SETTING(SITE_JAVASCRIPT, "site-javascript")
PSP_UI_SETTING(SITE_DATA_ALLOWED, "site-data-allowed")
PSP_UI_SETTING(MIXED_CONTENT_SITE, "mixed-content-site")
