+        "lv.q C100, 128(%0)\n\t" "lv.q C110, 160(%0)\n\t" "lv.q C120, 192(%0)\n\t" "lv.q C130, 224(%0)\n\t"
+        "lv.q C200, 256(%0)\n\t" "lv.q C210, 288(%0)\n\t" "lv.q C220, 320(%0)\n\t" "lv.q C230, 352(%0)\n\t"
+        "lv.q C300, 384(%0)\n\t"
+        : : "r"(tmp) : "memory");
+}
