+        LNT(LFN_MASK1)
+        ".set push\n\t.set noreorder\n\t"
+        "vcmp.q LT, C220, C630\n\t"
+        "nop\n\t"
+        "bvf   4, 9f\n\t"
+        "nop\n\t"
+        ".set pop\n\t"
+        LNT(LFN_APAQ) LNT(LFN_TPQ) LNT(LFN_F) LNT(LFN_TC) LNT(LFN_P0S) LNT(LFN_P1A) LNT(LFN_P1S)
+        "vadd.q C000, C000, C600\n\tvadd.q C010, C010, C600\n\tvadd.q C020, C020, C600\n\tvadd.q C030, C030, C600\n\t"
