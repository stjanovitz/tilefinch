+/* dst words %[w0..w3] -> (b-128) quads in T0..T3 = C310, C320, C330, C610 */
+#define VB_DST4() \
+    "mtv   %[w0], S310\n\tmtv %[w1], S320\n\tmtv %[w2], S330\n\tmtv %[w3], S610\n\t" \
