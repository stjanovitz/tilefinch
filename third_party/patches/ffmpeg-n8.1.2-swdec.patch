+/* One shared, out-of-line copy per kernel keeps the hot code small for
+   the 16 KB instruction cache: the position functions are thin glue.
+   Horizontal 6-tap for an 8-wide block of `rows` rows. Bands of four rows;
+   a partial last band (RAWF, 13 rows) writes its garbage rows into a
+   scratch line so the stores stay branch-free.
+   dst/dstStride: bytes for pixel modes; floats (row stride 32 B) for TMPF/RAWF. */
+static av_noinline void qpel8_h(uint8_t *dst, ptrdiff_t dstStride,
+                                const uint8_t *src, ptrdiff_t srcStride,
+                                int rows, int mode)
+{
+    float scratch[8] __attribute__((aligned(16)));
+    for (int y = 0; y < rows; y += 4) {
+        int band = rows - y < 4 ? rows - y : 4;
+        hload_band(src + y * srcStride, srcStride, band);
+        __asm__ volatile (HFIR_ALL8() : : [cst]"r"(qpel_consts) : "memory");
+        if (mode == HM_L2X0 || mode == HM_L2X0_DST)
+            __asm__ volatile ("vzero.q C620\n\t" HL2_ALL_X0() : : : "memory");
+        else if (mode == HM_L2X1 || mode == HM_L2X1_DST)
+            __asm__ volatile ("vzero.q C620\n\t" HL2_ALL_X1() : : : "memory");
+
+        uint8_t *d0 = dst + y * dstStride;
+        uint8_t *d1 = band > 1 ? d0 + dstStride : (uint8_t *) scratch;
+        uint8_t *d2 = band > 2 ? d0 + 2 * dstStride : (uint8_t *) scratch;
+        uint8_t *d3 = band > 3 ? d0 + 3 * dstStride : (uint8_t *) scratch;
+        uint32_t w0 = 0, w1 = 0, w2 = 0, w3 = 0, w4 = 0, w5 = 0, w6 = 0, w7 = 0;
+        if (mode == HM_AVGDST || mode == HM_L2X0_DST || mode == HM_L2X1_DST) {
+            w0 = psp_lw(d0) ^ PSP_PIX_XOR; w1 = psp_lw(d1) ^ PSP_PIX_XOR; w2 = psp_lw(d2) ^ PSP_PIX_XOR; w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+            w4 = psp_lw(d0 + 4) ^ PSP_PIX_XOR; w5 = psp_lw(d1 + 4) ^ PSP_PIX_XOR; w6 = psp_lw(d2 + 4) ^ PSP_PIX_XOR; w7 = psp_lw(d3 + 4) ^ PSP_PIX_XOR;
+        }
+#define HRUN(BODY) __asm__ volatile (BODY() \
+            : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3), \
+                [w0]"r"(w0), [w1]"r"(w1), [w2]"r"(w2), [w3]"r"(w3), [w4]"r"(w4), [w5]"r"(w5), [w6]"r"(w6), [w7]"r"(w7) : "memory")
+        switch (mode) {
+        case HM_PUT:                     HRUN(HB_PUT); break;
+        case HM_L2X0: case HM_L2X1:      HRUN(HB_DIV2); break;
+        case HM_L2X0_DST: case HM_L2X1_DST: HRUN(HB_L2DST); break;
+        case HM_AVGDST:                  HRUN(HB_AVGDST); break;
+        case HM_TMPF:                    HRUN(HB_TMPF); break;
+        default:                         HRUN(HB_RAWF); break;
+        }
+#undef HRUN
+    }
+}
