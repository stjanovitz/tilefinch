+    "vc2i.s C" #j2 #k2 "0, S" #j2 #k2 "0\n\tvc2i.s C" #j3 #k3 "0, S" #j3 #k3 "0\n\t" \
+    "vi2f.q C" #j0 #k0 "0, C" #j0 #k0 "0, 24\n\tvi2f.q C" #j1 #k1 "0, C" #j1 #k1 "0, 24\n\t" \
+    "vi2f.q C" #j2 #k2 "0, C" #j2 #k2 "0, 24\n\tvi2f.q C" #j3 #k3 "0, C" #j3 #k3 "0, 24\n\t"
