+        "vmov.q C720, C720[x,x,x,x]\n\tvmov.q C730, C730[x,x,x,x]\n\t"
+        "lw    %[t0], 0(%[q0])\n\tlw %[t1], 4(%[q0])\n\tlw %[t2], 0(%[rq1])\n\tlw %[t3], 4(%[rq1])\n\t"
+        "vadd.q C520, C720, C610\n\tvadd.q C530, C730, C610\n\t"
+        "xor   %[t0], %[t0], %[K]\n\txor %[t1], %[t1], %[K]\n\txor %[t2], %[t2], %[K]\n\txor %[t3], %[t3], %[K]\n\t"
+        "mtv   %[t0], S030\n\tmtv %[t1], S330\n\tmtv %[t2], S100\n\tmtv %[t3], S400\n\t"
+        "vc2i.s C010, S010\n\tvc2i.s C310, S310\n\tvc2i.s C020, S020\n\tvc2i.s C320, S320\n\t"
+        "vc2i.s C030, S030\n\tvc2i.s C330, S330\n\tvc2i.s C100, S100\n\tvc2i.s C400, S400\n\t"
+        "vi2f.q C010, C010, 24\n\tvi2f.q C310, C310, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C320, C320, 24\n\t"
+        "vi2f.q C030, C030, 24\n\tvi2f.q C330, C330, 24\n\tvi2f.q C100, C100, 24\n\tvi2f.q C400, C400, 24\n\t"
+        LNA(LFN_MASK1) LNB(LFN_MASK1)
+        "vmin.q C210, C120, C420\n\t"          /* any lane of either column below 0 -> filter */
+        ".set push\n\t.set noreorder\n\t"
+        "vcmp.q LT, C210, C630\n\t"
