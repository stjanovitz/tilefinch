+        "lw    %[t0], 0(%[rp2])\n\tlw %[t1], 4(%[rp2])\n\tlw %[t2], 0(%[rq2])\n\tlw %[t3], 4(%[rq2])\n\t"
+        "xor   %[t0], %[t0], %[K]\n\txor %[t1], %[t1], %[K]\n\txor %[t2], %[t2], %[K]\n\txor %[t3], %[t3], %[K]\n\t"
+        "mtv   %[t0], S000\n\tmtv %[t1], S300\n\tmtv %[t2], S110\n\tmtv %[t3], S410\n\t"
+        "vc2i.s C000, S000\n\tvc2i.s C300, S300\n\tvc2i.s C110, S110\n\tvc2i.s C410, S410\n\t"
+        "vi2f.q C000, C000, 24\n\tvi2f.q C300, C300, 24\n\tvi2f.q C110, C110, 24\n\tvi2f.q C410, C410, 24\n\t"
+        LNA(LFN_APAQ) LNB(LFN_APAQ)
+        LNA(LFN_TPQ)  LNB(LFN_TPQ)
+        LNA(LFN_F)    LNB(LFN_F)
