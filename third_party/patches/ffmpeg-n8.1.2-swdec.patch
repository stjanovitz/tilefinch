+/* transposed intra: 4 rows per block */
+static av_noinline void lfl_h_intra_group(uint8_t *pix, ptrdiff_t stride)
+{
+    uint8_t *r1 = pix + stride, *r2 = pix + 2 * stride, *r3 = pix + 3 * stride;
+    uint32_t t0, t1, t2, t3;
+    __asm__ volatile (
+        "lw    %[t0], -4(%[r0])\n\tlw %[t1], -4(%[r1])\n\tlw %[t2], -4(%[r2])\n\tlw %[t3], -4(%[r3])\n\t"
+        "xor   %[t0], %[t0], %[K]\n\txor %[t1], %[t1], %[K]\n\txor %[t2], %[t2], %[K]\n\txor %[t3], %[t3], %[K]\n\t"
+        "mtv   %[t0], S000\n\tmtv %[t1], S010\n\tmtv %[t2], S020\n\tmtv %[t3], S030\n\t"
+        "lw    %[t0], 0(%[r0])\n\tlw %[t1], 0(%[r1])\n\tlw %[t2], 0(%[r2])\n\tlw %[t3], 0(%[r3])\n\t"
+        "xor   %[t0], %[t0], %[K]\n\txor %[t1], %[t1], %[K]\n\txor %[t2], %[t2], %[K]\n\txor %[t3], %[t3], %[K]\n\t"
+        "mtv   %[t0], S100\n\tmtv %[t1], S110\n\tmtv %[t2], S120\n\tmtv %[t3], S130\n\t"
+        "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t"
+        "vc2i.s C100, S100\n\tvc2i.s C110, S110\n\tvc2i.s C120, S120\n\tvc2i.s C130, S130\n\t"
+        "vi2f.q R000, R000, 24\n\tvi2f.q R001, R001, 24\n\tvi2f.q R002, R002, 24\n\tvi2f.q R003, R003, 24\n\t"
+        "vi2f.q R100, R100, 24\n\tvi2f.q R101, R101, 24\n\tvi2f.q R102, R102, 24\n\tvi2f.q R103, R103, 24\n\t"
+        LFI_BODY("R000","R001","R002","R003","R100","R101","R102","R103")
+        "vadd.q C000, C000, C600\n\tvadd.q C010, C010, C600\n\tvadd.q C020, C020, C600\n\tvadd.q C030, C030, C600\n\t"
+        "vadd.q C100, C100, C600\n\tvadd.q C110, C110, C600\n\tvadd.q C120, C120, C600\n\tvadd.q C130, C130, C600\n\t"
+        "vf2id.q C000, C000, 23\n\tvf2id.q C010, C010, 23\n\tvf2id.q C020, C020, 23\n\tvf2id.q C030, C030, 23\n\t"
+        "vf2id.q C100, C100, 23\n\tvf2id.q C110, C110, 23\n\tvf2id.q C120, C120, 23\n\tvf2id.q C130, C130, 23\n\t"
+        "vi2uc.q S200, C000\n\tvi2uc.q S201, C010\n\tvi2uc.q S202, C020\n\tvi2uc.q S203, C030\n\t"
+        "vi2uc.q S210, C100\n\tvi2uc.q S211, C110\n\tvi2uc.q S212, C120\n\tvi2uc.q S213, C130\n\t"
+        "sv.s  S200, -4(%[r0])\n\tsv.s S201, -4(%[r1])\n\tsv.s S202, -4(%[r2])\n\tsv.s S203, -4(%[r3])\n\t"
+        "sv.s  S210, 0(%[r0])\n\tsv.s S211, 0(%[r1])\n\tsv.s S212, 0(%[r2])\n\tsv.s S213, 0(%[r3])\n\t"
+        "9:\n\t"
