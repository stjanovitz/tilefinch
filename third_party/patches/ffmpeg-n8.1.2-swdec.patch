+/* ---------------------------------------------------------------------
+ * swdec: row-batched reconstruction.
+ *
+ * On the PSP (16 KB instruction cache, 16 KB data cache) parsing a
+ * macroblock and reconstructing it back to back evicts each other's code
+ * and tables: a parse-only probe measured ~25% of CABAC time lost to that
+ * interference. So for frame pictures the CABAC loop parses a whole row of
+ * macroblocks first, keeping each macroblock's parsed state (the caches
+ * ff_h264_hl_decode_mb reads) in a job, and its coefficients in a per-row
+ * ring slot (sl->mb is a pointer), then reconstructs the row in order.
+ * Reconstruction order within a row is unchanged, deblocking still runs
+ * per row after reconstruction, so the output is bit-identical.
+ * ------------------------------------------------------------------- */
+
+typedef struct SwdecMbJob {
+    int mb_x, mb_y, mb_xy;
+    int intra;
+    unsigned cksum;                 /* save-time checksum of the payload (race diagnosis) */
+    int mb_field_decoding_flag;
+    int qscale, chroma_qp[2], cbp;
+    int chroma_pred_mode, intra16x16_pred_mode, top_type;
+    unsigned int topleft_samples_available, topright_samples_available;
+    const uint8_t *intra_pcm_ptr;
+    int16_t *mb;
+    uint16_t sub_mb_type[4];
+    uint8_t non_zero_count_cache[15 * 8];
+    int8_t intra4x4_pred_mode_cache[5 * 8];
+    int8_t ref_cache[2][5 * 8];
+    int16_t mv_cache[2][5 * 8][2];
+    int16_t mb_luma_dc[3][16 * 2];
+} SwdecMbJob;
+
+int swdec_rowbatch = 1;   /* runtime switch (the harness A/Bs it) */
+static int swdec_batch_enabled(const H264Context *h)
+{
+    return swdec_rowbatch && !FRAME_MBAFF(h) && h->picture_structure == PICT_FRAME;
+}
+
+/* ------------------------------------------------------------------------
+ * swdec row pipeline: the parser (producer, on the CPU or the Media Engine)
+ * fills per-row job lists + coefficient ring slots, double-buffered by row
+ * sequence parity, and publishes each finished row segment through a
+ * mailbox; the consumer (always the CPU) reconstructs the row's jobs on the
+ * recon slice context h->swdec_rsl and deblocks it. With SWDEC_ME=0 the
+ * producer calls the consumer inline (sequential, PPSSPP-validated).
+ * ------------------------------------------------------------------------ */
+/* full memory barrier: payload writes must be visible before the sequence
+   counter that publishes them, and counter reads must happen before payload
+   reads (the host simulator runs on weakly-ordered CPUs; the PSP pipe is
+   uncached but ME/CPU still need the write buffers drained) */
+#if defined(PSP)
+#define SWDEC_MB() __asm__ volatile ("sync" ::: "memory")
+#else
+#define SWDEC_MB() __sync_synchronize()
+#endif
+
+typedef struct SwdecRowRec { int mb_y, x_start, x_end, njobs, buf; } SwdecRowRec;
+#define SWDEC_DQ 16                 /* deblock queue depth (>= rows per frame) */
+typedef struct SwdecPipe {
+    volatile int prod_seq;      /* row segments published */
+    volatile int cons_seq;      /* row segments consumed */
+    volatile int status;        /* producer: 0 running, 1 finished, <0 error (ME mode) */
+    SwdecRowRec rec[2];         /* [seq & 1], written before prod_seq advances */
+    volatile int parse_done;    /* producer: all rows of the slice published */
+    volatile int tail_pushed;   /* consumer: held-back deblock row flushed */
+    volatile int dprod, dcons;  /* deblock queue: CPU publishes, the parser core filters */
+    SwdecRowRec drec[SWDEC_DQ];
+    SwdecRowRec dprev;          /* consumer-side: row awaiting its lag-1 publish */
+    int dprev_valid;
+} SwdecPipe;
+
+int swdec_me_enabled = 0;
+int swdec_me_deblock = 0;                                   /* deblocking runs on the parser core (needs swdec_me hooks) */
+void (*swdec_cpu_flush_row)(const struct H264Context *h, int mb_y) = NULL;  /* CPU: writeback+invalidate the row's pixels */
+void (*swdec_me_post_deblock)(void) = NULL;                 /* parser core: write back its D-cache after filtering */
+void (*swdec_me_aux)(void) = NULL;                          /* parser core: extra idle-time work (audio decoding) */
+void (*swdec_me_csc_row)(const struct H264Context *h, int mb_row) = NULL;   /* parser core: convert the now-final row above */                                   /* set by the harness/app when the ME runs the parser */
+int swdec_validate_force = 0;   /* validate jobs even in sequential mode (host diagnosis) */
+int swdec_pipe_bad = 0;                                     /* consumer saw an inconsistent row record (1) or job (2/3) */
+int swdec_pipe_bad_info[6];
+int (*swdec_me_run_slice)(struct AVCodecContext *avctx, void *sl) = NULL;   /* CPU dispatcher (swdec.c, PSP) */
+static int decode_slice(struct AVCodecContext *avctx, void *arg);
+int ff_swdec_decode_slice(struct AVCodecContext *avctx, void *arg) { return decode_slice(avctx, arg); }
+unsigned swdec_layout_key(void) { return (unsigned) sizeof(H264SliceContext) * 65536u + (unsigned) offsetof(H264SliceContext, swdec_ring) + (unsigned) sizeof(H264Context) % 65536u; }
+void (*swdec_me_pre_publish)(void) = NULL;                  /* ME side: write back its D-cache before publishing */
+void (*swdec_cpu_pre_consume)(const H264Context *h, int mb_y) = NULL;  /* CPU side: invalidate the row's tables */
+void (*swdec_cpu_post_consume)(void *p, size_t n) = NULL;   /* CPU side: writeback-invalidate ring/jobs of the row */
+static SwdecPipe swdec_pipe_storage __attribute__((aligned(64)));
+static SwdecPipe *swdec_pipe = &swdec_pipe_storage;         /* alias used by whoever runs this code (see swdec_pipe_set) */
+void swdec_pipe_set(void *unc) { swdec_pipe = unc ? (SwdecPipe *) unc : &swdec_pipe_storage; }
+void *swdec_pipe_get(void) { return &swdec_pipe_storage; }
+void swdec_pipe_reset(void) { swdec_pipe->prod_seq = swdec_pipe->cons_seq = swdec_pipe->status = 0; swdec_pipe->dprod = swdec_pipe->dcons = 0; swdec_pipe->dprev_valid = 0; swdec_pipe->parse_done = swdec_pipe->tail_pushed = 0; }
+void swdec_pipe_slice_begin(void) { swdec_pipe->parse_done = swdec_pipe->tail_pushed = 0; }
+void swdec_pipe_set_parse_done(void) { SWDEC_MB(); swdec_pipe->parse_done = 1; }
+int  swdec_pipe_parse_done(void) { return swdec_pipe->parse_done; }
+void swdec_pipe_set_tail_pushed(void) { SWDEC_MB(); swdec_pipe->tail_pushed = 1; }
+int  swdec_pipe_tail_pushed(void) { return swdec_pipe->tail_pushed; }
+
+/* The ring must be zero when parsing starts: the IDCTs clear what they
+   consume (the same invariant the single mb block relies on), and
+   h264_frame_start() re-zeroes it once per frame in case an error path
+   left something behind. Two rows: seq parity selects the half. */
+int swdec_ring_setup(H264Context *h, H264SliceContext *sl);
+int swdec_ring_setup(H264Context *h, H264SliceContext *sl)
+{
+    if (sl->swdec_ring_slots != 2 * h->mb_width) {
+        /* both halves must start on their own 64-byte cache line (the two cores
+           own different halves at the same time); jobs likewise */
+        size_t half = (size_t) h->mb_width * SWDEC_RING_SLOT(h) * sizeof(int16_t);
+        size_t jhalf = ((size_t) h->mb_width * sizeof(SwdecMbJob) + 63) & ~(size_t) 63;
+        av_freep(&sl->swdec_ring_base);
+        av_freep(&sl->swdec_jobs_base);
+        sl->swdec_ring_slots = 0;
+        sl->swdec_ring_base = av_mallocz(2 * half + 64);
+        sl->swdec_jobs_base = av_malloc(2 * jhalf + 64);
+        if (!sl->swdec_ring_base || !sl->swdec_jobs_base)
+            return AVERROR(ENOMEM);
+        sl->swdec_ring = (int16_t *) (((uintptr_t) sl->swdec_ring_base + 63) & ~(uintptr_t) 63);
+        sl->swdec_jobs = (void *) (((uintptr_t) sl->swdec_jobs_base + 63) & ~(uintptr_t) 63);
+        sl->swdec_jobs_stride = jhalf;
+        sl->swdec_ring_slots = 2 * h->mb_width;
+    }
+    sl->swdec_njobs = 0;
+    if (!h->swdec_rsl && !(h->swdec_rsl = av_malloc(sizeof(*sl))))
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+static av_always_inline void swdec_job_save(const H264SliceContext *sl, SwdecMbJob *j, int intra)
+{
+    j->mb_x = sl->mb_x; j->mb_y = sl->mb_y; j->mb_xy = sl->mb_xy;
+    j->mb_field_decoding_flag = sl->mb_field_decoding_flag;
+    j->qscale = sl->qscale; j->chroma_qp[0] = sl->chroma_qp[0]; j->chroma_qp[1] = sl->chroma_qp[1];
+    j->cbp = sl->cbp;
+    j->chroma_pred_mode = sl->chroma_pred_mode; j->intra16x16_pred_mode = sl->intra16x16_pred_mode;
+    j->top_type = sl->top_type;
+    j->topleft_samples_available = sl->topleft_samples_available;
+    j->topright_samples_available = sl->topright_samples_available;
+    j->intra_pcm_ptr = sl->intra_pcm_ptr;
+    j->mb = sl->mb;
+    memcpy(j->non_zero_count_cache, sl->non_zero_count_cache, sizeof j->non_zero_count_cache);
+    if (intra) {
+        memcpy(j->intra4x4_pred_mode_cache, sl->intra4x4_pred_mode_cache, sizeof j->intra4x4_pred_mode_cache);
+        memcpy(j->mb_luma_dc, sl->mb_luma_dc, sizeof j->mb_luma_dc);
+    } else {
+        memcpy(j->sub_mb_type, sl->sub_mb_type, sizeof j->sub_mb_type);
+        memcpy(j->ref_cache, sl->ref_cache, sizeof j->ref_cache);
+        memcpy(j->mv_cache, sl->mv_cache, sizeof j->mv_cache);
+    }
+    j->intra = intra;
+#if defined(SWDEC_PIPE_VALIDATE) && SWDEC_PIPE_VALIDATE
+    {
+        unsigned c = (unsigned) (j->mb_x * 2654435761u) ^ (unsigned) j->mb_xy ^ (unsigned) (j->qscale << 20) ^ (unsigned) (intra << 27);
+        const unsigned *q = (const unsigned *) j->non_zero_count_cache;
+        for (unsigned k = 0; k < sizeof(j->non_zero_count_cache) / 4; k++) c = c * 31u + q[k];
+        if (intra) {
+            q = (const unsigned *) j->intra4x4_pred_mode_cache;
+            for (unsigned k = 0; k < sizeof(j->intra4x4_pred_mode_cache) / 4; k++) c = c * 31u + q[k];
+        } else {
+            q = (const unsigned *) j->mv_cache;
+            for (unsigned k = 0; k < sizeof(j->mv_cache) / 4; k++) c = c * 31u + q[k];
+            q = (const unsigned *) j->ref_cache;
+            for (unsigned k = 0; k < sizeof(j->ref_cache) / 4; k++) c = c * 31u + q[k];
+        }
+        j->cksum = c;
+    }
+#endif
+}
