+#define VB_PUT_HV(Q0, Q1, Q2, Q3, A0, A1, A2, A3) \
+    VB_SCL(Q0, "S703") VB_SCL(Q1, "S703") VB_SCL(Q2, "S703") VB_SCL(Q3, "S703") \
+    VB_ADDK(Q0, "C710") VB_ADDK(Q1, "C710") VB_ADDK(Q2, "C710") VB_ADDK(Q3, "C710") \
+    VB_F2ID(Q0, "23") VB_F2ID(Q1, "23") VB_F2ID(Q2, "23") VB_F2ID(Q3, "23") \
+    VB_PACK4(Q0, Q1, Q2, Q3)
+#define VB_L2ROW(Q0, Q1, Q2, Q3, A0, A1, A2, A3) \
+    "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, "S702") VB_STOREAVG4(Q0, Q1, Q2, Q3, A0, A1, A2, A3)
+#define VB_TMPF_(Q0, Q1, Q2, Q3, inv) \
+    "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, inv) \
+    VB_F2ID(Q0, "0") VB_F2ID(Q1, "0") VB_F2ID(Q2, "0") VB_F2ID(Q3, "0") \
+    VB_I2F(Q0, "0") VB_I2F(Q1, "0") VB_I2F(Q2, "0") VB_I2F(Q3, "0") \
+    "sv.q  " Q0 ", 0(%[f0])\n\tsv.q " Q1 ", 0(%[f1])\n\tsv.q " Q2 ", 0(%[f2])\n\tsv.q " Q3 ", 0(%[f3])\n\t"
+#define VB_TMPF(Q0, Q1, Q2, Q3, A0, A1, A2, A3)    VB_TMPF_(Q0, Q1, Q2, Q3, "S702")
+#define VB_TMPF_HV(Q0, Q1, Q2, Q3, A0, A1, A2, A3) VB_TMPF_(Q0, Q1, Q2, Q3, "S703")
+#define VB_L2F_(Q0, Q1, Q2, Q3, inv) \
+    VB_F4() "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, inv) \
+    VB_ADD4(Q0, Q1, Q2, Q3, "C000", "C010", "C020", "C030") \
+    "vone.q C600\n\t" \
+    VB_ADD4(Q0, Q1, Q2, Q3, "C600", "C600", "C600", "C600") \
+    VB_F2ID(Q0, "22") VB_F2ID(Q1, "22") VB_F2ID(Q2, "22") VB_F2ID(Q3, "22") \
+    VB_PACK4(Q0, Q1, Q2, Q3)
+#define VB_L2F(Q0, Q1, Q2, Q3, A0, A1, A2, A3)    VB_L2F_(Q0, Q1, Q2, Q3, "S702")
+#define VB_L2F_HV(Q0, Q1, Q2, Q3, A0, A1, A2, A3) VB_L2F_(Q0, Q1, Q2, Q3, "S703")
+#define VB_AVGDST_(Q0, Q1, Q2, Q3, inv) \
+    VB_DST4() "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, inv) VB_STOREAVG4(Q0, Q1, Q2, Q3, "C310", "C320", "C330", "C610")
+#define VB_AVGDST(Q0, Q1, Q2, Q3, A0, A1, A2, A3)    VB_AVGDST_(Q0, Q1, Q2, Q3, "S702")
+#define VB_AVGDST_HV(Q0, Q1, Q2, Q3, A0, A1, A2, A3) VB_AVGDST_(Q0, Q1, Q2, Q3, "S703")
+#define VB_L2ROW_DST(Q0, Q1, Q2, Q3, A0, A1, A2, A3) \
+    VB_DST4() "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, "S702") \
+    VB_ADD4(Q0, Q1, Q2, Q3, A0, A1, A2, A3) \
+    VB_ADDK(Q0, "C720") VB_ADDK(Q1, "C720") VB_ADDK(Q2, "C720") VB_ADDK(Q3, "C720") \
+    VB_HALF4(Q0, Q1, Q2, Q3) \
+    VB_STOREAVG4(Q0, Q1, Q2, Q3, "C310", "C320", "C330", "C610")
+#define VB_L2F_DST_(Q0, Q1, Q2, Q3, inv) \
+    VB_DST4() VB_F4() "vzero.q C620\n\t" VB_XCLIP4(Q0, Q1, Q2, Q3, inv) \
+    VB_ADD4(Q0, Q1, Q2, Q3, "C000", "C010", "C020", "C030") \
+    "vone.q C600\n\t" \
+    VB_ADD4(Q0, Q1, Q2, Q3, "C600", "C600", "C600", "C600") \
+    VB_HALF4(Q0, Q1, Q2, Q3) \
+    VB_STOREAVG4(Q0, Q1, Q2, Q3, "C310", "C320", "C330", "C610")
+#define VB_L2F_DST(Q0, Q1, Q2, Q3, A0, A1, A2, A3)    VB_L2F_DST_(Q0, Q1, Q2, Q3, "S702")
+#define VB_L2F_DST_HV(Q0, Q1, Q2, Q3, A0, A1, A2, A3) VB_L2F_DST_(Q0, Q1, Q2, Q3, "S703")
+
+/* Vertical 6-tap on one 4-wide half. `src` points at the top-left of the
+   half (row 0); for float input (hv second stage) `srcf` is used instead
+   with the 1024 division. Rows are stored in two batches of four with all
+   VFPU stages interleaved across the batch. */
+static av_noinline void qpel8_v_half(uint8_t *dst, ptrdiff_t dstStride,
+                                     const uint8_t *src, ptrdiff_t srcStride,
+                                     const float *srcf, int mode,
+                                     const float *tmpf /* l2 float source or TMPF dest, row stride 32 B */,
+                                     int hv)
+{
+    if (srcf) vload_half_f(srcf); else vload_half(src, srcStride);
+    __asm__ volatile (VFIR_ALL8() : : [cst]"r"(qpel_consts) : "memory");
+
+    uint8_t *d0 = dst, *d1 = dst + dstStride, *d2 = dst + 2 * dstStride, *d3 = dst + 3 * dstStride;
+    uint8_t *d4 = dst + 4 * dstStride, *d5 = dst + 5 * dstStride, *d6 = dst + 6 * dstStride, *d7 = dst + 7 * dstStride;
+    const float *f0 = tmpf, *f1 = tmpf + 8, *f2 = tmpf + 16, *f3 = tmpf + 24;
+    const float *f4 = tmpf + 32, *f5 = tmpf + 40, *f6 = tmpf + 48, *f7 = tmpf + 56;
+    (void) f0; (void) f1; (void) f2; (void) f3; (void) f4; (void) f5; (void) f6; (void) f7;
+
+    /* batch 0: rows 0-3 in C400..C430, source rows y (A0..) = VG2..VG5, y+1 = VG3..VG6
+       batch 1: rows 4-7 in C500..C530, source rows y = VG6..VG9, y+1 = VG7..VG10 */
+#define RUN2(BODY, ROWSEL0, ROWSEL1) \
+    do { \
+        __asm__ volatile (BODY("C400", "C410", "C420", "C430", ROWSEL0) \
+            : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3), [f0]"r"(f0), [f1]"r"(f1), [f2]"r"(f2), [f3]"r"(f3), \
+                [w0]"r"(w0), [w1]"r"(w1), [w2]"r"(w2), [w3]"r"(w3) : "memory"); \
+        __asm__ volatile (BODY("C500", "C510", "C520", "C530", ROWSEL1) \
+            : : [d0]"r"(d4), [d1]"r"(d5), [d2]"r"(d6), [d3]"r"(d7), [f0]"r"(f4), [f1]"r"(f5), [f2]"r"(f6), [f3]"r"(f7), \
+                [w0]"r"(w4), [w1]"r"(w5), [w2]"r"(w6), [w3]"r"(w7) : "memory"); \
+    } while (0)
+#define ROWS_Y0   VG2, VG3, VG4, VG5
+#define ROWS_Y0B  VG6, VG7, VG8, VG9
+#define ROWS_Y1   VG3, VG4, VG5, VG6
+#define ROWS_Y1B  VG7, VG8, VG9, VG10
+    uint32_t w0 = 0, w1 = 0, w2 = 0, w3 = 0, w4 = 0, w5 = 0, w6 = 0, w7 = 0;
+    if (mode == VM_AVGDST || mode == VM_L2ROW0_DST || mode == VM_L2ROW1_DST || mode == VM_L2TMPF_DST) {
+        w0 = psp_lw(d0) ^ PSP_PIX_XOR; w1 = psp_lw(d1) ^ PSP_PIX_XOR; w2 = psp_lw(d2) ^ PSP_PIX_XOR; w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+        w4 = psp_lw(d4) ^ PSP_PIX_XOR; w5 = psp_lw(d5) ^ PSP_PIX_XOR; w6 = psp_lw(d6) ^ PSP_PIX_XOR; w7 = psp_lw(d7) ^ PSP_PIX_XOR;
+    }
+    switch (mode) {
+    case VM_PUT:        if (hv) RUN2(VB_PUT_HV, ROWS_Y0, ROWS_Y0B); else RUN2(VB_PUT, ROWS_Y0, ROWS_Y0B); break;
+    case VM_L2ROW0:     RUN2(VB_L2ROW, ROWS_Y0, ROWS_Y0B); break;
+    case VM_L2ROW1:     RUN2(VB_L2ROW, ROWS_Y1, ROWS_Y1B); break;
+    case VM_L2TMPF:     if (hv) RUN2(VB_L2F_HV, ROWS_Y0, ROWS_Y0B); else RUN2(VB_L2F, ROWS_Y0, ROWS_Y0B); break;
+    case VM_AVGDST:     if (hv) RUN2(VB_AVGDST_HV, ROWS_Y0, ROWS_Y0B); else RUN2(VB_AVGDST, ROWS_Y0, ROWS_Y0B); break;
+    case VM_TMPF:       if (hv) RUN2(VB_TMPF_HV, ROWS_Y0, ROWS_Y0B); else RUN2(VB_TMPF, ROWS_Y0, ROWS_Y0B); break;
+    case VM_L2ROW0_DST: RUN2(VB_L2ROW_DST, ROWS_Y0, ROWS_Y0B); break;
+    case VM_L2ROW1_DST: RUN2(VB_L2ROW_DST, ROWS_Y1, ROWS_Y1B); break;
+    default:            if (hv) RUN2(VB_L2F_DST_HV, ROWS_Y0, ROWS_Y0B); else RUN2(VB_L2F_DST, ROWS_Y0, ROWS_Y0B); break;
+    }
+#undef RUN2
+}
+
+/* ================================================================== */
+/* 8x8 position functions                                              */
+/* ================================================================== */
+
+/* full-pel copy / average */
+static av_noinline void put_qpel8_mc00_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{
+    for (int y = 0; y < 8; y++, dst += stride, src += stride) {
+        *(uint32_t *) dst = psp_ulw(src);
+        *(uint32_t *) (dst + 4) = psp_ulw(src + 4);
+    }
+}
+static inline uint32_t rnd_avg32(uint32_t a, uint32_t b) { return (a | b) - (((a ^ b) & 0xFEFEFEFEu) >> 1); }
+static av_noinline void avg_qpel8_mc00_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{
+    for (int y = 0; y < 8; y++, dst += stride, src += stride) {
+        *(uint32_t *) dst = rnd_avg32(psp_lw(dst), psp_ulw(src));
+        *(uint32_t *) (dst + 4) = rnd_avg32(psp_lw(dst + 4), psp_ulw(src + 4));
+    }
+}
+
+/* horizontal family */
+static av_noinline void put_qpel8_mc20_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_PUT); }
+static av_noinline void avg_qpel8_mc20_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_AVGDST); }
+static av_noinline void put_qpel8_mc10_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X0); }
+static av_noinline void avg_qpel8_mc10_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X0_DST); }
+static av_noinline void put_qpel8_mc30_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X1); }
+static av_noinline void avg_qpel8_mc30_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X1_DST); }
+
+/* vertical family */
+static av_always_inline void qpel8_v(uint8_t *dst, ptrdiff_t dstStride, const uint8_t *src, ptrdiff_t srcStride,
+                                     int mode, const float *tmpf)
+{
+    qpel8_v_half(dst, dstStride, src, srcStride, 0, mode, tmpf, 0);
+    qpel8_v_half(dst + 4, dstStride, src + 4, srcStride, 0, mode, tmpf ? tmpf + 4 : 0, 0);
+}
+static av_noinline void put_qpel8_mc02_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_PUT, 0); }
+static av_noinline void avg_qpel8_mc02_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_AVGDST, 0); }
+static av_noinline void put_qpel8_mc01_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW0, 0); }
+static av_noinline void avg_qpel8_mc01_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW0_DST, 0); }
+static av_noinline void put_qpel8_mc03_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW1, 0); }
+static av_noinline void avg_qpel8_mc03_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW1_DST, 0); }
+
+/* diagonal family: halfH (float tmp) averaged with v-lowpass */
+static av_always_inline void qpel8_diag(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                        int hoff, int voff, int avg)
+{
+    float halfH[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) halfH, 32, src + hoff * stride, stride, 8, HM_TMPF);
+    qpel8_v(dst, stride, src + voff, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfH);
+}
+static av_noinline void put_qpel8_mc11_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 0, 0); }
+static av_noinline void put_qpel8_mc31_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 1, 0); }
+static av_noinline void put_qpel8_mc13_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 0, 0); }
+static av_noinline void put_qpel8_mc33_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 1, 0); }
+static av_noinline void avg_qpel8_mc11_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 0, 1); }
+static av_noinline void avg_qpel8_mc31_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 1, 1); }
+static av_noinline void avg_qpel8_mc13_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 0, 1); }
+static av_noinline void avg_qpel8_mc33_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 1, 1); }
+
+/* hv family: raw horizontal sums for rows -2..10 into tmp (13 x 8 floats), then vertical over tmp */
+static av_always_inline void qpel8_hv(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                      int mode, const float *l2f)
+{
+    float tmp[13 * 8 + 8] __attribute__((aligned(16)));
+    qpel8_h((uint8_t *) tmp, 32, src - 2 * stride, stride, 13, HM_RAWF);
+    qpel8_v_half(dst, stride, 0, 0, tmp, mode, l2f, 1);
+    qpel8_v_half(dst + 4, stride, 0, 0, tmp + 4, mode, l2f ? l2f + 4 : 0, 1);
+}
+static av_noinline void put_qpel8_mc22_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_hv(dst, src, stride, VM_PUT, 0); }
+static av_noinline void avg_qpel8_mc22_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_hv(dst, src, stride, VM_AVGDST, 0); }
+
+/* mc21/mc23: halfH (rows +0 / +1) averaged with hv */
+static av_always_inline void qpel8_hv_h(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int hoff, int avg)
+{
+    float halfH[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) halfH, 32, src + hoff * stride, stride, 8, HM_TMPF);
+    qpel8_hv(dst, src, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfH);
+}
+static av_noinline void put_qpel8_mc21_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 0, 0); }
+static av_noinline void put_qpel8_mc23_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 1, 0); }
+static av_noinline void avg_qpel8_mc21_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 0, 1); }
+static av_noinline void avg_qpel8_mc23_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 1, 1); }
+
+/* mc12/mc32: halfV (columns +0 / +1) averaged with hv */
+static av_always_inline void qpel8_hv_v(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int voff, int avg)
+{
+    float halfV[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_v((uint8_t *) halfV, 32, src + voff, stride, VM_TMPF, halfV);
+    qpel8_hv(dst, src, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfV);
+}
+static av_noinline void put_qpel8_mc12_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 0, 0); }
+static av_noinline void put_qpel8_mc32_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 1, 0); }
+static av_noinline void avg_qpel8_mc12_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 0, 1); }
+static av_noinline void avg_qpel8_mc32_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 1, 1); }
+
+/* 16x16 = four 8x8 */
+#define MC16(op, xy) \
+static void op##_qpel16_mc##xy##_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) \
+{ \
+    op##_qpel8_mc##xy##_psp(dst, src, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8, src + 8, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8 * stride, src + 8 * stride, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8 * stride + 8, src + 8 * stride + 8, stride); \
+}
+#define MC16_ALL(op) \
+    MC16(op, 00) MC16(op, 10) MC16(op, 20) MC16(op, 30) \
+    MC16(op, 01) MC16(op, 11) MC16(op, 21) MC16(op, 31) \
+    MC16(op, 02) MC16(op, 12) MC16(op, 22) MC16(op, 32) \
+    MC16(op, 03) MC16(op, 13) MC16(op, 23) MC16(op, 33)
+MC16_ALL(put)
+MC16_ALL(avg)
+
+av_cold void ff_h264qpel_init_psp(H264QpelContext *c, int bit_depth)
+{
+    if (bit_depth != 8 || swdec_psp_level < 1)
+        return;
+#define SET(op, idx, sz) \
+    c->op##_h264_qpel_pixels_tab[idx][ 0] = op##_qpel##sz##_mc00_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 1] = op##_qpel##sz##_mc10_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 2] = op##_qpel##sz##_mc20_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 3] = op##_qpel##sz##_mc30_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 4] = op##_qpel##sz##_mc01_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 5] = op##_qpel##sz##_mc11_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 6] = op##_qpel##sz##_mc21_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 7] = op##_qpel##sz##_mc31_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 8] = op##_qpel##sz##_mc02_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 9] = op##_qpel##sz##_mc12_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][10] = op##_qpel##sz##_mc22_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][11] = op##_qpel##sz##_mc32_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][12] = op##_qpel##sz##_mc03_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][13] = op##_qpel##sz##_mc13_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][14] = op##_qpel##sz##_mc23_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][15] = op##_qpel##sz##_mc33_psp;
+    SET(put, 0, 16)
+    SET(put, 1, 8)
+    SET(avg, 0, 16)
+    SET(avg, 1, 8)
+#undef SET
+}
+
+#else
+typedef int swdec_psp_h264qpel_unused;
+#endif
diff --git a/libavcodec/psp/vfpu_util.h b/libavcodec/psp/vfpu_util.h
new file mode 100644
index 0000000..b901e21
--- /dev/null
+++ b/libavcodec/psp/vfpu_util.h
@@ -0,0 +1,70 @@
+/*
+ * Shared VFPU conventions for the swdec PSP kernels.
+ *
+ * Pixel bytes enter the VFPU as (b - 128) exactly: the GPR word is XORed
+ * with 0x80808080, moved with mtv, unpacked with vc2i (byte << 24, signed)
+ * and scaled with vi2f 24. Linear filters then only need their rounding
+ * constant adjusted by 128 * (sum of weights).
+ *
+ * Results leave the VFPU with vf2id (floor, saturating) + vi2uc, which
+ * yields clip_uint8(floor(x)) for the >>23 fixed-point convention; the
+ * imm of vf2id absorbs power-of-two divisions (imm = 23 - shift).
+ *
+ * All arithmetic is on integer-valued floats far below 2^24, so vadd/vscl
+ * are exact and no dot-product instruction is used (the VFPU dot product
+ * rounds internally).
+ *
+ * VFPU registers are not known to the compiler; every asm block here is
+ * self-contained (loads its inputs, stores its outputs) except where a
+ * function keeps constants in M700 for its own duration.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#ifndef AVCODEC_PSP_VFPU_UTIL_H
+#define AVCODEC_PSP_VFPU_UTIL_H
+
+#include <stdint.h>
+
+#define PSP_PIX_XOR 0x80808080u
+
+/* unaligned 32-bit load (lwl/lwr) */
+static inline uint32_t psp_ulw(const uint8_t *p)
+{
+    uint32_t w;
+    __asm__ ("ulw %0, 0(%1)" : "=r"(w) : "r"(p) : "memory");
+    return w;
+}
+static inline uint32_t psp_lw(const uint8_t *p)
+{
+    return *(const uint32_t *) p;
+}
+static inline void psp_sw(uint8_t *p, uint32_t w)
+{
+    *(uint32_t *) p = w;
+}
+/* unaligned 32-bit store (swl/swr) */
+static inline void psp_usw(uint8_t *p, uint32_t w)
+{
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(w), "r"(p) : "memory");
+}
+
+/* Byte->float unpack of a GPR word into a VFPU quad register (string
+   name), via a scratch single S in the same column.  The word must
+   already be XORed with PSP_PIX_XOR. */
+#define VFPU_UNPACK(sreg, qreg, w) \
+    "mtv   " w ", " sreg "\n\t" \
+    "vc2i.s " qreg ", " sreg "\n\t" \
+    "vi2f.q " qreg ", " qreg ", 24\n\t"
+
+/* Float quad -> 4 bytes at 4-byte aligned address (clip(floor(x))). */
+#define VFPU_PACK_STORE(qreg, sreg, addr) \
+    "vf2id.q " qreg ", " qreg ", 23\n\t" \
+    "vi2uc.q " sreg ", " qreg "\n\t" \
+    "sv.s  " sreg ", 0(" addr ")\n\t"
+
+#endif
diff --git a/libavcodec/swdec_pipe.h b/libavcodec/swdec_pipe.h
