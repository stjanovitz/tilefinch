+        : [rp3]"r"(rp3), [rp2]"r"(rp2), [rp1]"r"(rp1), [rp0]"r"(rp0), [q0]"r"(pix), [rq1]"r"(rq1), [rq2]"r"(rq2), [rq3]"r"(rq3), [K]"r"(PSP_PIX_XOR)
