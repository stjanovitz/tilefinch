+/*
+ * H.264 DSP kernels for the PSP (Allegrex + VFPU): weighted prediction.
+ *
+ * See vfpu_util.h for the number representation. Only the 8-bit 4:2:0
+ * decoder path is covered; everything else falls back to the C code.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#include "config.h"
+#if defined(SWDEC_PSP_ASM) && SWDEC_PSP_ASM
+
+#include <stdint.h>
+#include <stddef.h>
+#include "libavutil/attributes.h"
+#include "libavcodec/h264dsp.h"
+#include "vfpu_util.h"
+
+/* Runtime kernel level, read when a decoder is opened (the init hooks run
+   from avcodec_open2): 0 = no VFPU kernels (C dsp; the CABAC asm and the
+   C loop_filter_strength are compile-time and stay), 1 = all VFPU kernels
+   except chroma deblocking, 2 = everything. Lets one binary A/B itself. */
+int swdec_psp_level = 2;
+int swdec_psp_lf = 0;      /* loop-filter kernels: bit0 luma, bit1 chroma (needs level >= 1); both lose to C on hardware -> off */
+
+/* Constants live in M700 for the duration of a call:
+ *   S700 = ws (scaled), S701 = wd (scaled), C710 = K broadcast. */
+typedef struct { float ws, wd, pad0, pad1, k[4]; } __attribute__((aligned(16))) weight_consts;
+
+/* dst[x] = clip((src[x]*ws + dst[x]*wd + off) >> (L+1)), 4 pixels per quad.
+   Both pointers are 4-byte aligned by construction (partition offsets are
+   multiples of 4, linesize a multiple of 16). */
+#define BIWEIGHT_QUAD(dq, sq, ds, ss, os, dw, sw, addr) \
+    "mtv   " dw ", " ds "\n\t" \
+    "mtv   " sw ", " ss "\n\t" \
+    "vc2i.s " dq ", " ds "\n\t" \
+    "vc2i.s " sq ", " ss "\n\t" \
+    "vi2f.q " dq ", " dq ", 24\n\t" \
+    "vi2f.q " sq ", " sq ", 24\n\t" \
+    "vscl.q " dq ", " dq ", S701\n\t" \
+    "vscl.q " sq ", " sq ", S700\n\t" \
+    "vadd.q " dq ", " dq ", " sq "\n\t" \
+    "vadd.q " dq ", " dq ", C710\n\t" \
+    "vf2id.q " dq ", " dq ", 23\n\t" \
+    "vi2uc.q " os ", " dq "\n\t" \
+    "sv.s  " os ", 0(" addr ")\n\t"
+
+static av_always_inline void biweight_psp(uint8_t *dst, uint8_t *src, ptrdiff_t stride,
+                                          int height, int log2_denom, int weightd,
+                                          int weights, int offset, int width)
+{
+    weight_consts c;
+    float scale = 1.0f / (float) (1 << (log2_denom + 1));
+    offset = ((offset + 1) | 1) << log2_denom;
+    c.ws = (float) weights * scale;
+    c.wd = (float) weightd * scale;
+    c.k[0] = c.k[1] = c.k[2] = c.k[3] = (float) (128 * (weights + weightd) + offset) * scale;
+    __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\t" : : "r"(&c) : "memory");
+
+    for (int y = 0; y < height; y++, dst += stride, src += stride) {
+        if (width == 16) {
+            uint32_t d0 = psp_lw(dst)      ^ PSP_PIX_XOR, s0 = psp_lw(src)      ^ PSP_PIX_XOR;
+            uint32_t d1 = psp_lw(dst + 4)  ^ PSP_PIX_XOR, s1 = psp_lw(src + 4)  ^ PSP_PIX_XOR;
+            uint32_t d2 = psp_lw(dst + 8)  ^ PSP_PIX_XOR, s2 = psp_lw(src + 8)  ^ PSP_PIX_XOR;
+            uint32_t d3 = psp_lw(dst + 12) ^ PSP_PIX_XOR, s3 = psp_lw(src + 12) ^ PSP_PIX_XOR;
+            __asm__ volatile (
+                "mtv   %[d0], S000\n\t"  "mtv   %[s0], S100\n\t"
+                "mtv   %[d1], S010\n\t"  "mtv   %[s1], S110\n\t"
+                "mtv   %[d2], S020\n\t"  "mtv   %[s2], S120\n\t"
+                "mtv   %[d3], S030\n\t"  "mtv   %[s3], S130\n\t"
+                "vc2i.s C000, S000\n\t"  "vc2i.s C100, S100\n\t"
+                "vc2i.s C010, S010\n\t"  "vc2i.s C110, S110\n\t"
+                "vc2i.s C020, S020\n\t"  "vc2i.s C120, S120\n\t"
+                "vc2i.s C030, S030\n\t"  "vc2i.s C130, S130\n\t"
+                "vi2f.q C000, C000, 24\n\t" "vi2f.q C100, C100, 24\n\t"
+                "vi2f.q C010, C010, 24\n\t" "vi2f.q C110, C110, 24\n\t"
+                "vi2f.q C020, C020, 24\n\t" "vi2f.q C120, C120, 24\n\t"
+                "vi2f.q C030, C030, 24\n\t" "vi2f.q C130, C130, 24\n\t"
+                "vscl.q C000, C000, S701\n\t" "vscl.q C100, C100, S700\n\t"
+                "vscl.q C010, C010, S701\n\t" "vscl.q C110, C110, S700\n\t"
+                "vscl.q C020, C020, S701\n\t" "vscl.q C120, C120, S700\n\t"
+                "vscl.q C030, C030, S701\n\t" "vscl.q C130, C130, S700\n\t"
+                "vadd.q C000, C000, C100\n\t"
+                "vadd.q C010, C010, C110\n\t"
+                "vadd.q C020, C020, C120\n\t"
+                "vadd.q C030, C030, C130\n\t"
+                "vadd.q C000, C000, C710\n\t"
+                "vadd.q C010, C010, C710\n\t"
+                "vadd.q C020, C020, C710\n\t"
+                "vadd.q C030, C030, C710\n\t"
+                "vf2id.q C000, C000, 23\n\t"
+                "vf2id.q C010, C010, 23\n\t"
+                "vf2id.q C020, C020, 23\n\t"
+                "vf2id.q C030, C030, 23\n\t"
+                "vi2uc.q S200, C000\n\t"
+                "vi2uc.q S201, C010\n\t"
+                "vi2uc.q S202, C020\n\t"
+                "vi2uc.q S203, C030\n\t"
+                "sv.s  S200, 0(%[dst])\n\t"
+                "sv.s  S201, 4(%[dst])\n\t"
+                "sv.s  S202, 8(%[dst])\n\t"
+                "sv.s  S203, 12(%[dst])\n\t"
+                : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3),
+                    [s0]"r"(s0), [s1]"r"(s1), [s2]"r"(s2), [s3]"r"(s3), [dst]"r"(dst)
+                : "memory");
+        } else if (width == 8) {
+            /* two rows per iteration: four independent quads keep the VFPU pipeline full */
+            uint8_t *dst2 = dst + stride, *src2 = src + stride;
+            int two = (y + 1 < height);
+            if (!two) { dst2 = dst; src2 = src; }
+            uint32_t d0 = psp_lw(dst)      ^ PSP_PIX_XOR, s0 = psp_lw(src)      ^ PSP_PIX_XOR;
+            uint32_t d1 = psp_lw(dst + 4)  ^ PSP_PIX_XOR, s1 = psp_lw(src + 4)  ^ PSP_PIX_XOR;
+            uint32_t d2 = psp_lw(dst2)     ^ PSP_PIX_XOR, s2 = psp_lw(src2)     ^ PSP_PIX_XOR;
+            uint32_t d3 = psp_lw(dst2 + 4) ^ PSP_PIX_XOR, s3 = psp_lw(src2 + 4) ^ PSP_PIX_XOR;
+            __asm__ volatile (
+                "mtv   %[d0], S000\n\t"  "mtv   %[s0], S100\n\t"
+                "mtv   %[d1], S010\n\t"  "mtv   %[s1], S110\n\t"
+                "mtv   %[d2], S020\n\t"  "mtv   %[s2], S120\n\t"
+                "mtv   %[d3], S030\n\t"  "mtv   %[s3], S130\n\t"
+                "vc2i.s C000, S000\n\t"  "vc2i.s C100, S100\n\t"
+                "vc2i.s C010, S010\n\t"  "vc2i.s C110, S110\n\t"
+                "vc2i.s C020, S020\n\t"  "vc2i.s C120, S120\n\t"
+                "vc2i.s C030, S030\n\t"  "vc2i.s C130, S130\n\t"
+                "vi2f.q C000, C000, 24\n\t" "vi2f.q C100, C100, 24\n\t"
+                "vi2f.q C010, C010, 24\n\t" "vi2f.q C110, C110, 24\n\t"
+                "vi2f.q C020, C020, 24\n\t" "vi2f.q C120, C120, 24\n\t"
+                "vi2f.q C030, C030, 24\n\t" "vi2f.q C130, C130, 24\n\t"
+                "vscl.q C000, C000, S701\n\t" "vscl.q C100, C100, S700\n\t"
+                "vscl.q C010, C010, S701\n\t" "vscl.q C110, C110, S700\n\t"
+                "vscl.q C020, C020, S701\n\t" "vscl.q C120, C120, S700\n\t"
+                "vscl.q C030, C030, S701\n\t" "vscl.q C130, C130, S700\n\t"
+                "vadd.q C000, C000, C100\n\t"
+                "vadd.q C010, C010, C110\n\t"
+                "vadd.q C020, C020, C120\n\t"
+                "vadd.q C030, C030, C130\n\t"
+                "vadd.q C000, C000, C710\n\t"
+                "vadd.q C010, C010, C710\n\t"
+                "vadd.q C020, C020, C710\n\t"
+                "vadd.q C030, C030, C710\n\t"
+                "vf2id.q C000, C000, 23\n\t"
+                "vf2id.q C010, C010, 23\n\t"
+                "vf2id.q C020, C020, 23\n\t"
+                "vf2id.q C030, C030, 23\n\t"
+                "vi2uc.q S200, C000\n\t"
+                "vi2uc.q S201, C010\n\t"
+                "vi2uc.q S202, C020\n\t"
+                "vi2uc.q S203, C030\n\t"
+                "sv.s  S200, 0(%[dst])\n\t"
+                "sv.s  S201, 4(%[dst])\n\t"
+                "sv.s  S202, 0(%[dst2])\n\t"
+                "sv.s  S203, 4(%[dst2])\n\t"
+                : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3),
+                    [s0]"r"(s0), [s1]"r"(s1), [s2]"r"(s2), [s3]"r"(s3), [dst]"r"(dst), [dst2]"r"(dst2)
+                : "memory");
+            if (two) { y++; dst += stride; src += stride; }
+        } else { /* 4: two rows per iteration */
+            uint8_t *dst2 = dst + stride, *src2 = src + stride;
+            int two = (y + 1 < height);
+            if (!two) { dst2 = dst; src2 = src; }
+            uint32_t d0 = psp_lw(dst) ^ PSP_PIX_XOR, s0 = psp_lw(src) ^ PSP_PIX_XOR;
+            uint32_t d1 = psp_lw(dst2) ^ PSP_PIX_XOR, s1 = psp_lw(src2) ^ PSP_PIX_XOR;
+            __asm__ volatile (
+                "mtv   %[d0], S000\n\t"  "mtv   %[s0], S100\n\t"
+                "mtv   %[d1], S010\n\t"  "mtv   %[s1], S110\n\t"
+                "vc2i.s C000, S000\n\t"  "vc2i.s C100, S100\n\t"
+                "vc2i.s C010, S010\n\t"  "vc2i.s C110, S110\n\t"
+                "vi2f.q C000, C000, 24\n\t" "vi2f.q C100, C100, 24\n\t"
+                "vi2f.q C010, C010, 24\n\t" "vi2f.q C110, C110, 24\n\t"
+                "vscl.q C000, C000, S701\n\t" "vscl.q C100, C100, S700\n\t"
+                "vscl.q C010, C010, S701\n\t" "vscl.q C110, C110, S700\n\t"
+                "vadd.q C000, C000, C100\n\t"
+                "vadd.q C010, C010, C110\n\t"
+                "vadd.q C000, C000, C710\n\t"
+                "vadd.q C010, C010, C710\n\t"
+                "vf2id.q C000, C000, 23\n\t"
+                "vf2id.q C010, C010, 23\n\t"
+                "vi2uc.q S200, C000\n\t"
+                "vi2uc.q S201, C010\n\t"
+                "sv.s  S200, 0(%[dst])\n\t"
+                "sv.s  S201, 0(%[dst2])\n\t"
+                : : [d0]"r"(d0), [d1]"r"(d1), [s0]"r"(s0), [s1]"r"(s1), [dst]"r"(dst), [dst2]"r"(dst2)
+                : "memory");
+            if (two) { y++; dst += stride; src += stride; }
+        }
+    }
+}
+
+static void biweight_h264_pixels16_psp(uint8_t *dst, uint8_t *src, ptrdiff_t stride, int height,
+                                       int log2_denom, int weightd, int weights, int offset)
+{ biweight_psp(dst, src, stride, height, log2_denom, weightd, weights, offset, 16); }
+static void biweight_h264_pixels8_psp(uint8_t *dst, uint8_t *src, ptrdiff_t stride, int height,
+                                      int log2_denom, int weightd, int weights, int offset)
+{ biweight_psp(dst, src, stride, height, log2_denom, weightd, weights, offset, 8); }
+static void biweight_h264_pixels4_psp(uint8_t *dst, uint8_t *src, ptrdiff_t stride, int height,
+                                      int log2_denom, int weightd, int weights, int offset)
+{ biweight_psp(dst, src, stride, height, log2_denom, weightd, weights, offset, 4); }
+
+/* block[x] = clip((block[x]*w + off) >> L) */
+static av_always_inline void weight_psp(uint8_t *block, ptrdiff_t stride, int height,
+                                        int log2_denom, int weight, int offset, int width)
+{
+    weight_consts c;
+    float scale = 1.0f / (float) (1 << log2_denom);
+    offset = (unsigned) offset << log2_denom;
+    if (log2_denom) offset += 1 << (log2_denom - 1);
+    c.ws = 0.f;
+    c.wd = (float) weight * scale;
+    c.k[0] = c.k[1] = c.k[2] = c.k[3] = (float) (128 * weight + offset) * scale;
+    __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\t" : : "r"(&c) : "memory");
+
+    for (int y = 0; y < height; y++, block += stride) {
+        for (int x = 0; x < width; x += 4) {
+            uint32_t d0 = psp_lw(block + x) ^ PSP_PIX_XOR;
+            __asm__ volatile (
+                "mtv   %[d0], S000\n\t"
+                "vc2i.s C000, S000\n\t"
+                "vi2f.q C000, C000, 24\n\t"
+                "vscl.q C000, C000, S701\n\t"
+                "vadd.q C000, C000, C710\n\t"
+                "vf2id.q C000, C000, 23\n\t"
+                "vi2uc.q S200, C000\n\t"
+                "sv.s  S200, 0(%[dst])\n\t"
+                : : [d0]"r"(d0), [dst]"r"(block + x)
+                : "memory");
+        }
+    }
+}
+
+static void weight_h264_pixels16_psp(uint8_t *block, ptrdiff_t stride, int height,
+                                     int log2_denom, int weight, int offset)
+{ weight_psp(block, stride, height, log2_denom, weight, offset, 16); }
+static void weight_h264_pixels8_psp(uint8_t *block, ptrdiff_t stride, int height,
+                                    int log2_denom, int weight, int offset)
+{ weight_psp(block, stride, height, log2_denom, weight, offset, 8); }
+static void weight_h264_pixels4_psp(uint8_t *block, ptrdiff_t stride, int height,
+                                    int log2_denom, int weight, int offset)
+{ weight_psp(block, stride, height, log2_denom, weight, offset, 4); }
+
+/* ------------------------------------------------------------------ */
+/* Inverse transforms                                                   */
+/* ------------------------------------------------------------------ */
+/* M700 = (32,0,0,0) ; C710 = 128 bc ; S720 = 0.5, S721 = 0.25, S722 = 1/64 ; C730 = 0 */
+static const float idct_consts[12] __attribute__((aligned(16))) = {
+    32.f, 0.f, 0.f, 0.f,
+    128.f, 128.f, 128.f, 128.f,
+    0.5f, 0.25f, 1.f / 64.f, 0.f,
+};
+#define IDCT_CONSTS() \
+    __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\tlv.q C720, 32(%0)\n\tvzero.q C730\n\t" \
+                      : : "r"(idct_consts) : "memory")
+
+/* floor(x/2), floor(x/4) on integer-valued floats */
+#define VHALF(d, s)    "vscl.q " d ", " s ", S720\n\tvf2id.q " d ", " d ", 0\n\tvi2f.q " d ", " d ", 0\n\t"
+#define VQUARTER(d, s) "vscl.q " d ", " s ", S721\n\tvf2id.q " d ", " d ", 0\n\tvi2f.q " d ", " d ", 0\n\t"
+
+/* one 8-point H.264 transform over 8 vectors r0..r7 -> o0..o7 (all
+   distinct registers; the r registers are consumed as temporaries) */
+#define T8(r0, r1, r2, r3, r4, r5, r6, r7, o0, o1, o2, o3, o4, o5, o6, o7) \
+    "vadd.q " o0 ", " r0 ", " r4 "\n\t"        /* a0 */ \
+    "vsub.q " o7 ", " r0 ", " r4 "\n\t"        /* a2 */ \
+    "vscl.q " r0 ", " r2 ", S720\n\t"  "vscl.q " r4 ", " r6 ", S720\n\t" \
+    "vf2id.q " r0 ", " r0 ", 0\n\t"    "vf2id.q " r4 ", " r4 ", 0\n\t" \
+    "vi2f.q " r0 ", " r0 ", 0\n\t"     "vi2f.q " r4 ", " r4 ", 0\n\t" \
+    "vsub.q " r0 ", " r0 ", " r6 "\n\t"        /* a4 = (r2>>1) - r6 */ \
+    "vadd.q " r4 ", " r4 ", " r2 "\n\t"        /* a6 = (r6>>1) + r2 */ \
+    "vadd.q " r2 ", " o0 ", " r4 "\n\t"        /* b0 */ \
+    "vsub.q " r6 ", " o0 ", " r4 "\n\t"        /* b6 */ \
+    "vsub.q " r4 ", " o7 ", " r0 "\n\t"        /* b4 */ \
+    "vadd.q " r0 ", " o7 ", " r0 "\n\t"        /* b2 */ \
+    "vscl.q " o0 ", " r1 ", S720\n\t"  "vscl.q " o7 ", " r3 ", S720\n\t"  "vscl.q " o1 ", " r5 ", S720\n\t"  "vscl.q " o6 ", " r7 ", S720\n\t" \
+    "vf2id.q " o0 ", " o0 ", 0\n\t"    "vf2id.q " o7 ", " o7 ", 0\n\t"    "vf2id.q " o1 ", " o1 ", 0\n\t"    "vf2id.q " o6 ", " o6 ", 0\n\t" \
+    "vi2f.q " o0 ", " o0 ", 0\n\t"     "vi2f.q " o7 ", " o7 ", 0\n\t"     "vi2f.q " o1 ", " o1 ", 0\n\t"     "vi2f.q " o6 ", " o6 ", 0\n\t" \
+    "vsub.q " o2 ", " r5 ", " r3 "\n\t"        /* a1 = r5 - r3 - r7 - (r7>>1) */ \
+    "vsub.q " o2 ", " o2 ", " r7 "\n\t" \
+    "vsub.q " o2 ", " o2 ", " o6 "\n\t" \
+    "vadd.q " o5 ", " r1 ", " r7 "\n\t"        /* a3 = r1 + r7 - r3 - (r3>>1) */ \
+    "vsub.q " o5 ", " o5 ", " r3 "\n\t" \
+    "vsub.q " o5 ", " o5 ", " o7 "\n\t" \
+    "vsub.q " o3 ", " r7 ", " r1 "\n\t"        /* a5 = r7 - r1 + r5 + (r5>>1) */ \
+    "vadd.q " o3 ", " o3 ", " r5 "\n\t" \
+    "vadd.q " o3 ", " o3 ", " o1 "\n\t" \
+    "vadd.q " o4 ", " r3 ", " r5 "\n\t"        /* a7 = r3 + r5 + r1 + (r1>>1) */ \
+    "vadd.q " o4 ", " o4 ", " r1 "\n\t" \
+    "vadd.q " o4 ", " o4 ", " o0 "\n\t" \
+    "vscl.q " r1 ", " o4 ", S721\n\t"  "vscl.q " r3 ", " o3 ", S721\n\t"  "vscl.q " r5 ", " o5 ", S721\n\t"  "vscl.q " r7 ", " o2 ", S721\n\t" \
+    "vf2id.q " r1 ", " r1 ", 0\n\t"    "vf2id.q " r3 ", " r3 ", 0\n\t"    "vf2id.q " r5 ", " r5 ", 0\n\t"    "vf2id.q " r7 ", " r7 ", 0\n\t" \
+    "vi2f.q " r1 ", " r1 ", 0\n\t"     "vi2f.q " r3 ", " r3 ", 0\n\t"     "vi2f.q " r5 ", " r5 ", 0\n\t"     "vi2f.q " r7 ", " r7 ", 0\n\t" \
+    "vadd.q " r1 ", " r1 ", " o2 "\n\t"   /* b1 = (a7>>2) + a1 */ \
+    "vadd.q " r3 ", " o5 ", " r3 "\n\t"   /* b3 = a3 + (a5>>2) */ \
+    "vsub.q " r5 ", " r5 ", " o3 "\n\t"   /* b5 = (a3>>2) - a5 */ \
+    "vsub.q " r7 ", " o4 ", " r7 "\n\t"   /* b7 = a7 - (a1>>2) */ \
+    "vadd.q " o0 ", " r2 ", " r7 "\n\t"        /* b0 + b7 */ \
+    "vsub.q " o7 ", " r2 ", " r7 "\n\t" \
+    "vadd.q " o1 ", " r0 ", " r5 "\n\t"        /* b2 + b5 */ \
+    "vsub.q " o6 ", " r0 ", " r5 "\n\t" \
+    "vadd.q " o2 ", " r4 ", " r3 "\n\t"        /* b4 + b3 */ \
+    "vsub.q " o5 ", " r4 ", " r3 "\n\t" \
+    "vadd.q " o3 ", " r6 ", " r1 "\n\t"        /* b6 + b1 */ \
+    "vsub.q " o4 ", " r6 ", " r1 "\n\t"
+
+/* one 4-point transform: r0..r3 -> o0..o3 (o distinct from r) */
+#define T4(r0, r1, r2, r3, o0, o1, o2, o3) \
+    "vadd.q " o0 ", " r0 ", " r2 "\n\t"        /* z0 */ \
+    "vsub.q " o1 ", " r0 ", " r2 "\n\t"        /* z1 */ \
+    "vscl.q " o2 ", " r1 ", S720\n\t"  "vscl.q " o3 ", " r3 ", S720\n\t" \
+    "vf2id.q " o2 ", " o2 ", 0\n\t"    "vf2id.q " o3 ", " o3 ", 0\n\t" \
+    "vi2f.q " o2 ", " o2 ", 0\n\t"     "vi2f.q " o3 ", " o3 ", 0\n\t" \
+    "vsub.q " o2 ", " o2 ", " r3 "\n\t"        /* z2 = (r1>>1) - r3 */ \
+    "vadd.q " o3 ", " o3 ", " r1 "\n\t"        /* z3 = r1 + (r3>>1) */ \
+    "vadd.q " r0 ", " o0 ", " o3 "\n\t"        /* z0 + z3 */ \
+    "vsub.q " r3 ", " o0 ", " o3 "\n\t"        /* z0 - z3 */ \
+    "vadd.q " r1 ", " o1 ", " o2 "\n\t"        /* z1 + z2 */ \
+    "vsub.q " r2 ", " o1 ", " o2 "\n\t"        /* z1 - z2 */
+/* T4 leaves the results back in r0..r3 (o0..o3 are scratch) */
+
+/* load one 8-short row at (blk) into quads L (shorts 0-3) and R (4-7) as floats */
+#define LDROW8(L, R, blk, off) \
+    "lv.q  C600, " off "(" blk ")\n\t" \
+    "vs2i.p " L ", C600\n\t" \
+    "vs2i.p " R ", C602\n\t" \
+    "vi2f.q " L ", " L ", 16\n\t" \
+    "vi2f.q " R ", " R ", 16\n\t"
+
+/* dst row quad += floor(v/64) with clip; v in Q; d = address; w = xored dst word */
+#define IDCT_ADD_QUAD(Q, w, d) \
+    "mtv   " w ", S610\n\t" \
+    "vc2i.s C610, S610\n\t" \
+    "vi2f.q C610, C610, 24\n\t" \
+    "vscl.q " Q ", " Q ", S722\n\t" \
+    "vadd.q " Q ", " Q ", C610\n\t" \
+    "vadd.q " Q ", " Q ", C710\n\t" \
+    "vf2id.q " Q ", " Q ", 23\n\t" \
+    "vi2uc.q S620, " Q "\n\t" \
+    "sv.s  S620, 0(" d ")\n\t"
+
+static void h264_idct8_add_psp(uint8_t *dst, int16_t *block, int stride)
+{
+    IDCT_CONSTS();
+    __asm__ volatile (
+        LDROW8("C000", "C200", "%0", "0")   LDROW8("C010", "C210", "%0", "16")
+        LDROW8("C020", "C220", "%0", "32")  LDROW8("C030", "C230", "%0", "48")
+        LDROW8("C100", "C300", "%0", "64")  LDROW8("C110", "C310", "%0", "80")
+        LDROW8("C120", "C320", "%0", "96")  LDROW8("C130", "C330", "%0", "112")
+        "vadd.q C000, C000, C700\n\t"                     /* block[0] += 32 */
+        /* pass 1 (over rows): left half M0/M1 -> M4/M5, right half M2/M3 -> M0/M1 */
+        T8("C000", "C010", "C020", "C030", "C100", "C110", "C120", "C130",
+           "C400", "C410", "C420", "C430", "C500", "C510", "C520", "C530")
+        T8("C200", "C210", "C220", "C230", "C300", "C310", "C320", "C330",
+           "C000", "C010", "C020", "C030", "C100", "C110", "C120", "C130")
+        /* pass 2 (over columns) rows 0-3: cols 0-3 in R400..R403, cols 4-7 in R000..R003 -> M2 (cols 0-3), M3 (cols 4-7) */
+        T8("R400", "R401", "R402", "R403", "R000", "R001", "R002", "R003",
+           "R200", "R201", "R202", "R203", "R300", "R301", "R302", "R303")
+        /* rows 4-7: R500..R503, R100..R103 -> M4 (cols 0-3), M0 (cols 4-7) */
+        T8("R500", "R501", "R502", "R503", "R100", "R101", "R102", "R103",
+           "R400", "R401", "R402", "R403", "R000", "R001", "R002", "R003")
+        /* zero the coefficient block */
+        "sv.q  C730, 0(%0)\n\t"  "sv.q  C730, 16(%0)\n\t" "sv.q  C730, 32(%0)\n\t" "sv.q  C730, 48(%0)\n\t"
+        "sv.q  C730, 64(%0)\n\t" "sv.q  C730, 80(%0)\n\t" "sv.q  C730, 96(%0)\n\t" "sv.q  C730, 112(%0)\n\t"
+        : : "r"(block) : "memory");
+    /* ffmpeg's second pass writes dst[i + m*stride] from array row i, so
+       output vector m (lanes = array rows i = dst columns) *is* dst row m:
+       rows 0-3: (R20m, R40m); rows 4-7: (R30(m-4), R00(m-4)).
+       Add-to-dst is done four rows (eight quads) at a time with the VFPU
+       stages interleaved (5-cycle latency per dependent op on hardware). */
+#define IA8_UNPACK(a, b, c, d, e, f, g, h) \
+    "mtv   %[w0], S600\n\tmtv %[w1], S610\n\tmtv %[w2], S620\n\tmtv %[w3], S630\n\t" \
+    "mtv   %[w4], S500\n\tmtv %[w5], S510\n\tmtv %[w6], S520\n\tmtv %[w7], S530\n\t" \
+    "vc2i.s C600, S600\n\tvc2i.s C610, S610\n\tvc2i.s C620, S620\n\tvc2i.s C630, S630\n\t" \
+    "vc2i.s C500, S500\n\tvc2i.s C510, S510\n\tvc2i.s C520, S520\n\tvc2i.s C530, S530\n\t" \
+    "vi2f.q C600, C600, 24\n\tvi2f.q C610, C610, 24\n\tvi2f.q C620, C620, 24\n\tvi2f.q C630, C630, 24\n\t" \
+    "vi2f.q C500, C500, 24\n\tvi2f.q C510, C510, 24\n\tvi2f.q C520, C520, 24\n\tvi2f.q C530, C530, 24\n\t" \
+    "vscl.q " a ", " a ", S722\n\tvscl.q " b ", " b ", S722\n\tvscl.q " c ", " c ", S722\n\tvscl.q " d ", " d ", S722\n\t" \
+    "vscl.q " e ", " e ", S722\n\tvscl.q " f ", " f ", S722\n\tvscl.q " g ", " g ", S722\n\tvscl.q " h ", " h ", S722\n\t" \
+    "vadd.q " a ", " a ", C600\n\tvadd.q " b ", " b ", C610\n\tvadd.q " c ", " c ", C620\n\tvadd.q " d ", " d ", C630\n\t" \
+    "vadd.q " e ", " e ", C500\n\tvadd.q " f ", " f ", C510\n\tvadd.q " g ", " g ", C520\n\tvadd.q " h ", " h ", C530\n\t" \
+    "vadd.q " a ", " a ", C710\n\tvadd.q " b ", " b ", C710\n\tvadd.q " c ", " c ", C710\n\tvadd.q " d ", " d ", C710\n\t" \
+    "vadd.q " e ", " e ", C710\n\tvadd.q " f ", " f ", C710\n\tvadd.q " g ", " g ", C710\n\tvadd.q " h ", " h ", C710\n\t" \
+    "vf2id.q " a ", " a ", 23\n\tvf2id.q " b ", " b ", 23\n\tvf2id.q " c ", " c ", 23\n\tvf2id.q " d ", " d ", 23\n\t" \
+    "vf2id.q " e ", " e ", 23\n\tvf2id.q " f ", " f ", 23\n\tvf2id.q " g ", " g ", 23\n\tvf2id.q " h ", " h ", 23\n\t" \
+    "vi2uc.q S600, " a "\n\tvi2uc.q S601, " b "\n\tvi2uc.q S602, " c "\n\tvi2uc.q S603, " d "\n\t" \
+    "vi2uc.q S610, " e "\n\tvi2uc.q S611, " f "\n\tvi2uc.q S612, " g "\n\tvi2uc.q S613, " h "\n\t" \
+    "sv.s  S600, 0(%[d0])\n\tsv.s S601, 0(%[d1])\n\tsv.s S602, 0(%[d2])\n\tsv.s S603, 0(%[d3])\n\t" \
+    "sv.s  S610, 4(%[d0])\n\tsv.s S611, 4(%[d1])\n\tsv.s S612, 4(%[d2])\n\tsv.s S613, 4(%[d3])\n\t"
+    {
+        uint8_t *d0 = dst, *d1 = dst + stride, *d2 = dst + 2 * stride, *d3 = dst + 3 * stride;
+        uint32_t w0 = psp_lw(d0) ^ PSP_PIX_XOR, w1 = psp_lw(d1) ^ PSP_PIX_XOR, w2 = psp_lw(d2) ^ PSP_PIX_XOR, w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+        uint32_t w4 = psp_lw(d0 + 4) ^ PSP_PIX_XOR, w5 = psp_lw(d1 + 4) ^ PSP_PIX_XOR, w6 = psp_lw(d2 + 4) ^ PSP_PIX_XOR, w7 = psp_lw(d3 + 4) ^ PSP_PIX_XOR;
+        /* M6/M5 are free at this point (M5 held pass-1 left rows 4-7, consumed by pass 2) */
+        __asm__ volatile (IA8_UNPACK("R200", "R201", "R202", "R203", "R400", "R401", "R402", "R403")
+            : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3),
+                [w0]"r"(w0), [w1]"r"(w1), [w2]"r"(w2), [w3]"r"(w3), [w4]"r"(w4), [w5]"r"(w5), [w6]"r"(w6), [w7]"r"(w7) : "memory");
+        d0 += 4 * stride; d1 += 4 * stride; d2 += 4 * stride; d3 += 4 * stride;
+        w0 = psp_lw(d0) ^ PSP_PIX_XOR; w1 = psp_lw(d1) ^ PSP_PIX_XOR; w2 = psp_lw(d2) ^ PSP_PIX_XOR; w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+        w4 = psp_lw(d0 + 4) ^ PSP_PIX_XOR; w5 = psp_lw(d1 + 4) ^ PSP_PIX_XOR; w6 = psp_lw(d2 + 4) ^ PSP_PIX_XOR; w7 = psp_lw(d3 + 4) ^ PSP_PIX_XOR;
+        __asm__ volatile (IA8_UNPACK("R300", "R301", "R302", "R303", "R000", "R001", "R002", "R003")
+            : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3),
+                [w0]"r"(w0), [w1]"r"(w1), [w2]"r"(w2), [w3]"r"(w3), [w4]"r"(w4), [w5]"r"(w5), [w6]"r"(w6), [w7]"r"(w7) : "memory");
+    }
+}
