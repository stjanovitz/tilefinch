+static void h264_idct_add_psp(uint8_t *dst, int16_t *block, int stride)
+{
+    IDCT_CONSTS();
+    __asm__ volatile (
+        "lv.q  C600, 0(%0)\n\t"
+        "lv.q  C610, 16(%0)\n\t"
+        "vs2i.p C000, C600\n\t"     /* row 0 */
+        "vs2i.p C010, C602\n\t"     /* row 1 */
+        "vs2i.p C020, C610\n\t"     /* row 2 */
+        "vs2i.p C030, C612\n\t"     /* row 3 */
+        "vi2f.q C000, C000, 16\n\t"
+        "vi2f.q C010, C010, 16\n\t"
+        "vi2f.q C020, C020, 16\n\t"
+        "vi2f.q C030, C030, 16\n\t"
+        "vadd.q C000, C000, C700\n\t"                     /* block[0] += 32 */
+        T4("C000", "C010", "C020", "C030", "C400", "C410", "C420", "C430")   /* over rows, results in C0x0 */
+        T4("R000", "R001", "R002", "R003", "R400", "R401", "R402", "R403")   /* over columns, results in R00x */
+        "sv.q  C730, 0(%0)\n\t"
+        "sv.q  C730, 16(%0)\n\t"
+        : : "r"(block) : "memory");
+    /* second-pass output vector k is dst row k (see the 8x8 note); four rows interleaved */
+    {
+        uint8_t *d0 = dst, *d1 = dst + stride, *d2 = dst + 2 * stride, *d3 = dst + 3 * stride;
+        uint32_t w0 = psp_lw(d0) ^ PSP_PIX_XOR, w1 = psp_lw(d1) ^ PSP_PIX_XOR, w2 = psp_lw(d2) ^ PSP_PIX_XOR, w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+        __asm__ volatile (
+            "mtv   %[w0], S600\n\tmtv %[w1], S610\n\tmtv %[w2], S620\n\tmtv %[w3], S630\n\t"
+            "vc2i.s C600, S600\n\tvc2i.s C610, S610\n\tvc2i.s C620, S620\n\tvc2i.s C630, S630\n\t"
+            "vi2f.q C600, C600, 24\n\tvi2f.q C610, C610, 24\n\tvi2f.q C620, C620, 24\n\tvi2f.q C630, C630, 24\n\t"
+            "vscl.q R000, R000, S722\n\tvscl.q R001, R001, S722\n\tvscl.q R002, R002, S722\n\tvscl.q R003, R003, S722\n\t"
+            "vadd.q R000, R000, C600\n\tvadd.q R001, R001, C610\n\tvadd.q R002, R002, C620\n\tvadd.q R003, R003, C630\n\t"
+            "vadd.q R000, R000, C710\n\tvadd.q R001, R001, C710\n\tvadd.q R002, R002, C710\n\tvadd.q R003, R003, C710\n\t"
+            "vf2id.q R000, R000, 23\n\tvf2id.q R001, R001, 23\n\tvf2id.q R002, R002, 23\n\tvf2id.q R003, R003, 23\n\t"
+            "vi2uc.q S600, R000\n\tvi2uc.q S601, R001\n\tvi2uc.q S602, R002\n\tvi2uc.q S603, R003\n\t"
+            "sv.s  S600, 0(%[d0])\n\tsv.s S601, 0(%[d1])\n\tsv.s S602, 0(%[d2])\n\tsv.s S603, 0(%[d3])\n\t"
+            : : [d0]"r"(d0), [d1]"r"(d1), [d2]"r"(d2), [d3]"r"(d3), [w0]"r"(w0), [w1]"r"(w1), [w2]"r"(w2), [w3]"r"(w3) : "memory");
+    }
+}
+
+/* dst += dc (clip), dc = (block[0] + 32) >> 6, block[0] = 0 */
+#define DC_ADD_QUAD(w, d) \
+    "mtv   " w ", S610\n\t" \
+    "vc2i.s C610, S610\n\t" \
+    "vi2f.q C610, C610, 24\n\t" \
+    "vadd.q C610, C610, C700\n\t" \
+    "vf2id.q C610, C610, 23\n\t" \
+    "vi2uc.q S620, C610\n\t" \
+    "sv.s  S620, 0(" d ")\n\t"
+
+static av_always_inline void idct_dc_add_psp(uint8_t *dst, int16_t *block, int stride, int size)
+{
+    int dc = (block[0] + 32) >> 6;
+    float k[4] __attribute__((aligned(16)));
+    block[0] = 0;
+    k[0] = k[1] = k[2] = k[3] = (float) (dc + 128);
+    __asm__ volatile ("lv.q C700, 0(%0)\n\t" : : "r"(k) : "memory");
+#define DC4(w0, w1, w2, w3, d0, d1, d2, d3, off) \
+    "mtv   " w0 ", S600\n\tmtv " w1 ", S610\n\tmtv " w2 ", S620\n\tmtv " w3 ", S630\n\t" \
+    "vc2i.s C600, S600\n\tvc2i.s C610, S610\n\tvc2i.s C620, S620\n\tvc2i.s C630, S630\n\t" \
+    "vi2f.q C600, C600, 24\n\tvi2f.q C610, C610, 24\n\tvi2f.q C620, C620, 24\n\tvi2f.q C630, C630, 24\n\t" \
+    "vadd.q C600, C600, C700\n\tvadd.q C610, C610, C700\n\tvadd.q C620, C620, C700\n\tvadd.q C630, C630, C700\n\t" \
+    "vf2id.q C600, C600, 23\n\tvf2id.q C610, C610, 23\n\tvf2id.q C620, C620, 23\n\tvf2id.q C630, C630, 23\n\t" \
+    "vi2uc.q S600, C600\n\tvi2uc.q S601, C610\n\tvi2uc.q S602, C620\n\tvi2uc.q S603, C630\n\t" \
+    "sv.s  S600, " off "(" d0 ")\n\tsv.s S601, " off "(" d1 ")\n\tsv.s S602, " off "(" d2 ")\n\tsv.s S603, " off "(" d3 ")\n\t"
+    for (int r = 0; r < size; r += 4) {
+        uint8_t *d0 = dst + r * stride, *d1 = d0 + stride, *d2 = d0 + 2 * stride, *d3 = d0 + 3 * stride;
+        uint32_t w0 = psp_lw(d0) ^ PSP_PIX_XOR, w1 = psp_lw(d1) ^ PSP_PIX_XOR, w2 = psp_lw(d2) ^ PSP_PIX_XOR, w3 = psp_lw(d3) ^ PSP_PIX_XOR;
+        __asm__ volatile (DC4("%0", "%1", "%2", "%3", "%4", "%5", "%6", "%7", "0") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d0), "r"(d1), "r"(d2), "r"(d3) : "memory");
+        if (size == 8) {
+            w0 = psp_lw(d0 + 4) ^ PSP_PIX_XOR; w1 = psp_lw(d1 + 4) ^ PSP_PIX_XOR; w2 = psp_lw(d2 + 4) ^ PSP_PIX_XOR; w3 = psp_lw(d3 + 4) ^ PSP_PIX_XOR;
+            __asm__ volatile (DC4("%0", "%1", "%2", "%3", "%4", "%5", "%6", "%7", "4") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d0), "r"(d1), "r"(d2), "r"(d3) : "memory");
+        }
+    }
+#undef DC4
+}
+static void h264_idct_dc_add_psp(uint8_t *dst, int16_t *block, int stride) { idct_dc_add_psp(dst, block, stride, 4); }
+static void h264_idct8_dc_add_psp(uint8_t *dst, int16_t *block, int stride) { idct_dc_add_psp(dst, block, stride, 8); }
+
+/* the block-loop wrappers call the C versions directly, so re-implement them */
+static const uint8_t psp_scan8[16 * 3 + 3] = {
+    4 +  1 * 8, 5 +  1 * 8, 4 +  2 * 8, 5 +  2 * 8,
+    6 +  1 * 8, 7 +  1 * 8, 6 +  2 * 8, 7 +  2 * 8,
+    4 +  3 * 8, 5 +  3 * 8, 4 +  4 * 8, 5 +  4 * 8,
+    6 +  3 * 8, 7 +  3 * 8, 6 +  4 * 8, 7 +  4 * 8,
+    4 +  6 * 8, 5 +  6 * 8, 4 +  7 * 8, 5 +  7 * 8,
+    6 +  6 * 8, 7 +  6 * 8, 6 +  7 * 8, 7 +  7 * 8,
+    4 +  8 * 8, 5 +  8 * 8, 4 +  9 * 8, 5 +  9 * 8,
+    6 +  8 * 8, 7 +  8 * 8, 6 +  9 * 8, 7 +  9 * 8,
+    4 + 11 * 8, 5 + 11 * 8, 4 + 12 * 8, 5 + 12 * 8,
+    6 + 11 * 8, 7 + 11 * 8, 6 + 12 * 8, 7 + 12 * 8,
+    4 + 13 * 8, 5 + 13 * 8, 4 + 14 * 8, 5 + 14 * 8,
+    6 + 13 * 8, 7 + 13 * 8, 6 + 14 * 8, 7 + 14 * 8,
+    0 +  0 * 8, 0 +  5 * 8, 0 + 10 * 8
+};
+
+static void h264_idct_add16_psp(uint8_t *dst, const int *block_offset, int16_t *block, int stride, const uint8_t nnzc[5 * 8])
+{
+    for (int i = 0; i < 16; i++) {
+        int nnz = nnzc[psp_scan8[i]];
+        if (nnz) {
+            if (nnz == 1 && block[i * 16]) h264_idct_dc_add_psp(dst + block_offset[i], block + i * 16, stride);
+            else                           h264_idct_add_psp(dst + block_offset[i], block + i * 16, stride);
+        }
+    }
+}
+static void h264_idct_add16intra_psp(uint8_t *dst, const int *block_offset, int16_t *block, int stride, const uint8_t nnzc[5 * 8])
+{
+    for (int i = 0; i < 16; i++) {
+        if (nnzc[psp_scan8[i]])  h264_idct_add_psp(dst + block_offset[i], block + i * 16, stride);
+        else if (block[i * 16])  h264_idct_dc_add_psp(dst + block_offset[i], block + i * 16, stride);
+    }
+}
+static void h264_idct8_add4_psp(uint8_t *dst, const int *block_offset, int16_t *block, int stride, const uint8_t nnzc[5 * 8])
+{
+    for (int i = 0; i < 16; i += 4) {
+        int nnz = nnzc[psp_scan8[i]];
+        if (nnz) {
+            if (nnz == 1 && block[i * 16]) h264_idct8_dc_add_psp(dst + block_offset[i], block + i * 16, stride);
+            else                           h264_idct8_add_psp(dst + block_offset[i], block + i * 16, stride);
+        }
+    }
+}
+static void h264_idct_add8_psp(uint8_t **dest, const int *block_offset, int16_t *block, int stride, const uint8_t nnzc[15 * 8])
+{
+    for (int j = 1; j < 3; j++) {
+        for (int i = j * 16; i < j * 16 + 4; i++) {
+            if (nnzc[psp_scan8[i]])  h264_idct_add_psp(dest[j - 1] + block_offset[i], block + i * 16, stride);
+            else if (block[i * 16])  h264_idct_dc_add_psp(dest[j - 1] + block_offset[i], block + i * 16, stride);
+        }
+    }
+}
