+/* producer: publish the current row segment [x_start, x_end) of row mb_y */
+static void swdec_pipe_publish(const H264Context *h, H264SliceContext *sl, int mb_y, int x_start, int x_end)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    int seq = pipe->prod_seq;
+    if (sl->swdec_njobs == 0 && x_end <= x_start)
+        return;                     /* nothing to reconstruct or filter (e.g. slice end exactly at a row end) */
+    SwdecRowRec *r = &pipe->rec[seq & 1];
+    r->mb_y = mb_y; r->x_start = x_start; r->x_end = x_end; r->njobs = sl->swdec_njobs; r->buf = seq & 1;
+    sl->swdec_njobs = 0;
+    if (swdec_me_enabled && swdec_me_pre_publish) swdec_me_pre_publish();   /* ME side only */
+    SWDEC_MB();
+    pipe->prod_seq = seq + 1;
+    SWDEC_MB();
+    if (!swdec_me_enabled)
+        swdec_pipe_consume(h, sl);
+    else if (swdec_me_deblock == 1 || swdec_me_deblock == 3)
+        swdec_pipe_deblock_service(h);      /* parser core: filter finished rows while recon runs */
+    if (swdec_me_enabled && swdec_me_aux)
+        swdec_me_aux();
+}
+/* producer: before writing into the buffer of the row about to start, its previous
+   user (seq-2) must have been consumed */
+static void swdec_pipe_wait_buffer_slow(const H264Context *h)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    while (pipe->cons_seq < pipe->prod_seq - 1) {
+        if (swdec_me_enabled && (swdec_me_deblock == 1 || swdec_me_deblock == 3))
+            swdec_pipe_deblock_service(h);
+        if (swdec_me_enabled && swdec_me_aux)
+            swdec_me_aux();
+    }
+}
+static av_always_inline void swdec_pipe_wait_buffer(const H264Context *h)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    if (pipe->cons_seq < pipe->prod_seq - 1)
+        swdec_pipe_wait_buffer_slow(h);
+}
+static av_always_inline int swdec_pipe_buf(void) { return swdec_pipe->prod_seq & 1; }
