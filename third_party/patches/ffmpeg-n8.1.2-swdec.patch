+        "mtv   %[tcA], S720\n\tmtv %[tcB], S730\n\t"
+        "lw    %[t0], 0(%[rp1])\n\tlw %[t1], 4(%[rp1])\n\tlw %[t2], 0(%[rp0])\n\tlw %[t3], 4(%[rp0])\n\t"
+        "vi2f.s S720, S720, 0\n\tvi2f.s S730, S730, 0\n\t"
+        "xor   %[t0], %[t0], %[K]\n\txor %[t1], %[t1], %[K]\n\txor %[t2], %[t2], %[K]\n\txor %[t3], %[t3], %[K]\n\t"
