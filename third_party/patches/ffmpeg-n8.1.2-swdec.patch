+/* tc0[4] (-1 = skip) -> C400 lanes, C410 = +0.999 */
+#define LFL_SETUP_TC(tcword) \
+    __asm__ volatile ( \
+        "mtv   %0, S400\n\t" \
+        "vc2i.s C400, S400\n\t" \
+        "vi2f.q C400, C400, 24\n\t" \
+        "vadd.q C410, C400, C610\n\t" \
