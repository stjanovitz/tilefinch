+/* ------------------------------------------------------------------ */
+/* Chroma deblocking (4:2:0), normal and intra, both directions          */
+/* ------------------------------------------------------------------ */
+/* Static: C600 = 128 bc, C610 = 0.999 bc, C620 = (0.5, 0.125, 0.25, 0), C630 = 0.
+   Per call: C700 = alpha-0.5 bc, C710 = beta-0.5 bc,
+             C500 = tcA (t0,t0,t1,t1), C510 = tcB (t2,t2,t3,t3),
+             C720 = tcA + 0.999, C730 = tcB + 0.999,
+             C520 = tzA, C530 = tzB   (+1 where the group is skipped, -1 otherwise) */
+static const float lf_consts[16] __attribute__((aligned(16))) = {
+    128.f, 128.f, 128.f, 128.f,
+    0.999f, 0.999f, 0.999f, 0.999f,
+    0.5f, 0.125f, 0.25f, 0.f,
+    0.f, 0.f, 0.f, 0.f,
+};
+
+/* alpha/beta thresholds as (x - 0.5) broadcasts */
+#define LF_SETUP_AB(alpha, beta) \
+    __asm__ volatile ( \
+        "lv.q  C600, 0(%2)\n\tlv.q C610, 16(%2)\n\tlv.q C620, 32(%2)\n\tvzero.q C630\n\t" \
+        "mtv   %0, S700\n\tmtv %1, S710\n\t" \
+        "vi2f.s S700, S700, 0\n\tvi2f.s S710, S710, 0\n\t" \
+        "vsub.s S700, S700, S620\n\tvsub.s S710, S710, S620\n\t" \
+        "vmov.q C700, C700[x,x,x,x]\n\tvmov.q C710, C710[x,x,x,x]\n\t" \
+        : : "r"(alpha), "r"(beta), "r"(lf_consts) : "memory")
+
+/* tc0[4] (already +1 by the caller; <= 0 means skip the pair) -> tcA/tcB, tcp, tz */
+#define LF_SETUP_TC(tcword) \
+    __asm__ volatile ( \
+        "mtv   %0, S400\n\t" \
+        "vc2i.s C400, S400\n\t" \
+        "vi2f.q C400, C400, 24\n\t" \
+        "vmov.q C500, C400[x,x,y,y]\n\t" \
+        "vmov.q C510, C400[z,z,w,w]\n\t" \
+        "vadd.q C720, C500, C610\n\t" \
+        "vadd.q C730, C510, C610\n\t" \
+        "vsub.q C520, C500, C500[1/2,1/2,1/2,1/2]\n\t" \
+        "vsub.q C530, C510, C510[1/2,1/2,1/2,1/2]\n\t" \
+        "vsgn.q C520, C520\n\tvsgn.q C530, C530\n\t" \
+        "vneg.q C520, C520\n\tvneg.q C530, C530\n\t" \
+        : : "r"(tcword) : "memory")
+
+/* m = max(|p0-q0|-a', |p1-p0|-b', |q1-q0|-b' [, tz]) into M ; T temps */
+#define LF_MASK(M, T1, T2, p1, p0, q0, q1) \
+    "vsub.q " M ", " p0 ", " q0 "\n\t" \
+    "vsub.q " T1 ", " p1 ", " p0 "\n\t" \
+    "vsub.q " T2 ", " q1 ", " q0 "\n\t" \
+    "vabs.q " M ", " M "\n\t" \
+    "vabs.q " T1 ", " T1 "\n\t" \
+    "vabs.q " T2 ", " T2 "\n\t" \
+    "vsub.q " M ", " M ", C700\n\t" \
+    "vsub.q " T1 ", " T1 ", C710\n\t" \
+    "vsub.q " T2 ", " T2 ", C710\n\t" \
+    "vmax.q " M ", " M ", " T1 "\n\t" \
+    "vmax.q " M ", " M ", " T2 "\n\t"
+
+/* delta = clip(floor(((q0-p0)*4 + (p1-q1) + 4)/8), -tc, tc) into D (T temp) */
+#define LF_DELTA(D, T, p1, p0, q0, q1, TC, TCP) \
+    "vsub.q " D ", " q0 ", " p0 "\n\t" \
+    "vsub.q " T ", " p1 ", " q1 "\n\t" \
+    "vscl.q " D ", " D ", S620\n\t" \
+    "vscl.q " T ", " T ", S621\n\t" \
+    "vadd.q " D ", " D ", " T "\n\t" \
+    "vadd.q " D ", " D ", C630[1/2,1/2,1/2,1/2]\n\t" \
+    "vmax.q " D ", " D ", " TC "[-x,-y,-z,-w]\n\t" \
+    "vmin.q " D ", " D ", " TCP "\n\t" \
+    "vf2id.q " D ", " D ", 0\n\t" \
+    "vi2f.q " D ", " D ", 0\n\t"
+
+/* pack quad Q (b-128 domain) to 4 bytes at addr */
+#define LF_PACK(Q, S, addr) \
+    "vadd.q " Q ", " Q ", C600\n\t" \
+    "vf2id.q " Q ", " Q ", 23\n\t" \
+    "vi2uc.q " S ", " Q "\n\t" \
+    "sv.s  " S ", 0(" addr ")\n\t"
+
+/* one 4-pixel quad of a horizontal chroma edge (rows p1 p0 | q0 q1 at
+   pix - 2s, pix - s, pix, pix + s), normal filter, group constants A/B */
+#define LF_CHROMA_V_QUAD(TC, TCP, TZ, w_p1, w_p0, w_q0, w_q1, a_p0, a_q0) \
+    "mtv   " w_p1 ", S000\n\tmtv " w_p0 ", S010\n\tmtv " w_q0 ", S020\n\tmtv " w_q1 ", S030\n\t" \
+    "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t" \
+    "vi2f.q C000, C000, 24\n\tvi2f.q C010, C010, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C030, C030, 24\n\t" \
+    LF_MASK("C200", "C210", "C220", "C000", "C010", "C020", "C030") \
+    "vmax.q C200, C200, " TZ "\n\t" \
+    LF_DELTA("C230", "C300", "C000", "C010", "C020", "C030", TC, TCP) \
+    "vadd.q C310, C010, C230\n\t" \
+    "vsub.q C320, C020, C230\n\t" \
+    "vcmp.q LT, C200, C630\n\t" \
+    "vcmovf.q C310, C010, 6\n\t" \
+    "vcmovf.q C320, C020, 6\n\t" \
+    LF_PACK("C310", "S330", a_p0) \
+    LF_PACK("C320", "S331", a_q0)
+
+static void h264_v_loop_filter_chroma_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    uint32_t tcw = psp_ulw((const uint8_t *) tc0);
+    LF_SETUP_AB(alpha, beta);
+    LF_SETUP_TC(tcw);
+    uint8_t *p1 = pix - 2 * stride, *p0 = pix - stride, *q1 = pix + stride;
+    {
+        uint32_t a = psp_lw(p1) ^ PSP_PIX_XOR, b = psp_lw(p0) ^ PSP_PIX_XOR, c = psp_lw(pix) ^ PSP_PIX_XOR, d = psp_lw(q1) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_V_QUAD("C500", "C720", "C520", "%0", "%1", "%2", "%3", "%4", "%5")
+                          : : "r"(a), "r"(b), "r"(c), "r"(d), "r"(p0), "r"(pix) : "memory");
+    }
+    {
+        uint32_t a = psp_lw(p1 + 4) ^ PSP_PIX_XOR, b = psp_lw(p0 + 4) ^ PSP_PIX_XOR, c = psp_lw(pix + 4) ^ PSP_PIX_XOR, d = psp_lw(q1 + 4) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_V_QUAD("C510", "C730", "C530", "%0", "%1", "%2", "%3", "%4", "%5")
+                          : : "r"(a), "r"(b), "r"(c), "r"(d), "r"(p0 + 4), "r"(pix + 4) : "memory");
+    }
+}
+
+/* vertical edge: rows r..r+3, each row's (p1,p0,q0,q1) is the unaligned word at pix-2;
+   transposed: R000 = p1, R001 = p0, R002 = q0, R003 = q1 (lanes = rows) */
+#define LF_CHROMA_H_QUAD(TC, TCP, TZ, w0, w1, w2, w3) \
+    "mtv   " w0 ", S000\n\tmtv " w1 ", S010\n\tmtv " w2 ", S020\n\tmtv " w3 ", S030\n\t" \
+    "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t" \
+    "vi2f.q C000, C000, 24\n\tvi2f.q C010, C010, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C030, C030, 24\n\t" \
+    LF_MASK("C200", "C210", "C220", "R000", "R001", "R002", "R003") \
+    "vmax.q C200, C200, " TZ "\n\t" \
+    LF_DELTA("C230", "C300", "R000", "R001", "R002", "R003", TC, TCP) \
+    "vadd.q C310, R001, C230\n\t" \
+    "vsub.q C320, R002, C230\n\t" \
+    "vcmp.q LT, C200, C630\n\t" \
+    "vcmovt.q R001, C310, 6\n\t" \
+    "vcmovt.q R002, C320, 6\n\t" \
+    "vadd.q C000, C000, C600\n\tvadd.q C010, C010, C600\n\tvadd.q C020, C020, C600\n\tvadd.q C030, C030, C600\n\t" \
+    "vf2id.q C000, C000, 23\n\tvf2id.q C010, C010, 23\n\tvf2id.q C020, C020, 23\n\tvf2id.q C030, C030, 23\n\t" \
+    "vi2uc.q S330, C000\n\tvi2uc.q S331, C010\n\tvi2uc.q S332, C020\n\tvi2uc.q S333, C030\n\t"
+
+static av_always_inline void lf_h_store_rows(uint8_t *row0, ptrdiff_t stride)
+{
+    uint32_t o0, o1, o2, o3;
+    __asm__ volatile ("mfv %0, S330\n\tmfv %1, S331\n\tmfv %2, S332\n\tmfv %3, S333\n\t" : "=r"(o0), "=r"(o1), "=r"(o2), "=r"(o3));
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(o0), "r"(row0) : "memory");
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(o1), "r"(row0 + stride) : "memory");
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(o2), "r"(row0 + 2 * stride) : "memory");
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(o3), "r"(row0 + 3 * stride) : "memory");
+}
+
+static void h264_h_loop_filter_chroma_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    uint32_t tcw = psp_ulw((const uint8_t *) tc0);
+    LF_SETUP_AB(alpha, beta);
+    LF_SETUP_TC(tcw);
+    uint8_t *r = pix - 2;
+    {
+        uint32_t w0 = psp_ulw(r) ^ PSP_PIX_XOR, w1 = psp_ulw(r + stride) ^ PSP_PIX_XOR;
+        uint32_t w2 = psp_ulw(r + 2 * stride) ^ PSP_PIX_XOR, w3 = psp_ulw(r + 3 * stride) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_H_QUAD("C500", "C720", "C520", "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3) : "memory");
+        lf_h_store_rows(r, stride);
+    }
+    r += 4 * stride;
+    {
+        uint32_t w0 = psp_ulw(r) ^ PSP_PIX_XOR, w1 = psp_ulw(r + stride) ^ PSP_PIX_XOR;
+        uint32_t w2 = psp_ulw(r + 2 * stride) ^ PSP_PIX_XOR, w3 = psp_ulw(r + 3 * stride) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_H_QUAD("C510", "C730", "C530", "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3) : "memory");
+        lf_h_store_rows(r, stride);
+    }
+}
+
+/* intra: p0' = (2p1 + p0 + q1 + 2) >> 2, q0' = (2q1 + q0 + p1 + 2) >> 2 (floor at pack) */
+#define LF_INTRA_MATH(p1, p0, q0, q1) \
+    "vadd.q C310, " p0 ", " q1 "\n\t" \
+    "vscl.q C310, C310, S622\n\t" \
+    "vscl.q C300, " p1 ", S620\n\t" \
+    "vadd.q C310, C310, C300\n\t" \
+    "vadd.q C310, C310, C630[1/2,1/2,1/2,1/2]\n\t" \
+    "vadd.q C320, " q0 ", " p1 "\n\t" \
+    "vscl.q C320, C320, S622\n\t" \
+    "vscl.q C300, " q1 ", S620\n\t" \
+    "vadd.q C320, C320, C300\n\t" \
+    "vadd.q C320, C320, C630[1/2,1/2,1/2,1/2]\n\t"
+
+#define LF_CHROMA_V_INTRA_QUAD(w_p1, w_p0, w_q0, w_q1, a_p0, a_q0) \
+    "mtv   " w_p1 ", S000\n\tmtv " w_p0 ", S010\n\tmtv " w_q0 ", S020\n\tmtv " w_q1 ", S030\n\t" \
+    "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t" \
+    "vi2f.q C000, C000, 24\n\tvi2f.q C010, C010, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C030, C030, 24\n\t" \
+    LF_MASK("C200", "C210", "C220", "C000", "C010", "C020", "C030") \
+    LF_INTRA_MATH("C000", "C010", "C020", "C030") \
+    "vcmp.q LT, C200, C630\n\t" \
+    "vcmovf.q C310, C010, 6\n\t" \
+    "vcmovf.q C320, C020, 6\n\t" \
+    LF_PACK("C310", "S330", a_p0) \
+    LF_PACK("C320", "S331", a_q0)
+
+static void h264_v_loop_filter_chroma_intra_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    LF_SETUP_AB(alpha, beta);
+    uint8_t *p1 = pix - 2 * stride, *p0 = pix - stride, *q1 = pix + stride;
+    for (int x = 0; x < 8; x += 4) {
+        uint32_t a = psp_lw(p1 + x) ^ PSP_PIX_XOR, b = psp_lw(p0 + x) ^ PSP_PIX_XOR, c = psp_lw(pix + x) ^ PSP_PIX_XOR, d = psp_lw(q1 + x) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_V_INTRA_QUAD("%0", "%1", "%2", "%3", "%4", "%5")
+                          : : "r"(a), "r"(b), "r"(c), "r"(d), "r"(p0 + x), "r"(pix + x) : "memory");
+    }
+}
+
+#define LF_CHROMA_H_INTRA_QUAD(w0, w1, w2, w3) \
+    "mtv   " w0 ", S000\n\tmtv " w1 ", S010\n\tmtv " w2 ", S020\n\tmtv " w3 ", S030\n\t" \
+    "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t" \
+    "vi2f.q C000, C000, 24\n\tvi2f.q C010, C010, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C030, C030, 24\n\t" \
+    LF_MASK("C200", "C210", "C220", "R000", "R001", "R002", "R003") \
+    LF_INTRA_MATH("R000", "R001", "R002", "R003") \
+    "vcmp.q LT, C200, C630\n\t" \
+    "vcmovt.q R001, C310, 6\n\t" \
+    "vcmovt.q R002, C320, 6\n\t" \
+    "vadd.q C000, C000, C600\n\tvadd.q C010, C010, C600\n\tvadd.q C020, C020, C600\n\tvadd.q C030, C030, C600\n\t" \
+    "vf2id.q C000, C000, 23\n\tvf2id.q C010, C010, 23\n\tvf2id.q C020, C020, 23\n\tvf2id.q C030, C030, 23\n\t" \
+    "vi2uc.q S330, C000\n\tvi2uc.q S331, C010\n\tvi2uc.q S332, C020\n\tvi2uc.q S333, C030\n\t"
+
+static void h264_h_loop_filter_chroma_intra_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    LF_SETUP_AB(alpha, beta);
+    uint8_t *r = pix - 2;
+    for (int g = 0; g < 2; g++, r += 4 * stride) {
+        uint32_t w0 = psp_ulw(r) ^ PSP_PIX_XOR, w1 = psp_ulw(r + stride) ^ PSP_PIX_XOR;
+        uint32_t w2 = psp_ulw(r + 2 * stride) ^ PSP_PIX_XOR, w3 = psp_ulw(r + 3 * stride) ^ PSP_PIX_XOR;
+        __asm__ volatile (LF_CHROMA_H_INTRA_QUAD("%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3) : "memory");
+        lf_h_store_rows(r, stride);
+    }
+}
+
+
+/* ------------------------------------------------------------------ */
+/* Luma deblocking, normal (bS<4) and intra (bS=4), both directions     */
+/* ------------------------------------------------------------------ */
+/* Everything is done in the (b-128) float domain, exact for these ranges.
+   Rounding shifts become "scale, +1/2 (or +1/4..), floor at the pack" and
+   the tc clamps use the "max(-tc), min(tc+0.999), floor" form, so there is
+   one int round trip per clamped quantity and none for the strong filter.
+
+   Constants (LF_SETUP_AB): C600 128, C610 0.999, C620 (0.5,0.125,0.25,0),
+   C630 0, C700 alpha-0.5, C710 beta-0.5; intra adds C720 = ((alpha>>2)+2)-0.5.
+
+   Normal filter, per 4-pixel column: P2 P1 P0 Q0 Q1 Q2 inputs, TP/TQ =
+   2*p2+p0+q0+1 and 2*q2+p0+q0+1 (rows variant: in place of P2/Q2),
+   T1 = mask (<0: filter), T2/T3 = ap/aq then the p1/q1 masks, T4/T5 temps,
+   TC0 = tc0 broadcast, TC0P = tc0 + 0.999 broadcast. */
+
+#define LFN_MASK1(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vsub.q " T1 ", " P0 ", " Q0 "\n\t" \
+    "vsub.q " T4 ", " P1 ", " P0 "\n\t" \
+    "vsub.q " T5 ", " Q1 ", " Q0 "\n\t" \
+    "vabs.q " T1 ", " T1 "\n\t" \
+    "vabs.q " T4 ", " T4 "\n\t" \
+    "vabs.q " T5 ", " T5 "\n\t" \
+    "vsub.q " T1 ", " T1 ", C700\n\t" \
+    "vsub.q " T4 ", " T4 ", C710\n\t" \
+    "vsub.q " T5 ", " T5 ", C710\n\t" \
+    "vmax.q " T1 ", " T1 ", " T4 "\n\t" \
+    "vadd.q " T4 ", " TC0 ", C630[1/2,1/2,1/2,1/2]\n\t" \
+    "vmax.q " T1 ", " T1 ", " T5 "\n\t" \
+    "vmax.q " T1 ", " T1 ", " T4 "[-x,-y,-z,-w]\n\t"
+
+#define LFN_APAQ(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vsub.q " T2 ", " P2 ", " P0 "\n\t" \
+    "vsub.q " T3 ", " Q2 ", " Q0 "\n\t" \
+    "vabs.q " T2 ", " T2 "\n\t" \
+    "vabs.q " T3 ", " T3 "\n\t" \
+    "vsub.q " T2 ", C710, " T2 "\n\t" \
+    "vsub.q " T3 ", C710, " T3 "\n\t"
+
+#define LFN_TPQ(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vadd.q " T4 ", " P0 ", " Q0 "\n\t" \
+    "vadd.q " TP ", " P2 ", " P2 "\n\t" \
+    "vadd.q " TQ ", " Q2 ", " Q2 "\n\t" \
+    "vadd.q " TP ", " TP ", " T4 "\n\t" \
+    "vadd.q " TQ ", " TQ ", " T4 "\n\t" \
+    "vadd.q " TP ", " TP ", C630[1,1,1,1]\n\t" \
+    "vadd.q " TQ ", " TQ ", C630[1,1,1,1]\n\t"
+
+#define LFN_F(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vsub.q " T4 ", " Q0 ", " P0 "\n\t" \
+    "vsub.q " T5 ", " P1 ", " Q1 "\n\t" \
+    "vscl.q " T4 ", " T4 ", S620\n\t" \
+    "vscl.q " T5 ", " T5 ", S621\n\t" \
+    "vadd.q " T4 ", " T4 ", " T5 "\n\t" \
+    "vadd.q " T4 ", " T4 ", C630[1/2,1/2,1/2,1/2]\n\t"
+
+#define LFN_TC(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vsgn.q " T2 ", " T2 "\n\t" \
+    "vsgn.q " T3 ", " T3 "\n\t" \
+    "vadd.q " T5 ", " T2 ", " T3 "\n\t" \
+    "vmax.q " T2 ", " T1 ", " T2 "[-x,-y,-z,-w]\n\t" \
+    "vmax.q " T3 ", " T1 ", " T3 "[-x,-y,-z,-w]\n\t" \
+    "vscl.q " T5 ", " T5 ", S620\n\t" \
+    "vadd.q " T5 ", " T5 ", C630[1,1,1,1]\n\t" \
+    "vadd.q " T5 ", " T5 ", " TC0 "\n\t" \
+    "vmax.q " T4 ", " T4 ", " T5 "[-x,-y,-z,-w]\n\t" \
+    "vadd.q " T5 ", " T5 ", C610\n\t" \
+    "vmin.q " T4 ", " T4 ", " T5 "\n\t" \
+    "vf2id.q " T4 ", " T4 ", 0\n\t" \
+    "vi2f.q " T4 ", " T4 ", 0\n\t" \
+    "vadd.q " T5 ", " P0 ", " T4 "\n\t" \
+    "vsub.q " T4 ", " Q0 ", " T4 "\n\t"
+
+#define LFN_P0S(P2,P1,P0,Q0,Q1,Q2,TP,TQ,T1,T2,T3,T4,T5,TC0,TC0P) \
+    "vcmp.q LT, " T1 ", C630\n\t" \
+    "vcmovt.q " P0 ", " T5 ", 6\n\t" \
+    "vcmovt.q " Q0 ", " T4 ", 6\n\t"
+
