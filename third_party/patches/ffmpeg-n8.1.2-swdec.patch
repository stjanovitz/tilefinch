+#if defined(SWDEC_LF_STRENGTH_C) && SWDEC_LF_STRENGTH_C
+/* Deblocking strength for one inter macroblock, non-MBAFF.
+ * Mirrors check_mv()/filter_mb_dir() in h264_loopfilter.c: bS = 2 when
+ * either 4x4 block has coefficients, else 1 when refs/mvs differ, else 0.
+ * mask_mv1 marks internal horizontal edges whose two sides are known to
+ * share motion (pure skip hint); mask_mv0 is the "left edge uniform"
+ * hint and is not needed for correctness. */
+static int lfs_check_mv(int8_t ref[2][40], int16_t mv[2][40][2],
+                        int b, int bn, int bidir, int mvy_limit)
+{
+    int v = ref[0][b] != ref[0][bn];
+    if (!v && ref[0][b] != -1)
+        v = (unsigned)(mv[0][b][0] - mv[0][bn][0] + 3) >= 7U |
+            FFABS(mv[0][b][1] - mv[0][bn][1]) >= mvy_limit;
+    if (bidir) {
+        if (!v)
+            v = ref[1][b] != ref[1][bn] |
+                (unsigned)(mv[1][b][0] - mv[1][bn][0] + 3) >= 7U |
+                FFABS(mv[1][b][1] - mv[1][bn][1]) >= mvy_limit;
+        if (v) {
+            if (ref[0][b] != ref[1][bn] | ref[1][b] != ref[0][bn])
+                return 1;
+            return (unsigned)(mv[0][b][0] - mv[1][bn][0] + 3) >= 7U |
+                   FFABS(mv[0][b][1] - mv[1][bn][1]) >= mvy_limit |
+                   (unsigned)(mv[1][b][0] - mv[0][bn][0] + 3) >= 7U |
+                   FFABS(mv[1][b][1] - mv[0][bn][1]) >= mvy_limit;
+        }
+    }
+    return v;
+}
+
+static void h264_loop_filter_strength_c(int16_t bS[2][4][4], uint8_t nnz[40],
+                                        int8_t ref[2][40], int16_t mv[2][40][2],
+                                        int bidir, int edges, int step,
+                                        int mask_mv0, int mask_mv1, int field)
+{
+    const int mvy_limit = field ? 2 : 4;
+    int dir, edge, i;
+    (void) mask_mv0;
+    for (dir = 0; dir < 2; dir++) {
+        const int nstride = dir ? 8 : 1;
+        for (edge = 0; edge < edges; edge += step) {
+            const int skip_mv = dir && (edge & mask_mv1);
+            for (i = 0; i < 4; i++) {
+                const int b  = 12 + (dir ? i + 8 * edge : edge + 8 * i);
+                const int bn = b - nstride;
+                int v;
+                if (nnz[b] | nnz[bn])
+                    v = 2;
+                else if (skip_mv)
+                    v = 0;
+                else
+                    v = lfs_check_mv(ref, mv, b, bn, bidir, mvy_limit);
+                bS[dir][edge][i] = v;
+            }
+        }
+    }
+}
