+/* ------------------------------------------------------------------ */
+/* Deblocking in scheduled scalar C for the Allegrex: word loads and     */
+/* ext/ins instead of byte loads/stores, mask-first per pixel, min/max  */
+/* clips. Same semantics as h264dsp_template.c (8-bit).                 */
+/* ------------------------------------------------------------------ */
+static av_always_inline int lfc_abs(int v) { return v < 0 ? -v : v; }
+static av_always_inline int lfc_clip(int v, int lo, int hi) { return v < lo ? lo : v > hi ? hi : v; }
+static av_always_inline int lfc_clip_u8(int v) { return v & ~255 ? (~v >> 31) & 255 : v; }
+
+/* one luma line/lane of the normal filter given the 6 pixels; returns 0 if untouched.
+   p1/q1/p0/q0 are updated in place (originals used for delta as in the reference). */
+#define LFC_LUMA_NORMAL(P2, P1, P0, Q0, Q1, Q2, ALPHA, BETA, TC0, TOUCHED)                     \
+    do {                                                                                     \
+        int d0_ = (P0) - (Q0);                                                                \
+        if (lfc_abs(d0_) < (ALPHA) && lfc_abs((P1) - (P0)) < (BETA) && lfc_abs((Q1) - (Q0)) < (BETA)) { \
+            int tc_ = (TC0), pq_ = ((P0) + (Q0) + 1) >> 1, p1o_ = (P1), q1o_ = (Q1), dl_;    \
+            if (lfc_abs((P2) - (P0)) < (BETA)) {                                              \
+                if (TC0) (P1) = p1o_ + lfc_clip((((P2) + pq_) >> 1) - p1o_, -(TC0), (TC0));    \
+                tc_++;                                                                        \
+            }                                                                                 \
+            if (lfc_abs((Q2) - (Q0)) < (BETA)) {                                              \
+                if (TC0) (Q1) = q1o_ + lfc_clip((((Q2) + pq_) >> 1) - q1o_, -(TC0), (TC0));    \
+                tc_++;                                                                        \
+            }                                                                                 \
+            dl_ = lfc_clip(((-d0_ * 4) + (p1o_ - q1o_) + 4) >> 3, -tc_, tc_);                 \
+            (P0) = lfc_clip_u8((P0) + dl_);                                                   \
+            (Q0) = lfc_clip_u8((Q0) - dl_);                                                   \
+            TOUCHED = 1;                                                                      \
+        }                                                                                     \
+    } while (0)
+
+/* vertical edge ("h_loop_filter"): p3..q3 contiguous, aligned words at pix-4 and pix */
+static void lfc_h_luma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    for (int i = 0; i < 4; i++) {
+        const int tc = tc0[i];
+        if (tc < 0) { pix += 4 * stride; continue; }
+        for (int d = 0; d < 4; d++, pix += stride) {
+            uint32_t L = psp_lw(pix - 4), R = psp_lw(pix);
+            int p2 = (L >> 8) & 0xff, p1 = (L >> 16) & 0xff, p0 = L >> 24;
+            int q0 = R & 0xff, q1 = (R >> 8) & 0xff, q2 = (R >> 16) & 0xff;
+            int touched = 0;
+            LFC_LUMA_NORMAL(p2, p1, p0, q0, q1, q2, alpha, beta, tc, touched);
+            if (touched) {
+                psp_sw(pix - 4, (L & 0x0000ffffu) | ((uint32_t) p1 << 16) | ((uint32_t) p0 << 24));
+                psp_sw(pix, (R & 0xffff0000u) | (uint32_t) q0 | ((uint32_t) q1 << 8));
+            }
+        }
+    }
+}
+
+/* horizontal edge ("v_loop_filter"): rows p2..q2, four pixels per word */
+#define LFC_LANE_NORMAL(B)                                                                    \
+    do {                                                                                     \
+        int p2 = (wp2 >> (B)) & 0xff, p1 = (wp1 >> (B)) & 0xff, p0 = (wp0 >> (B)) & 0xff;    \
+        int q0 = (wq0 >> (B)) & 0xff, q1 = (wq1 >> (B)) & 0xff, q2 = (wq2 >> (B)) & 0xff;    \
+        int t_ = 0;                                                                          \
+        LFC_LUMA_NORMAL(p2, p1, p0, q0, q1, q2, alpha, beta, tc, t_);                        \
+        if (t_) {                                                                            \
+            np1 = (np1 & ~(0xffu << (B))) | ((uint32_t) p1 << (B));                          \
+            np0 = (np0 & ~(0xffu << (B))) | ((uint32_t) p0 << (B));                          \
+            nq0 = (nq0 & ~(0xffu << (B))) | ((uint32_t) q0 << (B));                          \
+            nq1 = (nq1 & ~(0xffu << (B))) | ((uint32_t) q1 << (B));                          \
+            touched = 1;                                                                     \
+        }                                                                                    \
+    } while (0)
+
+static void lfc_v_luma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    for (int i = 0; i < 4; i++, pix += 4) {
+        const int tc = tc0[i];
+        if (tc < 0) continue;
+        uint32_t wp2 = psp_lw(pix - 3 * stride), wp1 = psp_lw(pix - 2 * stride), wp0 = psp_lw(pix - stride);
+        uint32_t wq0 = psp_lw(pix), wq1 = psp_lw(pix + stride), wq2 = psp_lw(pix + 2 * stride);
+        uint32_t np1 = wp1, np0 = wp0, nq0 = wq0, nq1 = wq1;
+        int touched = 0;
+        LFC_LANE_NORMAL(0); LFC_LANE_NORMAL(8); LFC_LANE_NORMAL(16); LFC_LANE_NORMAL(24);
+        if (touched) {
+            psp_sw(pix - 2 * stride, np1); psp_sw(pix - stride, np0);
+            psp_sw(pix, nq0); psp_sw(pix + stride, nq1);
+        }
+    }
+}
+
+/* intra (bS=4) strong filter for one line/lane; p3..q3 in, p2..q2 out (in place) */
+#define LFC_LUMA_INTRA(P3, P2, P1, P0, Q0, Q1, Q2, Q3, ALPHA, BETA, ALPHA2, TOUCHED)          \
+    do {                                                                                     \
+        int d0_ = lfc_abs((P0) - (Q0));                                                       \
+        if (d0_ < (ALPHA) && lfc_abs((P1) - (P0)) < (BETA) && lfc_abs((Q1) - (Q0)) < (BETA)) {\
+            int p0o_ = (P0), p1o_ = (P1), p2o_ = (P2), q0o_ = (Q0), q1o_ = (Q1), q2o_ = (Q2); \
+            if (d0_ < (ALPHA2)) {                                                             \
+                if (lfc_abs(p2o_ - p0o_) < (BETA)) {                                          \
+                    (P0) = (p2o_ + 2 * p1o_ + 2 * p0o_ + 2 * q0o_ + q1o_ + 4) >> 3;           \
+                    (P1) = (p2o_ + p1o_ + p0o_ + q0o_ + 2) >> 2;                              \
+                    (P2) = (2 * (P3) + 3 * p2o_ + p1o_ + p0o_ + q0o_ + 4) >> 3;               \
+                } else {                                                                      \
+                    (P0) = (2 * p1o_ + p0o_ + q1o_ + 2) >> 2;                                 \
+                }                                                                             \
+                if (lfc_abs(q2o_ - q0o_) < (BETA)) {                                          \
+                    (Q0) = (p1o_ + 2 * p0o_ + 2 * q0o_ + 2 * q1o_ + q2o_ + 4) >> 3;           \
+                    (Q1) = (p0o_ + q0o_ + q1o_ + q2o_ + 2) >> 2;                              \
+                    (Q2) = (2 * (Q3) + 3 * q2o_ + q1o_ + q0o_ + p0o_ + 4) >> 3;               \
+                } else {                                                                      \
+                    (Q0) = (2 * q1o_ + q0o_ + p1o_ + 2) >> 2;                                 \
+                }                                                                             \
+            } else {                                                                          \
+                (P0) = (2 * p1o_ + p0o_ + q1o_ + 2) >> 2;                                     \
+                (Q0) = (2 * q1o_ + q0o_ + p1o_ + 2) >> 2;                                     \
+            }                                                                                 \
+            TOUCHED = 1;                                                                      \
+        }                                                                                     \
+    } while (0)
+
+static void lfc_h_luma_intra(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    const int alpha2 = (alpha >> 2) + 2;
+    for (int d = 0; d < 16; d++, pix += stride) {
+        uint32_t L = psp_lw(pix - 4), R = psp_lw(pix);
+        int p3 = L & 0xff, p2 = (L >> 8) & 0xff, p1 = (L >> 16) & 0xff, p0 = L >> 24;
+        int q0 = R & 0xff, q1 = (R >> 8) & 0xff, q2 = (R >> 16) & 0xff, q3 = R >> 24;
+        int touched = 0;
+        LFC_LUMA_INTRA(p3, p2, p1, p0, q0, q1, q2, q3, alpha, beta, alpha2, touched);
+        if (touched) {
+            psp_sw(pix - 4, (uint32_t) p3 | ((uint32_t) p2 << 8) | ((uint32_t) p1 << 16) | ((uint32_t) p0 << 24));
+            psp_sw(pix, (uint32_t) q0 | ((uint32_t) q1 << 8) | ((uint32_t) q2 << 16) | ((uint32_t) q3 << 24));
+        }
+    }
+}
+
+#define LFC_LANE_INTRA(B)                                                                     \
+    do {                                                                                     \
+        int p3 = (wp3 >> (B)) & 0xff, p2 = (wp2 >> (B)) & 0xff, p1 = (wp1 >> (B)) & 0xff, p0 = (wp0 >> (B)) & 0xff; \
+        int q0 = (wq0 >> (B)) & 0xff, q1 = (wq1 >> (B)) & 0xff, q2 = (wq2 >> (B)) & 0xff, q3 = (wq3 >> (B)) & 0xff; \
+        int t_ = 0;                                                                          \
+        LFC_LUMA_INTRA(p3, p2, p1, p0, q0, q1, q2, q3, alpha, beta, alpha2, t_);             \
+        if (t_) {                                                                            \
+            np2 = (np2 & ~(0xffu << (B))) | ((uint32_t) p2 << (B));                          \
+            np1 = (np1 & ~(0xffu << (B))) | ((uint32_t) p1 << (B));                          \
+            np0 = (np0 & ~(0xffu << (B))) | ((uint32_t) p0 << (B));                          \
+            nq0 = (nq0 & ~(0xffu << (B))) | ((uint32_t) q0 << (B));                          \
+            nq1 = (nq1 & ~(0xffu << (B))) | ((uint32_t) q1 << (B));                          \
+            nq2 = (nq2 & ~(0xffu << (B))) | ((uint32_t) q2 << (B));                          \
+            touched = 1;                                                                     \
+        }                                                                                    \
+    } while (0)
+
+static void lfc_v_luma_intra(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    const int alpha2 = (alpha >> 2) + 2;
+    for (int i = 0; i < 4; i++, pix += 4) {
+        uint32_t wp3 = psp_lw(pix - 4 * stride), wp2 = psp_lw(pix - 3 * stride), wp1 = psp_lw(pix - 2 * stride), wp0 = psp_lw(pix - stride);
+        uint32_t wq0 = psp_lw(pix), wq1 = psp_lw(pix + stride), wq2 = psp_lw(pix + 2 * stride), wq3 = psp_lw(pix + 3 * stride);
+        uint32_t np2 = wp2, np1 = wp1, np0 = wp0, nq0 = wq0, nq1 = wq1, nq2 = wq2;
+        int touched = 0;
+        LFC_LANE_INTRA(0); LFC_LANE_INTRA(8); LFC_LANE_INTRA(16); LFC_LANE_INTRA(24);
+        if (touched) {
+            psp_sw(pix - 3 * stride, np2); psp_sw(pix - 2 * stride, np1); psp_sw(pix - stride, np0);
+            psp_sw(pix, nq0); psp_sw(pix + stride, nq1); psp_sw(pix + 2 * stride, nq2);
+        }
+    }
+}
+
+/* chroma normal: p1 p0 | q0 q1, tc per pair of lines (inner_iters = 2); the caller passes tc0+1 (<= 0: skip) */
+#define LFC_CHROMA_NORMAL(P1, P0, Q0, Q1, ALPHA, BETA, TC, TOUCHED)                           \
+    do {                                                                                     \
+        int d0_ = (P0) - (Q0);                                                                \
+        if (lfc_abs(d0_) < (ALPHA) && lfc_abs((P1) - (P0)) < (BETA) && lfc_abs((Q1) - (Q0)) < (BETA)) { \
+            int dl_ = lfc_clip(((-d0_ * 4) + ((P1) - (Q1)) + 4) >> 3, -(TC), (TC));           \
+            (P0) = lfc_clip_u8((P0) + dl_);                                                   \
+            (Q0) = lfc_clip_u8((Q0) - dl_);                                                   \
+            TOUCHED = 1;                                                                      \
+        }                                                                                     \
+    } while (0)
+
+/* vertical chroma edge: p1 p0 q0 q1 = unaligned word at pix-2 */
+static void lfc_h_chroma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    for (int i = 0; i < 4; i++) {
+        const int tc = tc0[i];             /* the caller already added 1; <= 0 = skip the pair */
+        if (tc <= 0) { pix += 2 * stride; continue; }
+        for (int d = 0; d < 2; d++, pix += stride) {
+            uint32_t W = psp_ulw(pix - 2);
+            int p1 = W & 0xff, p0 = (W >> 8) & 0xff, q0 = (W >> 16) & 0xff, q1 = W >> 24;
+            int touched = 0;
+            LFC_CHROMA_NORMAL(p1, p0, q0, q1, alpha, beta, tc, touched);
+            if (touched)
+                psp_usw(pix - 2, (uint32_t) p1 | ((uint32_t) p0 << 8) | ((uint32_t) q0 << 16) | ((uint32_t) q1 << 24));
+        }
+    }
+}
+
+#define LFC_CLANE_NORMAL(B, TC)                                                               \
+    do {                                                                                     \
+        int p1 = (wp1 >> (B)) & 0xff, p0 = (wp0 >> (B)) & 0xff;                              \
+        int q0 = (wq0 >> (B)) & 0xff, q1 = (wq1 >> (B)) & 0xff;                              \
+        int t_ = 0;                                                                          \
+        if ((TC) > 0) LFC_CHROMA_NORMAL(p1, p0, q0, q1, alpha, beta, (TC), t_);              \
+        if (t_) {                                                                            \
+            np0 = (np0 & ~(0xffu << (B))) | ((uint32_t) p0 << (B));                          \
+            nq0 = (nq0 & ~(0xffu << (B))) | ((uint32_t) q0 << (B));                          \
+            touched = 1;                                                                     \
+        }                                                                                    \
+    } while (0)
+
+/* horizontal chroma edge: rows p1 p0 q0 q1, 8 pixels = 2 words; tc0[i] covers pixels 2i, 2i+1 */
+static void lfc_v_chroma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    for (int w = 0; w < 2; w++, pix += 4) {
+        const int tA = tc0[2 * w], tB = tc0[2 * w + 1];
+        if (tA <= 0 && tB <= 0) continue;
+        uint32_t wp1 = psp_lw(pix - 2 * stride), wp0 = psp_lw(pix - stride), wq0 = psp_lw(pix), wq1 = psp_lw(pix + stride);
+        uint32_t np0 = wp0, nq0 = wq0;
+        int touched = 0;
+        LFC_CLANE_NORMAL(0, tA); LFC_CLANE_NORMAL(8, tA); LFC_CLANE_NORMAL(16, tB); LFC_CLANE_NORMAL(24, tB);
+        if (touched) { psp_sw(pix - stride, np0); psp_sw(pix, nq0); }
+    }
+}
+
+#define LFC_CHROMA_INTRA(P1, P0, Q0, Q1, ALPHA, BETA, TOUCHED)                                \
+    do {                                                                                     \
+        if (lfc_abs((P0) - (Q0)) < (ALPHA) && lfc_abs((P1) - (P0)) < (BETA) && lfc_abs((Q1) - (Q0)) < (BETA)) { \
+            int p0o_ = (P0), q0o_ = (Q0);                                                     \
+            (P0) = (2 * (P1) + p0o_ + (Q1) + 2) >> 2;                                         \
+            (Q0) = (2 * (Q1) + q0o_ + (P1) + 2) >> 2;                                         \
+            TOUCHED = 1;                                                                      \
+        }                                                                                     \
+    } while (0)
+
+static void lfc_h_chroma_intra(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    for (int d = 0; d < 8; d++, pix += stride) {
+        uint32_t W = psp_ulw(pix - 2);
+        int p1 = W & 0xff, p0 = (W >> 8) & 0xff, q0 = (W >> 16) & 0xff, q1 = W >> 24;
+        int touched = 0;
+        LFC_CHROMA_INTRA(p1, p0, q0, q1, alpha, beta, touched);
+        if (touched)
+            psp_usw(pix - 2, (uint32_t) p1 | ((uint32_t) p0 << 8) | ((uint32_t) q0 << 16) | ((uint32_t) q1 << 24));
+    }
+}
+
+#define LFC_CLANE_INTRA(B)                                                                    \
+    do {                                                                                     \
+        int p1 = (wp1 >> (B)) & 0xff, p0 = (wp0 >> (B)) & 0xff;                              \
+        int q0 = (wq0 >> (B)) & 0xff, q1 = (wq1 >> (B)) & 0xff;                              \
+        int t_ = 0;                                                                          \
+        LFC_CHROMA_INTRA(p1, p0, q0, q1, alpha, beta, t_);                                   \
+        if (t_) {                                                                            \
+            np0 = (np0 & ~(0xffu << (B))) | ((uint32_t) p0 << (B));                          \
+            nq0 = (nq0 & ~(0xffu << (B))) | ((uint32_t) q0 << (B));                          \
+            touched = 1;                                                                     \
+        }                                                                                    \
+    } while (0)
+
+static void lfc_v_chroma_intra(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    for (int w = 0; w < 2; w++, pix += 4) {
+        uint32_t wp1 = psp_lw(pix - 2 * stride), wp0 = psp_lw(pix - stride), wq0 = psp_lw(pix), wq1 = psp_lw(pix + stride);
+        uint32_t np0 = wp0, nq0 = wq0;
+        int touched = 0;
+        LFC_CLANE_INTRA(0); LFC_CLANE_INTRA(8); LFC_CLANE_INTRA(16); LFC_CLANE_INTRA(24);
+        if (touched) { psp_sw(pix - stride, np0); psp_sw(pix, nq0); }
+    }
+}
+
+void swdec_psp_get_lf_luma(void (**v)(uint8_t *, ptrdiff_t, int, int, int8_t *), void (**h)(uint8_t *, ptrdiff_t, int, int, int8_t *),
+                           void (**vi)(uint8_t *, ptrdiff_t, int, int), void (**hi)(uint8_t *, ptrdiff_t, int, int));
+void swdec_psp_get_lf_luma(void (**v)(uint8_t *, ptrdiff_t, int, int, int8_t *), void (**h)(uint8_t *, ptrdiff_t, int, int, int8_t *),
+                           void (**vi)(uint8_t *, ptrdiff_t, int, int), void (**hi)(uint8_t *, ptrdiff_t, int, int))
+{
+#ifdef SWDEC_LF_TEST_VFPU
+    *v = h264_v_loop_filter_luma_psp; *h = h264_h_loop_filter_luma_psp;
+    *vi = h264_v_loop_filter_luma_intra_psp; *hi = h264_h_loop_filter_luma_intra_psp;
+#else
+    *v = lfc_v_luma; *h = lfc_h_luma; *vi = lfc_v_luma_intra; *hi = lfc_h_luma_intra;
+#endif
+}
+
+void swdec_psp_get_lf(void (**v)(uint8_t *, ptrdiff_t, int, int, int8_t *), void (**h)(uint8_t *, ptrdiff_t, int, int, int8_t *),
+                      void (**vi)(uint8_t *, ptrdiff_t, int, int), void (**hi)(uint8_t *, ptrdiff_t, int, int));
+void swdec_psp_get_lf(void (**v)(uint8_t *, ptrdiff_t, int, int, int8_t *), void (**h)(uint8_t *, ptrdiff_t, int, int, int8_t *),
+                      void (**vi)(uint8_t *, ptrdiff_t, int, int), void (**hi)(uint8_t *, ptrdiff_t, int, int))
+{
+#ifdef SWDEC_LF_TEST_VFPU
+    *v = h264_v_loop_filter_chroma_psp; *h = h264_h_loop_filter_chroma_psp;
+    *vi = h264_v_loop_filter_chroma_intra_psp; *hi = h264_h_loop_filter_chroma_intra_psp;
+#else
+    *v = lfc_v_chroma; *h = lfc_h_chroma; *vi = lfc_v_chroma_intra; *hi = lfc_h_chroma_intra;
+#endif
+}
+
+/* test hook: hand the transform kernels to an external unit test */
+void swdec_psp_get_idct(void (**a4)(uint8_t *, int16_t *, int), void (**a8)(uint8_t *, int16_t *, int),
+                        void (**dc4)(uint8_t *, int16_t *, int), void (**dc8)(uint8_t *, int16_t *, int));
+void swdec_psp_get_idct(void (**a4)(uint8_t *, int16_t *, int), void (**a8)(uint8_t *, int16_t *, int),
+                        void (**dc4)(uint8_t *, int16_t *, int), void (**dc8)(uint8_t *, int16_t *, int))
+{
+    *a4 = h264_idct_add_psp; *a8 = h264_idct8_add_psp;
+    *dc4 = h264_idct_dc_add_psp; *dc8 = h264_idct8_dc_add_psp;
+}
+
+static void lf_noop_tc(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0) { (void) pix; (void) stride; (void) alpha; (void) beta; (void) tc0; }
+static void lf_noop(uint8_t *pix, ptrdiff_t stride, int alpha, int beta) { (void) pix; (void) stride; (void) alpha; (void) beta; }
+
+av_cold void ff_h264dsp_init_psp(H264DSPContext *c, const int bit_depth,
+                                 const int chroma_format_idc)
+{
+    if (bit_depth != 8 || swdec_psp_level < 1)
+        return;
+    c->idct_add        = h264_idct_add_psp;
+    c->idct8_add       = h264_idct8_add_psp;
+    c->idct_dc_add     = h264_idct_dc_add_psp;
+    c->idct8_dc_add    = h264_idct8_dc_add_psp;
+    c->idct_add16      = h264_idct_add16_psp;
+    c->idct_add16intra = h264_idct_add16intra_psp;
+    c->idct8_add4      = h264_idct8_add4_psp;
+    if (chroma_format_idc <= 1) {
+        c->idct_add8   = h264_idct_add8_psp;
+#if defined(SWDEC_PSP_LF_CHROMA) && SWDEC_PSP_LF_CHROMA
+        if (swdec_psp_lf & 16) {
+        c->v_loop_filter_chroma       = h264_v_loop_filter_chroma_psp;
+        c->h_loop_filter_chroma       = h264_h_loop_filter_chroma_psp;
+        c->v_loop_filter_chroma_intra = h264_v_loop_filter_chroma_intra_psp;
+        c->h_loop_filter_chroma_intra = h264_h_loop_filter_chroma_intra_psp;
+        }
+#endif
+        if (swdec_psp_lf & 2) {
+        c->v_loop_filter_chroma       = lfc_v_chroma;
+        c->h_loop_filter_chroma       = lfc_h_chroma;
+        c->v_loop_filter_chroma_intra = lfc_v_chroma_intra;
+        c->h_loop_filter_chroma_intra = lfc_h_chroma_intra;
+        }
+    }
+    if (swdec_psp_lf & 1) {
+        c->v_loop_filter_luma       = lfc_v_luma;
+        c->h_loop_filter_luma       = lfc_h_luma;
+        c->v_loop_filter_luma_intra = lfc_v_luma_intra;
+        c->h_loop_filter_luma_intra = lfc_h_luma_intra;
+    }
+    if (swdec_psp_lf & 4) {   /* measurement only: no-op kernels (output garbage) -> fixed deblock overhead */
+        c->v_loop_filter_luma = c->h_loop_filter_luma = lf_noop_tc;
+        c->v_loop_filter_luma_intra = c->h_loop_filter_luma_intra = lf_noop;
+        c->v_loop_filter_chroma = c->h_loop_filter_chroma = lf_noop_tc;
+        c->v_loop_filter_chroma_intra = c->h_loop_filter_chroma_intra = lf_noop;
+    } else if (swdec_psp_lf & 8) {
+        c->v_loop_filter_luma       = h264_v_loop_filter_luma_psp;
+        c->h_loop_filter_luma       = h264_h_loop_filter_luma_psp;
+        c->v_loop_filter_luma_intra = h264_v_loop_filter_luma_intra_psp;
+        c->h_loop_filter_luma_intra = h264_h_loop_filter_luma_intra_psp;
+    }
+    c->weight_pixels_tab[0]   = weight_h264_pixels16_psp;
+    c->weight_pixels_tab[1]   = weight_h264_pixels8_psp;
+    c->weight_pixels_tab[2]   = weight_h264_pixels4_psp;
+    c->biweight_pixels_tab[0] = biweight_h264_pixels16_psp;
+    c->biweight_pixels_tab[1] = biweight_h264_pixels8_psp;
+    c->biweight_pixels_tab[2] = biweight_h264_pixels4_psp;
+}
+
+#else
+typedef int swdec_psp_h264dsp_unused;
+#endif
diff --git a/libavcodec/psp/h264qpel_psp.c b/libavcodec/psp/h264qpel_psp.c
new file mode 100644
index 0000000..2fdaa5f
--- /dev/null
+++ b/libavcodec/psp/h264qpel_psp.c
@@ -0,0 +1,678 @@
+/*
+ * H.264 luma quarter-pel motion compensation for the PSP VFPU (8-bit).
+ *
+ * Numbers: pixels enter as (b - 128) exactly (see vfpu_util.h); the 6-tap
+ * filter (1,-5,20,20,-5,1) sums to 32, so the put rounding constant is
+ * 16 + 128*32 = 4112 and floor(v/32) is vf2id with imm 18.  The 2-D (hv)
+ * path keeps the horizontal intermediates as exact integer floats and
+ * rounds once with 512 + 128*32*32 = 131584 and imm 13.
+ *
+ * Layout trick for the horizontal filter: four source rows are loaded as
+ * the *columns* of matrices M0..M3 (one matrix per 4-pixel word, pixel
+ * offsets -4..11 relative to the block), so every pixel *column* of the
+ * 4-row band is available as a row register Rj0k with no shuffling.  The
+ * filter runs on those vertical vectors and writes its results into the
+ * row registers of M4/M5, whose columns are the output rows -- the
+ * transpose back is free as well.
+ *
+ * The vertical filter works on row quads directly.  Compositions of the
+ * 16 quarter-pel positions follow h264qpel_template.c exactly (including
+ * which of the two half-sample sources is used for the final average) so
+ * results are bit-identical to the C reference.
+ *
+ * Only the 8x8 (and via four calls, 16x16) sizes are covered; 4x4 uses the
+ * C code (rare at these bitrates, and half the VFPU lanes would idle).
+ *
+ * VFPU allocation inside a kernel: M0-M3 inputs, M4/M5 outputs, M6 temps
+ * (C630 = 255 broadcast), M7 constants.
+ *
