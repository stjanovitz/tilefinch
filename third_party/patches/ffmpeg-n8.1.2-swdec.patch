+/* mode bodies over one batch (Q0..Q3 given, A0..A3 = source rows for the l2-row modes) */
+#define VB_PUT(Q0, Q1, Q2, Q3, A0, A1, A2, A3) \
+    VB_ADDK(Q0, "C730") VB_ADDK(Q1, "C730") VB_ADDK(Q2, "C730") VB_ADDK(Q3, "C730") \
