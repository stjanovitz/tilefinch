+static av_always_inline void swdec_job_restore(H264SliceContext *sl, const SwdecMbJob *j)
+{
+    sl->mb_x = j->mb_x; sl->mb_y = j->mb_y; sl->mb_xy = j->mb_xy;
+    sl->mb_field_decoding_flag = j->mb_field_decoding_flag;
+    sl->qscale = j->qscale; sl->chroma_qp[0] = j->chroma_qp[0]; sl->chroma_qp[1] = j->chroma_qp[1];
+    sl->cbp = j->cbp;
+    sl->chroma_pred_mode = j->chroma_pred_mode; sl->intra16x16_pred_mode = j->intra16x16_pred_mode;
+    sl->top_type = j->top_type;
+    sl->topleft_samples_available = j->topleft_samples_available;
+    sl->topright_samples_available = j->topright_samples_available;
+    sl->intra_pcm_ptr = j->intra_pcm_ptr;
+    sl->mb = j->mb;
+    memcpy(sl->non_zero_count_cache, j->non_zero_count_cache, sizeof j->non_zero_count_cache);
+    if (j->intra) {
+        memcpy(sl->intra4x4_pred_mode_cache, j->intra4x4_pred_mode_cache, sizeof j->intra4x4_pred_mode_cache);
+        memcpy(sl->mb_luma_dc, j->mb_luma_dc, sizeof j->mb_luma_dc);
+    } else {
+        memcpy(sl->sub_mb_type, j->sub_mb_type, sizeof j->sub_mb_type);
+        memcpy(sl->ref_cache, j->ref_cache, sizeof j->ref_cache);
+        memcpy(sl->mv_cache, j->mv_cache, sizeof j->mv_cache);
+    }
+}
