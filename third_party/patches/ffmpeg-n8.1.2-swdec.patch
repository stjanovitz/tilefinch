+/* reconstruct every parsed-but-pending macroblock, then put the parser's
+   own macroblock state back (qscale etc. carry across macroblocks) */
+
+static void swdec_pipe_deblock_publish(const H264Context *h, const SwdecRowRec *r);
+
+/* CPU: reconstruct + deblock every published row segment not yet consumed */
+static void swdec_pipe_consume(const H264Context *hc, H264SliceContext *sl)
+{
+    H264Context *h = (H264Context *) hc;
+    H264SliceContext *rsl = h->swdec_rsl;
+    SwdecPipe *pipe = swdec_pipe;
+    while (pipe->cons_seq < pipe->prod_seq) {
+        int seq = pipe->cons_seq;
+        SWDEC_MB();
+        SwdecRowRec rec = pipe->rec[seq & 1];
+        SwdecMbJob *jobs = (SwdecMbJob *) ((char *) sl->swdec_jobs + (size_t) rec.buf * sl->swdec_jobs_stride);
+        if (rec.njobs < 0 || rec.njobs > h->mb_width || rec.mb_y < 0 || rec.mb_y > h->mb_height ||
+            rec.buf != (seq & 1) || rec.x_start < 0 || rec.x_end > h->mb_width || pipe->prod_seq - seq > 2) {
+            swdec_pipe_bad = 1;   /* refuse to act on a garbage record; the dispatcher reports and stops */
+            pipe->cons_seq = pipe->prod_seq;
+            return;
+        }
+        if (swdec_cpu_pre_consume) swdec_cpu_pre_consume(h, rec.mb_y);
+        {
+            SWDEC_STAGE_BEGIN(t_recon);
+            for (int i = 0; i < rec.njobs; i++) {
+#if defined(SWDEC_PIPE_VALIDATE) && SWDEC_PIPE_VALIDATE
+                if (swdec_me_enabled || swdec_validate_force) {
+                    /* never reconstruct from a corrupt job: a wild pointer would crash this
+                       core and leak the module (device power cycle). Validate, then use. */
+                    const SwdecMbJob *j = &jobs[i];
+                    {
+                        unsigned c = (unsigned) (j->mb_x * 2654435761u) ^ (unsigned) j->mb_xy ^ (unsigned) (j->qscale << 20) ^ (unsigned) (j->intra << 27);
+                        const unsigned *q = (const unsigned *) j->non_zero_count_cache;
+                        for (unsigned k = 0; k < sizeof(j->non_zero_count_cache) / 4; k++) c = c * 31u + q[k];
+                        if (j->intra) {
+                            q = (const unsigned *) j->intra4x4_pred_mode_cache;
+                            for (unsigned k = 0; k < sizeof(j->intra4x4_pred_mode_cache) / 4; k++) c = c * 31u + q[k];
+                        } else {
+                            q = (const unsigned *) j->mv_cache;
+                            for (unsigned k = 0; k < sizeof(j->mv_cache) / 4; k++) c = c * 31u + q[k];
+                            q = (const unsigned *) j->ref_cache;
+                            for (unsigned k = 0; k < sizeof(j->ref_cache) / 4; k++) c = c * 31u + q[k];
+                        }
+                        if (c != j->cksum) {
+                            swdec_pipe_bad = 4;   /* transfer/tearing: content changed after save */
+                            swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                            swdec_pipe_bad_info[2] = j->mb_x; swdec_pipe_bad_info[3] = rec.mb_y;
+                            swdec_pipe_bad_info[4] = (int) c; swdec_pipe_bad_info[5] = (int) j->cksum;
+                            pipe->cons_seq = pipe->prod_seq;
+                            return;
+                        }
+                    }
+                    if ((unsigned) j->mb_x >= (unsigned) h->mb_width || j->mb_y != rec.mb_y ||
+                        j->mb_xy != j->mb_x + j->mb_y * h->mb_stride ||
+                        (unsigned) j->qscale > 51u || (unsigned) j->intra > 7u) {   /* intra = IS_INTRA mask bits */
+                        swdec_pipe_bad = 2;
+                        swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                        swdec_pipe_bad_info[2] = j->mb_x; swdec_pipe_bad_info[3] = j->mb_y;
+                        swdec_pipe_bad_info[4] = j->mb_xy; swdec_pipe_bad_info[5] = j->qscale;
+                        pipe->cons_seq = pipe->prod_seq;
+                        return;
+                    }
+                    if (!j->intra) {
+                        /* hard bound only: the ref_list array has 48 entries; legitimate cache
+                           values can exceed ref_count (direct modes), so that is not an error */
+                        for (int l = 0; l < 2; l++)
+                            for (int k = 0; k < 5 * 8; k++) {
+                                int r_ = j->ref_cache[l][k];
+                                if (r_ >= 48 || r_ < -8) {
+                                    swdec_pipe_bad = 3;
+                                    swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                                    swdec_pipe_bad_info[2] = l; swdec_pipe_bad_info[3] = k;
+                                    swdec_pipe_bad_info[4] = r_; swdec_pipe_bad_info[5] = j->mb_x;
+                                    pipe->cons_seq = pipe->prod_seq;
+                                    return;
+                                }
+                            }
+                    }
+                }
+#endif
+                swdec_job_restore(rsl, &jobs[i]);
+                if (SWDEC_RECON_ENABLED)
+                    ff_h264_hl_decode_mb(h, rsl);
+            }
+            SWDEC_STAGE_END(t_recon, 1);
+        }
+        if (rec.x_end > rec.x_start) {
+            SWDEC_STAGE_BEGIN(t_lf);
+            rsl->mb_x = rec.x_end; rsl->mb_y = rec.mb_y;
+            if (swdec_me_deblock) {
+                loop_filter_ex(h, rsl, rec.x_start, rec.x_end, 1);   /* backup borders only */
+                if (pipe->dprev_valid) {
+                    swdec_pipe_deblock_publish(h, &pipe->dprev);     /* row above: border exchange done */
+                    if (swdec_me_deblock == 3)
+                        while (pipe->dcons < pipe->dprod) { }        /* diagnosis: serialize deblock vs later CPU work */
+                }
+                pipe->dprev = rec;
+                pipe->dprev_valid = 1;
+            } else {
+                loop_filter(h, rsl, rec.x_start, rec.x_end);
+            }
+            SWDEC_STAGE_END(t_lf, 2);
+        }
+        if (swdec_cpu_post_consume) {
+            swdec_cpu_post_consume(sl->swdec_ring + (size_t) rec.buf * h->mb_width * SWDEC_RING_SLOT(h),
+                                   (size_t) h->mb_width * SWDEC_RING_SLOT(h) * sizeof(int16_t));
+            swdec_cpu_post_consume(jobs, (size_t) rec.njobs * sizeof(SwdecMbJob));
+        }
+        SWDEC_MB();
+        pipe->cons_seq = seq + 1;
+    }
+}
+void swdec_pipe_consume_all(void *h, void *sl) { swdec_pipe_consume((const H264Context *) h, (H264SliceContext *) sl); }
+
+/* Deblock offload: the CPU publishes fully reconstructed rows (lag 1 behind
+   recon, so the border exchange of the next row is finished); the parser core
+   filters them from its idle loops. h->swdec_dsl is the filter's own slice
+   context (set up by the CPU dispatcher per slice). */
+void swdec_pipe_deblock_service(const void *hv)
+{
+    const H264Context *h = hv;
+    SwdecPipe *pipe = swdec_pipe;
+    while (pipe->dcons < pipe->dprod) {
+        SWDEC_MB();
+        SwdecRowRec r = pipe->drec[pipe->dcons & (SWDEC_DQ - 1)];
+        H264SliceContext *dsl = h->swdec_dsl;
+        dsl->mb_x = r.x_end; dsl->mb_y = r.mb_y;
+        loop_filter_ex(h, dsl, r.x_start, r.x_end, 2);
+        /* filtering row mb_y finished the shared border of the row above:
+           that row's pixels are final now - convert it while it is cache-hot */
+        if (swdec_me_csc_row && r.mb_y > 0 && r.x_end >= h->mb_width)
+            swdec_me_csc_row(h, r.mb_y - 1);
+        if (swdec_me_post_deblock) swdec_me_post_deblock();
+        SWDEC_MB();
+        pipe->dcons = pipe->dcons + 1;
+    }
+}
+
+static void swdec_pipe_deblock_publish(const H264Context *h, const SwdecRowRec *r)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    if (r->x_end <= r->x_start)
+        return;
+    if (swdec_cpu_flush_row) swdec_cpu_flush_row(h, r->mb_y);
+    while (pipe->dprod - pipe->dcons >= SWDEC_DQ) { }   /* queue full: filter core behind */
+    pipe->drec[pipe->dprod & (SWDEC_DQ - 1)] = *r;
+    SWDEC_MB();
+    pipe->dprod = pipe->dprod + 1;
+    SWDEC_MB();
+    if (swdec_me_deblock == 2)
+        swdec_pipe_deblock_service(h);   /* diagnosis: same split, no concurrency */
+}
+
+int swdec_me_tail_cpu = 1;   /* frame-tail work stealing: the CPU deblocks the held-back
+                                row itself instead of queueing it and idling on the ME
+                                (which is still busy with audio at slice end) */
+/* CPU, end of slice: everything reconstructed; push (or steal) the held-back row */
+void swdec_pipe_deblock_flush(const void *hv)
+{
+    const H264Context *h = hv;
+    SwdecPipe *pipe = swdec_pipe;
+    if (pipe->dprev_valid) {
+        if (swdec_me_tail_cpu && h->swdec_rsl) {
+            SwdecRowRec r = pipe->dprev;
+            while (pipe->dcons < pipe->dprod) { }   /* the row above is queued: it must finish
+                                                       first (shared boundary lines) */
+            if (r.x_end > r.x_start) {
+                H264SliceContext *rsl = h->swdec_rsl;
+                if (swdec_cpu_flush_row) swdec_cpu_flush_row(h, r.mb_y);   /* rows above were ME-filtered */
+                rsl->mb_x = r.x_end; rsl->mb_y = r.mb_y;
+                loop_filter_ex(h, rsl, r.x_start, r.x_end, 2);
+                if (swdec_cpu_post_consume) {   /* make the filtered pixels visible to RAM readers */
+                    /* pixel writeback happens via the frame-level invalidate at hand-off end */
+                }
+            }
+        } else {
+            swdec_pipe_deblock_publish(h, &pipe->dprev);
+        }
+        pipe->dprev_valid = 0;
+    }
+}
+int swdec_pipe_deblock_pending(void)
+{
+    return swdec_pipe->dprod - swdec_pipe->dcons;
+}
