+static void publish_device(libusb_device_handle *dev)
+{
+	pthread_mutex_lock(&usb_lifetime_mutex);
+	usbhdr = dev;
+	pthread_mutex_unlock(&usb_lifetime_mutex);
+}
+
+static void retire_device(void)
+{
+	/* Wait for the already-admitted writer; no new writer can retain dev
+	 * while interface/reset/close are releasing its libusb internals. */
+	pthread_mutex_lock(&usb_lifetime_mutex);
+	libusb_device_handle *dev = usbhdr;
+	usbhdr = NULL;
+	close_device(dev);
+	pthread_mutex_unlock(&usb_lifetime_mutex);
+}
+
+static int write_async_usb(char *bytes, int size)
+{
+	pthread_mutex_lock(&usb_lifetime_mutex);
+	int result = usbhdr ? euid_usb_bulk_write(usbhdr, 0x3, bytes, size, 10000)
+		: LIBUSB_ERROR_NO_DEVICE;
+	pthread_mutex_unlock(&usb_lifetime_mutex);
+	return result;
+}
