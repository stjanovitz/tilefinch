+/* The hostfs owner reads concurrently with the endpoint-3 command writer.
+ * Protect only publication/retirement and that writer: holding this mutex
+ * across the owner's blocking read would prevent duplex protocol progress. */
+static pthread_mutex_t usb_lifetime_mutex = PTHREAD_MUTEX_INITIALIZER;
 
 static int g_servsocks[MAX_ASYNC_CHANNELS];
 static int g_clientsocks[MAX_ASYNC_CHANNELS];
@@ -319,6 +323,33 @@ void close_device(libusb_device_handle *dev)
 	}
