<!doctype html><html><head><title>Root aggregate title</title></head><body><h1>Section zero</h1><p>Alpha source</p><div id="root-text-result">WAIT</div><script type="module">const titleWord=String.fromCharCode(82,111,111,116,32,97,103,103,114,101,103,97,116,101,32,116,105,116,108,101),tailWord=String.fromCharCode(67,104,97,114,108,105,101,32,115,111,117,114,99,101),bodyText=document.body.textContent,htmlText=document.documentElement.textContent,result=document.getElementById('root-text-result'),checks=[bodyText.includes(tailWord),!bodyText.includes(titleWord),htmlText.includes(titleWord),htmlText.includes(tailWord)];result.textContent=checks.every(Boolean)?'ROOT-TEXT-PASS':'ROOT-TEXT-FAIL:'+checks.map(Number).join('');</script><h2>Section one</h2><p>Bravo source</p><h2>Section two</h2><p>Charlie source</p></body></html>
