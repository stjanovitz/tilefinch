<!doctype html><title>Viewport after stylesheet</title><script>document.documentElement.setAttribute('data-early','1')</script><style>#probe{color:#010101}@media (max-width:639px){#probe{color:#112233}}@media (min-width:640px){#probe{color:#445566}}</style><meta name=viewport content="width=device-width"><body><p id=probe>viewport</p><script>globalThis.pocSummary='viewport:'+innerWidth</script></body>
