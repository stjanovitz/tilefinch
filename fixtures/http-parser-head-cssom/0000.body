<!doctype html><html><head><title>Head CSSOM initialization</title><style>html{color:#123456}#field{width:73px}</style><script>globalThis.headBodyAbsent=document.body===null;globalThis.headColor=getComputedStyle(document.documentElement).color;globalThis.headWidth=getComputedStyle(document.documentElement).width;globalThis.headBox=document.documentElement.getBoundingClientRect().width;var fake=document.createElement('body');fake.style.width='37px';document.documentElement.appendChild(fake);globalThis.liveBody=document.body===fake;globalThis.fakeWidth=fake.getBoundingClientRect().width;fake.remove();document.addEventListener('DOMContentLoaded',function(){var field=document.getElementById('field');field.setAttribute('data-ready','yes');globalThis.pocSummary=[headBodyAbsent,headColor,liveBody,fakeWidth,getComputedStyle(field).width].join('|')})</script></head><body><input id="field" aria-label="Find items"><nav>Browse items</nav></body></html>
