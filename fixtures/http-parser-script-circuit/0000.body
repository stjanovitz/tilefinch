<!doctype html><html><head><title>Bounded script fallback</title></head><body><main><h1 id="content">Server page remains useful</h1><script>throw new Error('first expected failure')</script><script>throw new Error('second expected failure')</script><script>throw new Error('third expected failure')</script><script src="/must-not-fetch.js"></script><script>document.body.setAttribute('data-fifth-ran','yes')</script><a id="useful-link" href="/next">Continue</a><form id="usable-form" action="/search" method="get"><label>Search <input id="query" name="q"></label><button id="submit" type="submit">Go</button></form></main></body></html>
