<!doctype html><html><head><title>Lazy section scripts</title><script>globalThis.lazyRuns=(globalThis.lazyRuns||0)+100;globalThis.scriptOrder=['head'];globalThis.parserChecks=[document.body===null,document.forms.length===0,document.getElementById('alpha')===null,document.querySelector('#beta')===null,document.querySelectorAll('#beta').length===0];globalThis.parserVisibility=parserChecks.every(Boolean);</script></head><body><h1 id="alpha">Alpha</h1><div id="alpha-result">original-a</div><script>const alphaScript=document.currentScript;parserChecks.push(document.getElementById('beta')===null,document.querySelector('#beta')===null,document.querySelectorAll('#beta').length===0,document.forms.length===0,document.body.children.length===3,document.body.lastElementChild===alphaScript,alphaScript.nextElementSibling===null);parserVisibility=parserVisibility&&parserChecks.slice(5).every(Boolean);lazyRuns+=1;scriptOrder.push('alpha');document.getElementById('alpha-result').textContent=String(lazyRuns);</script><script id="boundary-script" type="module">scriptOrder.push('module');const boundary=document.getElementById('boundary-script');const beta=document.getElementById('beta');const bodyChildren=document.body.children;const relations=boundary.nextElementSibling===beta&&beta.previousElementSibling===boundary&&bodyChildren.length===9&&bodyChildren[3]===boundary&&bodyChildren[4]===beta&&document.body.firstElementChild===bodyChildren[0]&&document.body.lastElementChild===bodyChildren[8];parserChecks.push(document.getElementById('beta')===beta,document.querySelectorAll('#beta').length===1,document.forms.length===1,document.forms[0]===document.getElementById('future-form'));const visibility=parserVisibility&&parserChecks.slice(-4).every(Boolean);document.getElementById('order-result').textContent=scriptOrder.join('>')+':visibility='+(visibility?'yes':'no-'+parserChecks.map(Number).join(''))+':relations='+(relations?'yes':'no');</script><h2 id="beta">Beta</h2><div id="beta-result">original-b</div><div id="order-result">original-order</div><script>const betaScript=document.currentScript;parserChecks.push(document.getElementById('alpha')!==null,document.getElementById('beta')!==null,document.forms.length===0,document.body.children.length===8,document.body.lastElementChild===betaScript);parserVisibility=parserVisibility&&parserChecks.slice(-5).every(Boolean);lazyRuns+=10;scriptOrder.push('beta');document.getElementById('beta-result').textContent=String(lazyRuns);</script><form id="future-form"></form></body></html>
