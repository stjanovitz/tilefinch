<!doctype html><html><head><title>Lazy section scripts</title><script>globalThis.lazyRuns=(globalThis.lazyRuns||0)+100;</script></head><body><h1 id="alpha">Alpha</h1><div id="alpha-result">original-a</div><script>lazyRuns+=1;document.getElementById('alpha-result').textContent=String(lazyRuns);</script><h2 id="beta">Beta</h2><div id="beta-result">original-b</div><script>lazyRuns+=10;document.getElementById('beta-result').textContent=String(lazyRuns);</script></body></html>
