<!doctype html><html><head><title>Root attribute parity</title></head><body><h1>Section zero</h1><div>Zero</div><script type="module">document.documentElement.id='root-html';document.documentElement.setAttribute('data-root-state','html-kept');document.head.id='root-head';document.head.setAttribute('data-root-state','head-kept');document.body.id='root-body';document.body.setAttribute('data-root-state','body-kept');</script><h2>Section one</h2><div>One</div><h2>Section two</h2><div>Two</div></body></html>
