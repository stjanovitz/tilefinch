<!doctype html><html><head><title>Parser mutation deadline</title></head><body><main><script>new MutationObserver(function(){if(document.getElementById('victim')){for(;;){}}}).observe(document,{childList:true,subtree:true})</script><section><script id="victim">for(;;){};document.body.setAttribute('data-victim-ran','bad')</script></section><script>document.body.setAttribute('data-tail-ran','bad')</script><h1 id="content">Server content remains useful</h1><a id="useful-link" href="/next">Continue</a></main></body></html>
