<!doctype html><html><head><title>Parser mutation records</title></head><body><script>function scan(records,cls,found){records.forEach(function(record){record.addedNodes.forEach(function(node){if(node.nodeType!==1)return;if(node.className===cls)found.add(node);node.querySelectorAll('.'+cls).forEach(function(match){found.add(match)})})})}var many=new Set(),bodyMany=new Set();new MutationObserver(function(records){scan(records,'many',many);records.forEach(function(record){record.addedNodes.forEach(function(node){if(node.id==='tail')document.body.setAttribute('data-tail-seen',(record.target===document.body?'body':'other')+':'+(record.previousSibling&&record.previousSibling.id)+':'+record.nextSibling)})})}).observe(document,{childList:true,subtree:true});new MutationObserver(function(records){scan(records,'many',bodyMany)}).observe(document.body,{childList:true})</script><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i></i></div><div class=many><i