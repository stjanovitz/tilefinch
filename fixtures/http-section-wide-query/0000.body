<!doctype html><html><head><title>Wide section query</title></head><body><h1>Section 0</h1><div class="wide-match">0</div><h2>Section 1</h2><div class="wide-match">1</div><h2>Section 2</h2><div class="wide-match">2</div><h2>Section 3</h2><div class="wide-match">3</div><h2>Section 4</h2><div class="wide-match">4</div><h2>Section 5</h2><div class="wide-match">5</div><h2>Section 6</h2><div class="wide-match">6</div><h2>Section 7</h2><div class="wide-match">7</div><h2>Section 8</h2><div class="wide-match">8</div><h2>Section 9</h2><div class="wide-match">9</div><div id="wide-query-result">WAIT</div><script type="module">const matches=document.querySelectorAll('div.wide-match'),iterator=document.createNodeIterator(document.body,NodeFilter.SHOW_ELEMENT|NodeFilter.SHOW_TEXT),traversed=[];for(let node;(node=iterator.nextNode());)traversed.push(node);const elements=traversed.filter(node=>node.nodeType===Node.ELEMENT_NODE),texts=traversed.filter(node=>node.nodeType===Node.TEXT_NODE),walker=document.createTreeWalker(document.body,NodeFilter.SHOW_ELEMENT),walked=[];for(let node;(node=walker.nextNode());)walked.push(node);const documentIterator=document.createNodeIterator(document,NodeFilter.SHOW_ELEMENT),documentElements=[];for(let node;(node=documentIterator.nextNode())&&documentElements.length<4;)documentElements.push(node);const result=document.getElementById('wide-query-result'),checks=[matches.length===10,matches.item(0)===matches[0],matches.item(9)===matches[9],matches.every((node,index)=>node.textContent===String(index)&&node.tagName==='DIV'&&node.isConnected),new Set(matches).size===10,elements.length===23,elements[0]===document.body,elements[1]===document.querySelector('h1'),elements[20]===matches[9],elements[21]===result,elements[22]?.tagName==='SCRIPT'&&document.currentScript===null,texts.length===23,texts[0]?.data==='Section 0',texts[19]?.data==='9',walked.length===22,walked[0]===elements[1],walked[21]===elements[22],documentElements[0]===document.documentElement,documentElements[1]===document.head,documentElements[2]?.tagName==='TITLE',documentElements[3]===document.body];result.textContent=checks.every(Boolean)?'WIDE-QUERY-PASS':'WIDE-QUERY-FAIL:'+checks.map(Number).join('')+':counts='+elements.length+','+texts.length+','+walked.length+':doc='+documentElements.map(node=>node?.tagName).join(',');</script></body></html>
