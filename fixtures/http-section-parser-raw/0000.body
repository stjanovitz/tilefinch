<!doctype html><html><head><title>Parser raw visibility</title><script>globalThis.rawChecks=[document.body===null];</script></head><body><h1 id="first">First</h1><script>globalThis.firstScript=document.currentScript;const futureWord=String.fromCharCode(83,101,99,111,110,100);rawChecks.push(firstScript.nextSibling===null,document.body.lastChild===firstScript,document.body.childNodes[document.body.childNodes.length-1]===firstScript,document.body.textContent.includes('First'),!document.body.textContent.includes(futureWord));</script> <!--future--><script id="deferred-module" type="module">const moduleNode=document.getElementById('deferred-module'),afterFirst=firstScript.nextSibling,futureComment=afterFirst&&afterFirst.nextSibling,afterModule=moduleNode.nextSibling,second=afterModule&&afterModule.nextSibling,finalNode=document.body.lastChild;rawChecks.push(afterFirst&&afterFirst.nodeType===Node.TEXT_NODE,futureComment&&futureComment.nodeType===Node.COMMENT_NODE&&futureComment.data==='future',futureComment&&futureComment.nextSibling===moduleNode,afterModule&&afterModule.nodeType===Node.TEXT_NODE,second&&second.id==='second',moduleNode.nextElementSibling===second,finalNode&&finalNode.nodeType===Node.TEXT_NODE&&finalNode.previousSibling===globalThis.tailScript,document.body.textContent.includes('First')&&document.body.textContent.includes('Second'));document.getElementById('raw-parser-result').textContent=rawChecks.every(Boolean)?'RAW-PARSER-PASS':'RAW-PARSER-FAIL:'+rawChecks.map(Number).join('');</script> <h2 id="second">Second</h2><div id="raw-parser-result">WAIT</div><script>globalThis.tailScript=document.currentScript;rawChecks.push(tailScript.nextSibling===null,document.body.lastChild===tailScript,document.body.childNodes[document.body.childNodes.length-1]===tailScript);</script></body></html>
