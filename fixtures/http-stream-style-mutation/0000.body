<!doctype html><title>Style checkpoint</title><style id="sheet">#probe{display:block}</style><body><p id="probe">probe</p><script>document.getElementById('sheet').textContent='#probe{display:grid}'</script><script>globalThis.secondStyle=getComputedStyle(document.getElementById('probe')).display</script><script>globalThis.pocSummary=globalThis.secondStyle==='grid'?'style-checkpoint:ok':'style-checkpoint:stale'</script><style>#probe{display:flex}</style>
