<!doctype html><title>Disabled link</title><link id=sheet rel=stylesheet href=/grid.css><body><p id=probe>probe</p><script>globalThis.before=getComputedStyle(document.getElementById('probe')).display</script><script>document.getElementById('sheet').setAttribute('disabled','')</script><style>#tail{color:#102030}</style><script>globalThis.pocSummary=globalThis.before+'/'+getComputedStyle(document.getElementById('probe')).display</script><p>tail</p>