<!doctype html><html data-color-mode=light data-light-theme=light data-dark-theme=dark><head><title>Theme</title><link rel=stylesheet data-color-theme=light data-href=/grid.css><link rel=stylesheet data-color-theme=dark data-href=/flex.css><link rel=stylesheet href=/flex.css><link rel=stylesheet href=/grid.css></head><body><p id=probe>probe</p><script>globalThis.before=getComputedStyle(document.getElementById('probe')).display</script><script>document.documentElement.setAttribute('data-color-mode','dark')</script><style>#tail{color:#102030}</style><script>globalThis.pocSummary=globalThis.before+'/'+getComputedStyle(document.getElementById('probe')).display</script><p>tail</p>