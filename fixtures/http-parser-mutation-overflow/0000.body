<!doctype html><html><head><title>Parser mutation overflow</title></head><body><script>function scan(records,cls,found){records.forEach(function(record){record.addedNodes.forEach(function(node){if(node.nodeType!==1)return;if(node.className===cls)found.add(node);node.querySelectorAll('.'+cls).forEach(function(match){found.add(match)})})})}var big=new Set(),js=new Set(),drops=__tilefinchRetentionStats.recordDrops;new MutationObserver(function(records){scan(records,'big',big)}).observe(document,{childList:true,subtree:true})</script><section><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div><div class=big><b></b></div