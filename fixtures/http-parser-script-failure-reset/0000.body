<!doctype html><html><head><title>Failure reset</title></head><body><main><script>throw new Error('failure one')</script><script>throw new Error('failure two')</script><script>document.body.setAttribute('data-reset-ran','yes')</script><script>throw new Error('failure three')</script><script>throw new Error('failure four')</script><script>document.body.setAttribute('data-tail-ran','yes')</script><h1 id="content">Hydrated after isolated failures</h1></main></body></html>
