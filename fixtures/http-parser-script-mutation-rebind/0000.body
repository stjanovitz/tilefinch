<!doctype html><html><head><title>Parser script mutation rebind</title></head><body><main><script>new MutationObserver(function(){var victim=document.getElementById('victim');if(victim){document.body.setAttribute('data-removed','yes');victim.parentNode.textContent=''}var retyped=document.getElementById('retyped');if(retyped){document.body.setAttribute('data-retyped','yes');retyped.setAttribute('type','application/json')}}).observe(document,{childList:true,subtree:true})</script><section><script id="victim">document.body.setAttribute('data-victim-ran','bad')</script></section><script id="retyped">document.body.setAttribute('data-retyped-ran','bad')</script><script>document.body.setAttribute('data-tail-ran','yes')</script><h1 id="content">Server content remains useful</h1><a id="useful-link" href="/next">Continue</a></main></body></html>
