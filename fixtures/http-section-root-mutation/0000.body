<!doctype html><html><head><title>Root mutation parity</title></head><body><h1>Old section 0</h1><div class="old">Old zero</div><h2>Old section 1</h2><div class="old">Old one</div><h2>Old section 2</h2><div class="old">Old two</div><script type="module">document.documentElement.setAttribute('data-html-state','kept');document.head.setAttribute('data-head-state','kept');document.body.setAttribute('data-root-state','kept');document.body.innerHTML='<main id="replacement"><div id="root-result">WAIT</div><p>Replacement content</p></main>';const iterator=document.createNodeIterator(document.body,NodeFilter.SHOW_ELEMENT),iterated=[];for(let node;(node=iterator.nextNode());)iterated.push(node);const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_ELEMENT),walked=[];for(let node;(node=walker.nextNode());)walked.push(node);const result=document.getElementById('root-result'),checks=[document.querySelectorAll('.old').length===0,document.querySelector('h1')===null,document.querySelector('#replacement')===document.getElementById('replacement'),document.documentElement.getAttribute('data-html-state')==='kept',document.head.getAttribute('data-head-state')==='kept',document.body.getAttribute('data-root-state')==='kept',document.body.textContent.includes('Replacement content'),!document.body.textContent.includes('Old zero'),iterated.length===4,iterated[0]===document.body,iterated[1]===document.getElementById('replacement'),walked.length===3,walked[0]===document.getElementById('replacement')];result.textContent=checks.every(Boolean)?'ROOT-MUTATION-PASS':'ROOT-MUTATION-FAIL:'+checks.map(Number).join('')+':counts='+iterated.length+','+walked.length;</script></body></html>
