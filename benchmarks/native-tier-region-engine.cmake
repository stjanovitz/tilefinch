# Generate an isolated interpreter copy with an explicit frame handoff. Do not
# mutate the vendored engine or its pins to run this isolated experiment.
file(READ "${INPUT}" source)
set(live_prototypes "#ifdef TF_REGION_LIVE_ENGINE\nstatic void tf_region_live_reset(JSRuntime *rt);\nstatic size_t tf_region_live_limit(JSRuntime *rt, size_t limit);\nstatic uint64_t tf_region_lazy_compile_ns;\nstatic uint64_t tf_region_clock_ns(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec; }\n#endif\n")
set(public_header "#include \"quickjs.h\"")
set(marker "/* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */\nstatic JSValue JS_CallInternal(JSContext *caller_ctx")
set(dispatch "#define SWITCH(pc)      goto *dispatch_table[(TF_COUNT_OP(), TF_CENSUS_OP(rt, *pc), opcode = *pc++)];")
set(declare "    JSValue *local_buf, *stack_buf, *var_buf, *arg_buf, *sp, ret_val, *pval;")
set(init "    ctx = b->realm; /* set the current realm */")
set(restart " restart:\n")
set(close "    done:\n        {\n        TF_CENSUS(rt, JS_CENSUS_FRAME_CLEANUP, 0);")
set(exception " exception:\n    if (is_backtrace_needed(ctx, rt->current_exception)) {")
set(free_runtime "void JS_FreeRuntime(JSRuntime *rt)\n{")
set(memory_limit "void JS_SetMemoryLimit(JSRuntime *rt, size_t limit)\n{")
set(lazy_begin "static int js_lazy_function_compile(JSContext *caller_ctx, JSFunctionBytecode *b)\n{\n    JSRuntime *rt = b->realm->rt;")
set(lazy_end "    return ret;\n}\n\n\n/* 'input' must be zero terminated")
set(call_counter "    uint32_t tf_calls;\n#endif")
foreach(needle IN ITEMS "${marker}" "${dispatch}" "${declare}" "${init}" "${restart}" "${close}" "${exception}" "${free_runtime}" "${memory_limit}" "${public_header}" "${lazy_begin}" "${lazy_end}" "${call_counter}")
    string(FIND "${source}" "${needle}" first)
    if(first EQUAL -1)
        message(FATAL_ERROR "Native-region experiment injection point changed: ${needle}")
    endif()
    string(LENGTH "${needle}" length)
    math(EXPR next "${first} + ${length}")
    string(SUBSTRING "${source}" ${next} -1 tail)
    string(FIND "${tail}" "${needle}" second)
    if(NOT second EQUAL -1)
        message(FATAL_ERROR "Native-region experiment injection point is ambiguous")
    endif()
endforeach()
string(REPLACE "${public_header}" "${public_header}\n${live_prototypes}" source "${source}")
string(REPLACE "${call_counter}" "    uint32_t tf_calls;\n#ifdef TF_REGION_LIVE_ENGINE\n    uint32_t tf_job_epoch;\n    uint32_t tf_job_calls;\n    uint64_t tf_job_interpreter_ops;\n    uint64_t tf_job_identity;\n    uint64_t tf_job_primitive_ops;\n    uint64_t tf_job_reference_ops;\n    uint64_t tf_job_value_ops[4];\n#endif\n#endif" source "${source}")
string(REPLACE "${marker}" "#include \"native-tier-region.inc\"\n${marker}" source "${source}")
string(REPLACE "${free_runtime}" "${free_runtime}\n#ifdef TF_REGION_LIVE_ENGINE\n    tf_region_live_reset(rt);\n#endif" source "${source}")
string(REPLACE "${memory_limit}" "${memory_limit}\n#ifdef TF_REGION_LIVE_ENGINE\n    limit = tf_region_live_limit(rt, limit);\n#endif" source "${source}")
string(REPLACE "${lazy_begin}" "${lazy_begin}\n#ifdef TF_REGION_LIVE_ENGINE\n    uint64_t tf_lazy_started_ns = tf_region_clock_ns();\n#endif" source "${source}")
string(REPLACE "${lazy_end}" "#ifdef TF_REGION_LIVE_ENGINE\n    tf_region_lazy_compile_ns += tf_region_clock_ns() - tf_lazy_started_ns;\n#endif\n${lazy_end}" source "${source}")
string(REPLACE "${dispatch}" "#ifdef TF_REGION_TABLE_DISPATCH\n    static const void *const tf_native_dispatch_table[256] = {[0 ... 255] = &&tf_native_dispatch};\n    const void *const *tf_dispatch_table = dispatch_table;\n#if defined(TF_REGION_LIVE_ENGINE) && defined(TF_REGION_JOB_CENSUS)\n#define SWITCH(pc) if (tf_region_job_census_enabled && tf_region_job_epoch) tf_region_job_record(ctx, b, false, *pc, pc, stack_buf, sp, var_buf, arg_buf, var_refs); goto *tf_dispatch_table[(TF_COUNT_OP(), TF_CENSUS_OP(rt, *pc), opcode = *pc++)];\n#else\n#define SWITCH(pc) goto *tf_dispatch_table[(TF_COUNT_OP(), TF_CENSUS_OP(rt, *pc), opcode = *pc++)];\n#endif\n#else\n#define SWITCH(pc) TF_REGION_DISPATCH(ctx, b, pc, flags, var_buf, arg_buf, var_refs, stack_buf, sf, &sp, &pc); goto *dispatch_table[(TF_COUNT_OP(), TF_CENSUS_OP(rt, *pc), opcode = *pc++)];\n#endif" source "${source}")
string(REPLACE "b->tf_calls++;" "b->tf_calls++;\n#if defined(TF_REGION_LIVE_ENGINE) && defined(TF_REGION_JOB_CENSUS)\n    if (tf_region_job_census_enabled && tf_region_job_epoch) tf_region_job_record(caller_ctx, b, true, -1, NULL, NULL, NULL, NULL, NULL, NULL);\n#endif" source "${source}")
string(REPLACE "${declare}" "${declare}\n    TF_REGION_DECLARE;\n#ifdef TF_REGION_LIVE_ENGINE\n    TF_REGION_CALL_PROBE_START;\n#endif" source "${source}")
string(REPLACE "${init}" "${init}\n    TF_REGION_INIT;" source "${source}")
string(REPLACE "${restart}" "${restart}#ifdef TF_REGION_LIVE_ENGINE\n    TF_REGION_CALL_PROBE_RESTART;\n#endif\n" source "${source}")
string(REPLACE "${close}" "    done:\n        TF_REGION_CLOSE;\n        {\n        TF_CENSUS(rt, JS_CENSUS_FRAME_CLEANUP, 0);" source "${source}")
string(REPLACE "${exception}" "#ifdef TF_REGION_TABLE_DISPATCH\n tf_native_dispatch:\n    pc--; /* the table dispatch consumed the opcode, the region expects its address */\n    TF_REGION_DISPATCH(ctx, b, pc, flags, var_buf, arg_buf, var_refs, stack_buf, sf, &sp, &pc);\n    goto *dispatch_table[opcode = *pc++];\n#endif\n${exception}" source "${source}")
file(WRITE "${OUTPUT}" "#line 1 \"${INPUT}\"\n${source}")
