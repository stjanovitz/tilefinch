js (()=>{const a=document.querySelectorAll('a[href="item?id=49010345"]').slice(-1)[0];if(!a)throw new Error('missing frozen comments link');a.id='tilefinch-comments-link';return 'home:'+document.querySelectorAll('tr.athing.submission').length+':'+scrollY})()
focus-id tilefinch-comments-link
activate
tick 3 100
js 'comments:'+location.pathname+location.search+':'+(document.querySelector('tr.athing.comtr')!==null)+':'+scrollY
