--- a/include/pocketsphinx/prim_type.h
+++ b/include/pocketsphinx/prim_type.h
@@ -119,9 +119,21 @@ typedef union anytype_s {
 #include <stdint.h>
+/*
+ * Newlib's PSP target defines int32_t as long even though both long and int
+ * are 32 bits.  PocketSphinx uses plain int in a few internal interfaces,
+ * which GCC 15 correctly diagnoses as incompatible with long pointers and
+ * function returns.  Keep the public 32-bit representation while using the
+ * target's natural int type, as PocketSphinx does on most other 32-bit hosts.
+ */
+#if defined(__PSP__)
+typedef signed int      int32;
+typedef unsigned int    uint32;
+#else
 typedef int32_t		int32;
+typedef uint32_t	uint32;
+#endif
 typedef int16_t		int16;
 typedef int8_t		int8;
-typedef uint32_t	uint32;
 typedef uint16_t	uint16;
 typedef uint8_t		uint8;
 typedef int64_t		int64;
 typedef uint64_t	uint64;
