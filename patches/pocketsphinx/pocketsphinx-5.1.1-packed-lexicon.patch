+#ifdef TILEFINCH_PACKED_LEXICON
+static int32
+dict_measure(FILE *fp, int32 *word_count, size_t *word_bytes,
+             size_t *phone_count)
+{
+    lineiter_t *li;
+    char **wptr;
+    int32 maxwd = 512;
+    int32 nwd;
 
+    wptr = (char **)ckd_calloc(maxwd, sizeof(*wptr));
+    for (li = lineiter_start(fp); li; li = lineiter_next(li)) {
+        if (0 == strncmp(li->buf, "##", 2)
+            || 0 == strncmp(li->buf, ";;", 2))
+            continue;
+        if ((nwd = str2words(li->buf, wptr, maxwd)) < 0) {
+            nwd = str2words(li->buf, NULL, 0);
+            maxwd = nwd;
+            wptr = (char **)ckd_realloc(
+                wptr, maxwd * sizeof(*wptr));
+            nwd = str2words(li->buf, wptr, maxwd);
+        }
+        if (nwd < 2)
+            continue;
+        ++*word_count;
+        *word_bytes += strlen(wptr[0]) + 1;
+        *phone_count += nwd - 1;
+    }
+    ckd_free(wptr);
+    fseek(fp, 0L, SEEK_SET);
+    return 0;
+}
+#endif
