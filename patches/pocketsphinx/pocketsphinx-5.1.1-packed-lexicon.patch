+
+static int
+dict_pointer_in_arena(const void *pointer, const void *arena, size_t bytes)
+{
+    uintptr_t at = (uintptr_t)pointer;
+    uintptr_t begin = (uintptr_t)arena;
+    return arena != NULL && pointer != NULL
+        && at >= begin && at - begin < bytes;
+}
+
+static char *
+dict_alloc_word(dict_t *d, const char *word)
+{
+    size_t bytes = strlen(word) + 1;
+    if (bytes <= d->word_arena_bytes - d->word_arena_used) {
+        char *copy = d->word_arena + d->word_arena_used;
+        memcpy(copy, word, bytes);
+        d->word_arena_used += bytes;
+        return copy;
+    }
+    return ckd_salloc(word);
+}
+
+static s3cipid_t *
+dict_alloc_phones(dict_t *d, const s3cipid_t *phones, size_t count)
+{
+    s3cipid_t *copy;
+    if (count <= d->phone_arena_count - d->phone_arena_used) {
+        copy = d->phone_arena + d->phone_arena_used;
+        d->phone_arena_used += count;
+    }
+    else {
+        copy = (s3cipid_t *)ckd_malloc(count * sizeof(*copy));
+    }
+    memcpy(copy, phones, count * sizeof(*copy));
+    return copy;
+}
+#endif
