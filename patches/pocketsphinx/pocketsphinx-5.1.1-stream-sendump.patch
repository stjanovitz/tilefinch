+#ifdef TILEFINCH_STREAM_SENDUMP
+static uint8 *
+tilefinch_ptm_mixw_row(ptm_mgau_t *s, int feat, int density)
+{
+    uint32 now;
+    size_t key;
+    uint16 slot;
+    int victim = 0;
+    uint8 *row;
+
+    if (s->sendump_stream == NULL)
+        return s->mixw[feat][density];
+    key = (size_t)feat * s->sendump_n_density + density;
+    slot = s->sendump_cache_slot[key];
+    now = ++s->sendump_cache_clock;
+    if (now == 0) {
+        int at;
+        for (at = 0; at < (int)s->sendump_cache_rows; ++at)
+            s->sendump_cache_age[at] =
+                (s->sendump_cache_age[at] >> 1)
+                | (s->sendump_cache_age[at] != 0);
+        now = s->sendump_cache_clock = UINT32_C(0x80000000);
+    }
+    if (slot != UINT16_MAX) {
+        s->sendump_cache_age[slot] = now;
+        ++s->sendump_cache_hits;
+        return s->mixw[feat][density];
+    }
+    for (slot = 0; slot < s->sendump_cache_rows; ++slot) {
+        if (s->sendump_cache_age[slot] == 0) {
+            victim = slot;
+            break;
+        }
+        if (s->sendump_cache_age[slot]
+            < s->sendump_cache_age[victim])
+            victim = slot;
+    }
+    if (s->sendump_cache_age[victim] != 0) {
+        size_t old_key =
+            (size_t)s->sendump_cache_feat[victim]
+                * s->sendump_n_density
+            + s->sendump_cache_density[victim];
+        s->sendump_cache_slot[old_key] = UINT16_MAX;
+        s->mixw[s->sendump_cache_feat[victim]]
+               [s->sendump_cache_density[victim]] = NULL;
+    }
+    row = s->sendump_cache_data
+        + (size_t)victim * s->sendump_row_bytes;
+    if (fseek(s->sendump_stream,
+              s->sendump_data_offset
+                  + (long)key * s->sendump_row_bytes,
+              SEEK_SET) != 0
+        || fread(row, 1, s->sendump_row_bytes, s->sendump_stream)
+           != (size_t)s->sendump_row_bytes) {
+        E_ERROR("Fixed sendump row read failed at feature %d density %d\n",
+                feat, density);
+        memset(row, 0xff, s->sendump_row_bytes);
+        s->sendump_cache_failed = TRUE;
+    }
+    s->sendump_cache_feat[victim] = feat;
+    s->sendump_cache_density[victim] = density;
+    s->sendump_cache_age[victim] = now;
+    s->sendump_cache_slot[key] = (uint16)victim;
+    s->mixw[feat][density] = row;
+    ++s->sendump_cache_misses;
+    return row;
+}
