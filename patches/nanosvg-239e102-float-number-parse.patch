+
+static const float nsvg__pow10f[11] = {
+	1e0f, 1e1f, 1e2f, 1e3f, 1e4f, 1e5f, 1e6f, 1e7f, 1e8f, 1e9f, 1e10f
+};
+static const double nsvg__pow10d[23] = {
+	1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
+	1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
+};
+
+// The value of a number nsvg__atofDouble reads, as the float it rounds to,
+// without its pow() calls. The digits (at most 18) form one integer m, the
+// number being m * 10^d. With m < 2^24 and -10 <= d <= 0 both operands are
+// exact floats and one float division rounds correctly; with m < 2^53,
+// -10 <= d <= 22 and a magnitude under 4096, one double operation does and
+// the float conversion follows. In both cases no float halfway point lies
+// within 2^-47 (relative) of such a decimal, far outside the general
+// conversion's few-ulp double error, so both give the same float. Anything
+// else (more digits, larger exponents, magnitudes past 4096 where a short
+// decimal can be an exact halfway point) takes nsvg__atofDouble.
+static float nsvg__atof(const char* s)
+{
+	const char* cur = s;
+	unsigned long long m = 0;
+	int digits = 0, fraction = 0, exponent = 0, negative = 0;
+
+	if (*cur == '+') {
+		cur++;
+	} else if (*cur == '-') {
+		negative = 1;
+		cur++;
+	}
+	while (nsvg__isdigit(*cur)) {
+		if (++digits > 18) return (float)nsvg__atofDouble(s);
+		m = m * 10 + (unsigned)(*cur++ - '0');
+	}
+	if (*cur == '.') {
+		cur++;
+		while (nsvg__isdigit(*cur)) {
+			if (++digits > 18) return (float)nsvg__atofDouble(s);
+			m = m * 10 + (unsigned)(*cur++ - '0');
+			fraction++;
+		}
+	}
+	// A valid number should have integer or fractional part.
+	if (digits == 0) return 0.0f;
+	if (*cur == 'e' || *cur == 'E') {
+		const char* e = cur + 1;
+		int expNegative = 0, expDigits = 0;
+		if (*e == '+' || *e == '-') expNegative = *e++ == '-';
+		// strtol's whitespace, overflow and empty-digit handling: leave it
+		// to the general conversion.
+		if (!nsvg__isdigit(*e)) return (float)nsvg__atofDouble(s);
+		while (nsvg__isdigit(*e)) {
+			if (++expDigits > 3) return (float)nsvg__atofDouble(s);
+			exponent = exponent * 10 + (*e++ - '0');
+		}
+		if (expNegative) exponent = -exponent;
+	}
+	exponent -= fraction;
+	if (m < (1ull << 24) && exponent >= -10 && exponent <= 0) {
+		float value = (float)m / nsvg__pow10f[-exponent];
+		return negative ? -value : value;
+	}
+	if (m < (1ull << 53) && exponent >= -10 && exponent <= 22) {
+		double value = exponent < 0 ? (double)m / nsvg__pow10d[-exponent]
+			: (double)m * nsvg__pow10d[exponent];
+		if (value < 4096.0)
+			return (float)(negative ? -value : value);
+	}
+	return (float)nsvg__atofDouble(s);
 }
 
 
