+
+/* Tilefinch: the generated entity table has 9,854 entries and values of
+ * at most six UTF-8 bytes. Narrow its indices, not its accepted entities.
+ * Natural pointer alignment keeps records 12 bytes on PSP, 16 on hosts. */
+#define LXB_HTML_COMPACT_ENTITIES 1
+typedef struct {
+    lxb_char_t key;
+    uint8_t value_len;
+    uint16_t left;
+    uint16_t right;
+    uint16_t next;
+    void *value;
+} lxb_html_entity_entry_t;
+
+lxb_inline const lxb_html_entity_entry_t *
+lxb_html_entity_find(const lxb_html_entity_entry_t *table,
+                     const lxb_html_entity_entry_t *entry, lxb_char_t key)
+{
+    while (entry != table) {
+        if (entry->key == key) return entry;
+        entry = &table[key > entry->key ? entry->right : entry->left];
+    }
+    return NULL;
+}
 
