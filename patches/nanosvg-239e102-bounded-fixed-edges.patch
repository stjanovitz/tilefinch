+static int nsvg__fixedLimit(const NSVGrasterizer* r)
+{
+	double viewport = ((double)r->width + 2.0) * (double)NSVG__FIX;
+	double ceiling = (double)INT_MAX / 4.0;
+	return (int)(viewport < ceiling ? viewport : ceiling);
+}
+
+static int nsvg__boundedFixed(float value, int limit)
+{
+	float rounded;
+	if (!isfinite(value)) return 0;
+	rounded = nsvg__roundf(value);
+	if (rounded > (float)limit) return limit;
+	if (rounded < (float)-limit) return -limit;
+	return (int)rounded;
+}
