Preserve NanoSVG array ownership and capacity when realloc is refused.

A refused point growth previously installed NULL with the new capacity;
the next point wrote through NULL. The decoder's Budget hook records any
refused allocation and declines the partial parse/raster at its boundary.

--- a/src/nanosvg.h
+++ b/src/nanosvg.h
@@ -734,5 +734,7 @@
 	if (p->npts+1 > p->cpts) {
-		p->cpts = p->cpts ? p->cpts*2 : 8;
-		p->pts = (float*)realloc(p->pts, p->cpts*2*sizeof(float));
-		if (!p->pts) return;
+		int capacity = p->cpts ? p->cpts*2 : 8;
+		float* points = (float*)realloc(p->pts, capacity*2*sizeof(float));
+		if (!points) return;
+		p->pts = points;
+		p->cpts = capacity;
 	}
@@ -2821,4 +2823,5 @@
-	grad->nstops++;
-	grad->stops = (NSVGgradientStop*)realloc(grad->stops, sizeof(NSVGgradientStop)*grad->nstops);
-	if (grad->stops == NULL) return;
+	NSVGgradientStop* stops = (NSVGgradientStop*)realloc(grad->stops, sizeof(NSVGgradientStop)*(grad->nstops+1));
+	if (stops == NULL) return;
+	grad->stops = stops;
+	grad->nstops++;
 
