+        int set_result = JS_SetPropertyInternal(
+            ctx, arg_buf[3], key_atom, closure, arg_buf[3],
+            JS_PROP_THROW_STRICT);
+        JS_FreeAtom(ctx, key_atom);
+        if (unlikely(set_result < 0))
+            return -1;
+
+#ifdef CONFIG_EXECUTION_PROFILE
+        JSFunctionBytecode *closure_bytecode =
+            JS_VALUE_GET_PTR(owner->cpool[pc[closure_index_offset]]);
+        rt->profile_fclosure_total++;
+        if (closure_bytecode->func_kind < 4)
+            rt->profile_fclosure_kind[closure_bytecode->func_kind]
+                                      [closure_bytecode->has_prototype != 0]++;
+        rt->profile_fclosure_next_opcode[OP_put_array_el]++;
+        if (closure_bytecode->closure_var_count == 0) {
+            rt->profile_fclosure_capture_free++;
+            rt->profile_fclosure_capture_free_next_opcode
+              [OP_put_array_el]++;
+        }
+        if (method_encoding)
+            rt->profile_fused_field_call_method1_hits++;
+        rt->profile_fused_closure_store_hits++;
+        rt->profile_fused_field_call_closure_store_hits++;
+        rt->profile_fused_function_table_entries++;
+#endif
+        pc += entry_size;
+        completed++;
+        if (pc >= end || pc[0] != OP_get_arg3)
+            break;
+        int next_size, next_field_offset, next_closure_offset;
+        BOOL next_method_encoding;
+        if (!js_function_table_entry_layout(
+                pc + 1, end, &next_size, &next_field_offset,
+                &next_closure_offset, &next_method_encoding))
+            break;
+        pc++;
+    }
+    if (completed == 0)
+        return 0;
+    JSObject *table_object = JS_VALUE_GET_OBJ(arg_buf[3]);
+    if (owner->function_table_template == NULL && fresh_call1 &&
+        completed >= 8 &&
+        table_object->shape->prop_count == completed + 1) {
+        JSFunctionTableTemplate *template = js_mallocz_rt(
+            rt, sizeof(*template));
+        if (template != NULL) {
+            template->shape = js_dup_shape(table_object->shape);
+            template->start_pc =
+                (uint32_t)(start_pc - owner->byte_code_buf);
+            template->property_count = completed + 1;
+            if (JS_VALUE_GET_TAG(arg_buf[2]) == JS_TAG_OBJECT) {
+                JSObject *decoder = JS_VALUE_GET_OBJ(arg_buf[2]);
+                JSDecoderCache *cache = decoder->class_id ==
+                        JS_CLASS_BYTECODE_FUNCTION ?
+                    decoder->u.func.decoder_cache : NULL;
+                if (cache != NULL && cache->array != NULL &&
+                    cache->mutation_version ==
+                        cache->array->mutation_version) {
+                    template->decoder_function = decoder;
+                    template->decoder_array = cache->array;
+                    template->decoder_mutation_version =
+                        cache->mutation_version;
+                    JS_DupValue(ctx, JS_MKPTR(JS_TAG_OBJECT, decoder));
+                    JS_DupValue(ctx, JS_MKPTR(
+                        JS_TAG_OBJECT, cache->array));
+                }
+            }
+            owner->function_table_template = template;
+#ifdef CONFIG_EXECUTION_PROFILE
+            rt->profile_function_table_template_builds++;
+#endif
+        }
+    }
+    *pc_ptr = pc;
+    return 1;
+}
+
+/* Fuse `receiver; helper(source.field)` followed by get_array_el2. */
+static force_inline int js_try_decoder_field_array(
+    JSContext *ctx, JSRuntime *rt, JSStackFrame *sf,
+    JSFunctionBytecode *owner,
+    const uint8_t **pc_ptr, const uint8_t *end, JSValue *arg_buf,
+    JSValue **stack_pointer, int receiver_index)
+{
+    const uint8_t *pc = *pc_ptr;
+    if (pc + 16 > end || pc[2] != OP_undefined ||
+        pc[3] != OP_get_arg || pc[6] != OP_get_arg3 ||
+        pc[7] != OP_get_field || pc[12] != OP_call_method ||
+        get_u16(pc + 13) != 1 || pc[15] != OP_get_array_el2)
+        return 0;
+
+    int function_index = get_u16(pc + 4);
+    sf->cur_pc = pc + 16;
+    JSValue field = js_get_field_borrowed(
+        ctx, rt, arg_buf[3], get_u32(pc + 8));
+    if (unlikely(JS_IsException(field)))
+        return -1;
+    JSValue key;
+    JSAtom key_atom;
+    int cached_key = js_try_cached_decoder_atom(
+        ctx, owner,
+        (uint32_t)(pc + 12 - owner->byte_code_buf),
+        arg_buf[function_index], field, &key_atom);
+    if (unlikely(cached_key < 0)) {
+        JS_FreeValue(ctx, field);
+        return -1;
+    }
+    if (cached_key > 0) {
+        key = JS_AtomToValue(ctx, key_atom);
+        JS_FreeAtom(ctx, key_atom);
+    } else {
+        key = JS_CallInternal(ctx, arg_buf[function_index], JS_UNDEFINED,
+                              JS_UNDEFINED, 1, &field, 0);
+    }
+    JS_FreeValue(ctx, field);
+    if (unlikely(JS_IsException(key)))
+        return -1;
+
+    JSValue receiver = JS_DupValue(ctx, arg_buf[receiver_index]);
+    JSValue value = js_get_array_element_keep_traced(
+        ctx, receiver, key, pc + 16, end);
+    if (unlikely(JS_IsException(value))) {
+        JS_FreeValue(ctx, receiver);
+        return -1;
+    }
+    JSValue *sp = *stack_pointer;
+    *sp++ = receiver;
+    *sp++ = value;
+    *stack_pointer = sp;
+    *pc_ptr = pc + 16;
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_fused_field_call_method1_hits++;
+    rt->profile_fused_field_call_method1_array_hits++;
+    rt->profile_fused_decoder_field_array_hits++;
+#endif
+    return 1;
+}
+
+static force_inline int js_try_arg_array_store(
+    JSContext *ctx, JSRuntime *rt, JSStackFrame *sf,
+    const uint8_t **pc_ptr, const uint8_t *end, JSValue *arg_buf,
+    int receiver_index)
+{
+    const uint8_t *pc = *pc_ptr;
+    if (pc + 9 > end || pc[2] != OP_get_arg ||
+        pc[5] != OP_get_array_el || pc[6] != OP_put_arg)
+        return 0;
+    int property_index = get_u16(pc + 3);
+    int destination_index = get_u16(pc + 7);
+    sf->cur_pc = pc + 9;
+    JSValueConst receiver = arg_buf[receiver_index];
+    JSValueConst property = arg_buf[property_index];
+    JSValue value;
+    if (likely(JS_VALUE_GET_TAG(receiver) == JS_TAG_OBJECT &&
+               JS_VALUE_GET_TAG(property) == JS_TAG_INT)) {
+        JSObject *array = JS_VALUE_GET_OBJ(receiver);
+        uint32_t index = JS_VALUE_GET_INT(property);
+        if (likely(array->class_id == JS_CLASS_ARRAY &&
+                   index < array->u.array.count)) {
+            value = JS_DupValue(ctx, array->u.array.u.values[index]);
+        } else if (array->class_id == JS_CLASS_UINT8_ARRAY &&
+                   index < array->u.array.count) {
+            value = JS_NewInt32(ctx, array->u.array.u.uint8_ptr[index]);
+        } else {
+            value = JS_GetPropertyValue(
+                ctx, JS_DupValue(ctx, receiver),
+                JS_DupValue(ctx, property));
+            JS_FreeValue(ctx, receiver);
+        }
+    } else {
+        value = JS_GetPropertyValue(ctx, JS_DupValue(ctx, receiver),
+                                    JS_DupValue(ctx, property));
+        JS_FreeValue(ctx, receiver);
+    }
+    if (unlikely(JS_IsException(value)))
+        return -1;
+    set_value(ctx, &arg_buf[destination_index], value);
+    *pc_ptr = pc + 9;
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_fused_arg_array_store_hits++;
+#else
+    (void)rt;
+#endif
+    return 1;
+}
+
+static BOOL js_vm_speculative_enabled(void)
+{
+    /* Speculative pattern-matched execution (tiny calls, fused methods,
+       arithmetic regions) verifies opcodes only at sparse offsets and can
+       mis-execute foreign bytecode that happens to alias a fingerprint.
+       Opt in explicitly for profiled fixture workloads. */
+    static int speculative_enabled = -1;
+    if (speculative_enabled < 0) {
+        const char *value = getenv("TILEFINCH_VM_SPECULATIVE");
+        speculative_enabled = value != NULL && value[0] != '\0'
+            && value[0] != '0';
+    }
+    return speculative_enabled;
+}
+
+static BOOL js_try_tiny_bytecode_call(JSContext *ctx,
+                                      JSFunctionBytecode *bytecode,
+                                      int argc, JSValue *argv,
+                                      JSValue *result)
+{
+    if (!js_vm_speculative_enabled())
+        return FALSE;
+    if (likely(bytecode->byte_code_len == 4 && argc >= 2 &&
+               bytecode->byte_code_buf[3] == OP_return &&
+               ((bytecode->byte_code_buf[0] == OP_get_arg0 &&
+                 bytecode->byte_code_buf[1] == OP_get_arg1) ||
+                (bytecode->byte_code_buf[0] == OP_get_arg1 &&
+                 bytecode->byte_code_buf[1] == OP_get_arg0)) &&
+               (bytecode->byte_code_buf[2] == OP_strict_eq ||
+                bytecode->byte_code_buf[2] == OP_strict_neq))) {
+        BOOL equal = js_strict_eq(ctx, argv[0], argv[1]);
+        *result = JS_NewBool(
+            ctx, bytecode->byte_code_buf[2] == OP_strict_eq ? equal : !equal);
+        return TRUE;
+    }
+
+    if (likely(bytecode->byte_code_len == 4 && argc >= 2 &&
+               bytecode->byte_code_buf[3] == OP_return &&
+               ((bytecode->byte_code_buf[0] == OP_get_arg0 &&
+                 bytecode->byte_code_buf[1] == OP_get_arg1) ||
+                (bytecode->byte_code_buf[0] == OP_get_arg1 &&
+                 bytecode->byte_code_buf[1] == OP_get_arg0)) &&
+               JS_VALUE_GET_TAG(argv[0]) == JS_TAG_INT &&
+               JS_VALUE_GET_TAG(argv[1]) == JS_TAG_INT)) {
+        int32_t left = JS_VALUE_GET_INT(argv[0]);
+        int32_t right = JS_VALUE_GET_INT(argv[1]);
+        if (bytecode->byte_code_buf[0] == OP_get_arg1) {
+            int32_t temporary = left;
+            left = right;
+            right = temporary;
+        }
+        switch (bytecode->byte_code_buf[2]) {
+        case OP_xor:
+            *result = JS_NewInt32(ctx, left ^ right);
+            return TRUE;
+        case OP_and:
+            *result = JS_NewInt32(ctx, left & right);
+            return TRUE;
+        case OP_or:
+            *result = JS_NewInt32(ctx, left | right);
+            return TRUE;
+        case OP_add:
+            *result = JS_NewInt64(ctx, (int64_t)left + right);
+            return TRUE;
+        case OP_sub:
+            *result = JS_NewInt64(ctx, (int64_t)left - right);
+            return TRUE;
+        case OP_mul:
+            *result = JS_NewInt64(ctx, (int64_t)left * right);
+            return TRUE;
+        case OP_mod:
+            if (right != 0) {
+                *result = JS_NewInt32(
+                    ctx, left == INT32_MIN && right == -1 ? 0 : left % right);
+                return TRUE;
+            }
+            return FALSE;
+        case OP_shl:
+            *result = JS_NewInt32(
+                ctx, (int32_t)((uint32_t)left << ((uint32_t)right & 31)));
+            return TRUE;
+        case OP_sar:
+            *result = JS_NewInt32(ctx, left >> ((uint32_t)right & 31));
+            return TRUE;
+        case OP_shr:
+            *result = JS_NewUint32(
+                ctx, (uint32_t)left >> ((uint32_t)right & 31));
+            return TRUE;
+        case OP_lt:
+            *result = JS_NewBool(ctx, left < right);
+            return TRUE;
+        case OP_lte:
+            *result = JS_NewBool(ctx, left <= right);
+            return TRUE;
+        case OP_gt:
+            *result = JS_NewBool(ctx, left > right);
+            return TRUE;
+        case OP_gte:
+            *result = JS_NewBool(ctx, left >= right);
+            return TRUE;
+        default:
+            return FALSE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL js_try_fused_tiny_method(JSContext *ctx, JSRuntime *rt,
+                                     const uint8_t **pc_ptr,
+                                     const uint8_t *end,
+                                     JSValue *stack_base,
+                                     JSValue **stack_pointer,
+                                     BOOL from_arg_batch)
+{
+    BOOL fused_any = FALSE;
+    if (!js_vm_speculative_enabled())
+        return FALSE;
+    for (int depth = 0; depth < 8; depth++) {
+        const uint8_t *pc = *pc_ptr;
+        JSValue *sp = *stack_pointer;
+        if (pc + 3 > end || pc[0] != OP_call_method)
+            break;
+        int call_argc = get_u16(pc + 1);
+        if (call_argc < 2 || sp - stack_base < call_argc + 2)
+            break;
+
+        JSValue *call_argv = sp - call_argc;
+        if (JS_VALUE_GET_TAG(call_argv[-1]) != JS_TAG_OBJECT)
+            break;
+        JSObject *method = JS_VALUE_GET_OBJ(call_argv[-1]);
+        if (method->class_id != JS_CLASS_BYTECODE_FUNCTION)
+            break;
+        JSFunctionBytecode *method_bytecode =
+            method->u.func.function_bytecode;
+        JSValue result;
+        if (!js_try_tiny_bytecode_call(ctx, method_bytecode, call_argc,
+                                       call_argv, &result))
+            break;
+
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_bytecode_calls++;
+        method_bytecode->profile_calls++;
+        rt->profile_tiny_hits++;
+        rt->profile_direct_tiny_method_hits++;
+        if (from_arg_batch && !fused_any)
+            rt->profile_fused_arg_tiny_method_hits++;
+        else
+            rt->profile_fused_value_tiny_method_hits++;
+#endif
+        for (int i = -2; i < call_argc; i++)
+            JS_FreeValue(ctx, call_argv[i]);
+        sp = call_argv - 2;
+        *sp++ = result;
+        *stack_pointer = sp;
+        *pc_ptr = pc + 3;
+        fused_any = TRUE;
+    }
+    return fused_any;
+}
+
+static JSDecoderCache *js_decoder_cache_prepare(
+    JSContext *ctx, JSObject *function, JSObject *array)
+{
+    if (array->mutation_version == UINT32_MAX)
+        return NULL;
+    JSDecoderCache *cache = function->u.func.decoder_cache;
+    if (cache == NULL) {
+        cache = js_mallocz_rt(ctx->rt, sizeof(*cache));
+        if (cache == NULL)
+            return NULL;
+        function->u.func.decoder_cache = cache;
+    }
+    if (cache->array != array ||
+        cache->mutation_version != array->mutation_version) {
+        if (cache->array != NULL)
+            JS_FreeValue(ctx, JS_MKPTR(JS_TAG_OBJECT, cache->array));
+        for (int slot = 0; slot < JS_DECODER_CACHE_CAPACITY; slot++) {
+            if (cache->entries[slot].valid) {
+                JS_FreeValue(ctx, cache->entries[slot].value);
+                cache->entries[slot].valid = FALSE;
+            }
+        }
+        cache->array = array;
+        JS_DupValue(ctx, JS_MKPTR(JS_TAG_OBJECT, array));
+        cache->mutation_version = array->mutation_version;
+#ifdef CONFIG_EXECUTION_PROFILE
+        ctx->rt->profile_decoder_cache_resets++;
+#endif
+    }
+    return cache;
+}
+
+static BOOL js_decoder_cache_lookup(JSContext *ctx, JSDecoderCache *cache,
+                                    int32_t index, JSValue *result)
+{
+    if (cache == NULL)
+        return FALSE;
+    unsigned int slot = (uint32_t)index * UINT32_C(2654435761) &
+                        (JS_DECODER_CACHE_CAPACITY - 1);
+    JSDecoderCacheEntry *entry = &cache->entries[slot];
+    if (!entry->valid || entry->index != index) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        ctx->rt->profile_decoder_cache_misses++;
+#endif
+        return FALSE;
+    }
+    *result = JS_DupValue(ctx, entry->value);
+#ifdef CONFIG_EXECUTION_PROFILE
+    ctx->rt->profile_decoder_cache_hits++;
+#endif
+    return TRUE;
+}
+
+static void js_decoder_cache_store(JSContext *ctx, JSDecoderCache *cache,
+                                   int32_t index, JSValueConst value)
+{
+    if (cache == NULL)
+        return;
+    unsigned int slot = (uint32_t)index * UINT32_C(2654435761) &
+                        (JS_DECODER_CACHE_CAPACITY - 1);
+    JSDecoderCacheEntry *entry = &cache->entries[slot];
+    if (entry->valid)
+        JS_FreeValue(ctx, entry->value);
+    entry->index = index;
+    entry->value = JS_DupValue(ctx, value);
+    entry->valid = TRUE;
+}
+
+static BOOL js_check_decoder_bytecode(JSFunctionBytecode *bytecode)
+{
+    if (bytecode->decoder_checked)
+        return bytecode->decoder_safe;
+    int constant_size = bytecode->byte_code_len >= 3 &&
+                        bytecode->byte_code_buf[1] == OP_push_i8 ? 2 :
+                        bytecode->byte_code_len >= 4 &&
+                        bytecode->byte_code_buf[1] == OP_push_i16 ? 3 : 0;
+    int tail = 1 + constant_size;
+    int after_call = 0;
+    if (constant_size != 0 && bytecode->byte_code_len >= tail + 9 &&
+        bytecode->byte_code_buf[tail + 2] == OP_get_var_ref0 &&
+        bytecode->byte_code_buf[tail + 3] == OP_call0) {
+        after_call = tail + 4;
+    } else if (constant_size != 0 &&
+               bytecode->byte_code_len >= tail + 12 &&
+               bytecode->byte_code_buf[tail + 2] == OP_undefined &&
+               bytecode->byte_code_buf[tail + 3] == OP_get_var_ref0 &&
+               bytecode->byte_code_buf[tail + 4] == OP_call_method &&
+               get_u16(bytecode->byte_code_buf + tail + 5) == 0) {
+        after_call = tail + 7;
+    }
+    BOOL safe = bytecode->arg_count == 4 &&
+        bytecode->closure_var_count >= 1 && constant_size != 0 &&
+        after_call != 0 && bytecode->byte_code_len == after_call + 5 &&
+        bytecode->byte_code_buf[0] == OP_get_arg0 &&
+        bytecode->byte_code_buf[tail] == OP_sub &&
+        bytecode->byte_code_buf[tail + 1] == OP_put_arg0 &&
+        bytecode->byte_code_buf[after_call] == OP_set_arg2 &&
+        bytecode->byte_code_buf[after_call + 1] == OP_get_arg0 &&
+        bytecode->byte_code_buf[after_call + 2] == OP_get_array_el &&
+        bytecode->byte_code_buf[after_call + 3] == OP_set_arg3 &&
+        bytecode->byte_code_buf[after_call + 4] == OP_return;
+    if (safe) {
+        bytecode->decoder_decrement = constant_size == 2 ?
+            (int8_t)bytecode->byte_code_buf[2] :
+            (int16_t)get_u16(bytecode->byte_code_buf + 2);
+    }
+    bytecode->decoder_safe = safe;
+    bytecode->decoder_checked = TRUE;
+    return safe;
+}
+
+/* Directly execute the exact capture-getter decoder shape used by generated
+   string/operation tables. The bytecode proof is cached; runtime guards cover
+   closure topology, argument type, array identity, bounds, and mutation. */
+static BOOL js_try_decoder_fast_call(JSContext *ctx, JSValueConst function,
+                                     JSValueConst argument, JSValue *result,
+                                     BOOL poll_interrupts,
+                                     BOOL account_bytecode_call)
+{
+    if (JS_VALUE_GET_TAG(function) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(argument) != JS_TAG_INT)
+        return FALSE;
+    JSObject *function_object = JS_VALUE_GET_OBJ(function);
+    if (function_object->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return FALSE;
+    JSFunctionBytecode *bytecode = function_object->u.func.function_bytecode;
+    if (!js_check_decoder_bytecode(bytecode))
+        return FALSE;
+
+    JSValueConst getter = *function_object->u.func.var_refs[0]->pvalue;
+    if (JS_VALUE_GET_TAG(getter) != JS_TAG_OBJECT)
+        return FALSE;
+    JSObject *getter_object = JS_VALUE_GET_OBJ(getter);
+    if (getter_object->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return FALSE;
+    JSFunctionBytecode *getter_bytecode =
+        getter_object->u.func.function_bytecode;
+    if (getter_bytecode->byte_code_len != 2 ||
+        getter_bytecode->closure_var_count < 1 ||
+        getter_bytecode->byte_code_buf[0] != OP_get_var_ref0 ||
+        getter_bytecode->byte_code_buf[1] != OP_return)
+        return FALSE;
+    JSValueConst array = *getter_object->u.func.var_refs[0]->pvalue;
+    if (JS_VALUE_GET_TAG(array) != JS_TAG_OBJECT)
+        return FALSE;
+    JSObject *array_object = JS_VALUE_GET_OBJ(array);
+    if (array_object->class_id != JS_CLASS_ARRAY ||
+        !array_object->fast_array)
+        return FALSE;
+
+    int64_t stepped =
+        (int64_t)JS_VALUE_GET_INT(argument) - bytecode->decoder_decrement;
+    if (stepped < 0 || (uint64_t)stepped >= array_object->u.array.count)
+        return FALSE;
+    if (poll_interrupts && unlikely(js_profile_poll_interrupts(
+            ctx, JS_PROFILE_POLL_CALL_ENTRY))) {
+        *result = JS_EXCEPTION;
+        return TRUE;
+    }
+
+    JSDecoderCache *cache = js_decoder_cache_prepare(
+        ctx, function_object, array_object);
+    if (!js_decoder_cache_lookup(
+            ctx, cache, (int32_t)stepped, result)) {
+        *result = JS_DupValue(
+            ctx, array_object->u.array.u.values[(uint32_t)stepped]);
+        js_decoder_cache_store(ctx, cache, (int32_t)stepped, *result);
+    }
+#ifdef CONFIG_EXECUTION_PROFILE
+    if (account_bytecode_call) {
+        ctx->rt->profile_bytecode_calls++;
+        bytecode->profile_calls++;
+    }
+    ctx->rt->profile_trace_hits++;
+    ctx->rt->profile_direct_property_hits++;
+#endif
+    return TRUE;
+}
+
+/* Cache a decoder result as an atom at the consuming bytecode site.  This is
+   stronger than the decoder's index/value cache: property operations can use
+   the atom directly and avoid reconstructing a JS string on every VM step. */
+static int js_try_cached_decoder_atom(
+    JSContext *ctx, JSFunctionBytecode *owner, uint32_t site_pc,
+    JSValueConst function, JSValueConst argument, JSAtom *result)
+{
+    if (JS_VALUE_GET_TAG(function) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(argument) != JS_TAG_INT)
+        return 0;
+    JSObject *decoder = JS_VALUE_GET_OBJ(function);
+    if (decoder->class_id != JS_CLASS_BYTECODE_FUNCTION ||
+        !js_check_decoder_bytecode(decoder->u.func.function_bytecode))
+        return 0;
+    JSDecoderCache *decoder_cache = decoder->u.func.decoder_cache;
+    JSDecodedKeyCacheEntry *entry = NULL;
+    if (owner->decoded_key_cache != NULL) {
+        unsigned int slot = site_pc * UINT32_C(2654435761) &
+            (JS_DECODED_KEY_CACHE_CAPACITY - 1);
+        for (unsigned int probe = 0;
+             probe < JS_DECODED_KEY_CACHE_CAPACITY; probe++) {
+            JSDecodedKeyCacheEntry *candidate =
+                &owner->decoded_key_cache->entries[
+                    (slot + probe) & (JS_DECODED_KEY_CACHE_CAPACITY - 1)];
+            if (!candidate->valid || candidate->site_pc == site_pc) {
+                entry = candidate;
+                break;
+            }
+        }
+    }
+    if (entry != NULL && entry->valid && entry->decoder == decoder &&
+        decoder_cache != NULL && entry->array == decoder_cache->array &&
+        entry->mutation_version == decoder_cache->mutation_version &&
+        entry->array->mutation_version == entry->mutation_version &&
+        entry->mutation_version != UINT32_MAX) {
+        if (unlikely(js_profile_poll_interrupts(
+                ctx, JS_PROFILE_POLL_CALL_ENTRY)))
+            return -1;
+        *result = JS_DupAtom(ctx, entry->atom);
+#ifdef CONFIG_EXECUTION_PROFILE
+        JSRuntime *rt = ctx->rt;
+        JSFunctionBytecode *decoder_bytecode =
+            decoder->u.func.function_bytecode;
+        rt->profile_bytecode_calls++;
+        decoder_bytecode->profile_calls++;
+        rt->profile_trace_hits++;
+        rt->profile_direct_property_hits++;
+        rt->profile_decoder_cache_hits++;
+        rt->profile_decoded_key_cache_hits++;
+#endif
+        return 1;
+    }
+
+    JSValue decoded;
+    if (!js_try_decoder_fast_call(
+            ctx, function, argument, &decoded, TRUE, TRUE))
+        return 0;
+    if (JS_IsException(decoded))
+        return -1;
+    JSAtom atom = JS_ValueToAtom(ctx, decoded);
+    JS_FreeValue(ctx, decoded);
+    if (atom == JS_ATOM_NULL)
+        return -1;
+#ifdef CONFIG_EXECUTION_PROFILE
+    ctx->rt->profile_decoded_key_cache_misses++;
+#endif
+    decoder_cache = decoder->u.func.decoder_cache;
+    if (decoder_cache != NULL && decoder_cache->array != NULL &&
+        decoder_cache->mutation_version != UINT32_MAX &&
+        decoder_cache->array->mutation_version ==
+            decoder_cache->mutation_version) {
+        if (owner->decoded_key_cache == NULL) {
+            owner->decoded_key_cache = js_mallocz(
+                ctx, sizeof(*owner->decoded_key_cache));
+        }
+        if (owner->decoded_key_cache != NULL) {
+            unsigned int slot = site_pc * UINT32_C(2654435761) &
+                (JS_DECODED_KEY_CACHE_CAPACITY - 1);
+            entry = NULL;
+            for (unsigned int probe = 0;
+                 probe < JS_DECODED_KEY_CACHE_CAPACITY; probe++) {
+                JSDecodedKeyCacheEntry *candidate =
+                    &owner->decoded_key_cache->entries[
+                        (slot + probe) &
+                        (JS_DECODED_KEY_CACHE_CAPACITY - 1)];
+                if (!candidate->valid || candidate->site_pc == site_pc) {
+                    entry = candidate;
+                    break;
+                }
+            }
+            if (entry != NULL) {
+                if (entry->valid) {
+                    JS_FreeValue(ctx, JS_MKPTR(
+                        JS_TAG_OBJECT, entry->decoder));
+                    JS_FreeValue(ctx, JS_MKPTR(
+                        JS_TAG_OBJECT, entry->array));
+                    JS_FreeAtom(ctx, entry->atom);
+                }
+                entry->site_pc = site_pc;
+                entry->decoder = decoder;
+                entry->array = decoder_cache->array;
+                entry->mutation_version =
+                    decoder_cache->mutation_version;
+                entry->atom = JS_DupAtom(ctx, atom);
+                entry->valid = TRUE;
+                JS_DupValue(ctx, JS_MKPTR(JS_TAG_OBJECT, decoder));
+                JS_DupValue(ctx, JS_MKPTR(
+                    JS_TAG_OBJECT, decoder_cache->array));
+            }
+        }
+    }
+    *result = atom;
+    return 1;
+}
