+        {254,OP_get_array_el2},{265,OP_get_arg},{271,OP_post_inc},
+        {272,OP_put_arg},{275,OP_get_array_el},{276,OP_push_6},
+        {277,OP_call_method},{280,OP_push_i16},{283,OP_call_method},
+        {286,OP_push_i16},{289,OP_and},{290,OP_xor},
+        {291,OP_put_arg},{294,OP_push_i8},{296,OP_get_arg},
+        {299,OP_and},{300,OP_put_arg},{303,OP_get_arg2},
+        {312,OP_get_array_el2},{313,OP_get_arg},{316,OP_push_i16},
+        {319,OP_call_method},{322,OP_if_false8},
+        {324,OP_push_7},{325,OP_put_arg},{328,OP_get_arg},
+        {331,OP_push_i8},{333,OP_gte},{334,OP_if_false8},
+        {346,OP_get_var},{349,OP_call_method},{352,OP_throw},
+        {353,OP_get_arg},{364,OP_call1},{365,OP_get_array_el2},
+        {376,OP_get_arg},{382,OP_post_inc},{383,OP_put_arg},
+        {386,OP_get_array_el},{387,OP_push_6},
+        {388,OP_call_method},{391,OP_push_i16},{394,OP_add},
+        {395,OP_push_i16},{398,OP_call_method},{401,OP_xor},
+        {402,OP_put_arg},{405,OP_get_arg},{416,OP_call1},
+        {417,OP_get_array_el2},{418,OP_get_arg},
+        {421,OP_push_const8},{423,OP_and},{424,OP_get_arg},
+        {427,OP_call_method},{430,OP_or},{431,OP_put_arg},
+        {434,OP_get_arg},{437,OP_push_7},{438,OP_add},
+        {439,OP_put_arg},{442,OP_get_arg},{445,OP_push_const8},
+        {447,OP_and},{448,OP_if_true8},
+        {450,OP_get_arg},{461,OP_call1},{462,OP_get_array_el2},
+        {473,OP_get_arg},{479,OP_post_inc},{480,OP_put_arg},
+        {483,OP_get_array_el},{484,OP_push_6},
+        {485,OP_call_method},{488,OP_push_i16},{491,OP_add},
+        {492,OP_push_const8},{494,OP_and},{495,OP_push_i8},
+        {497,OP_call_method},{500,OP_xor},{501,OP_put_arg},
+        {504,OP_get_arg3},{505,OP_get_arg},{508,OP_get_arg},
+        {511,OP_put_array_el},{512,OP_get_arg3},{513,OP_get_arg},
+        {516,OP_get_arg},{519,OP_xor},{520,OP_get_arg},
+        {523,OP_get_arg},{526,OP_get_array_el},{527,OP_get_field},
+        {532,OP_put_array_el},{533,OP_return_undef},
+    };
+    const uint8_t *code = bytecode->byte_code_buf;
+    for (unsigned int index = 0; index < countof(checks); index++)
+        if (code[checks[index].offset] != checks[index].opcode)
+            return FALSE;
+    if (get_i8(code + 295) != 127 || get_i16(code + 317) != 128 ||
+        get_i8(code + 332) != 21 || get_i16(code + 281) != 256 ||
+        get_i16(code + 287) != 255 || get_i16(code + 392) != 256 ||
+        get_i16(code + 396) != 255 || get_i16(code + 489) != 256 ||
+        get_i8(code + 496) != 84)
+        return FALSE;
+    const int expected[3] = {127,128,255};
+    const int offsets[3] = {422,446,493};
+    for (int index = 0; index < 3; index++) {
+        uint32_t constant_index = code[offsets[index]];
+        int32_t value;
+        if (constant_index >= (uint32_t)bytecode->cpool_count ||
+            JS_ToInt32(ctx, &value, bytecode->cpool[constant_index]) ||
+            value != expected[index])
+            return FALSE;
+    }
+    bytecode->varint_safe = TRUE;
+    return TRUE;
+}
