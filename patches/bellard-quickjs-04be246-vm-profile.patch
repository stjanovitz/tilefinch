+static force_inline void js_learn_arg_switch_target(
+    JSRuntime *rt, JSStackFrame *sf, JSFunctionBytecode *bytecode,
+    BOOL condition_true, const uint8_t *fallthrough_pc)
+{
+    if (!sf->arg_switch_pending)
+        return;
+    if (sf->arg_switch_branches != UINT16_MAX)
+        sf->arg_switch_branches++;
+    if (!condition_true) {
+        if (sf->arg_switch_branches >= 255)
+            sf->arg_switch_pending = FALSE;
+        return;
+    }
+    JSArgSwitchCache *cache = bytecode->arg_switch_cache;
+    int32_t selector = sf->arg_switch_selector;
+    if (cache != NULL && cache->start_pc == sf->arg_switch_start_pc &&
+        (uint32_t)selector < 256) {
+        cache->valid[selector] = TRUE;
+        cache->targets[selector] =
+            (uint32_t)(fallthrough_pc - bytecode->byte_code_buf);
+        cache->costs[selector] = min_int(
+            sf->arg_switch_branches, UINT8_MAX);
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_arg_switch_cache_learns++;
+#else
+        (void)rt;
+#endif
+    }
+    sf->arg_switch_pending = FALSE;
+}
