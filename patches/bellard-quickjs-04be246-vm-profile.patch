+#ifdef CONFIG_NATIVE_TRACE
+/* Compile only straight-line, side-effect-free integer bytecode initially.
+   Unsupported instructions or runtime type mismatches preserve the ordinary
+   interpreter path. This intentionally recognizes semantics, not source or
+   challenge-specific function identities. */
+static NativeTrace *js_compile_native_trace(JSFunctionBytecode *bytecode)
+{
+    if (bytecode->func_kind != JS_FUNC_NORMAL ||
+        bytecode->closure_var_count != 0 || bytecode->var_count != 0 ||
+        bytecode->need_home_object || bytecode->stack_size > 64 ||
+        bytecode->byte_code_len < 4)
+        return NULL;
+
+    JSRuntime *rt = bytecode->realm->rt;
+    NativeTraceInstruction *instructions = js_malloc_rt(
+        rt, sizeof(*instructions) * (size_t)bytecode->byte_code_len);
+    if (instructions == NULL)
+        return NULL;
+    size_t count = 0;
+    BOOL valid = TRUE;
+    for (int pc = 0; valid && pc < bytecode->byte_code_len;) {
+        int opcode = bytecode->byte_code_buf[pc];
+        int size = short_opcode_info(opcode).size;
+        if (size <= 0 || pc + size > bytecode->byte_code_len) {
+            valid = FALSE;
+            break;
+        }
+        NativeTraceInstruction instruction = {0};
+        switch (opcode) {
+        case OP_get_arg:
+            instruction.opcode = NATIVE_TRACE_GET_ARG;
+            instruction.operand = get_u16(bytecode->byte_code_buf + pc + 1);
+            break;
+#if SHORT_OPCODES
+        case OP_get_arg0:
+        case OP_get_arg1:
+        case OP_get_arg2:
+        case OP_get_arg3:
+            instruction.opcode = NATIVE_TRACE_GET_ARG;
+            instruction.operand = opcode - OP_get_arg0;
+            break;
+        case OP_push_minus1:
+        case OP_push_0:
+        case OP_push_1:
+        case OP_push_2:
+        case OP_push_3:
+        case OP_push_4:
+        case OP_push_5:
+        case OP_push_6:
+        case OP_push_7:
+            instruction.opcode = NATIVE_TRACE_CONST_I32;
+            instruction.operand = opcode - OP_push_0;
+            break;
+        case OP_push_i8:
+            instruction.opcode = NATIVE_TRACE_CONST_I32;
+            instruction.operand = get_i8(bytecode->byte_code_buf + pc + 1);
+            break;
+        case OP_push_i16:
+            instruction.opcode = NATIVE_TRACE_CONST_I32;
+            instruction.operand = get_i16(bytecode->byte_code_buf + pc + 1);
+            break;
+        case OP_push_const8: {
+            JSValueConst value =
+                bytecode->cpool[bytecode->byte_code_buf[pc + 1]];
+            if (JS_VALUE_GET_TAG(value) != JS_TAG_INT) {
+                valid = FALSE;
+                continue;
+            }
+            instruction.opcode = NATIVE_TRACE_CONST_I32;
+            instruction.operand = JS_VALUE_GET_INT(value);
+            break;
+        }
+#endif
+        case OP_push_i32:
+            instruction.opcode = NATIVE_TRACE_CONST_I32;
+            instruction.operand = (int32_t)get_u32(
+                bytecode->byte_code_buf + pc + 1);
+            break;
+        case OP_and: instruction.opcode = NATIVE_TRACE_AND_I32; break;
+        case OP_or: instruction.opcode = NATIVE_TRACE_OR_I32; break;
+        case OP_xor: instruction.opcode = NATIVE_TRACE_XOR_I32; break;
+        case OP_shl: instruction.opcode = NATIVE_TRACE_SHL_I32; break;
+        case OP_sar: instruction.opcode = NATIVE_TRACE_SAR_I32; break;
+        case OP_return:
+            if (pc + size != bytecode->byte_code_len) {
+                valid = FALSE;
+                continue;
+            }
+            instruction.opcode = NATIVE_TRACE_RETURN_I32;
+            break;
+        default:
+            valid = FALSE;
+            continue;
+        }
+        instructions[count++] = instruction;
+        pc += size;
+    }
+
+    NativeTrace *trace = valid ? native_trace_compile(
+        instructions, count, bytecode->arg_count) : NULL;
+    js_free_rt(rt, instructions);
+    return trace;
+}
+#endif
