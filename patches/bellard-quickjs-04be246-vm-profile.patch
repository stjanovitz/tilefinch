+void JS_DumpExecutionProfile(JSRuntime *rt)
+{
+    uint64_t total = 0;
+    int top_opcodes[20];
+    uint16_t top_pairs[20];
+    JSFunctionBytecode *top_functions[20] = {0};
+    size_t top_pcs[20];
+    struct list_head *el;
