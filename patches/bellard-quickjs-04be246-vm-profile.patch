+void JS_RecordExecutionProfilePoll(JSRuntime *rt)
+{
+    void *function = rt->profile_current_function;
+    uint32_t pc = rt->profile_current_pc;
+    uintptr_t key;
+    size_t index;
+
+    if (rt->profile_poll_site < JS_PROFILE_POLL_SITE_COUNT)
+        rt->profile_poll_site_counts[rt->profile_poll_site]++;
+    if (function == NULL)
+        return;
+    key = ((uintptr_t)function >> 4) ^
+          ((uintptr_t)pc * UINT32_C(2654435761));
+    index = key & (countof(rt->profile_poll_hotspots) - 1);
+    for (size_t probe = 0; probe < 8; probe++) {
+        size_t candidate = (index + probe) &
+                           (countof(rt->profile_poll_hotspots) - 1);
+        if (rt->profile_poll_hotspots[candidate].function == function &&
+            rt->profile_poll_hotspots[candidate].pc == pc) {
+            rt->profile_poll_hotspots[candidate].count++;
+            return;
+        }
+        if (rt->profile_poll_hotspots[candidate].function == NULL) {
+            rt->profile_poll_hotspots[candidate].function = function;
+            rt->profile_poll_hotspots[candidate].pc = pc;
+            rt->profile_poll_hotspots[candidate].count = 1;
+            return;
+        }
+    }
+}
+
+static BOOL js_profile_function_is_live(JSRuntime *rt,
+                                        JSFunctionBytecode *wanted)
+{
+    struct list_head *el;
+    list_for_each(el, &rt->gc_obj_list) {
+        JSGCObjectHeader *header = list_entry(el, JSGCObjectHeader, link);
+        if (js_rc(header)->gc_obj_type == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE &&
+            (JSFunctionBytecode *)header == wanted)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static void js_profile_dump_location(JSRuntime *rt, const char *kind,
+                                     int rank, JSFunctionBytecode *function,
+                                     uint32_t pc, uint64_t count,
+                                     uint64_t denominator)
+{
+    fprintf(stderr, "js-profile-snapshot-%s rank=%d function=%p pc=%u"
+            " count=%" PRIu64 " share-permille=%" PRIu64,
+            kind, rank, (void *)function, pc, count,
+            denominator ? count * 1000 / denominator : 0);
+    if (js_profile_function_is_live(rt, function)) {
+        char name_buffer[ATOM_GET_STR_BUF_SIZE];
+        char filename_buffer[ATOM_GET_STR_BUF_SIZE];
+        const char *name = JS_AtomGetStr(function->realm, name_buffer,
+                                        sizeof(name_buffer),
+                                        function->func_name);
+        const char *filename = function->has_debug ?
+            JS_AtomGetStr(function->realm, filename_buffer,
+                          sizeof(filename_buffer), function->debug.filename) :
+            "?";
+        int column = 0;
+        int line = function->has_debug ?
+            find_line_num(function->realm, function, pc, &column) : -1;
+        fprintf(stderr, " name=%s file=%s line=%d column=%d",
+                name, filename, line, column);
+    } else {
+        fprintf(stderr, " retired=yes");
+    }
+    fprintf(stderr, "\n");
+}
