+static JSObjectLiteralTemplate *js_object_literal_cache_lookup(
+    JSFunctionBytecode *bytecode, uint32_t object_pc)
+{
+    JSObjectLiteralCache *cache = bytecode->object_literal_cache;
+    if (cache == NULL)
+        return NULL;
+    unsigned int mask = cache->capacity - 1;
+    unsigned int slot = object_pc * UINT32_C(2654435761) & mask;
+    for (;;) {
+        JSObjectLiteralTemplate *template = cache->entries[slot];
+        if (template == NULL || template->object_pc == object_pc)
+            return template;
+        slot = (slot + 1) & mask;
+    }
+}
+
+static int js_object_literal_cache_insert(
+    JSContext *ctx, JSFunctionBytecode *bytecode,
+    JSObjectLiteralTemplate *template)
+{
+    JSObjectLiteralCache *cache = bytecode->object_literal_cache;
+    unsigned int old_capacity = cache == NULL ? 0 : cache->capacity;
+    if (cache == NULL || (cache->count + 1) * 2 >= cache->capacity) {
+        unsigned int capacity = old_capacity == 0 ? 8 : old_capacity * 2;
+        size_t size = sizeof(*cache) +
+            sizeof(cache->entries[0]) * capacity;
+        JSObjectLiteralCache *replacement = js_mallocz(ctx, size);
+        if (unlikely(replacement == NULL))
+            return -1;
+        replacement->capacity = capacity;
+        if (cache != NULL) {
+            for (unsigned int index = 0; index < old_capacity; index++) {
+                JSObjectLiteralTemplate *entry = cache->entries[index];
+                if (entry == NULL)
+                    continue;
+                unsigned int slot = entry->object_pc *
+                    UINT32_C(2654435761) & (capacity - 1);
+                while (replacement->entries[slot] != NULL)
+                    slot = (slot + 1) & (capacity - 1);
+                replacement->entries[slot] = entry;
+                replacement->count++;
+            }
+            js_free(ctx, cache);
+        }
+        bytecode->object_literal_cache = replacement;
+        cache = replacement;
+    }
+    unsigned int slot = template->object_pc * UINT32_C(2654435761) &
+                        (cache->capacity - 1);
+    while (cache->entries[slot] != NULL)
+        slot = (slot + 1) & (cache->capacity - 1);
+    cache->entries[slot] = template;
+    cache->count++;
+    return 0;
+}
