+static int js_arg_switch_constant(
+    JSFunctionBytecode *bytecode, const uint8_t *pc, const uint8_t *end,
+    int32_t *value, const uint8_t **next)
+{
+    if (pc >= end)
+        return 0;
+    switch (*pc) {
+#if SHORT_OPCODES
+    case OP_push_i8:
+        if (pc + 2 > end) return 0;
+        *value = get_i8(pc + 1);
+        *next = pc + 2;
+        return 1;
+    case OP_push_i16:
+        if (pc + 3 > end) return 0;
+        *value = get_i16(pc + 1);
+        *next = pc + 3;
+        return 1;
+    case OP_push_0:
+    case OP_push_1:
+    case OP_push_2:
+    case OP_push_3:
+    case OP_push_4:
+    case OP_push_5:
+    case OP_push_6:
+    case OP_push_7:
+        *value = *pc - OP_push_0;
+        *next = pc + 1;
+        return 1;
+    case OP_push_const8: {
+        if (pc + 2 > end || pc[1] >= bytecode->cpool_count ||
+            JS_VALUE_GET_TAG(bytecode->cpool[pc[1]]) != JS_TAG_INT)
+            return 0;
+        *value = JS_VALUE_GET_INT(bytecode->cpool[pc[1]]);
+        *next = pc + 2;
+        return 1;
+    }
+#endif
+    case OP_push_i32:
+        if (pc + 5 > end) return 0;
+        *value = (int32_t)get_u32(pc + 1);
+        *next = pc + 5;
+        return 1;
+    default:
+        return 0;
+    }
+}
