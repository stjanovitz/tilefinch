+/* Collapse generated `arg0 === constant` if/else ladders into a compact
+   direct dispatch table.  The chain builder proves every skipped comparison
+   is side-effect free and retains comparison-count watchdog accounting. */
+static int js_try_arg0_switch_dispatch(
+    JSContext *ctx, JSStackFrame *sf, JSFunctionBytecode *bytecode,
+    JSValueConst argument, const uint8_t **pc_ptr)
+{
+    if (JS_VALUE_GET_TAG(argument) != JS_TAG_INT)
+        return 0;
+    const uint8_t *instruction = *pc_ptr - 1;
+    uint32_t start_pc =
+        (uint32_t)(instruction - bytecode->byte_code_buf);
+    JSArgSwitchCache *cache = bytecode->arg_switch_cache;
+    if (cache == NULL) {
+        JSArgSwitchCache candidate;
+        memset(&candidate, 0, sizeof(candidate));
+        candidate.start_pc = start_pc;
+        const uint8_t *end = bytecode->byte_code_buf +
+                             bytecode->byte_code_len;
+        const uint8_t *cursor = instruction;
+        int comparisons = 0;
+        for (; comparisons < 255; comparisons++) {
+            if (cursor >= end || cursor[0] != OP_get_arg0)
+                break;
+            int32_t constant;
+            const uint8_t *after_constant;
+            if (!js_arg_switch_constant(
+                    bytecode, cursor + 1, end,
+                    &constant, &after_constant) ||
+                constant < 0 || constant > 255 ||
+                after_constant >= end ||
+                after_constant[0] != OP_strict_eq)
+                break;
+            const uint8_t *branch = after_constant + 1;
+            const uint8_t *matched;
+            const uint8_t *fallback;
+            if (branch < end && branch[0] == OP_if_false &&
+                branch + 5 <= end) {
+                matched = branch + 5;
+                fallback = branch + 1 +
+                    (int32_t)get_u32(branch + 1);
+#if SHORT_OPCODES
+            } else if (branch < end && branch[0] == OP_if_false8 &&
+                       branch + 2 <= end) {
+                matched = branch + 2;
+                fallback = branch + 1 + get_i8(branch + 1);
+#endif
+            } else {
+                break;
+            }
+            if (fallback <= cursor || fallback > end ||
+                candidate.valid[constant])
+                break;
+            candidate.valid[constant] = TRUE;
+            candidate.targets[constant] =
+                (uint32_t)(matched - bytecode->byte_code_buf);
+            candidate.costs[constant] = comparisons + 1;
+            if (fallback >= end || fallback[0] != OP_get_arg0) {
+                cursor = fallback;
+                comparisons++;
+                break;
+            }
+            cursor = fallback;
+        }
+        if (comparisons == 0)
+            return 0;
+        candidate.default_pc =
+            (uint32_t)(cursor - bytecode->byte_code_buf);
+        candidate.default_cost = min_int(comparisons, UINT8_MAX);
+        candidate.complete = comparisons >= 8;
+        cache = js_malloc(ctx, sizeof(*cache));
+        if (cache == NULL)
+            return 0;
+        *cache = candidate;
+        bytecode->arg_switch_cache = cache;
+#ifdef CONFIG_EXECUTION_PROFILE
+        ctx->rt->profile_arg_switch_cache_builds++;
+#endif
+    }
+    if (cache->start_pc != start_pc)
+        return 0;
+    int32_t selector = JS_VALUE_GET_INT(argument);
+    uint32_t target = cache->default_pc;
+    int cost = cache->default_cost;
+    if ((uint32_t)selector < 256 && cache->valid[selector]) {
+        target = cache->targets[selector];
+        cost = cache->costs[selector];
+    } else if (!cache->complete) {
+        sf->arg_switch_pending = TRUE;
+        sf->arg_switch_start_pc = cache->start_pc;
+        sf->arg_switch_selector = selector;
+        sf->arg_switch_branches = cost;
+    }
+    ctx->interrupt_counter -= cost;
+    if (unlikely(ctx->interrupt_counter <= 0 &&
+        js_profile_poll_interrupts_force(
+            ctx, JS_PROFILE_POLL_SWITCH_CHAIN)))
+        return -1;
+    *pc_ptr = bytecode->byte_code_buf + target;
+#ifdef CONFIG_EXECUTION_PROFILE
+    ctx->rt->profile_switch_hits++;
+    ctx->rt->profile_switch_comparisons += cost;
+    ctx->rt->profile_arg_switch_cache_hits++;
+#endif
+    return 1;
+}
