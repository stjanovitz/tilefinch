+static JSPortableRegion *js_compile_portable_region(
+    JSContext *ctx, JSFunctionBytecode *bytecode)
+{
+    if (bytecode->func_kind != JS_FUNC_NORMAL ||
+        bytecode->closure_var_count != 0 || bytecode->need_home_object ||
+        bytecode->var_count > JS_PORTABLE_REGION_LOCAL_LIMIT ||
+        bytecode->stack_size > JS_PORTABLE_REGION_STACK_LIMIT ||
+        bytecode->byte_code_len < 6 ||
+        bytecode->byte_code_len > JS_PORTABLE_REGION_INSTRUCTION_LIMIT * 5)
+        return NULL;
