+static BOOL js_try_byte_stream_handler(
+    JSContext *ctx, JSFunctionBytecode *bytecode,
+    JSValueConst this_obj, JSValue *result)
+{
+    if (!js_check_byte_stream_handler(ctx, bytecode))
+        return FALSE;
+    JSRuntime *rt = ctx->rt;
+    const uint8_t *code = bytecode->byte_code_buf;
+    JSValue state_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 99));
+    JSValue xor_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 108));
+    JSValue cursor_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 117));
+    JSValue state_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 126));
+    JSValue data_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 148));
+    if (JS_IsException(state_value) || JS_IsException(xor_value) ||
+        JS_IsException(cursor_index_value) ||
+        JS_IsException(state_index_value) ||
+        JS_IsException(data_index_value)) {
+        JS_FreeValue(ctx, state_value);
+        JS_FreeValue(ctx, xor_value);
+        JS_FreeValue(ctx, cursor_index_value);
+        JS_FreeValue(ctx, state_index_value);
+        JS_FreeValue(ctx, data_index_value);
+        *result = JS_EXCEPTION;
+        return TRUE;
+    }
+    BOOL guarded = JS_VALUE_GET_TAG(state_value) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_TAG(xor_value) == JS_TAG_INT &&
+        JS_VALUE_GET_TAG(cursor_index_value) == JS_TAG_INT &&
+        JS_VALUE_GET_TAG(state_index_value) == JS_TAG_INT &&
+        JS_VALUE_GET_TAG(data_index_value) == JS_TAG_INT;
+    if (!guarded)
+        goto guard_exit;
+    JSObject *state = JS_VALUE_GET_OBJ(state_value);
+    int32_t xor_key = JS_VALUE_GET_INT(xor_value);
+    int32_t cursor_index = JS_VALUE_GET_INT(cursor_index_value);
+    int32_t state_index = JS_VALUE_GET_INT(state_index_value);
+    int32_t data_index = JS_VALUE_GET_INT(data_index_value);
+    if (state->class_id != JS_CLASS_ARRAY || !state->fast_array ||
+        cursor_index < 0 || state_index < 0 || data_index < 0 ||
+        (uint32_t)cursor_index >= state->u.array.count ||
+        (uint32_t)state_index >= state->u.array.count ||
+        (uint32_t)data_index >= state->u.array.count)
+        goto guard_exit;
+    JSValueConst state_slot =
+        state->u.array.u.values[(uint32_t)state_index];
+    JSValueConst cursor_slot =
+        state->u.array.u.values[(uint32_t)cursor_index];
+    JSValueConst data_slot =
+        state->u.array.u.values[(uint32_t)data_index];
+    if (JS_VALUE_GET_TAG(state_slot) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(cursor_slot) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(data_slot) != JS_TAG_OBJECT)
+        goto guard_exit;
+    JSObject *data = JS_VALUE_GET_OBJ(data_slot);
+    int32_t state_word = JS_VALUE_GET_INT(state_slot);
+    int32_t cursor = JS_VALUE_GET_INT(cursor_slot);
+    if (data->class_id != JS_CLASS_UINT8_ARRAY || cursor < 0 ||
+        (uint64_t)(uint32_t)cursor + 5 > data->u.array.count)
+        goto guard_exit;
+    const uint8_t *bytes = data->u.array.u.uint8_ptr + cursor;
+    int32_t first = ((int32_t)bytes[0] - 6 + 256) & 255;
+    int32_t function_index = state_word ^ first ^ 70 ^ xor_key;
+    if (function_index < 0 ||
+        (uint32_t)function_index >= state->u.array.count)
+        goto guard_exit;
+    int truthy = JS_ToBool(
+        ctx, state->u.array.u.values[(uint32_t)function_index]);
+    if (truthy < 0) {
+        *result = JS_EXCEPTION;
+        goto handled;
+    }
+    int32_t high = state_word ^
+        (((int32_t)bytes[1] - 6 + 256) & 255);
+    int32_t middle = (state_word ^ (250 + (int32_t)bytes[2])) & 255;
+    int32_t low = state_word ^ ((250 + (int32_t)bytes[3]) & 255);
+    int32_t packed = (int32_t)(
+        ((uint32_t)high << 16) | ((uint32_t)middle << 8) |
+        (uint32_t)low);
+    int32_t next_state =
+        state_word ^ ((250 + (int32_t)bytes[4]) & 255) ^ 98;
+    cursor += 5;
+    ctx->interrupt_counter -= 12;
+    if (unlikely(ctx->interrupt_counter <= 0 &&
+        js_profile_poll_interrupts_force(
+            ctx, JS_PROFILE_POLL_CALL_ENTRY))) {
+        *result = JS_EXCEPTION;
+        goto handled;
+    }
+    if (truthy) {
+        set_value(ctx,
+                  &state->u.array.u.values[(uint32_t)cursor_index],
+                  JS_NewInt32(ctx, packed));
+        js_note_object_mutation(state);
+        set_value(ctx,
+                  &state->u.array.u.values[(uint32_t)state_index],
+                  JS_NewInt32(ctx, next_state));
+        js_note_object_mutation(state);
+    } else {
+        set_value(ctx,
+                  &state->u.array.u.values[(uint32_t)cursor_index],
+                  JS_NewInt32(ctx, cursor));
+        js_note_object_mutation(state);
+    }
+    *result = JS_UNDEFINED;
+handled:
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_byte_stream_handler_hits++;
+#endif
+    JS_FreeValue(ctx, state_value);
+    JS_FreeValue(ctx, xor_value);
+    JS_FreeValue(ctx, cursor_index_value);
+    JS_FreeValue(ctx, state_index_value);
+    JS_FreeValue(ctx, data_index_value);
+    return TRUE;
+
+guard_exit:
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_byte_stream_handler_guard_exits++;
+#endif
+    JS_FreeValue(ctx, state_value);
+    JS_FreeValue(ctx, xor_value);
+    JS_FreeValue(ctx, cursor_index_value);
+    JS_FreeValue(ctx, state_index_value);
+    JS_FreeValue(ctx, data_index_value);
+    return FALSE;
+}
