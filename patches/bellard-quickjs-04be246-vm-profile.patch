+static void js_note_arithmetic_region_backedge(
+    JSContext *ctx, JSFunctionBytecode *bytecode,
+    uint32_t from_pc, uint32_t to_pc)
+{
+    if (bytecode->arithmetic_region != NULL ||
+        bytecode->arithmetic_region_attempted || to_pc >= from_pc)
+        return;
+    if (bytecode->arithmetic_region_backedges == 0 ||
+        bytecode->arithmetic_region_from_pc != from_pc ||
+        bytecode->arithmetic_region_to_pc != to_pc) {
+        bytecode->arithmetic_region_from_pc = from_pc;
+        bytecode->arithmetic_region_to_pc = to_pc;
+        bytecode->arithmetic_region_backedges = 1;
+        return;
+    }
+    if (++bytecode->arithmetic_region_backedges < 1024)
+        return;
+    bytecode->arithmetic_region_attempted = TRUE;
+    bytecode->arithmetic_region = js_compile_arithmetic_region(
+        ctx, bytecode, to_pc, from_pc);
+}
