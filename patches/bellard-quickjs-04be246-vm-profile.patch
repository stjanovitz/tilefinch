+/* Object-literal method tables emitted as
+     fclosure8 <constant>, set_name <atom>, define_field <same atom>
+   can keep capture-free functions in their bytecode form.  A normal function
+   object is still created on the first observable property read; direct calls
+   use the already-supported internal bytecode value. */
+static int js_parse_named_function_literal_property(
+    JSFunctionBytecode *owner, const uint8_t *cursor, const uint8_t *end,
+    JSAtom *atom, JSValue *value, JSAtom *inferred_name)
+{
+#if SHORT_OPCODES
+    if (cursor + 12 > end || cursor[0] != OP_fclosure8 ||
+        cursor[2] != OP_set_name || cursor[7] != OP_define_field)
+        return 0;
+    uint32_t constant_index = cursor[1];
+#else
+    if (cursor + 15 > end || cursor[0] != OP_fclosure ||
+        cursor[5] != OP_set_name || cursor[10] != OP_define_field)
+        return 0;
+    uint32_t constant_index = get_u32(cursor + 1);
+#endif
+    if (constant_index >= (uint32_t)owner->cpool_count)
+        return 0;
+    JSValue bytecode_value = owner->cpool[constant_index];
+    if (JS_VALUE_GET_TAG(bytecode_value) != JS_TAG_FUNCTION_BYTECODE)
+        return 0;
+    JSFunctionBytecode *function = JS_VALUE_GET_PTR(bytecode_value);
+    if (function->closure_var_count != 0 || function->need_home_object ||
+        function->func_kind != JS_FUNC_NORMAL ||
+        function->deferred_name_conflict)
+        return 0;
+#if SHORT_OPCODES
+    JSAtom name = get_u32(cursor + 3);
+    JSAtom field = get_u32(cursor + 8);
+    int instruction_size = 12;
+#else
+    JSAtom name = get_u32(cursor + 6);
+    JSAtom field = get_u32(cursor + 11);
+    int instruction_size = 15;
+#endif
+    if (name == JS_ATOM_NULL || name != field ||
+        (function->deferred_name_set &&
+         function->deferred_name_atom != name))
+        return 0;
+    *atom = field;
+    *value = bytecode_value;
+    *inferred_name = name;
+    return instruction_size;
+}
+
+static int js_parse_cached_literal_property(
+    JSFunctionBytecode *bytecode, const uint8_t *cursor, const uint8_t *end,
+    JSAtom *atom, JSValue *value, JSAtom *inferred_name)
+{
+    int size = js_parse_primitive_literal_property(
+        bytecode, cursor, end, atom, value);
+    if (size != 0) {
+        *inferred_name = JS_ATOM_NULL;
+        return size;
+    }
+    return js_parse_named_function_literal_property(
+        bytecode, cursor, end, atom, value, inferred_name);
+}
