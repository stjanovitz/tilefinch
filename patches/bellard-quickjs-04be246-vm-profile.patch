+        {216, OP_get_arg}, {219, OP_mul}, {220, OP_push_i32},
+        {225, OP_call_method}, {228, OP_get_arg}, {231, OP_get_arg},
+        {234, OP_get_arg3}, {235, OP_get_field}, {240, OP_call1},
+        {241, OP_get_array_el2}, {242, OP_get_arg},
+        {245, OP_push_i32}, {250, OP_call_method}, {253, OP_add},
+        {254, OP_push_i16}, {257, OP_call_method},
