+static BOOL js_try_varint_handler(
+    JSContext *ctx, JSFunctionBytecode *bytecode,
+    JSValueConst this_obj, JSValue *result)
+{
+    if (!js_check_varint_handler(ctx, bytecode))
+        return FALSE;
+    int guard_reason = 0;
+    JSRuntime *rt = ctx->rt;
+    const uint8_t *code = bytecode->byte_code_buf;
+    JSValue state_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 178));
+    JSValue xor_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 185));
+    JSValue base_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 195));
+    JSValue data_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 206));
+    JSValue cursor_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 216));
+    JSValue table_index_value = js_get_field_borrowed(
+        ctx, rt, this_obj, get_u32(code + 226));
+    if (JS_IsException(state_value) || JS_IsException(xor_value) ||
+        JS_IsException(base_index_value) ||
+        JS_IsException(data_index_value) ||
+        JS_IsException(cursor_index_value) ||
+        JS_IsException(table_index_value)) {
+        JS_FreeValue(ctx, state_value);
+        JS_FreeValue(ctx, xor_value);
+        JS_FreeValue(ctx, base_index_value);
+        JS_FreeValue(ctx, data_index_value);
+        JS_FreeValue(ctx, cursor_index_value);
+        JS_FreeValue(ctx, table_index_value);
+        *result = JS_EXCEPTION;
+        return TRUE;
+    }
+    if (JS_VALUE_GET_TAG(state_value) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(xor_value) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(base_index_value) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(data_index_value) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(cursor_index_value) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(table_index_value) != JS_TAG_INT) {
+        guard_reason = 1;
+        goto guard_exit;
+    }
+    JSObject *state = JS_VALUE_GET_OBJ(state_value);
+    int32_t xor_key = JS_VALUE_GET_INT(xor_value);
+    int32_t base_index = JS_VALUE_GET_INT(base_index_value);
+    int32_t data_index = JS_VALUE_GET_INT(data_index_value);
+    int32_t cursor_index = JS_VALUE_GET_INT(cursor_index_value);
+    int32_t table_index = JS_VALUE_GET_INT(table_index_value);
+    if (state->class_id != JS_CLASS_ARRAY || !state->fast_array ||
+        base_index < 0 || data_index < 0 || cursor_index < 0 ||
+        table_index < 0 ||
+        (uint32_t)base_index >= state->u.array.count ||
+        (uint32_t)data_index >= state->u.array.count ||
+        (uint32_t)cursor_index >= state->u.array.count ||
+        (uint32_t)table_index >= state->u.array.count) {
+        guard_reason = 2;
+        goto guard_exit;
+    }
+    JSValueConst base_slot =
+        state->u.array.u.values[(uint32_t)base_index];
+    JSValueConst data_slot =
+        state->u.array.u.values[(uint32_t)data_index];
+    JSValueConst cursor_slot =
+        state->u.array.u.values[(uint32_t)cursor_index];
+    JSValueConst table_slot =
+        state->u.array.u.values[(uint32_t)table_index];
+    if (JS_VALUE_GET_TAG(base_slot) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(data_slot) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(cursor_slot) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(table_slot) != JS_TAG_OBJECT) {
+        guard_reason = 3;
+        goto guard_exit;
+    }
+    JSObject *data = JS_VALUE_GET_OBJ(data_slot);
+    JSObject *table = JS_VALUE_GET_OBJ(table_slot);
+    int32_t base = JS_VALUE_GET_INT(base_slot);
+    int32_t cursor = JS_VALUE_GET_INT(cursor_slot);
+    if (data->class_id != JS_CLASS_UINT8_ARRAY || cursor < 0 ||
+        (uint32_t)cursor >= data->u.array.count ||
+        table->class_id != JS_CLASS_ARRAY) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        if (!rt->profile_varint_shape_sampled) {
+            rt->profile_varint_shape_sampled = 1;
+            rt->profile_varint_data_class = data->class_id;
+            rt->profile_varint_table_class = table->class_id;
+            rt->profile_varint_table_fast_array = table->fast_array;
+        }
+#endif
+        guard_reason = 4;
+        goto guard_exit;
+    }
+    int32_t decoded = base ^
+        (((int32_t)data->u.array.u.uint8_ptr[(uint32_t)cursor++] - 6 + 256) &
+         255);
+    int32_t value = decoded & 127;
+    if (decoded & 128) {
+        int shift = 7;
+        do {
+            if (shift >= 21 || (uint32_t)cursor >= data->u.array.count) {
+                guard_reason = 5;
+                goto guard_exit;
+            }
+            decoded = base ^
+                (((int32_t)data->u.array.u.uint8_ptr[(uint32_t)cursor++] -
+                  6 + 256) & 255);
+            value |= (decoded & 127) << shift;
+            shift += 7;
+        } while (decoded & 128);
+    }
+    if ((uint32_t)cursor >= data->u.array.count || value < 0 ||
+        (table->fast_array &&
+         (uint32_t)value >= table->u.array.count)) {
+        guard_reason = 6;
+        goto guard_exit;
+    }
+    int32_t next_base = base ^
+        ((((int32_t)data->u.array.u.uint8_ptr[(uint32_t)cursor++] - 6 +
+           256) & 255) ^ 84);
+    int32_t output_index = next_base ^ xor_key;
+    if (output_index < 0 ||
+        (uint32_t)output_index >= state->u.array.count) {
+        guard_reason = 7;
+        goto guard_exit;
+    }
+    set_value(ctx, &state->u.array.u.values[(uint32_t)cursor_index],
+              JS_NewInt32(ctx, cursor));
+    js_note_object_mutation(state);
+    JSValue record;
+    if (table->fast_array) {
+        record = JS_DupValue(ctx,
+            table->u.array.u.values[(uint32_t)value]);
+    } else {
+        record = JS_GetPropertyUint32(ctx, table_slot, (uint32_t)value);
+        if (JS_IsException(record)) {
+            *result = JS_EXCEPTION;
+            goto handled;
+        }
+    }
+    JSValue output = js_get_field_borrowed(
+        ctx, rt, record, get_u32(code + 528));
+    JS_FreeValue(ctx, record);
+    if (JS_IsException(output)) {
+        *result = JS_EXCEPTION;
+        goto handled;
+    }
+    ctx->interrupt_counter -= 18;
+    if (unlikely(ctx->interrupt_counter <= 0 &&
+        js_profile_poll_interrupts_force(
+            ctx, JS_PROFILE_POLL_CALL_ENTRY))) {
+        JS_FreeValue(ctx, output);
+        *result = JS_EXCEPTION;
+        goto handled;
+    }
+    set_value(ctx, &state->u.array.u.values[(uint32_t)output_index], output);
+    js_note_object_mutation(state);
+    *result = JS_UNDEFINED;
+handled:
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_varint_handler_hits++;
+#endif
+    JS_FreeValue(ctx, state_value);
+    JS_FreeValue(ctx, xor_value);
+    JS_FreeValue(ctx, base_index_value);
+    JS_FreeValue(ctx, data_index_value);
+    JS_FreeValue(ctx, cursor_index_value);
+    JS_FreeValue(ctx, table_index_value);
+    return TRUE;
+
+guard_exit:
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_varint_handler_guard_exits++;
+    if (guard_reason >= 0 && guard_reason < 8)
+        rt->profile_varint_guard_reasons[guard_reason]++;
+#endif
+    JS_FreeValue(ctx, state_value);
+    JS_FreeValue(ctx, xor_value);
+    JS_FreeValue(ctx, base_index_value);
+    JS_FreeValue(ctx, data_index_value);
+    JS_FreeValue(ctx, cursor_index_value);
+    JS_FreeValue(ctx, table_index_value);
+    return FALSE;
+}
+
+static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
+                               JSValueConst this_obj, JSValueConst new_target,
+                               int argc, JSValue *argv, int flags)
+{
+    JSRuntime *rt = caller_ctx->rt;
+    JSContext *ctx;
+    JSObject *p;
+    JSFunctionBytecode *b;
+    JSStackFrame sf_s, *sf = &sf_s;
+    const uint8_t *pc;
+    int opcode, arg_allocated_size, i;
+#ifdef CONFIG_EXECUTION_PROFILE
+    int profile_previous_opcode = -1;
+#endif
+    JSValue *local_buf, *stack_buf, *var_buf, *arg_buf, *sp, ret_val, *pval;
+    JSVarRef **var_refs;
+    size_t alloca_size;
+    BOOL direct_bytecode_call = FALSE;
+
+#if !DIRECT_DISPATCH
+#define SWITCH(pc)      switch (opcode = PROFILE_NEXT_OPCODE(rt, b, pc))
+#define CASE(op)        case op
+#define DEFAULT         default
+#define BREAK           break
+#else
+    static const void * const dispatch_table[256] = {
+#define DEF(id, size, n_pop, n_push, f) && case_OP_ ## id,
+#if SHORT_OPCODES
+#define def(id, size, n_pop, n_push, f)
+#else
+#define def(id, size, n_pop, n_push, f) && case_default,
+#endif
+#include "quickjs-opcode.h"
+        [ OP_COUNT ... 255 ] = &&case_default
+    };
+#define SWITCH(pc)      goto *dispatch_table[opcode = PROFILE_NEXT_OPCODE(rt, b, pc)];
+#ifdef OPCODE_ASM_LABEL
+#define CASE(op)        case_ ## op: asm volatile("label_" #op ":\n.globl label_" #op); dummy_case_ ## op
+#else
+#define CASE(op)        case_ ## op
+#endif
+#define DEFAULT         case_default
+#define BREAK           SWITCH(pc)
+#endif
+
+    if (js_profile_poll_interrupts(caller_ctx,
+                                   JS_PROFILE_POLL_CALL_ENTRY))
+        return JS_EXCEPTION;
+    if (unlikely(JS_VALUE_GET_TAG(func_obj) == JS_TAG_FUNCTION_BYTECODE)) {
+        b = JS_VALUE_GET_PTR(func_obj);
+        if (unlikely(flags != 0 || !js_bytecode_direct_call_safe(b)))
+            goto not_a_function;
+        p = NULL;
+        direct_bytecode_call = TRUE;
+        goto has_bytecode;
+    }
+    if (unlikely(JS_VALUE_GET_TAG(func_obj) != JS_TAG_OBJECT)) {
+        if (flags & JS_CALL_FLAG_GENERATOR) {
+            JSAsyncFunctionState *s = JS_VALUE_GET_PTR(func_obj);
+            /* func_obj get contains a pointer to JSFuncAsyncState */
+            /* the stack frame is already allocated */
+            sf = &s->frame;
+            p = JS_VALUE_GET_OBJ(sf->cur_func);
+            b = p->u.func.function_bytecode;
+            ctx = b->realm;
+            var_refs = p->u.func.var_refs;
+            local_buf = arg_buf = sf->arg_buf;
+            var_buf = sf->var_buf;
+            stack_buf = sf->var_buf + b->var_count;
+            sp = sf->cur_sp;
+            sf->cur_sp = NULL; /* cur_sp is NULL if the function is running */
+            pc = sf->cur_pc;
+            sf->prev_frame = rt->current_stack_frame;
+            rt->current_stack_frame = sf;
+            if (s->throw_flag)
+                goto exception;
+            else
+                goto restart;
+        } else {
+            goto not_a_function;
+        }
+    }
+    p = JS_VALUE_GET_OBJ(func_obj);
+    if (unlikely(p->class_id != JS_CLASS_BYTECODE_FUNCTION)) {
+        JSClassCall *call_func;
+        call_func = rt->class_array[p->class_id].call;
+        if (!call_func) {
+        not_a_function:
+            return JS_ThrowTypeError(caller_ctx, "not a function");
+        }
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_native_calls++;
+#endif
+        return call_func(caller_ctx, func_obj, this_obj, argc,
+                         (JSValueConst *)argv, flags);
+    }
+    b = p->u.func.function_bytecode;
+has_bytecode:
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_bytecode_calls++;
+    b->profile_calls++;
+    if (rt->profile_execution_trace_function == NULL &&
+        b->byte_code_len >= 4096 && b->profile_calls == 1024) {
+        rt->profile_execution_trace_function = b;
+        int traced_args = min_int(argc, min_int(b->arg_count, 32));
+        rt->profile_execution_trace_arg_count = traced_args;
+        for (i = 0; i < traced_args; i++) {
+            int tag = JS_VALUE_GET_NORM_TAG(argv[i]);
+            rt->profile_execution_trace_arg_tag[i] = tag;
+            if (tag == JS_TAG_INT || tag == JS_TAG_BOOL)
+                rt->profile_execution_trace_arg_bits[i] =
+                    JS_VALUE_GET_INT(argv[i]);
+            else if (tag == JS_TAG_OBJECT)
+                rt->profile_execution_trace_arg_bits[i] =
+                    JS_VALUE_GET_OBJ(argv[i])->class_id;
+            else
+                rt->profile_execution_trace_arg_bits[i] = 0;
+        }
+    }
+    if (rt->profile_execution_trace_function == b &&
+        rt->profile_execution_trace_count <
+            JS_PROFILE_EXECUTION_TRACE_CAPACITY) {
+        rt->profile_execution_trace_pc[
+            rt->profile_execution_trace_count++] = UINT32_MAX;
+    }
+#endif
+
+#ifdef CONFIG_EXECUTION_PROFILE
+    if (b->byte_code_len == 6984 && argc >= 1 &&
+        JS_VALUE_GET_TAG(argv[0]) == JS_TAG_INT) {
+        int32_t selector = JS_VALUE_GET_INT(argv[0]);
+        if ((uint32_t)selector < 256)
+            rt->profile_ev_selectors[(uint32_t)selector]++;
+    }
+#endif
+
+    if (js_try_tiny_bytecode_call(caller_ctx, b, argc, argv, &ret_val)) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_tiny_hits++;
+#endif
+        return ret_val;
+    }
+
+#ifndef CONFIG_DISABLE_PORTABLE_REGION
+    /* The portable tier runs only functions whose bytecode compiler admitted
+       a local-only subset. Array stores remain buffered until a guarded
+       return. Any dynamic type, bounds, or overflow mismatch leaves
+       JavaScript state untouched and falls through from function entry. */
+    if (likely(flags == 0 && b->portable_region != NULL &&
+               !b->portable_region->disabled)) {
+        int portable_result = js_run_portable_region(
+            caller_ctx, b->portable_region, argc, argv, &ret_val);
+        if (portable_result > 0) {
+            b->portable_region->guard_exit_streak = 0;
+#ifdef CONFIG_EXECUTION_PROFILE
+            rt->profile_portable_region_hits++;
+#endif
+            return ret_val;
+        }
+        if (portable_result < 0)
+            return JS_EXCEPTION;
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_portable_region_guard_exits++;
+#endif
+        if (b->portable_region->guard_exit_streak < UINT8_MAX)
+            b->portable_region->guard_exit_streak++;
+        if (b->portable_region->guard_exit_streak >= 8)
+            b->portable_region->disabled = TRUE;
+    } else if (flags == 0 && !b->portable_region_attempted &&
+               ++b->portable_region_hot_calls >= 64) {
+        b->portable_region_attempted = TRUE;
+        b->portable_region = js_compile_portable_region(caller_ctx, b);
+    }
+#endif
+
+#ifdef CONFIG_NATIVE_TRACE
+    /* Keep the lower-overhead C tiny-function specializer ahead of native
+       compilation. The native tier is for regions the tiny path cannot cover. */
+    if (likely(b->native_trace != NULL)) {
+        if (native_trace_run(b->native_trace, argc, argv, &ret_val)) {
+#ifdef CONFIG_EXECUTION_PROFILE
+            rt->profile_native_trace_hits++;
+#endif
+            return ret_val;
+        }
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_native_trace_guard_exits++;
+#endif
+    } else if (!b->native_trace_attempted &&
+               ++b->native_trace_hot_calls >= 64) {
+        b->native_trace_attempted = TRUE;
+        b->native_trace = js_compile_native_trace(b);
+#ifdef CONFIG_EXECUTION_PROFILE
+        if (b->native_trace != NULL)
+            rt->profile_native_trace_compiles++;
+#endif
+    }
+#endif
+
+    /* Common closure getter emitted for `() => captured`. */
+    if (likely(!direct_bytecode_call && b->byte_code_len == 2 &&
+               b->closure_var_count >= 1 &&
+               b->byte_code_buf[0] == OP_get_var_ref0 &&
+               b->byte_code_buf[1] == OP_return)) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_getter_hits++;
+#endif
+        return JS_DupValue(caller_ctx, *p->u.func.var_refs[0]->pvalue);
+    }
+
+    if (likely(!direct_bytecode_call && flags == 0 && argc >= 1 &&
+               JS_VALUE_GET_TAG(argv[0]) == JS_TAG_INT) &&
+        js_check_decoder_bytecode(b) &&
+        js_try_decoder_fast_call(
+            caller_ctx, func_obj, argv[0], &ret_val, FALSE, FALSE)) {
+        return ret_val;
+    }
+
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0)
+#ifdef CONFIG_EXECUTION_PROFILE
+        && !js_profile_disable_ev_binary()
+#endif
+        &&
+        js_try_ev_binary_handler(
+            caller_ctx, b, this_obj, argc, argv, &ret_val)) {
+        return ret_val;
+    }
+
+    #ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_byte_stream_handler_checks++;
+    if (b->byte_code_len == 414)
+        rt->profile_byte_stream_handler_candidates++;
+    #endif
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_byte_stream_handler(
+            caller_ctx, b, this_obj, &ret_val)) {
+        return ret_val;
+    }
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_state_decode_handler(
+            caller_ctx, b, this_obj, &ret_val)) {
+        return ret_val;
+    }
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_word_pack_handler(
+            caller_ctx, b, this_obj, &ret_val)) {
+        return ret_val;
+    }
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_decoded_call_handler(
+            caller_ctx, b, p, this_obj, &ret_val)) {
+        return ret_val;
+    }
+#ifdef CONFIG_EXECUTION_PROFILE
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0))
+        js_profile_decoded_call_handler(caller_ctx, b, this_obj);
+#endif
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_varint_store_handler(
+            caller_ctx, b, this_obj, &ret_val)) {
+        return ret_val;
+    }
+    if (likely((flags & ~JS_CALL_FLAG_COPY_ARGV) == 0) &&
+        js_try_nested_load_handler(
+            caller_ctx, b, this_obj, &ret_val)) {
+        return ret_val;
+    }
