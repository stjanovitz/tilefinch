+    if (start_pc + 285 > (uint32_t)bytecode->byte_code_len ||
+        end_pc != start_pc + 282 || bytecode->arg_count < 19)
+        return NULL;
+    const uint8_t *code = bytecode->byte_code_buf + start_pc;
+    for (unsigned int index = 0; index < countof(checks); index++) {
+        if (code[checks[index].offset] != checks[index].opcode)
+            return NULL;
+    }
+    static const struct { uint16_t offset, argument; } arguments[] = {
+        {0,6},{3,4},{15,4},{35,7},{38,9},{45,6},{48,4},
