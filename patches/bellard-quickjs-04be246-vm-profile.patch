+    memset(top_opcodes, -1, sizeof(top_opcodes));
+    memset(top_pairs, 0xff, sizeof(top_pairs));
+    memset(top_pcs, 0xff, sizeof(top_pcs));
+    for (int opcode = 0; opcode < 256; opcode++) {
+        total += rt->profile_opcode_counts[opcode];
+        for (int rank = 0; rank < 20; rank++) {
+            int prior = top_opcodes[rank];
+            if (prior < 0 || rt->profile_opcode_counts[opcode] >
+                             rt->profile_opcode_counts[prior]) {
+                memmove(&top_opcodes[rank + 1], &top_opcodes[rank],
+                        (19 - rank) * sizeof(top_opcodes[0]));
+                top_opcodes[rank] = opcode;
+                break;
+            }
+        }
+    }
+    for (int first = 0; first < 256; first++) {
+        for (int second = 0; second < 256; second++) {
+            uint16_t pair = (uint16_t)((first << 8) | second);
+            uint32_t count = rt->profile_opcode_pairs[first][second];
+            if (count == 0)
+                continue;
+            for (int rank = 0; rank < 20; rank++) {
+                uint16_t prior = top_pairs[rank];
+                uint32_t prior_count = prior == UINT16_MAX ? 0 :
+                    rt->profile_opcode_pairs[prior >> 8][prior & 0xff];
+                if (prior == UINT16_MAX || count > prior_count) {
+                    memmove(&top_pairs[rank + 1], &top_pairs[rank],
+                            (19 - rank) * sizeof(top_pairs[0]));
+                    top_pairs[rank] = pair;
+                    break;
