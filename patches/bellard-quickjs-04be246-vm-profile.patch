+static JSFunctionBytecode *js_region_property_bytecode(
+    JSObject *object, JSAtom atom)
+{
+    JSProperty *property;
+    JSShapeProperty *shape = find_own_property(&property, object, atom);
+    if (shape == NULL || (shape->flags & JS_PROP_TMASK))
+        return NULL;
+    JSValueConst value = property->u.value;
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_FUNCTION_BYTECODE)
+        return JS_VALUE_GET_PTR(value);
+    if (JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT) {
+        JSObject *function = JS_VALUE_GET_OBJ(value);
+        if (function->class_id == JS_CLASS_BYTECODE_FUNCTION)
+            return function->u.func.function_bytecode;
+    }
+    return NULL;
+}
+
+static BOOL js_region_tiny_operation(
+    JSFunctionBytecode *function, int expected_opcode)
+{
+    if (function == NULL || function->byte_code_len != 4 ||
+        function->byte_code_buf[3] != OP_return ||
+        function->byte_code_buf[2] != expected_opcode)
+        return FALSE;
+    return (function->byte_code_buf[0] == OP_get_arg0 &&
+            function->byte_code_buf[1] == OP_get_arg1) ||
+           (function->byte_code_buf[0] == OP_get_arg1 &&
+            function->byte_code_buf[1] == OP_get_arg0);
+}
+
+static int js_region_decode_atom(
+    JSContext *ctx, JSRuntime *rt, JSValueConst constants,
+    JSValueConst decoder, JSAtom encrypted_atom, JSAtom *result)
+{
+    JSValue encrypted = js_get_field_borrowed(
+        ctx, rt, constants, encrypted_atom);
+    if (JS_IsException(encrypted))
+        return -1;
+    JSValue decoded;
+    BOOL handled = js_try_decoder_fast_call(
+        ctx, decoder, encrypted, &decoded, FALSE, FALSE);
+    JS_FreeValue(ctx, encrypted);
+    if (!handled)
+        return 0;
+    if (JS_IsException(decoded))
+        return -1;
+    JSAtom atom = JS_ValueToAtom(ctx, decoded);
+    JS_FreeValue(ctx, decoded);
+    if (atom == JS_ATOM_NULL)
+        return -1;
+    *result = atom;
+    return 1;
+}
+
+static int js_bind_arithmetic_region(
+    JSContext *ctx, JSRuntime *rt, JSFunctionBytecode *owner,
+    JSArithmeticRegion *region, JSValue *arg_buf)
+{
+    if (JS_VALUE_GET_TAG(arg_buf[3]) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(arg_buf[4]) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(arg_buf[6]) != JS_TAG_OBJECT)
+        return 0;
+    JSObject *decoder = JS_VALUE_GET_OBJ(arg_buf[4]);
+    JSObject *helper = JS_VALUE_GET_OBJ(arg_buf[6]);
+    if (decoder->class_id != JS_CLASS_BYTECODE_FUNCTION ||
+        helper->class_id != JS_CLASS_OBJECT || helper->is_exotic)
+        return 0;
+    if (region->binding_ready && region->bound_decoder == decoder &&
+        region->bound_helper == helper &&
+        region->bound_helper_shape == helper->shape) {
+        JSDecoderCache *cache = decoder->u.func.decoder_cache;
+        if (cache == NULL || cache->array != region->bound_decoder_array ||
+            cache->mutation_version != region->bound_decoder_mutation_version ||
+            cache->array->mutation_version != cache->mutation_version)
+            return 0;
+        for (int index = 0; index < 8; index++) {
+            if (js_region_property_bytecode(
+                    helper, region->helper_atoms[index]) !=
+                region->helper_targets[index])
+                return 0;
+        }
+        return 1;
+    }
+
+    const uint16_t helper_field_offsets[8] = {
+        7, 52, 98, 119, 156, 192, 206, 235,
+    };
+    const uint8_t helper_opcodes[8] = {
+        OP_strict_neq, OP_strict_neq, OP_xor, OP_and,
+        OP_add, OP_add, OP_mul, OP_mul,
+    };
+    JSAtom condition_atom = JS_ATOM_NULL;
+    JSAtom helper_atoms[8] = {0};
+    JSFunctionBytecode *targets[8] = {0};
+    const uint8_t *code = owner->byte_code_buf + region->start_pc;
+    int decoded = js_region_decode_atom(
+        ctx, rt, arg_buf[3], arg_buf[4], get_u32(code + 20),
+        &condition_atom);
+    if (decoded <= 0)
+        return decoded;
+    if (condition_atom != JS_ATOM_length)
+        goto reject;
+    for (int index = 0; index < 8; index++) {
+        decoded = js_region_decode_atom(
+            ctx, rt, arg_buf[3], arg_buf[4],
+            get_u32(code + helper_field_offsets[index] + 1),
+            &helper_atoms[index]);
+        if (decoded <= 0) {
+            if (decoded < 0)
+                goto fail;
+            goto reject;
+        }
+        targets[index] = js_region_property_bytecode(
+            helper, helper_atoms[index]);
+        if (!js_region_tiny_operation(targets[index], helper_opcodes[index]))
+            goto reject;
+    }
+    JSDecoderCache *cache = decoder->u.func.decoder_cache;
+    if (cache == NULL || cache->array == NULL ||
+        cache->mutation_version == UINT32_MAX ||
+        cache->array->mutation_version != cache->mutation_version)
+        goto reject;
+    if (region->binding_ready) {
+        JS_FreeAtom(ctx, region->condition_atom);
+        for (int index = 0; index < 8; index++)
+            JS_FreeAtom(ctx, region->helper_atoms[index]);
+    }
+    region->condition_atom = condition_atom;
+    for (int index = 0; index < 8; index++) {
+        region->helper_atoms[index] = helper_atoms[index];
+        region->helper_targets[index] = targets[index];
+    }
+    region->bound_decoder = decoder;
+    region->bound_helper = helper;
+    region->bound_helper_shape = helper->shape;
+    region->bound_decoder_array = cache->array;
+    region->bound_decoder_mutation_version = cache->mutation_version;
+    region->binding_ready = TRUE;
+    return 1;
+
+reject:
+    decoded = 0;
+fail:
+    if (condition_atom != JS_ATOM_NULL)
+        JS_FreeAtom(ctx, condition_atom);
+    for (int index = 0; index < 8; index++)
+        if (helper_atoms[index] != JS_ATOM_NULL)
+            JS_FreeAtom(ctx, helper_atoms[index]);
+    return decoded;
+}
+
+/* Execute the stable arithmetic-VM backedge as one guarded C region.  The
+   recognizer above proves the decoder and helper operation semantics; the
+   only intentionally dynamic operation left is the final handler call. */
+#ifdef CONFIG_EXECUTION_PROFILE
+static uint64_t js_profile_arithmetic_state_hash(
+    JSObject *state, BOOL ignore_clock_slots)
+{
+    uint64_t hash = UINT64_C(1469598103934665603);
+    for (uint32_t index = 0; index < state->u.array.count; index++) {
+        if (ignore_clock_slots && (index == 64 || index == 95))
+            continue;
+        JSValueConst value = state->u.array.u.values[index];
+        int tag = JS_VALUE_GET_TAG(value);
+        uint64_t bits = (uint32_t)tag;
+        if (tag == JS_TAG_INT || tag == JS_TAG_BOOL ||
+            tag == JS_TAG_NULL || tag == JS_TAG_UNDEFINED) {
+            bits = (bits << 32) ^ (uint32_t)JS_VALUE_GET_INT(value);
+        } else if (JS_TAG_IS_FLOAT64(tag)) {
+            union { double d; uint64_t u; } raw;
+            raw.d = JS_VALUE_GET_FLOAT64(value);
+            bits ^= raw.u;
+        } else if (tag == JS_TAG_OBJECT) {
+            JSObject *object = JS_VALUE_GET_OBJ(value);
+            bits = (bits << 32) ^ object->class_id;
+        }
+        hash ^= bits ^ ((uint64_t)index << 40);
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+static void js_profile_print_value(
+    JSContext *ctx, const char *label, JSValueConst value)
+{
+    int tag = JS_VALUE_GET_TAG(value);
+    fprintf(stderr, " %s-tag=%d", label, tag);
+    if (tag == JS_TAG_INT || tag == JS_TAG_BOOL)
+        fprintf(stderr, " %s-int=%d", label, JS_VALUE_GET_INT(value));
+    else if (JS_TAG_IS_FLOAT64(tag))
+        fprintf(stderr, " %s-float=%.17g", label,
+                JS_VALUE_GET_FLOAT64(value));
+    else if (tag == JS_TAG_STRING || tag == JS_TAG_STRING_ROPE) {
+        const char *text = JS_ToCString(ctx, value);
+        fprintf(stderr, " %s-string=%s", label,
+                text != NULL ? text : "<unavailable>");
+        if (text != NULL)
+            JS_FreeCString(ctx, text);
+    }
+}
