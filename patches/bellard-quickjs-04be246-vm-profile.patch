+/* A bounded, architecture-neutral micro-op tier for whole bytecode functions
+   that are proven side-effect free by construction.  It deliberately starts
+   with integer/boolean data and local-only control flow: a failed type or
+   overflow guard restarts the untouched function in the normal interpreter.
+   This makes the same representation usable on the PSP and in the lab. */
+typedef enum {
+    JS_PORTABLE_GET_ARG,
+    JS_PORTABLE_GET_LOCAL,
+    JS_PORTABLE_PUT_LOCAL,
+    JS_PORTABLE_SET_LOCAL,
+    JS_PORTABLE_INVALIDATE_LOCAL,
+    JS_PORTABLE_PUT_LOCAL_CHECK,
+    JS_PORTABLE_SET_LOCAL_CHECK,
+    JS_PORTABLE_INC_LOCAL,
+    JS_PORTABLE_DEC_LOCAL,
+    JS_PORTABLE_ADD_LOCAL,
+    JS_PORTABLE_CONST_INT,
+    JS_PORTABLE_CONST_BOOL,
+    JS_PORTABLE_DROP,
+    JS_PORTABLE_DUP,
+    JS_PORTABLE_SWAP,
+    JS_PORTABLE_NEG,
+    JS_PORTABLE_INC,
+    JS_PORTABLE_DEC,
+    JS_PORTABLE_POST_INC,
+    JS_PORTABLE_POST_DEC,
+    JS_PORTABLE_GET_LENGTH,
+    JS_PORTABLE_GET_ARRAY,
+    JS_PORTABLE_PUT_ARRAY,
+    JS_PORTABLE_BIT_NOT,
+    JS_PORTABLE_LOGICAL_NOT,
+    JS_PORTABLE_ADD,
+    JS_PORTABLE_SUB,
+    JS_PORTABLE_MUL,
+    JS_PORTABLE_SHL,
+    JS_PORTABLE_SAR,
+    JS_PORTABLE_SHR,
+    JS_PORTABLE_AND,
+    JS_PORTABLE_XOR,
+    JS_PORTABLE_OR,
+    JS_PORTABLE_LT,
+    JS_PORTABLE_LTE,
+    JS_PORTABLE_GT,
+    JS_PORTABLE_GTE,
+    JS_PORTABLE_EQ,
+    JS_PORTABLE_NEQ,
+    JS_PORTABLE_STRICT_EQ,
+    JS_PORTABLE_STRICT_NEQ,
+    JS_PORTABLE_IF_FALSE,
+    JS_PORTABLE_IF_TRUE,
+    JS_PORTABLE_GOTO,
+    JS_PORTABLE_RETURN,
+} JSPortableOpcode;
