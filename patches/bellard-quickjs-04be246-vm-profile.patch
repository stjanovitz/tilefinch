+        {51, OP_get_arg3}, {52, OP_get_field}, {57, OP_call1},
+        {58, OP_get_array_el2}, {59, OP_get_arg}, {62, OP_get_arg},
+        {65, OP_call_method}, {68, OP_if_false8},
+        {79, OP_get_arg}, {82, OP_get_arg}, {85, OP_get_arg},
+        {88, OP_push_1}, {89, OP_add}, {90, OP_put_array_el},
