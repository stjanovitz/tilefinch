+/* Cache the immutable layout and values of large primitive object literals
+   and capture-free named-function tables.
+   Each execution still receives a fresh, extensible object and independent
+   property storage. Other reference-valued properties, computed keys,
+   duplicate names, and observable evaluation are left to the interpreter. */
+static JSValue js_new_cached_primitive_object_literal(
+    JSContext *ctx, JSFunctionBytecode *bytecode,
+    const uint8_t *object_instruction, const uint8_t **next_pc)
+{
+    uint32_t object_pc =
+        (uint32_t)(object_instruction - bytecode->byte_code_buf);
+    JSObjectLiteralTemplate *template = js_object_literal_cache_lookup(
+        bytecode, object_pc);
+    if (template != NULL && template->shape == NULL)
+        return JS_NewObject(ctx);
+
+    if (template == NULL) {
+        const uint8_t *start = object_instruction + 1;
+        const uint8_t *end = bytecode->byte_code_buf +
+                             bytecode->byte_code_len;
+        const uint8_t *cursor = start;
+        unsigned int property_count = 0;
+        for (;;) {
+            JSAtom atom;
+            JSAtom inferred_name;
+            JSValue value;
+            int property_size = js_parse_cached_literal_property(
+                bytecode, cursor, end, &atom, &value, &inferred_name);
+            if (property_size == 0 || property_count >= UINT16_MAX)
+                break;
+            for (const uint8_t *prior = start; prior < cursor;) {
+                JSAtom prior_atom;
+                JSAtom prior_name;
+                JSValue prior_value;
+                int prior_size = js_parse_cached_literal_property(
+                    bytecode, prior, end, &prior_atom, &prior_value,
+                    &prior_name);
+                assert(prior_size > 0);
+                if (prior_atom == atom)
+                    return js_reject_cached_object_literal(
+                        ctx, bytecode, object_pc);
+                if (inferred_name != JS_ATOM_NULL &&
+                    prior_name != JS_ATOM_NULL &&
+                    JS_VALUE_GET_PTR(prior_value) == JS_VALUE_GET_PTR(value) &&
+                    prior_name != inferred_name)
+                    return js_reject_cached_object_literal(
+                        ctx, bytecode, object_pc);
+                prior += prior_size;
+            }
+            property_count++;
+            cursor += property_size;
+        }
+        if (property_count < 8)
+            return js_reject_cached_object_literal(
+                ctx, bytecode, object_pc);
+
+        size_t allocation_size = sizeof(*template) +
+            sizeof(template->properties[0]) * property_count;
+        template = js_mallocz(ctx, allocation_size);
+        if (unlikely(template == NULL))
+            return JS_EXCEPTION;
+
+        unsigned int hash_size = JS_PROP_INITIAL_HASH_SIZE;
+        while (hash_size < property_count * 2)
+            hash_size <<= 1;
+        template->shape = js_new_shape2(
+            ctx, get_proto_obj(ctx->class_proto[JS_CLASS_OBJECT]),
+            hash_size, property_count);
+        if (unlikely(template->shape == NULL)) {
+            js_free(ctx, template);
+            return JS_EXCEPTION;
+        }
+
+        cursor = start;
+        for (unsigned int index = 0; index < property_count; index++) {
+            JSAtom atom;
+            JSAtom inferred_name;
+            JSValue value;
+            int property_size = js_parse_cached_literal_property(
+                bytecode, cursor, end, &atom, &value, &inferred_name);
+            assert(property_size > 0);
+            if (unlikely(add_shape_property(
+                    ctx, &template->shape, NULL, atom, JS_PROP_C_W_E) < 0)) {
+                js_free_shape(ctx->rt, template->shape);
+                js_free(ctx, template);
+                return JS_EXCEPTION;
+            }
+            template->properties[index].u.value = value;
+            if (JS_VALUE_HAS_REF_COUNT(value))
+                template->has_reference_values = TRUE;
+            if (inferred_name != JS_ATOM_NULL) {
+                JSFunctionBytecode *function = JS_VALUE_GET_PTR(value);
+                if (!function->deferred_name_set) {
+                    function->deferred_name_atom =
+                        JS_DupAtom(ctx, inferred_name);
+                    function->deferred_name_set = TRUE;
+                } else if (function->deferred_name_atom != inferred_name) {
+                    function->deferred_name_conflict = TRUE;
+                }
+                template->has_named_functions = TRUE;
+#ifdef CONFIG_EXECUTION_PROFILE
+                ctx->rt->profile_named_function_literal_properties++;
+#endif
+            }
+            cursor += property_size;
+        }
+        template->object_pc = object_pc;
+        template->end_pc = (uint32_t)(cursor - bytecode->byte_code_buf);
+        template->property_count = property_count;
+        if (unlikely(js_object_literal_cache_insert(
+                ctx, bytecode, template) < 0)) {
+            js_free_shape(ctx->rt, template->shape);
+            js_free(ctx, template);
+            return JS_EXCEPTION;
+        }
+#ifdef CONFIG_EXECUTION_PROFILE
+        ctx->rt->profile_object_literal_template_builds++;
+        ctx->rt->profile_object_literal_template_properties += property_count;
+#endif
+    }
+
+    JSValue object = JS_NewObjectFromShape(
+        ctx, js_dup_shape(template->shape), JS_CLASS_OBJECT, NULL);
+    if (unlikely(JS_IsException(object)))
+        return object;
+    if (!template->has_reference_values) {
+        memcpy(JS_VALUE_GET_OBJ(object)->prop, template->properties,
+               sizeof(template->properties[0]) * template->property_count);
+    } else {
+        JSProperty *properties = JS_VALUE_GET_OBJ(object)->prop;
+        for (unsigned int index = 0; index < template->property_count;
+             index++) {
+            properties[index].u.value = JS_DupValue(
+                ctx, template->properties[index].u.value);
+        }
+    }
+    *next_pc = bytecode->byte_code_buf + template->end_pc;
+#ifdef CONFIG_EXECUTION_PROFILE
+    ctx->rt->profile_object_literal_template_hits++;
+    if (template->has_named_functions)
+        ctx->rt->profile_named_function_literal_hits++;
+#endif
+    return object;
+}
