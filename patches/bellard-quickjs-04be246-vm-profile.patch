+static int js_parse_primitive_literal_property(
+    JSFunctionBytecode *bytecode, const uint8_t *cursor, const uint8_t *end,
+    JSAtom *atom, JSValue *value)
+{
+    int push_size;
+    switch (cursor < end ? cursor[0] : -1) {
+    case OP_push_i32:
+        push_size = 5;
+        if (cursor + push_size > end)
+            return 0;
+        *value = JS_NewInt32(NULL, (int32_t)get_u32(cursor + 1));
+        break;
+    case OP_push_const: {
+        push_size = 5;
+        if (cursor + push_size > end)
+            return 0;
+        uint32_t index = get_u32(cursor + 1);
+        if (index >= (uint32_t)bytecode->cpool_count ||
+            JS_VALUE_HAS_REF_COUNT(bytecode->cpool[index]))
+            return 0;
+        *value = bytecode->cpool[index];
+        break;
+    }
+    case OP_undefined:
+        push_size = 1;
+        *value = JS_UNDEFINED;
+        break;
+    case OP_null:
+        push_size = 1;
+        *value = JS_NULL;
+        break;
+    case OP_push_false:
+        push_size = 1;
+        *value = JS_FALSE;
+        break;
+    case OP_push_true:
+        push_size = 1;
+        *value = JS_TRUE;
+        break;
+#if SHORT_OPCODES
+    case OP_push_minus1:
+    case OP_push_0:
+    case OP_push_1:
+    case OP_push_2:
+    case OP_push_3:
+    case OP_push_4:
+    case OP_push_5:
+    case OP_push_6:
+    case OP_push_7:
+        push_size = 1;
+        *value = JS_NewInt32(NULL, cursor[0] - OP_push_0);
+        break;
+    case OP_push_i8:
+        push_size = 2;
+        if (cursor + push_size > end)
+            return 0;
+        *value = JS_NewInt32(NULL, get_i8(cursor + 1));
+        break;
+    case OP_push_i16:
+        push_size = 3;
+        if (cursor + push_size > end)
+            return 0;
+        *value = JS_NewInt32(NULL, get_i16(cursor + 1));
+        break;
+    case OP_push_const8: {
+        push_size = 2;
+        if (cursor + push_size > end)
+            return 0;
+        uint32_t index = cursor[1];
+        if (index >= (uint32_t)bytecode->cpool_count ||
+            JS_VALUE_HAS_REF_COUNT(bytecode->cpool[index]))
+            return 0;
+        *value = bytecode->cpool[index];
+        break;
+    }
+#endif
+    default:
+        return 0;
+    }
+    if (cursor + push_size + 5 > end ||
+        cursor[push_size] != OP_define_field)
+        return 0;
+    *atom = get_u32(cursor + push_size + 1);
+    return push_size + 5;
+}
