+static JSValue js_reject_cached_object_literal(
+    JSContext *ctx, JSFunctionBytecode *bytecode, uint32_t object_pc)
+{
+    JSObjectLiteralTemplate *template = js_mallocz(ctx, sizeof(*template));
+    if (unlikely(template == NULL))
+        return JS_EXCEPTION;
+    template->object_pc = object_pc;
+    if (unlikely(js_object_literal_cache_insert(
+            ctx, bytecode, template) < 0)) {
+        js_free(ctx, template);
+        return JS_EXCEPTION;
+    }
+#ifdef CONFIG_EXECUTION_PROFILE
+    ctx->rt->profile_object_literal_template_rejects++;
+#endif
+    return JS_NewObject(ctx);
+}
