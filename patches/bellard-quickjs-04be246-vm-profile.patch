+static BOOL js_try_direct_bound_vm_handler(
+    JSContext *ctx, JSObject *handler, JSValueConst argument,
+    JSValue *result)
+{
+    if (handler->class_id != JS_CLASS_BOUND_FUNCTION)
+        return FALSE;
+    JSBoundFunction *bound = handler->u.bound_function;
+    if (bound == NULL || bound->argc < 0 || bound->argc > 2 ||
+        JS_VALUE_GET_TAG(bound->func_obj) != JS_TAG_OBJECT)
+        return FALSE;
+    JSObject *target = JS_VALUE_GET_OBJ(bound->func_obj);
+    if (target->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return FALSE;
+    JSFunctionBytecode *bytecode = target->u.func.function_bytecode;
+    JSValue args[3];
+    for (int index = 0; index < bound->argc; index++)
+        args[index] = bound->argv[index];
+    args[bound->argc] = argument;
+    int argc = bound->argc + 1;
+    switch (bytecode->byte_code_len) {
+    case 414:
+        return js_try_byte_stream_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 362:
+        return js_try_state_decode_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 460:
+        return js_try_word_pack_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 534:
+        return js_try_varint_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 1224:
+        return js_try_unary_handler(
+            ctx, bytecode, bound->this_val, argc, args, result);
+    case 425:
+        return js_try_nested_load_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 538:
+        return js_try_varint_store_handler(
+            ctx, bytecode, bound->this_val, result);
+    case 2172:
+        return js_try_decoded_call_handler(
+            ctx, bytecode, target, bound->this_val, result);
+    case 6984:
+#ifdef CONFIG_EXECUTION_PROFILE
+        if (js_profile_disable_ev_binary())
+            return FALSE;
+#endif
+        return js_try_ev_binary_handler(
+            ctx, bytecode, bound->this_val, argc, args, result);
+    default:
+        return FALSE;
+    }
+}
+
+static int js_try_arithmetic_vm_region(
+    JSContext *ctx, JSRuntime *rt, JSStackFrame *sf,
+    JSFunctionBytecode *owner, JSValue *arg_buf,
+    const uint8_t **pc_ptr)
+{
+    JSArithmeticRegion *region = owner->arithmetic_region;
+    if (region == NULL ||
+        (uint32_t)(*pc_ptr - owner->byte_code_buf - 1) != region->start_pc)
+        return 0;
+    int bound = js_bind_arithmetic_region(
+        ctx, rt, owner, region, arg_buf);
+    if (bound <= 0) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_arithmetic_region_guard_exits++;
+#endif
+        return bound;
+    }
+    if (JS_VALUE_GET_TAG(arg_buf[0]) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(arg_buf[7]) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(arg_buf[8]) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(arg_buf[9]) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(arg_buf[10]) != JS_TAG_INT ||
+        JS_VALUE_GET_TAG(arg_buf[12]) != JS_TAG_OBJECT)
+        return 0;
+    JSObject *input = JS_VALUE_GET_OBJ(arg_buf[0]);
+    JSObject *state = JS_VALUE_GET_OBJ(arg_buf[7]);
+    JSObject *data = JS_VALUE_GET_OBJ(arg_buf[12]);
+    int32_t state_index = JS_VALUE_GET_INT(arg_buf[9]);
+    int32_t accumulator_index = JS_VALUE_GET_INT(arg_buf[10]);
+    int32_t handler_xor = JS_VALUE_GET_INT(arg_buf[8]);
+    if (input->class_id != JS_CLASS_ARRAY || !input->fast_array ||
+        state->class_id != JS_CLASS_ARRAY || !state->fast_array ||
+        data->class_id != JS_CLASS_UINT8_ARRAY ||
+        state_index < 0 || accumulator_index < 0 ||
+        (uint32_t)state_index >= state->u.array.count ||
+        (uint32_t)accumulator_index >= state->u.array.count)
+        return 0;
+
+    int completed = 0;
+    for (; completed < 256 && input->u.array.count != 0; completed++) {
+        JSValueConst cursor_value =
+            state->u.array.u.values[(uint32_t)state_index];
+        JSValueConst accumulator_value =
+            state->u.array.u.values[(uint32_t)accumulator_index];
+        if (JS_VALUE_GET_TAG(cursor_value) != JS_TAG_INT ||
+            JS_VALUE_GET_TAG(accumulator_value) != JS_TAG_INT)
+            break;
+        int32_t cursor = JS_VALUE_GET_INT(cursor_value);
+        int32_t accumulator = JS_VALUE_GET_INT(accumulator_value);
+        if (cursor < 0 || (uint32_t)cursor >= data->u.array.count)
+            break;
+        int32_t mixed = region->offset_constant +
+            data->u.array.u.uint8_ptr[(uint32_t)cursor];
+        int32_t z = accumulator ^ (mixed & region->byte_mask);
+        int32_t x = accumulator + z;
+        int32_t handler_index = handler_xor ^ z;
+        if (handler_index < 0 ||
+            (uint32_t)handler_index >= state->u.array.count)
+            break;
+        JSValueConst handler_value =
+            state->u.array.u.values[(uint32_t)handler_index];
+        BOOL callable = JS_VALUE_GET_TAG(handler_value) ==
+                            JS_TAG_FUNCTION_BYTECODE;
+        if (JS_VALUE_GET_TAG(handler_value) == JS_TAG_OBJECT) {
+            JSObject *handler = JS_VALUE_GET_OBJ(handler_value);
+            callable = rt->class_array[handler->class_id].call != NULL;
+        }
+        if (!callable)
+            break;
+        ctx->interrupt_counter -= 18;
+        if (unlikely(ctx->interrupt_counter <= 0 &&
+            js_profile_poll_interrupts_force(
+                ctx, JS_PROFILE_POLL_CALL_ENTRY)))
+            return -1;
+
+        double updated = (double)x * (double)x;
+        updated = updated * (double)region->multiply_a +
+                  (double)x * (double)region->multiply_b;
+        updated += (double)region->add_constant;
+        int32_t updated_i32;
+        if (unlikely(JS_ToInt32(
+                ctx, &updated_i32, JS_NewFloat64(ctx, updated))))
+            return -1;
+        updated_i32 &= region->final_mask;
+
+        set_value(ctx,
+                  &state->u.array.u.values[(uint32_t)state_index],
+                  JS_NewInt32(ctx, cursor + 1));
+        js_note_object_mutation(state);
+        set_value(ctx,
+                  &state->u.array.u.values[(uint32_t)accumulator_index],
+                  JS_NewInt32(ctx, updated_i32));
+        js_note_object_mutation(state);
+        set_value(ctx, &arg_buf[16], JS_NewInt32(ctx, cursor));
+        set_value(ctx, &arg_buf[17], JS_NewInt32(ctx, z));
+        set_value(ctx, &arg_buf[18], JS_NewInt32(ctx, x));
+
+        JSValue argument = JS_NewInt32(ctx, z);
+        sf->cur_pc = owner->byte_code_buf + region->end_pc;
+        JSValue result;
+        BOOL direct = JS_VALUE_GET_TAG(handler_value) == JS_TAG_OBJECT &&
+            js_try_direct_bound_vm_handler(
+                ctx, JS_VALUE_GET_OBJ(handler_value), argument, &result);
+        if (!direct) {
+            JSValue handler = JS_DupValue(ctx, handler_value);
+            result = JS_CallInternal(
+                ctx, handler, JS_MKPTR(JS_TAG_OBJECT, state), JS_UNDEFINED,
+                1, &argument, 0);
+            JS_FreeValue(ctx, handler);
+        }
+        JS_FreeValue(ctx, argument);
+        if (unlikely(JS_IsException(result)))
+            return -1;
+        JS_FreeValue(ctx, result);
+#ifdef CONFIG_EXECUTION_PROFILE
+        uint64_t iteration = rt->profile_arithmetic_region_iterations +
+            (uint64_t)completed + 1;
+        if (rt->profile_arithmetic_checkpoint_count < 16 &&
+            iteration >=
+                ((uint64_t)rt->profile_arithmetic_checkpoint_count + 1) *
+                    UINT64_C(100000)) {
+            int checkpoint = rt->profile_arithmetic_checkpoint_count++;
+            rt->profile_arithmetic_checkpoint_hashes[checkpoint] =
+                js_profile_arithmetic_state_hash(state, FALSE);
+            rt->profile_arithmetic_checkpoint_no_clock_hashes[checkpoint] =
+                js_profile_arithmetic_state_hash(state, TRUE);
+            if (state->u.array.count > 95) {
+                union { double d; uint64_t u; } raw;
+                JSValueConst clock64 = state->u.array.u.values[64];
+                JSValueConst clock95 = state->u.array.u.values[95];
+                if (JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(clock64))) {
+                    raw.d = JS_VALUE_GET_FLOAT64(clock64);
+                    rt->profile_arithmetic_checkpoint_clock64[checkpoint] =
+                        raw.u;
+                }
+                if (JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(clock95))) {
+                    raw.d = JS_VALUE_GET_FLOAT64(clock95);
+                    rt->profile_arithmetic_checkpoint_clock95[checkpoint] =
+                        raw.u;
+                }
+            }
+            if (checkpoint == 0) {
+                rt->profile_arithmetic_first_count =
+                    min_int(state->u.array.count, 256);
+                for (uint32_t index = 0;
+                     index < rt->profile_arithmetic_first_count; index++) {
+                    JSValueConst value = state->u.array.u.values[index];
+                    int tag = JS_VALUE_GET_TAG(value);
+                    int32_t payload = 0;
+                    if (tag == JS_TAG_INT || tag == JS_TAG_BOOL ||
+                        tag == JS_TAG_NULL || tag == JS_TAG_UNDEFINED) {
+                        payload = JS_VALUE_GET_INT(value);
+                    } else if (tag == JS_TAG_OBJECT) {
+                        payload = JS_VALUE_GET_OBJ(value)->class_id;
+                    } else if (JS_TAG_IS_FLOAT64(tag)) {
+                        union { double d; uint64_t u; } raw;
+                        raw.d = JS_VALUE_GET_FLOAT64(value);
+                        payload = (int32_t)(raw.u ^ (raw.u >> 32));
+                        rt->profile_arithmetic_first_bits[index] = raw.u;
+                    } else if (tag == JS_TAG_STRING ||
+                               tag == JS_TAG_STRING_ROPE) {
+                        payload = JS_VALUE_GET_STRING(value)->len;
+                    }
+                    rt->profile_arithmetic_first_tags[index] = tag;
+                    rt->profile_arithmetic_first_values[index] = payload;
+                }
+            }
+            JSValueConst checkpoint_cursor =
+                state->u.array.u.values[(uint32_t)state_index];
+            JSValueConst checkpoint_accumulator =
+                state->u.array.u.values[(uint32_t)accumulator_index];
+            rt->profile_arithmetic_checkpoint_cursors[checkpoint] =
+                JS_VALUE_GET_TAG(checkpoint_cursor) == JS_TAG_INT ?
+                JS_VALUE_GET_INT(checkpoint_cursor) : INT32_MIN;
+            rt->profile_arithmetic_checkpoint_accumulators[checkpoint] =
+                JS_VALUE_GET_TAG(checkpoint_accumulator) == JS_TAG_INT ?
+                JS_VALUE_GET_INT(checkpoint_accumulator) : INT32_MIN;
+        }
+#endif
+    }
+    if (completed == 0) {
+#ifdef CONFIG_EXECUTION_PROFILE
+        rt->profile_arithmetic_region_guard_exits++;
+#endif
+        return 0;
+    }
+    *pc_ptr = owner->byte_code_buf + region->start_pc;
+#ifdef CONFIG_EXECUTION_PROFILE
+    rt->profile_arithmetic_region_hits++;
+    rt->profile_arithmetic_region_iterations += completed;
+#endif
+    return 1;
+}
