+            rt->profile_fused_arg_post_inc_array_hits);
+    fprintf(stderr, "js-profile arg-post-inc patterns=%" PRIu64
+            " receiver-nonobject=%" PRIu64
+            " not-fast-array=%" PRIu64 " index-nonint=%" PRIu64
+            " index-oob=%" PRIu64 " index-overflow=%" PRIu64,
+            rt->profile_arg_post_inc_patterns,
+            rt->profile_arg_post_inc_receiver_nonobject,
+            rt->profile_arg_post_inc_not_fast_array,
+            rt->profile_arg_post_inc_index_nonint,
+            rt->profile_arg_post_inc_index_oob,
+            rt->profile_arg_post_inc_index_overflow);
+    for (int class_id = 0; class_id < 64; class_id++)
+        if (rt->profile_arg_post_inc_receiver_class[class_id])
+            fprintf(stderr, " class%d=%" PRIu64, class_id,
+                    rt->profile_arg_post_inc_receiver_class[class_id]);
+    fprintf(stderr, "\n");
+    fprintf(stderr, "js-profile fused-field-call-closure-store=%" PRIu64
+            "\n", rt->profile_fused_field_call_closure_store_hits);
+    fprintf(stderr, "js-profile fused-field-array-get=%" PRIu64
+            " fused-field-put-arg=%" PRIu64 "\n",
+            rt->profile_fused_field_array_get_hits,
+            rt->profile_fused_field_put_arg_hits);
+    fprintf(stderr, "js-profile fused-field-call-method1=%" PRIu64
+            " fused-field-call-method1-array=%" PRIu64 "\n",
+            rt->profile_fused_field_call_method1_hits,
+            rt->profile_fused_field_call_method1_array_hits);
+    fprintf(stderr, "js-profile fused-function-table-entries=%" PRIu64
+            "\n", rt->profile_fused_function_table_entries);
+    fprintf(stderr, "js-profile fused-decoder-field-array=%" PRIu64
+            "\n", rt->profile_fused_decoder_field_array_hits);
+    fprintf(stderr, "js-profile fused-arg-array-store=%" PRIu64
+            "\n", rt->profile_fused_arg_array_store_hits);
+    fprintf(stderr, "js-profile deferred-closure-stores=%" PRIu64
+            " materializations=%" PRIu64 "\n",
+            rt->profile_deferred_closure_stores,
+            rt->profile_deferred_closure_materializations);
+    fprintf(stderr, "js-profile put-array fast-append=%" PRIu64
+            " fast-replace=%" PRIu64 " slow=%" PRIu64
+            " function-values=%" PRIu64,
+            rt->profile_put_array_fast_append,
+            rt->profile_put_array_fast_replace,
+            rt->profile_put_array_slow,
+            rt->profile_put_array_slow_function_values);
+    for (int tag = 0; tag < 16; tag++) {
+        if (rt->profile_put_array_slow_receiver_tags[tag])
+            fprintf(stderr, " receiver-tag%d=%" PRIu64, tag,
+                    rt->profile_put_array_slow_receiver_tags[tag]);
+        if (rt->profile_put_array_slow_key_tags[tag])
+            fprintf(stderr, " key-tag%d=%" PRIu64, tag,
+                    rt->profile_put_array_slow_key_tags[tag]);
+    }
+    for (int class_id = 0; class_id < 64; class_id++) {
+        if (rt->profile_put_array_slow_receiver_classes[class_id])
+            fprintf(stderr, " receiver-class%d=%" PRIu64, class_id,
+                    rt->profile_put_array_slow_receiver_classes[class_id]);
+    }
+    fprintf(stderr, "\n");
+    for (int opcode = 0; opcode < 256; opcode++) {
+        uint64_t total_count = rt->profile_fclosure_next_opcode[opcode];
+        uint64_t capture_free_count =
+            rt->profile_fclosure_capture_free_next_opcode[opcode];
+        if (total_count == 0)
+            continue;
+        fprintf(stderr, "js-profile fclosure-next opcode=%d name=%s"
+                " total=%" PRIu64 " capture-free=%" PRIu64 "\n",
+                opcode,
+                profile_opcode_names[opcode] ? profile_opcode_names[opcode] : "?",
+                total_count, capture_free_count);
+    }
+    for (int rank = 0; rank < 20 && top_opcodes[rank] >= 0; rank++) {
+        int opcode = top_opcodes[rank];
+        if (rt->profile_opcode_counts[opcode] == 0) break;
+        fprintf(stderr, "js-profile opcode rank=%d opcode=%d name=%s count=%" PRIu64 "\n",
+                rank + 1, opcode,
+                profile_opcode_names[opcode] ? profile_opcode_names[opcode] : "?",
+                rt->profile_opcode_counts[opcode]);
+    }
+    for (int rank = 0; rank < 20 && top_pairs[rank] != UINT16_MAX; rank++) {
+        int first = top_pairs[rank] >> 8;
+        int second = top_pairs[rank] & 0xff;
+        fprintf(stderr, "js-profile pair rank=%d first=%s second=%s"
+                " count=%u\n", rank + 1,
+                profile_opcode_names[first] ? profile_opcode_names[first] : "?",
+                profile_opcode_names[second] ? profile_opcode_names[second] : "?",
+                rt->profile_opcode_pairs[first][second]);
+    }
+    for (int rank = 0; rank < 20 && top_functions[rank] != NULL; rank++) {
+        JSFunctionBytecode *function = top_functions[rank];
+        if (function->profile_opcodes == 0) break;
+        char name_buffer[ATOM_GET_STR_BUF_SIZE];
+        char filename_buffer[ATOM_GET_STR_BUF_SIZE];
+        JSContext *ctx = function->realm;
+        const char *name = JS_AtomGetStr(ctx, name_buffer,
+                                        sizeof(name_buffer),
+                                        function->func_name);
+        const char *filename;
+        if (function->has_debug)
+            filename = JS_AtomGetStr(ctx, filename_buffer,
+                                     sizeof(filename_buffer),
+                                     function->debug.filename);
+        else
+            filename = "?";
+        fprintf(stderr, "js-profile function rank=%d ptr=%p calls=%" PRIu64
+                " opcodes=%" PRIu64 " bytecode=%d name=%s file=%s\n",
+                rank + 1, (void *)function, function->profile_calls,
+                function->profile_opcodes, function->byte_code_len, name, filename);
+        fprintf(stderr, "js-profile function-args rank=%d", rank + 1);
+        for (int argument = 0; argument < min_int(function->arg_count, 32);
+             argument++) {
+            if (function->profile_arg_tag_masks[argument] != 0) {
+                fprintf(stderr, " a%d:tags=%08" PRIx32 ":classes=%016" PRIx64,
+                        argument,
+                        function->profile_arg_tag_masks[argument],
+                        function->profile_arg_class_masks[argument]);
+            }
+        }
+        fprintf(stderr, "\n");
+        if (function->byte_code_len <= 64) {
+            fprintf(stderr, "js-profile bytecode ptr=%p", (void *)function);
+            for (int pc = 0; pc < function->byte_code_len;) {
+                int opcode = function->byte_code_buf[pc];
+                fprintf(stderr, " pc=%d:%s", pc,
+                        profile_opcode_names[opcode] ?
+                        profile_opcode_names[opcode] : "?");
+                int size = short_opcode_info(opcode).size;
+                pc += size > 0 ? size : 1;
+            }
+            fprintf(stderr, "\njs-profile bytes ptr=%p data=", (void *)function);
+            for (int pc = 0; pc < function->byte_code_len; pc++)
+                fprintf(stderr, "%02x", function->byte_code_buf[pc]);
+            fprintf(stderr, "\n");
+        }
+    }
+    for (int function_rank = 0; function_rank < 8 &&
+                                top_functions[function_rank] != NULL;
+         function_rank++) {
+        JSFunctionBytecode *function = top_functions[function_rank];
+        if (function->profile_opcodes == 0)
+            break;
+        fprintf(stderr, "js-profile top-function-instructions rank=%d ptr=%p"
+                " bytecode=%d\n", function_rank + 1, (void *)function,
+                function->byte_code_len);
+        for (int pc = 0; pc < function->byte_code_len;) {
+            int opcode = function->byte_code_buf[pc];
+            int size = short_opcode_info(opcode).size;
+            if (size <= 0)
+                size = 1;
+            fprintf(stderr, "js-profile top-instruction rank=%d pc=%d"
+                    " name=%s bytes=", function_rank + 1, pc,
+                    profile_opcode_names[opcode] ?
+                        profile_opcode_names[opcode] : "?");
+            for (int offset = 0;
+                 offset < size && pc + offset < function->byte_code_len;
+                 offset++) {
+                fprintf(stderr, "%02x", function->byte_code_buf[pc + offset]);
+            }
+            fprintf(stderr, "\n");
+            pc += size;
+        }
+    }
+    for (int rank = 0; rank < 20 && top_pcs[rank] != SIZE_MAX; rank++) {
+        size_t index = top_pcs[rank];
+        if (rt->profile_pc_hotspots[index].count == 0) break;
+        fprintf(stderr, "js-profile pc rank=%d function=%p pc=%u count=%" PRIu64 "\n",
+                rank + 1, rt->profile_pc_hotspots[index].function,
+                rt->profile_pc_hotspots[index].pc,
+                rt->profile_pc_hotspots[index].count);
+    }
+    void *window_functions[4] = {0};
+    uint32_t window_pcs[4] = {0};
+    int window_count = 0;
+    for (int rank = 0; rank < 20 && window_count < 4 &&
+                       top_pcs[rank] != SIZE_MAX; rank++) {
+        size_t index = top_pcs[rank];
+        JSFunctionBytecode *function =
+            rt->profile_pc_hotspots[index].function;
+        uint32_t hot_pc = rt->profile_pc_hotspots[index].pc;
+        BOOL duplicate = FALSE;
+        for (int prior = 0; prior < window_count; prior++) {
+            if (window_functions[prior] == function &&
+                abs((int)window_pcs[prior] - (int)hot_pc) < 64) {
+                duplicate = TRUE;
+                break;
+            }
+        }
+        if (duplicate) continue;
+        window_functions[window_count] = function;
+        window_pcs[window_count] = hot_pc;
+        int column = 0;
+        int line = function->has_debug ?
+            find_line_num(function->realm, function, hot_pc, &column) : -1;
+        fprintf(stderr, "js-profile window function=%p hot-pc=%u line=%d column=%d\n",
+                (void *)function, hot_pc, line, column);
+        for (int pc = 0; pc < function->byte_code_len;) {
+            int opcode = function->byte_code_buf[pc];
+            int size = short_opcode_info(opcode).size;
+            if (size <= 0) size = 1;
+            if (pc >= (int)hot_pc - 40 && pc <= (int)hot_pc + 40) {
+                fprintf(stderr, "js-profile instruction pc=%d name=%s bytes=",
+                        pc, profile_opcode_names[opcode] ?
+                        profile_opcode_names[opcode] : "?");
+                for (int offset = 0; offset < size &&
+                                     pc + offset < function->byte_code_len;
+                     offset++)
+                    fprintf(stderr, "%02x", function->byte_code_buf[pc + offset]);
+                fprintf(stderr, "\n");
+            }
+            pc += size;
+        }
+        window_count++;
+    }
+    for (int function_rank = 0; function_rank < 3 &&
+                                top_functions[function_rank] != NULL;
+         function_rank++) {
+        JSFunctionBytecode *function = top_functions[function_rank];
+        size_t function_pcs[3] = {SIZE_MAX, SIZE_MAX, SIZE_MAX};
+        for (size_t index = 0; index < countof(rt->profile_pc_hotspots);
+             index++) {
+            if (rt->profile_pc_hotspots[index].function != function ||
+                rt->profile_pc_hotspots[index].count == 0)
+                continue;
+            for (int rank = 0; rank < 3; rank++) {
+                size_t prior = function_pcs[rank];
+                if (prior == SIZE_MAX ||
+                    rt->profile_pc_hotspots[index].count >
+                        rt->profile_pc_hotspots[prior].count) {
+                    memmove(&function_pcs[rank + 1], &function_pcs[rank],
+                            (2 - rank) * sizeof(function_pcs[0]));
+                    function_pcs[rank] = index;
+                    break;
+                }
+            }
+        }
+        for (int rank = 0; rank < 3 && function_pcs[rank] != SIZE_MAX;
+             rank++) {
+            size_t index = function_pcs[rank];
+            uint32_t hot_pc = rt->profile_pc_hotspots[index].pc;
+            fprintf(stderr, "js-profile function-pc function-rank=%d"
+                    " pc-rank=%d function=%p pc=%u count=%" PRIu64 "\n",
+                    function_rank + 1, rank + 1, (void *)function, hot_pc,
+                    rt->profile_pc_hotspots[index].count);
+            for (int pc = 0; pc < function->byte_code_len;) {
+                int opcode = function->byte_code_buf[pc];
+                int size = short_opcode_info(opcode).size;
+                if (size <= 0) size = 1;
+                if (pc >= (int)hot_pc - 24 && pc <= (int)hot_pc + 24) {
+                    fprintf(stderr, "js-profile function-pc-instruction"
+                            " function-rank=%d pc=%d name=%s bytes=",
+                            function_rank + 1, pc,
+                            profile_opcode_names[opcode] ?
+                                profile_opcode_names[opcode] : "?");
+                    for (int offset = 0; offset < size &&
+                                         pc + offset < function->byte_code_len;
+                         offset++)
+                        fprintf(stderr, "%02x",
+                                function->byte_code_buf[pc + offset]);
+                    fprintf(stderr, "\n");
+                }
+                pc += size;
+            }
+        }
+    }
+}
+#endif
