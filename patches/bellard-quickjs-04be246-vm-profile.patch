+    if (get_u16(code + 43) != 16 || get_u16(code + 147) != 17 ||
+        get_u16(code + 177) != 18 || get_u16(code + 28) != 2 ||
+        get_u16(code + 66) != 2 || get_u16(code + 141) != 2 ||
+        get_u16(code + 144) != 2 || get_u16(code + 174) != 2 ||
+        get_u16(code + 226) != 2 || get_u16(code + 251) != 2 ||
+        get_u16(code + 258) != 2 || get_u16(code + 279) != 1 ||
+        get_i16(code + 283) != -283 || code[69] != 10)
