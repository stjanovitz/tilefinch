+// Tilefinch: store one IDCT block at component n, plane offset (x, y) in
+// full-resolution samples (multiples of 8), reduced by tilefinch_scale_shift.
+static void stbi__jpeg_idct_store(stbi__jpeg *z, int n, int x, int y, short data[64])
+{
+   int shift = z->tilefinch_scale_shift;
+   if (shift == 0) {
+      z->idct_block_kernel(z->img_comp[n].data+z->img_comp[n].w2*y+x, z->img_comp[n].w2, data);
+   } else {
+      STBI_SIMD_ALIGN(stbi_uc, block[64]);
+      int size = 8 >> shift, step = 1 << shift, area = shift * 2;
+      int stride = z->img_comp[n].w2 >> shift, i, j, u, v;
+      stbi_uc *out = z->img_comp[n].data + stride*(y >> shift) + (x >> shift);
+      z->idct_block_kernel(block, 8, data);
+      for (j=0; j < size; ++j) {
+         for (i=0; i < size; ++i) {
+            int sum = 0;
+            const stbi_uc *at = block + (j << shift)*8 + (i << shift);
+            for (v=0; v < step; ++v)
+               for (u=0; u < step; ++u)
+                  sum += at[v*8 + u];
+            out[j*stride + i] = (stbi_uc) ((sum + (1 << (area-1))) >> area);
+         }
+      }
+   }
+}
+
+// Tilefinch: a reduced progressive block is decoded in a full block that
+// holds the stored low-frequency values and 1 at every other nonzero
+// coefficient (refinement only tests and grows nonzero values, which stay
+// nonzero); afterwards the square and the nonzero map are stored back. A
+// block a first AC scan's EOB run skips is not touched, and stays in place.
+static short *stbi__jpeg_coeff_open(stbi__jpeg *z, int n, int bx, int by, short full[64])
+{
+   short *stored = z->img_comp[n].coeff + z->tilefinch_coeff_stride * (bx + by * z->img_comp[n].coeff_w);
+   int size = 8 >> z->tilefinch_scale_shift, i, u, v;
+   unsigned long long map;
+   if (z->tilefinch_coeff_stride == 64 || (z->eob_run && z->succ_high == 0 && z->spec_start != 0)) return stored;
+   memcpy(&map, stored + size*size, sizeof(map));
+   memset(full, 0, 64*sizeof(full[0]));
+   for (i=0; map != 0; i += 8, map >>= 8)
+      if (map & 255)
+         for (u=0; u < 8; ++u)
+            full[i + u] = (short) ((map >> u) & 1);
+   for (v=0; v < size; ++v)
+      for (u=0; u < size; ++u)
+         full[v*8 + u] = stored[v*size + u];
+   return full;
+}
+
+static void stbi__jpeg_coeff_close(stbi__jpeg *z, int n, int bx, int by, const short full[64])
+{
+   short *stored = z->img_comp[n].coeff + z->tilefinch_coeff_stride * (bx + by * z->img_comp[n].coeff_w);
+   int size = 8 >> z->tilefinch_scale_shift, i, u, v;
+   unsigned long long map;
+   if (full == stored) return;
+   memcpy(&map, stored + size*size, sizeof(map));
+   for (i=z->spec_start; i <= z->spec_end; ++i)
+      map |= (unsigned long long) (full[stbi__jpeg_dezigzag[i]] != 0) << stbi__jpeg_dezigzag[i];
+   memcpy(stored + size*size, &map, sizeof(map));
+   for (v=0; v < size; ++v)
+      for (u=0; u < size; ++u)
+         stored[v*size + u] = full[v*8 + u];
+}
