+// Tilefinch: store one IDCT block at component n, plane offset (x, y) in
+// full-resolution samples (multiples of 8), reduced by tilefinch_scale_shift.
+static void stbi__jpeg_idct_store(stbi__jpeg *z, int n, int x, int y, short data[64])
+{
+   int shift = z->tilefinch_scale_shift;
+   if (shift == 0) {
+      z->idct_block_kernel(z->img_comp[n].data+z->img_comp[n].w2*y+x, z->img_comp[n].w2, data);
+   } else {
+      STBI_SIMD_ALIGN(stbi_uc, block[64]);
+      int size = 8 >> shift, step = 1 << shift, area = shift * 2;
+      int stride = z->img_comp[n].w2 >> shift, i, j, u, v;
+      stbi_uc *out = z->img_comp[n].data + stride*(y >> shift) + (x >> shift);
+      z->idct_block_kernel(block, 8, data);
+      for (j=0; j < size; ++j) {
+         for (i=0; i < size; ++i) {
+            int sum = 0;
+            const stbi_uc *at = block + (j << shift)*8 + (i << shift);
+            for (v=0; v < step; ++v)
+               for (u=0; u < step; ++u)
+                  sum += at[v*8 + u];
+            out[j*stride + i] = (stbi_uc) ((sum + (1 << (area-1))) >> area);
+         }
+      }
+   }
 }
 
