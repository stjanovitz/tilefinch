+#ifdef CONFIG_TILEFINCH_EVAL_ROPE_TEST
+#define TILEFINCH_EVAL_PHYSICAL_WORK(scan, amount) \
+    ((scan)->physical_work += (amount))
+#else
+#define TILEFINCH_EVAL_PHYSICAL_WORK(scan, amount) ((void) 0)
