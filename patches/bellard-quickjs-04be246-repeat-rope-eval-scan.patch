+typedef struct {
+    const void *horizontal[JS_STRING_ROPE_MAX_DEPTH];
+    int8_t horizontal_tag[JS_STRING_ROPE_MAX_DEPTH];
+    uint8_t horizontal_count;
+    uint32_t skipped;
