+/* raw sums -> float tmp rows (hv intermediate); only the first `band` rows are valid, all are stored to scratch */
+#define HB_RAWF() \
+    "sv.q  C400, 0(%[d0])\n\tsv.q C410, 0(%[d1])\n\tsv.q C420, 0(%[d2])\n\tsv.q C430, 0(%[d3])\n\t" \
+    "sv.q  C500, 16(%[d0])\n\tsv.q C510, 16(%[d1])\n\tsv.q C520, 16(%[d2])\n\tsv.q C530, 16(%[d3])\n\t"
