+static av_noinline void lfl_v_pair(uint8_t *pix, ptrdiff_t stride, int tcA, int tcB)
+{
+    uint8_t *rp2 = pix - 3 * stride, *rp1 = pix - 2 * stride, *rp0 = pix - stride;
