+/* rows variant ("v_loop_filter": horizontal edge, rows p2..q2 are natural quads), two columns per block */
+#define LNA(m) m("C000","C010","C020","C030","C100","C110","C000","C110","C120","C130","C200","C210","C220","C720","C520")
+#define LNB(m) m("C300","C310","C320","C330","C400","C410","C300","C410","C420","C430","C230","C500","C510","C730","C530")
