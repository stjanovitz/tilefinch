+    SwdecPipe *pipe = swdec_pipe;
+    H264SliceContext *sl = swdec_chroma_sl;
+    if (!sl || !SWDEC_CHROMA_ACTIVE) return;
+    for (int seq = pipe->cons_seq; seq < pipe->prod_seq; seq++) {
+        const int b = seq & 1;
+        int k = 0;
+        const unsigned done = pipe->cme_done[b];
+        if (SWDEC_CME_IS(done, seq)) {
+            if (done & SWDEC_CME_STOP) continue;
+            k = SWDEC_CME_K(done);
+        }
+        const SwdecRowRec r = pipe->rec[b];
+        if (r.njobs > SWDEC_CME_MAX_MBS) continue;
+        int last = r.njobs;
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+        if (swdec_chroma_partial)   /* validation: stop part-way (0 to all) */
+            last = FFMIN(last, (seq * 5 + r.mb_y) % (r.njobs + 2));
+#endif
+        SwdecMbJob *jobs = (SwdecMbJob *) ((char *) sl->swdec_jobs + (size_t) b * sl->swdec_jobs_stride);
+        for (; k < r.njobs; k++) {
+            if (yield && pipe->cons_seq >= pipe->prod_seq - 1)
+                break;                              /* a buffer is free: parse */
+            const SwdecMbJob *j = &jobs[k];
+            pipe->cme_busy[b] = SWDEC_CME(seq, k);
+            SWDEC_MB();
+            const unsigned from = pipe->ccpu_from[b];
+            if (k >= last || (SWDEC_CME_IS(from, seq) && SWDEC_CME_K(from) <= k)) {
+                pipe->cme_done[b] = SWDEC_CME(seq, k) | SWDEC_CME_STOP;   /* the main core's from here */
+                break;
+            }
+            if (!j->intra) {
+                const SwdecChromaMotion m = { j->mb_x, j->mb_y, j->mb_xy,
+                                              j->sub_mb_type, j->ref_cache, j->mv_cache };
+                if (!ff_swdec_chroma_predict(h, sl, &m, pred)) {
+                    pipe->cme_done[b] = SWDEC_CME(seq, k) | SWDEC_CME_STOP;
+                    break;
+                }
+                uint32_t *dst = (uint32_t *) ((char *) j->chroma_pred + swdec_unc_offset);
+                const uint32_t *src = (const uint32_t *) pred;
+                for (int w = 0; w < 32; w++)
+                    dst[w] = src[w];
+                SWDEC_MB();
+            }
+            pipe->cme_done[b] = SWDEC_CME(seq, k + 1);
+        }
+        pipe->cme_busy[b] = 0;
+        if (k < r.njobs && !(pipe->cme_done[b] & SWDEC_CME_STOP))
+            break;                                  /* yielded */
+    }
+}
+
+/* Main core, at inter macroblock k of row seq (in order): its chroma
+   prediction when the parser's may be used, else NULL, and from then on the
+   row is the main core's (*own): the parser will not write it. */
+static const uint8_t *swdec_chroma_take(SwdecMbJob *jobs, int seq, int k, int *own)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    const int b = seq & 1;
+    if (k >= SWDEC_CME_MAX_MBS) {   /* never the parser's (see swdec_chroma_service) */
+        SWDEC_CHROMA_COUNT(1, 1);
+        return NULL;
+    }
+    unsigned done = pipe->cme_done[b];
+    if (SWDEC_CME_IS(done, seq) && SWDEC_CME_K(done) > k)
+        goto parser;
+    if (!*own) {
+        pipe->ccpu_from[b] = SWDEC_CME(seq, k);
+        *own = 1;
+        SWDEC_CHROMA_COUNT(4, 1);
+        SWDEC_MB();
+        done = pipe->cme_done[b];
+        if (SWDEC_CME_IS(done, seq) && SWDEC_CME_K(done) > k)
+            goto parser;
+    }
+    if (pipe->cme_busy[b] == SWDEC_CME(seq, k)) {
+        /* part-way through this very macroblock: wait for it, bounded */
+        unsigned spins = 0;
+        SWDEC_CHROMA_COUNT(2, 1);
+        while (pipe->cme_busy[b] == SWDEC_CME(seq, k) && ++spins < (1u << 16)) { }
+        SWDEC_CHROMA_COUNT(3, spins);
+        SWDEC_MB();
+        done = pipe->cme_done[b];
+        if (SWDEC_CME_IS(done, seq) && SWDEC_CME_K(done) > k)
+            goto parser;
+    }
+    SWDEC_CHROMA_COUNT(1, 1);
+    return NULL;
+parser:
+    SWDEC_CHROMA_COUNT(0, 1);
+    return jobs[k].chroma_pred[0];
+}
+
+/* reconstruct every parsed-but-pending macroblock, then put the parser's
+   own macroblock state back (qscale etc. carry across macroblocks) */
+
+static void swdec_pipe_deblock_publish(const H264Context *h, const SwdecRowRec *r);
+
+/* CPU: reconstruct + deblock every published row segment not yet consumed */
+static void swdec_pipe_consume(const H264Context *hc, H264SliceContext *sl)
+{
+    H264Context *h = (H264Context *) hc;
+    H264SliceContext *rsl = h->swdec_rsl;
+    SwdecPipe *pipe = swdec_pipe;
+    while (pipe->cons_seq < pipe->prod_seq) {
+        int seq = pipe->cons_seq;
+        SWDEC_MB();
+        SwdecRowRec rec = pipe->rec[seq & 1];
+        SwdecMbJob *jobs = (SwdecMbJob *) ((char *) sl->swdec_jobs + (size_t) rec.buf * sl->swdec_jobs_stride);
+        if (rec.njobs < 0 || rec.njobs > h->mb_width || rec.mb_y < 0 || rec.mb_y > h->mb_height ||
+            rec.buf != (seq & 1) || rec.x_start < 0 || rec.x_end > h->mb_width || pipe->prod_seq - seq > 2) {
+            swdec_pipe_bad = 1;   /* refuse to act on a garbage record; the dispatcher reports and stops */
+            pipe->cons_seq = pipe->prod_seq;
+            return;
+        }
+        SWDEC_MARK(SWDEC_MARK_CPU_PRE);
+        SWDEC_RMARK(SWDEC_RMARK_ROW);
+        if (swdec_cpu_pre_consume) swdec_cpu_pre_consume(h, rec.mb_y);
+        SWDEC_MARK(SWDEC_MARK_CPU_RECON);
+        SWDEC_RMARK(SWDEC_RMARK_RECON);
+        const int chroma_me = SWDEC_CHROMA_ACTIVE;
+        int chroma_own = 0;
+        {
+            SWDEC_STAGE_BEGIN(t_recon);
+            for (int i = 0; i < rec.njobs; i++) {
+#if defined(SWDEC_PIPE_VALIDATE) && SWDEC_PIPE_VALIDATE
+                if (swdec_me_enabled || swdec_validate_force) {
+                    /* never reconstruct from a corrupt job: a wild pointer would crash this
+                       core and leak the module (device power cycle). Validate, then use. */
+                    const SwdecMbJob *j = &jobs[i];
+                    {
+                        unsigned c = (unsigned) (j->mb_x * 2654435761u) ^ (unsigned) j->mb_xy ^ (unsigned) (j->qscale << 20) ^ (unsigned) (j->intra << 27);
+                        const unsigned *q = (const unsigned *) j->non_zero_count_cache;
+                        for (unsigned k = 0; k < sizeof(j->non_zero_count_cache) / 4; k++) c = c * 31u + q[k];
+                        if (j->intra) {
+                            q = (const unsigned *) j->intra4x4_pred_mode_cache;
+                            for (unsigned k = 0; k < sizeof(j->intra4x4_pred_mode_cache) / 4; k++) c = c * 31u + q[k];
+                        } else {
+                            q = (const unsigned *) j->mv_cache;
+                            for (unsigned k = 0; k < sizeof(j->mv_cache) / 4; k++) c = c * 31u + q[k];
+                            q = (const unsigned *) j->ref_cache;
+                            for (unsigned k = 0; k < sizeof(j->ref_cache) / 4; k++) c = c * 31u + q[k];
+                        }
+                        if (c != j->cksum) {
+                            swdec_pipe_bad = 4;   /* transfer/tearing: content changed after save */
+                            swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                            swdec_pipe_bad_info[2] = j->mb_x; swdec_pipe_bad_info[3] = rec.mb_y;
+                            swdec_pipe_bad_info[4] = (int) c; swdec_pipe_bad_info[5] = (int) j->cksum;
+                            pipe->cons_seq = pipe->prod_seq;
+                            return;
+                        }
+                    }
+                    if ((unsigned) j->mb_x >= (unsigned) h->mb_width || j->mb_y != rec.mb_y ||
+                        j->mb_xy != j->mb_x + j->mb_y * h->mb_stride ||
+                        (unsigned) j->qscale > 51u || (unsigned) j->intra > 7u) {   /* intra = IS_INTRA mask bits */
+                        swdec_pipe_bad = 2;
+                        swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                        swdec_pipe_bad_info[2] = j->mb_x; swdec_pipe_bad_info[3] = j->mb_y;
+                        swdec_pipe_bad_info[4] = j->mb_xy; swdec_pipe_bad_info[5] = j->qscale;
+                        pipe->cons_seq = pipe->prod_seq;
+                        return;
+                    }
+                    if (!j->intra) {
+                        /* hard bound only: the ref_list array has 48 entries; legitimate cache
+                           values can exceed ref_count (direct modes), so that is not an error */
+                        for (int l = 0; l < 2; l++)
+                            for (int k = 0; k < 5 * 8; k++) {
+                                int r_ = j->ref_cache[l][k];
+                                if (r_ >= 48 || r_ < -8) {
+                                    swdec_pipe_bad = 3;
+                                    swdec_pipe_bad_info[0] = seq; swdec_pipe_bad_info[1] = i;
+                                    swdec_pipe_bad_info[2] = l; swdec_pipe_bad_info[3] = k;
+                                    swdec_pipe_bad_info[4] = r_; swdec_pipe_bad_info[5] = j->mb_x;
+                                    pipe->cons_seq = pipe->prod_seq;
+                                    return;
+                                }
+                            }
+                    }
+                }
+#endif
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+                swdec_rt_on = swdec_recon_mark
+                    && (jobs[i].mb_x + rec.mb_y) % SWDEC_RT_SAMPLE == 0;
+                swdec_rt_mbs[0]++;
+                swdec_rt_mbs[1] += swdec_rt_on;
+#endif
+                SWDEC_RT_BEGIN(r_mb);
+                {
+                    SWDEC_RT_BEGIN(r_restore);
+                    swdec_job_restore(rsl, &jobs[i]);
+                    if (chroma_me && !jobs[i].intra)
+                        rsl->swdec_chroma_pred = swdec_chroma_take(jobs, seq, i, &chroma_own);
+                    SWDEC_RT_END(r_restore, SWDEC_RT_RESTORE);
+                }
+                if (SWDEC_RECON_ENABLED)
+                    ff_h264_hl_decode_mb(h, rsl);
+                SWDEC_RT_END(r_mb, SWDEC_RT_MB);
+            }
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+            swdec_rt_on = 0;
+#endif
+            SWDEC_STAGE_END(t_recon, 1);
+        }
+        SWDEC_MARK(SWDEC_MARK_CPU_BORDER);
+        SWDEC_RMARK(SWDEC_RMARK_BORDER);
+        if (rec.x_end > rec.x_start) {
+            SWDEC_STAGE_BEGIN(t_lf);
+            rsl->mb_x = rec.x_end; rsl->mb_y = rec.mb_y;
+            if (swdec_me_deblock) {
+                loop_filter_ex(h, rsl, rec.x_start, rec.x_end, 1);   /* backup borders only */
+                if (pipe->dprev_valid) {
+                    swdec_pipe_deblock_publish(h, &pipe->dprev);     /* row above: border exchange done */
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+                    if (swdec_me_deblock == 3)
+                        while (pipe->dcons < pipe->dprod) { }        /* diagnosis: serialize deblock vs later CPU work */
+#endif
+                }
+                pipe->dprev = rec;
+                pipe->dprev_valid = 1;
+            } else {
+                loop_filter(h, rsl, rec.x_start, rec.x_end);
+            }
+            SWDEC_STAGE_END(t_lf, 2);
+        }
+        SWDEC_MARK(SWDEC_MARK_CPU_POST);
+        SWDEC_RMARK(SWDEC_RMARK_POST);
+        if (swdec_cpu_post_consume) {
+            swdec_cpu_post_consume(sl->swdec_ring + (size_t) rec.buf * h->mb_width * SWDEC_RING_SLOT(h),
+                                   (size_t) h->mb_width * SWDEC_RING_SLOT(h) * sizeof(int16_t));
+            swdec_cpu_post_consume(jobs, (size_t) rec.njobs * sizeof(SwdecMbJob));
+        }
+        SWDEC_MARK(SWDEC_MARK_CPU_ROW_END);
+        SWDEC_RMARK(SWDEC_RMARK_ROW_END);
+        SWDEC_MB();
+        pipe->cons_seq = seq + 1;
+    }
+}
+void swdec_pipe_consume_all(void *h, void *sl) { swdec_pipe_consume((const H264Context *) h, (H264SliceContext *) sl); }
+
+/* Deblock offload: the CPU publishes fully reconstructed rows (lag 1 behind
+   recon, so the border exchange of the next row is finished); the parser core
+   filters them from its idle loops. h->swdec_dsl is the filter's own slice
+   context (set up by the CPU dispatcher per slice). */
+void swdec_pipe_deblock_service(const void *hv)
+{
+    const H264Context *h = hv;
+    SwdecPipe *pipe = swdec_pipe;
+    if (pipe->parse_done && swdec_me_enabled)
+        swdec_chroma_service(h, 0);   /* drain: the slice's last rows */
+    while (pipe->dcons < pipe->dprod) {
+        SWDEC_MB();
+        SwdecRowRec r = pipe->drec[pipe->dcons & (SWDEC_DQ - 1)];
+        H264SliceContext *dsl = h->swdec_dsl;
+        dsl->mb_x = r.x_end; dsl->mb_y = r.mb_y;
+        SWDEC_MARK(SWDEC_MARK_ME_DEBLOCK);
+        loop_filter_ex(h, dsl, r.x_start, r.x_end, 2);
+        SWDEC_MARK(SWDEC_MARK_ME_DEBLOCK_END);
+        /* filtering row mb_y finished the shared border of the row above:
+           that row's pixels are final now - convert it while it is cache-hot */
+        if (swdec_me_csc_row && r.mb_y > 0 && r.x_end >= h->mb_width)
+            swdec_me_csc_row(h, r.mb_y - 1);
+        if (swdec_me_post_deblock) swdec_me_post_deblock();
+        SWDEC_MB();
+        pipe->dcons = pipe->dcons + 1;
+    }
+}
+
+static void swdec_pipe_deblock_publish(const H264Context *h, const SwdecRowRec *r)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    if (r->x_end <= r->x_start)
+        return;
+    if (swdec_cpu_flush_row) {
+        SWDEC_RMARK(SWDEC_RMARK_FLUSH);
+        swdec_cpu_flush_row(h, r->mb_y);
+        SWDEC_RMARK(SWDEC_RMARK_FLUSH_END);
+    }
+    if (pipe->dprod - pipe->dcons >= SWDEC_DQ) {
+        SWDEC_RMARK(SWDEC_RMARK_SPIN);
+        SWDEC_SPIN_WHILE(pipe->dprod - pipe->dcons >= SWDEC_DQ, 1);   /* queue full: filter core behind */
+        SWDEC_RMARK(SWDEC_RMARK_SPIN_END);
+    }
+    pipe->drec[pipe->dprod & (SWDEC_DQ - 1)] = *r;
+    SWDEC_MB();
+    pipe->dprod = pipe->dprod + 1;
+    SWDEC_MB();
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+    if (swdec_me_deblock == 2)
+        swdec_pipe_deblock_service(h);   /* diagnosis: same split, no concurrency */
+#endif
+}
+
+/* frame-tail work stealing: the CPU deblocks the held-back row itself
+   instead of queueing it and idling on the ME (which is still busy with
+   audio at slice end). Always on; diagnostic builds can A/B it. */
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+int swdec_me_tail_cpu = 1;
+#else
+#define swdec_me_tail_cpu 1
+#endif
+/* CPU, end of slice: everything reconstructed; push (or steal) the held-back row */
+void swdec_pipe_deblock_flush(const void *hv)
+{
+    const H264Context *h = hv;
+    SwdecPipe *pipe = swdec_pipe;
+    if (pipe->dprev_valid) {
+        if (swdec_me_tail_cpu && h->swdec_rsl) {
+            SwdecRowRec r = pipe->dprev;
+            SWDEC_RMARK(SWDEC_RMARK_TAIL);
+            if (pipe->dcons < pipe->dprod) {
+                SWDEC_RMARK(SWDEC_RMARK_SPIN);
+                SWDEC_SPIN_WHILE(pipe->dcons < pipe->dprod, 2);   /* the row above is queued: it must finish
+                                                       first (shared boundary lines) */
+                SWDEC_RMARK(SWDEC_RMARK_SPIN_END);
+            }
+            if (r.x_end > r.x_start) {
+                H264SliceContext *rsl = h->swdec_rsl;
+                if (swdec_cpu_flush_row) {   /* rows above were ME-filtered */
+                    SWDEC_RMARK(SWDEC_RMARK_FLUSH);
+                    swdec_cpu_flush_row(h, r.mb_y);
+                    SWDEC_RMARK(SWDEC_RMARK_FLUSH_END);
+                }
+                rsl->mb_x = r.x_end; rsl->mb_y = r.mb_y;
+                loop_filter_ex(h, rsl, r.x_start, r.x_end, 2);
+                if (swdec_cpu_post_consume) {   /* make the filtered pixels visible to RAM readers */
+                    /* pixel writeback happens via the frame-level invalidate at hand-off end */
+                }
+            }
+            SWDEC_RMARK(SWDEC_RMARK_TAIL_END);
+        } else {
+            swdec_pipe_deblock_publish(h, &pipe->dprev);
+        }
+        pipe->dprev_valid = 0;
+    }
+}
+int swdec_pipe_deblock_pending(void)
+{
+    return swdec_pipe->dprod - swdec_pipe->dcons;
+}
+
+/* producer: publish the current row segment [x_start, x_end) of row mb_y */
+static void swdec_pipe_publish(const H264Context *h, H264SliceContext *sl, int mb_y, int x_start, int x_end)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    int seq = pipe->prod_seq;
+    if (sl->swdec_njobs == 0 && x_end <= x_start)
+        return;                     /* nothing to reconstruct or filter (e.g. slice end exactly at a row end) */
+    SwdecRowRec *r = &pipe->rec[seq & 1];
+    r->mb_y = mb_y; r->x_start = x_start; r->x_end = x_end; r->njobs = sl->swdec_njobs; r->buf = seq & 1;
+    sl->swdec_njobs = 0;
+    if (swdec_me_enabled && swdec_me_pre_publish) swdec_me_pre_publish();   /* ME side only */
+    SWDEC_MB();
+    pipe->prod_seq = seq + 1;
+    SWDEC_MB();
+    if (!swdec_me_enabled) {
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+        if (swdec_chroma_force) swdec_chroma_service(h, 0);   /* bench: in step */
+#endif
+        swdec_pipe_consume(h, sl);
+    }
+    else if (SWDEC_DEBLOCK_ON_PARSER(swdec_me_deblock))
+        swdec_pipe_deblock_service(h);      /* parser core: filter finished rows while recon runs */
+    if (swdec_me_enabled && swdec_me_aux)
+        swdec_me_aux();
+}
+/* producer: before writing into the buffer of the row about to start, its previous
+   user (seq-2) must have been consumed */
+static void swdec_pipe_wait_buffer_slow(const H264Context *h)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    SWDEC_MARK(SWDEC_MARK_ME_WAIT);
+    while (pipe->cons_seq < pipe->prod_seq - 1) {
+        if (swdec_me_enabled)
+            swdec_chroma_service(h, 1);      /* the main core needs it first */
+        if (swdec_me_enabled && SWDEC_DEBLOCK_ON_PARSER(swdec_me_deblock))
+            swdec_pipe_deblock_service(h);
+        if (swdec_me_enabled && swdec_me_aux)
+            swdec_me_aux();
+    }
+    SWDEC_MARK(SWDEC_MARK_ME_WAIT_END);
+}
+static av_always_inline void swdec_pipe_wait_buffer(const H264Context *h)
+{
+    SwdecPipe *pipe = swdec_pipe;
+    if (pipe->cons_seq < pipe->prod_seq - 1)
+        swdec_pipe_wait_buffer_slow(h);
+}
+static av_always_inline int swdec_pipe_buf(void) { return swdec_pipe->prod_seq & 1; }
