+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#include "config.h"
+#if defined(SWDEC_PSP_ASM) && SWDEC_PSP_ASM
+
+#include <stdint.h>
+#include <stddef.h>
+#include "libavutil/attributes.h"
+#include "libavcodec/h264qpel.h"
+#include "vfpu_util.h"
+
+extern int swdec_psp_level;
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+/* Validation builds: 1 keeps the motion-compensation kernels as they were
+   before the shared-pass hv family (same-binary device A/B). Read when a
+   decoder is initialised. */
+int swdec_mc_reference;
+#endif
+
+/* M700: S700 = 20, S701 = -5, S702 = 1/32, S703 = 1/1024
+   C710 = 128.5 (= 4112/32 = 131584/1024: rounding after the scale),
+   C720 = 129, C730 = 4112 (h/v put rounding before vf2id 18)
+   C630 = 255.5 (clip ceiling; see the floor lemma below) */
+static const float qpel_consts[20] __attribute__((aligned(16))) = {
+    20.f, -5.f, 1.f / 32.f, 1.f / 1024.f,
+    128.5f, 128.5f, 128.5f, 128.5f,
+    129.f, 129.f, 129.f, 129.f,
+    4112.f, 4112.f, 4112.f, 4112.f,
+    255.5f, 255.5f, 255.5f, 255.5f,
+};
+
+/* Floor lemma used throughout: for real x and integer k,
+   floor((floor(x) + k) / 2) == floor((x + k) / 2).  So the clipped
+   half-sample value p = clip(floor(x)) can be carried as
+   x' = min(max(x, 0), 255.5) without flooring, as long as the other
+   operand of every average is an integer (source pixels, destination
+   pixels, or an intermediate that *was* floored before being stored). */
+#define LOAD_CONSTS() \
+    __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\tlv.q C720, 32(%0)\n\t" \
+                      "lv.q C730, 48(%0)\n\tlv.q C630, 64(%0)\n\t" \
+                      : : "r"(qpel_consts) : "memory")
+
+/* --- generic quad-level building blocks (Q = quad reg string, S = single scratch, T = temp quad) --- */
+
+/* x' = clip(Q * inv + 128.5, 0, 255.5) into Q ; C620 must be zero.
+   inv = S702 (1/32, h/v) or S703 (1/1024, hv). */
+#define X_CLIP(Q, inv) \
+    "vscl.q " Q ", " Q ", " inv "\n\t" \
+    "vadd.q " Q ", " Q ", C710\n\t" \
+    "vmax.q " Q ", " Q ", C620\n\t" \
+    "vmin.q " Q ", " Q ", C630\n\t"
+/* integer p = floor(x') (for values that will be stored and re-used) */
+#define X_FLOOR(Q) \
+    "vf2id.q " Q ", " Q ", 0\n\t" \
+    "vi2f.q " Q ", " Q ", 0\n\t"
+
+/* Q (unrounded) -> bytes at addr: clip(floor((Q+Kq)/2^sh)) with imm = 23-sh */
+#define STORE_PUT(Q, S, Kq, imm, addr, off) \
+    "vadd.q " Q ", " Q ", " Kq "\n\t" \
+    "vf2id.q " Q ", " Q ", " imm "\n\t" \
+    "vi2uc.q " S ", " Q "\n\t" \
+    "sv.s  " S ", " off "(" addr ")\n\t"
+
+/* Q = p_float already; average with A (b-128) : floor((p + A + 129)/2) -> bytes */
+#define STORE_AVG(Q, S, A, addr, off) \
+    "vadd.q " Q ", " Q ", " A "\n\t" \
+    "vadd.q " Q ", " Q ", C720\n\t" \
+    "vf2id.q " Q ", " Q ", 22\n\t" \
+    "vi2uc.q " S ", " Q "\n\t" \
+    "sv.s  " S ", " off "(" addr ")\n\t"
+
+/* Q = Q / 2 exactly (Q has at most 22 fractional bits and |Q| < 512) */
+#define HALF(Q) \
+    "vf2id.q " Q ", " Q ", 22\n\t" \
+    "vi2f.q " Q ", " Q ", 23\n\t"
+
+/* unpack a GPR word (already XORed) into quad Cjk0 through single Sjk0 */
+#define UNPACK(j, k, w) \
+    "mtv   " w ", S" #j #k "0\n\t" \
+    "vc2i.s C" #j #k "0, S" #j #k "0\n\t" \
+    "vi2f.q C" #j #k "0, C" #j #k "0, 24\n\t"
+
+/* ================================================================== */
+/* Horizontal filter, transposed layout                                 */
+/* ================================================================== */
+
+#define XR(j, k) "R" #j "0" #k
+#define HFIR(OUT, xm2, xm1, x0, x1, x2, x3) \
+    "vadd.q C600, " xm2 ", " x3 "\n\t" \
+    "vadd.q C610, " xm1 ", " x2 "\n\t" \
+    "vadd.q C620, " x0 ", " x1 "\n\t" \
+    "vscl.q C620, C620, S700\n\t" \
+    "vscl.q C610, C610, S701\n\t" \
+    "vadd.q C600, C600, C620\n\t" \
+    "vadd.q " OUT ", C600, C610\n\t"
+
+/* Four columns interleaved, one temporary each (C600..C630): the VFPU has a
+   ~5-cycle latency per dependent op and issues one per cycle, so four
+   independent chains keep it busy (PPSSPP models none of this).
+   Per column: T = X(x-1)+X(x+2); T *= -5; OUT = X(x-2)+X(x+3); OUT += T;
+               T = X(x)+X(x+1); T *= 20; OUT += T. */
+#define HFIR4(OA, am2, am1, a0, a1, a2, a3, OB, bm2, bm1, b0, b1, b2, b3, \
+              OC, cm2, cm1, c0, c1, c2, c3, OD, dm2, dm1, d0, d1, d2, d3) \
+    "vadd.q C600, " am1 ", " a2 "\n\t"  "vadd.q C610, " bm1 ", " b2 "\n\t"  "vadd.q C620, " cm1 ", " c2 "\n\t"  "vadd.q C630, " dm1 ", " d2 "\n\t" \
+    "vadd.q " OA ", " am2 ", " a3 "\n\t" "vadd.q " OB ", " bm2 ", " b3 "\n\t" "vadd.q " OC ", " cm2 ", " c3 "\n\t" "vadd.q " OD ", " dm2 ", " d3 "\n\t" \
+    "vscl.q C600, C600, S701\n\t"       "vscl.q C610, C610, S701\n\t"       "vscl.q C620, C620, S701\n\t"       "vscl.q C630, C630, S701\n\t" \
+    "vadd.q " OA ", " OA ", C600\n\t"   "vadd.q " OB ", " OB ", C610\n\t"   "vadd.q " OC ", " OC ", C620\n\t"   "vadd.q " OD ", " OD ", C630\n\t" \
+    "vadd.q C600, " a0 ", " a1 "\n\t"   "vadd.q C610, " b0 ", " b1 "\n\t"   "vadd.q C620, " c0 ", " c1 "\n\t"   "vadd.q C630, " d0 ", " d1 "\n\t" \
+    "vscl.q C600, C600, S700\n\t"       "vscl.q C610, C610, S700\n\t"       "vscl.q C620, C620, S700\n\t"       "vscl.q C630, C630, S700\n\t" \
+    "vadd.q " OA ", " OA ", C600\n\t"   "vadd.q " OB ", " OB ", C610\n\t"   "vadd.q " OC ", " OC ", C620\n\t"   "vadd.q " OD ", " OD ", C630\n\t"
+
+/* output columns x=0..7 (g = x+4) into R400..R403, R500..R503.
+   C630 is used as a temporary here and reloaded with 255.5 after. */
+#define HFIR_ALL8() \
+    HFIR4("R400", XR(0,2), XR(0,3), XR(1,0), XR(1,1), XR(1,2), XR(1,3), \
+          "R401", XR(0,3), XR(1,0), XR(1,1), XR(1,2), XR(1,3), XR(2,0), \
+          "R402", XR(1,0), XR(1,1), XR(1,2), XR(1,3), XR(2,0), XR(2,1), \
+          "R403", XR(1,1), XR(1,2), XR(1,3), XR(2,0), XR(2,1), XR(2,2)) \
+    HFIR4("R500", XR(1,2), XR(1,3), XR(2,0), XR(2,1), XR(2,2), XR(2,3), \
+          "R501", XR(1,3), XR(2,0), XR(2,1), XR(2,2), XR(2,3), XR(3,0), \
+          "R502", XR(2,0), XR(2,1), XR(2,2), XR(2,3), XR(3,0), XR(3,1), \
+          "R503", XR(2,1), XR(2,2), XR(2,3), XR(3,0), XR(3,1), XR(3,2)) \
+    "lv.q  C630, 64(%[cst])\n\t"
+
+/* vertical-domain l2 for the 8 output columns, all stages interleaved:
+   R = clip(R/32 + 128.5, 0, 255.5) then + X + 129 (final /2 at store) */
+#define R8(op) op("R400") op("R401") op("R402") op("R403") op("R500") op("R501") op("R502") op("R503")
+#define HL2_SCL(R)   "vscl.q " R ", " R ", S702\n\t"
+#define HL2_ADDK(R)  "vadd.q " R ", " R ", C710\n\t"
+#define HL2_MAX(R)   "vmax.q " R ", " R ", C620\n\t"
+#define HL2_MIN(R)   "vmin.q " R ", " R ", C630\n\t"
+#define HL2_ADD129(R) "vadd.q " R ", " R ", C720\n\t"
+#define HL2_ADDX(R, X) "vadd.q " R ", " R ", " X "\n\t"
+#define HL2_ALL(X0, X1, X2, X3, X4, X5, X6, X7) \
+    R8(HL2_SCL) R8(HL2_ADDK) R8(HL2_MAX) R8(HL2_MIN) \
+    HL2_ADDX("R400", X0) HL2_ADDX("R401", X1) HL2_ADDX("R402", X2) HL2_ADDX("R403", X3) \
+    HL2_ADDX("R500", X4) HL2_ADDX("R501", X5) HL2_ADDX("R502", X6) HL2_ADDX("R503", X7) \
+    R8(HL2_ADD129)
+/* l2 with X(x) (mc10): X(x) at g=x+4 */
+#define HL2_ALL_X0() HL2_ALL(XR(1,0), XR(1,1), XR(1,2), XR(1,3), XR(2,0), XR(2,1), XR(2,2), XR(2,3))
+/* l2 with X(x+1) (mc30) */
+#define HL2_ALL_X1() HL2_ALL(XR(1,1), XR(1,2), XR(1,3), XR(2,0), XR(2,1), XR(2,2), XR(2,3), XR(3,0))
+
+/* one source row r (pixels -4..11) into column r of M0..M3 */
+#define HLOAD_ROW(r, w0, w1, w2, w3) \
+    UNPACK(0, r, w0) UNPACK(1, r, w1) UNPACK(2, r, w2) UNPACK(3, r, w3)
+
+static av_always_inline void hload_band(const uint8_t *src, ptrdiff_t stride, int rows)
+{
+    for (int r = 0; r < rows; r++) {
+        const uint8_t *p = src + r * stride;
+        uint32_t w0 = psp_ulw(p - 4) ^ PSP_PIX_XOR, w1 = psp_ulw(p) ^ PSP_PIX_XOR;
+        uint32_t w2 = psp_ulw(p + 4) ^ PSP_PIX_XOR, w3 = psp_ulw(p + 8) ^ PSP_PIX_XOR;
+        switch (r) {
+        case 0: __asm__ volatile (HLOAD_ROW(0, "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); break;
+        case 1: __asm__ volatile (HLOAD_ROW(1, "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); break;
+        case 2: __asm__ volatile (HLOAD_ROW(2, "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); break;
+        default: __asm__ volatile (HLOAD_ROW(3, "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); break;
+        }
+    }
+}
+
+/* Row-domain finish for a whole 4-row band, all stages interleaved over the
+   eight quads C400..C430 (pixels 0..3 of rows 0..3) and C500..C530 (4..7).
