+static void h264_v_loop_filter_luma_intra_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    LF_SETUP_AB(alpha, beta);
+    LF_SETUP_A2((alpha >> 2) + 2);
+    for (int x = 0; x < 16; x += 4)
