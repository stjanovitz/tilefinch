+#ifdef SWDEC_FRAME_ONLY
+/* ------------------------------------------------------------------ */
+/* Chroma prediction on the parser (swdec): scalar integer kernels for   */
+/* the Media Engine (no VFPU, and none of the PSP DSP tables), on private */
+/* 8x8 blocks, with the arithmetic of FFmpeg's C references for 8-bit    */
+/* pixels: h264chroma_template.c (put/avg) and h264dsp_template.c        */
+/* (weight/biweight). References outside the picture are read at clamped */
+/* coordinates, which is what emulated_edge_mc provides.                 */
+/* ------------------------------------------------------------------ */
+static inline int swdec_cp_clamp(int v, int hi) { return v < 0 ? 0 : v > hi ? hi : v; }
+static inline uint8_t swdec_cp_clip8(int v) { return (uint8_t) (v < 0 ? 0 : v > 255 ? 255 : v); }
+
+static void swdec_cp_mc(uint8_t *d, const uint8_t *ref, int s, int pw, int ph,
+                        int mx, int my, int w, int hh, int avg)
+{
+    const int cx = mx >> 3, cy = my >> 3, fx = mx & 7, fy = my & 7;
+    const int A = (8 - fx) * (8 - fy), B = fx * (8 - fy), C = (8 - fx) * fy, D = fx * fy;
+    const int inside = cx >= 0 && cy >= 0 && cx + w + 1 <= pw && cy + hh + 1 <= ph;
+    for (int j = 0; j < hh; j++, d += 8) {
+        if (inside) {
+            const uint8_t *p = ref + (cy + j) * s + cx;
+            for (int i = 0; i < w; i++) {
+                int v = (A * p[i] + B * p[i + 1] + C * p[i + s] + D * p[i + s + 1] + 32) >> 6;
+                d[i] = (uint8_t) (avg ? (d[i] + v + 1) >> 1 : v);
+            }
+        } else {
+            const int y0 = swdec_cp_clamp(cy + j, ph - 1), y1 = swdec_cp_clamp(cy + j + 1, ph - 1);
+            for (int i = 0; i < w; i++) {
+                const int x0 = swdec_cp_clamp(cx + i, pw - 1), x1 = swdec_cp_clamp(cx + i + 1, pw - 1);
+                int v = (A * ref[y0 * s + x0] + B * ref[y0 * s + x1]
+                         + C * ref[y1 * s + x0] + D * ref[y1 * s + x1] + 32) >> 6;
+                d[i] = (uint8_t) (avg ? (d[i] + v + 1) >> 1 : v);
+            }
+        }
+    }
+}
+
+static void swdec_cp_weight(uint8_t *d, int w, int hh, int log2, int weight, int off)
+{
+    int offset = (int) ((unsigned) off << log2);
+    if (log2) offset += 1 << (log2 - 1);
+    for (int j = 0; j < hh; j++, d += 8)
+        for (int i = 0; i < w; i++)
+            d[i] = swdec_cp_clip8((d[i] * weight + offset) >> log2);
+}
+
+static void swdec_cp_biweight(uint8_t *d, const uint8_t *src, int w, int hh, int log2,
+                              int weightd, int weights, int off)
+{
+    const int offset = (int) ((unsigned) ((off + 1) | 1) << log2);
+    for (int j = 0; j < hh; j++, d += 8, src += 8)
+        for (int i = 0; i < w; i++)
+            d[i] = swdec_cp_clip8((src[i] * weights + d[i] * weightd + offset) >> (log2 + 1));
+}
+
+/* one partition, as mc_part / mc_part_std / mc_part_weighted (4:2:0
+   frame macroblocks); x_off, y_off and the partition size are in chroma
+   samples within the macroblock; 0 when the partition is not predictable
+   here */
+static int swdec_cp_part(const H264Context *h, const H264SliceContext *sl,
+                         const SwdecChromaMotion *m,
+                         uint8_t (*pred)[64], uint8_t (*tmp)[64],
+                         int n, int w, int hh, int x_off, int y_off, int list0, int list1)
+{
+    const int s = (int) sl->uvlinesize, pw = 8 * h->mb_width, ph = 8 * h->mb_height;
+    const int ax = x_off + 8 * m->mb_x, ay = y_off + 8 * m->mb_y;
+    const int o = y_off * 8 + x_off;
+    int refn[2] = { -1, -1 };
+    const H264Ref *ref[2] = { NULL, NULL };
+    for (int l = 0; l < 2; l++) {
+        if (!(l ? list1 : list0)) continue;
+        refn[l] = m->ref_cache[l][scan8[n]];
+        if (refn[l] < 0 || refn[l] >= 48) return 0;
+        ref[l] = &sl->ref_list[l][refn[l]];
+        if (!ref[l]->data[1] || !ref[l]->data[2]) return 0;
+    }
+#define MV(l) m->mv_cache[l][scan8[n]][0] + ax * 8, m->mv_cache[l][scan8[n]][1] + ay * 8
+    const int weighted = (sl->pwt.use_weight == 2 && list0 && list1
+                          && sl->pwt.implicit_weight[refn[0]][refn[1]][m->mb_y & 1] != 32)
+                         || sl->pwt.use_weight == 1;
+    for (int p = 0; p < 2; p++) {
+        if (!weighted) {
+            if (list0) swdec_cp_mc(pred[p] + o, ref[0]->data[1 + p], s, pw, ph, MV(0), w, hh, 0);
+            if (list1) swdec_cp_mc(pred[p] + o, ref[1]->data[1 + p], s, pw, ph, MV(1), w, hh, list0);
+        } else if (list0 && list1) {
+            swdec_cp_mc(pred[p] + o, ref[0]->data[1 + p], s, pw, ph, MV(0), w, hh, 0);
+            swdec_cp_mc(tmp[p] + o, ref[1]->data[1 + p], s, pw, ph, MV(1), w, hh, 0);
+            if (sl->pwt.use_weight == 2) {
+                const int w0 = sl->pwt.implicit_weight[refn[0]][refn[1]][m->mb_y & 1];
+                swdec_cp_biweight(pred[p] + o, tmp[p] + o, w, hh, 5, w0, 64 - w0, 0);
+            } else {
+                swdec_cp_biweight(pred[p] + o, tmp[p] + o, w, hh,
+                                  sl->pwt.chroma_log2_weight_denom,
+                                  sl->pwt.chroma_weight[refn[0]][0][p][0],
+                                  sl->pwt.chroma_weight[refn[1]][1][p][0],
+                                  sl->pwt.chroma_weight[refn[0]][0][p][1]
+                                  + sl->pwt.chroma_weight[refn[1]][1][p][1]);
+            }
+        } else {
+            const int l = list1 ? 1 : 0;
+            swdec_cp_mc(pred[p] + o, ref[l]->data[1 + p], s, pw, ph, MV(l), w, hh, 0);
+            if (sl->pwt.use_weight_chroma)
+                swdec_cp_weight(pred[p] + o, w, hh, sl->pwt.chroma_log2_weight_denom,
+                                sl->pwt.chroma_weight[refn[l]][l][p][0],
+                                sl->pwt.chroma_weight[refn[l]][l][p][1]);
+        }
+    }
+#undef MV
+    return 1;
+}
+
+/* the whole inter macroblock, partitions walked as hl_motion does */
+int ff_swdec_chroma_predict(const H264Context *h, const H264SliceContext *sl,
+                            const SwdecChromaMotion *m, uint8_t pred[2][64])
+{
+    const int mb_type = h->cur_pic.mb_type[m->mb_xy];
+    uint8_t tmp[2][64];
+    if (!IS_INTER(mb_type) || sl->uvlinesize > 1024) return 0;
+#define PART(n, w, hh, x, y, l0, l1) \
+    do { if (!swdec_cp_part(h, sl, m, pred, tmp, n, w, hh, x, y, l0, l1)) return 0; } while (0)
+    if (IS_16X16(mb_type)) {
+        PART(0, 8, 8, 0, 0, IS_DIR(mb_type, 0, 0), IS_DIR(mb_type, 0, 1));
+    } else if (IS_16X8(mb_type)) {
+        PART(0, 8, 4, 0, 0, IS_DIR(mb_type, 0, 0), IS_DIR(mb_type, 0, 1));
+        PART(8, 8, 4, 0, 4, IS_DIR(mb_type, 1, 0), IS_DIR(mb_type, 1, 1));
+    } else if (IS_8X16(mb_type)) {
+        PART(0, 4, 8, 0, 0, IS_DIR(mb_type, 0, 0), IS_DIR(mb_type, 0, 1));
+        PART(4, 4, 8, 4, 0, IS_DIR(mb_type, 1, 0), IS_DIR(mb_type, 1, 1));
+    } else if (IS_8X8(mb_type)) {
+        for (int i = 0; i < 4; i++) {
+            const int sub = m->sub_mb_type[i], n = 4 * i;
+            const int x = (i & 1) << 2, y = (i & 2) << 1;
+            const int l0 = IS_DIR(sub, 0, 0), l1 = IS_DIR(sub, 0, 1);
+            if (IS_SUB_8X8(sub)) {
+                PART(n, 4, 4, x, y, l0, l1);
+            } else if (IS_SUB_8X4(sub)) {
+                PART(n, 4, 2, x, y, l0, l1);
+                PART(n + 2, 4, 2, x, y + 2, l0, l1);
+            } else if (IS_SUB_4X8(sub)) {
+                PART(n, 2, 4, x, y, l0, l1);
+                PART(n + 1, 2, 4, x + 2, y, l0, l1);
+            } else {
+                for (int j = 0; j < 4; j++)
+                    PART(n + j, 2, 2, x + 2 * (j & 1), y + (j & 2), l0, l1);
+            }
+        }
+    } else {
+        return 0;
+    }
+#undef PART
+    return 1;
+}
+#endif
+
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS && defined(SWDEC_FRAME_ONLY)
+/* Chroma prediction recorder (swdec_chroma_rec.h): one row at a time, on
+   the main core only, while swdec_chroma_rec_on is set. */
+int swdec_chroma_rec_on;
+SwdecChromaRec swdec_chroma_rec __attribute__((aligned(64)));
+static struct {
+    int on, mb;
+    const uint8_t *cb, *cr, *tmp;
+    ptrdiff_t stride;
+} cr_mb;
+static void cr_mb_begin(const H264Context *h, const H264SliceContext *sl,
+                        const uint8_t *cb, const uint8_t *cr)
+{
+    SwdecChromaRec *r = &swdec_chroma_rec;
+    cr_mb.on = 0;
+    if (!swdec_chroma_rec_on || r->overflow || sl->swdec_chroma_pred) return;
+    if (r->mbs >= SWDEC_CR_MAX_MBS || sl->mb_uvlinesize > 512) { r->overflow = 1; return; }
+    cr_mb.on = 1; cr_mb.mb = r->mbs;
+    cr_mb.cb = cb; cr_mb.cr = cr; cr_mb.tmp = sl->bipred_scratchpad;
+    cr_mb.stride = sl->mb_uvlinesize;
+    r->ref_stride = (int) sl->mb_uvlinesize;
+    r->pic_w = 8 * h->mb_width; r->pic_h = 8 * h->mb_height; r->mb_y = sl->mb_y;
+    r->chroma_ctx = &h->h264chroma; r->dsp_ctx = &h->h264dsp; r->vdsp_ctx = &h->vdsp;
+}
+/* a new operation whose Cb destination is dst_cb (the prediction or the
+   bi-prediction scratch); NULL ends the row's recording as unsupported */
+static SwdecChromaOp *cr_op(const uint8_t *dst_cb)
+{
+    SwdecChromaRec *r = &swdec_chroma_rec;
+    if (!cr_mb.on) return NULL;
+    const ptrdiff_t s = cr_mb.stride;
+    ptrdiff_t off = dst_cb - cr_mb.cb;
+    int buf = SWDEC_CR_PIC;
+    if (!(off >= 0 && off < 8 * s && off % s < 8)) {
+        off = dst_cb - cr_mb.tmp;
+        buf = SWDEC_CR_TMP;
+        if (!(off >= 0 && off < 8 * s && off % s < 8)) off = -1;
+    }
+    if (off < 0 || r->ops >= SWDEC_CR_MAX_OPS) { r->overflow = 1; cr_mb.on = 0; return NULL; }
+    SwdecChromaOp *o = &r->op[r->ops++];
+    memset(o, 0, sizeof(*o));
+    o->buf = buf; o->x = off % s; o->y = off / s; o->mb = cr_mb.mb;
+    return o;
+}
+static void cr_mb_end(void)
+{
+    SwdecChromaRec *r = &swdec_chroma_rec;
+    if (!cr_mb.on) return;
+    for (int y = 0; y < 8; y++) {
+        memcpy(r->expect[cr_mb.mb][0] + 8 * y, cr_mb.cb + y * cr_mb.stride, 8);
+        memcpy(r->expect[cr_mb.mb][1] + 8 * y, cr_mb.cr + y * cr_mb.stride, 8);
+    }
+    r->mbs++;
+    cr_mb.on = 0;
+}
+#define SWDEC_CR_MB_BEGIN(h, sl, cb, cr) cr_mb_begin(h, sl, cb, cr)
+#define SWDEC_CR_MB_END() cr_mb_end()
+
+/* The recorded operations through the main core's own kernels (the
+   recorder's check, and the CPU cost of the same work). */
+void swdec_chroma_rec_cpu_replay(const SwdecChromaRec *r, uint8_t (*out)[2][64])
+{
+    static uint8_t buf[2][2][10 * 512] __attribute__((aligned(16)));
+    static uint8_t emu[2][10 * 512] __attribute__((aligned(16)));
+    const H264ChromaContext *cc = r->chroma_ctx;
+    const H264DSPContext *dsp = r->dsp_ctx;
+    const VideoDSPContext *vd = r->vdsp_ctx;
+    const ptrdiff_t s = r->ref_stride;
+    int k = 0;
+    for (int mb = 0; mb < r->mbs; mb++) {
+        for (int b = 0; b < 2; b++)
+            for (int p = 0; p < 2; p++)
+                for (int y = 0; y < 8; y++) memset(buf[b][p] + y * s, 0, 8);
+        for (; k < r->ops && r->op[k].mb == mb; k++) {
+            const SwdecChromaOp *o = &r->op[k];
+            const int wi = o->w == 8 ? 0 : o->w == 4 ? 1 : 2;
+            for (int p = 0; p < 2; p++) {
+                uint8_t *d = buf[o->buf][p] + o->y * s + o->x;
+                if (o->type == SWDEC_CR_MC) {
+                    const uint8_t *src = o->ref[p] + o->cy * s + o->cx;
+                    if (o->cx < 0 || o->cy < 0 || o->cx + o->w + 1 > r->pic_w
+                        || o->cy + o->h + 1 > r->pic_h) {
+                        vd->emulated_edge_mc(emu[p], src, s, s, o->w + 1, o->h + 1,
+                                             o->cx, o->cy, r->pic_w, r->pic_h);
+                        src = emu[p];
+                    }
+                    (o->avg ? cc->avg_h264_chroma_pixels_tab
+                            : cc->put_h264_chroma_pixels_tab)[wi](d, src, s, o->h, o->fx, o->fy);
+                } else if (o->type == SWDEC_CR_WEIGHT) {
+                    dsp->weight_pixels_tab[wi + 1](d, s, o->h, o->log2, o->wa[p], o->off[p]);
+                } else {
+                    dsp->biweight_pixels_tab[wi + 1](d, buf[SWDEC_CR_TMP][p] + o->ty * s + o->tx,
+                                                          s, o->h, o->log2, o->wa[p], o->wb[p], o->off[p]);
+                }
+            }
+        }
+        for (int p = 0; p < 2; p++)
+            for (int y = 0; y < 8; y++) memcpy(out[mb][p] + 8 * y, buf[SWDEC_CR_PIC][p] + y * s, 8);
+    }
+}
+#else
+#define SWDEC_CR_MB_BEGIN(h, sl, cb, cr) ((void) 0)
+#define SWDEC_CR_MB_END() ((void) 0)
+#endif
+
