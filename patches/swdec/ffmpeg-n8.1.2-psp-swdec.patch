+    "vc2i.s C000, S000\n\tvc2i.s C010, S010\n\tvc2i.s C020, S020\n\tvc2i.s C030, S030\n\t" \
+    "vc2i.s C100, S100\n\tvc2i.s C110, S110\n\tvc2i.s C120, S120\n\tvc2i.s C130, S130\n\t" \
+    "vi2f.q C000, C000, 24\n\tvi2f.q C010, C010, 24\n\tvi2f.q C020, C020, 24\n\tvi2f.q C030, C030, 24\n\t" \
+    "vi2f.q C100, C100, 24\n\tvi2f.q C110, C110, 24\n\tvi2f.q C120, C120, 24\n\tvi2f.q C130, C130, 24\n\t"
+#define HB_ADDDST() \
+    "vadd.q C400, C400, C000\n\tvadd.q C410, C410, C010\n\tvadd.q C420, C420, C020\n\tvadd.q C430, C430, C030\n\t" \
+    "vadd.q C500, C500, C100\n\tvadd.q C510, C510, C110\n\tvadd.q C520, C520, C120\n\tvadd.q C530, C530, C130\n\t"
+#define HB_XCLIP()  HB_SCL("S702") HB_ADDK("C710") HB_MAX0() HB_MIN255()
+#define HB_STOREAVG_DST() HB_ADDDST() HB_ADDK("C720") HB_F2ID("22") HB_PACK()
