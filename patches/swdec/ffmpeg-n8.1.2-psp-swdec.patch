+    "vscl.q C500, C500, " S "\n\tvscl.q C510, C510, " S "\n\tvscl.q C520, C520, " S "\n\tvscl.q C530, C530, " S "\n\t"
+#define HB_MAX0()  "vmax.q C400, C400, C620\n\tvmax.q C410, C410, C620\n\tvmax.q C420, C420, C620\n\tvmax.q C430, C430, C620\n\t" \
+                   "vmax.q C500, C500, C620\n\tvmax.q C510, C510, C620\n\tvmax.q C520, C520, C620\n\tvmax.q C530, C530, C620\n\t"
+#define HB_MIN255() "vmin.q C400, C400, C630\n\tvmin.q C410, C410, C630\n\tvmin.q C420, C420, C630\n\tvmin.q C430, C430, C630\n\t" \
