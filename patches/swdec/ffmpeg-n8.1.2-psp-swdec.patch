+/* ================================================================== */
+/* Vertical filter, row domain (one 4-wide half at a time)              */
+/* Rows -2..10 (index i, g=i+2) in C000..C030, C100..C130, C200..C230, C300 */
+/* ================================================================== */
+#define VFIR(OUT, rm2, rm1, r0, r1, r2, r3) \
+    "vadd.q C600, " rm2 ", " r3 "\n\t" \
+    "vadd.q C610, " rm1 ", " r2 "\n\t" \
+    "vadd.q C620, " r0 ", " r1 "\n\t" \
+    "vscl.q C620, C620, S700\n\t" \
+    "vscl.q C610, C610, S701\n\t" \
+    "vadd.q C600, C600, C620\n\t" \
+    "vadd.q " OUT ", C600, C610\n\t"
+/* rows y-2..y+3 for y=0..7 -> g=y..y+5 */
+#define VG0 "C000"
+#define VG1 "C010"
+#define VG2 "C020"
+#define VG3 "C030"
+#define VG4 "C100"
+#define VG5 "C110"
+#define VG6 "C120"
+#define VG7 "C130"
+#define VG8 "C200"
+#define VG9 "C210"
+#define VG10 "C220"
+#define VG11 "C230"
+#define VG12 "C300"
+/* outputs for y=0..7 into C400..C430, C500..C530 */
+#define VFIR2(OA, am2, am1, a0, a1, a2, a3, OB, bm2, bm1, b0, b1, b2, b3) \
+    "vadd.q C600, " am2 ", " a3 "\n\t" \
+    "vadd.q C630, " bm2 ", " b3 "\n\t" \
+    "vadd.q C610, " am1 ", " a2 "\n\t" \
+    "vadd.q " OB ", " bm1 ", " b2 "\n\t" \
+    "vadd.q C620, " a0 ", " a1 "\n\t" \
+    "vadd.q " OA ", " b0 ", " b1 "\n\t" \
+    "vscl.q C620, C620, S700\n\t" \
+    "vscl.q " OA ", " OA ", S700\n\t" \
+    "vscl.q C610, C610, S701\n\t" \
+    "vscl.q " OB ", " OB ", S701\n\t" \
+    "vadd.q C600, C600, C620\n\t" \
+    "vadd.q C630, C630, " OA "\n\t" \
+    "vadd.q " OA ", C600, C610\n\t" \
+    "vadd.q " OB ", C630, " OB "\n\t"
+#define VFIR_ALL8() \
+    VFIR2("C400", VG0, VG1, VG2, VG3, VG4, VG5,  "C410", VG1, VG2, VG3, VG4, VG5, VG6) \
+    VFIR2("C420", VG2, VG3, VG4, VG5, VG6, VG7,  "C430", VG3, VG4, VG5, VG6, VG7, VG8) \
+    VFIR2("C500", VG4, VG5, VG6, VG7, VG8, VG9,  "C510", VG5, VG6, VG7, VG8, VG9, VG10) \
+    VFIR2("C520", VG6, VG7, VG8, VG9, VG10, VG11, "C530", VG7, VG8, VG9, VG10, VG11, VG12) \
+    "lv.q  C630, 64(%[cst])\n\t"
+
+/* four rows unpacked stage-wise (mtv x4, vc2i x4, vi2f x4): the VFPU has a
+   ~5-cycle latency per dependent op, so independent words are interleaved */
+#define UNPACK4(j0, k0, j1, k1, j2, k2, j3, k3) \
+    "mtv   %0, S" #j0 #k0 "0\n\tmtv %1, S" #j1 #k1 "0\n\tmtv %2, S" #j2 #k2 "0\n\tmtv %3, S" #j3 #k3 "0\n\t" \
+    "vc2i.s C" #j0 #k0 "0, S" #j0 #k0 "0\n\tvc2i.s C" #j1 #k1 "0, S" #j1 #k1 "0\n\t" \
+    "vc2i.s C" #j2 #k2 "0, S" #j2 #k2 "0\n\tvc2i.s C" #j3 #k3 "0, S" #j3 #k3 "0\n\t" \
+    "vi2f.q C" #j0 #k0 "0, C" #j0 #k0 "0, 24\n\tvi2f.q C" #j1 #k1 "0, C" #j1 #k1 "0, 24\n\t" \
+    "vi2f.q C" #j2 #k2 "0, C" #j2 #k2 "0, 24\n\tvi2f.q C" #j3 #k3 "0, C" #j3 #k3 "0, 24\n\t"
+
+static av_always_inline void vload_half(const uint8_t *src, ptrdiff_t stride)
+{
+    const uint8_t *p = src - 2 * stride;
+    uint32_t w0, w1, w2, w3;
+    w0 = psp_ulw(p) ^ PSP_PIX_XOR; w1 = psp_ulw(p + stride) ^ PSP_PIX_XOR; w2 = psp_ulw(p + 2 * stride) ^ PSP_PIX_XOR; w3 = psp_ulw(p + 3 * stride) ^ PSP_PIX_XOR;
+    __asm__ volatile (UNPACK4(0,0, 0,1, 0,2, 0,3) : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); p += 4 * stride;
+    w0 = psp_ulw(p) ^ PSP_PIX_XOR; w1 = psp_ulw(p + stride) ^ PSP_PIX_XOR; w2 = psp_ulw(p + 2 * stride) ^ PSP_PIX_XOR; w3 = psp_ulw(p + 3 * stride) ^ PSP_PIX_XOR;
+    __asm__ volatile (UNPACK4(1,0, 1,1, 1,2, 1,3) : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); p += 4 * stride;
+    w0 = psp_ulw(p) ^ PSP_PIX_XOR; w1 = psp_ulw(p + stride) ^ PSP_PIX_XOR; w2 = psp_ulw(p + 2 * stride) ^ PSP_PIX_XOR; w3 = psp_ulw(p + 3 * stride) ^ PSP_PIX_XOR;
+    __asm__ volatile (UNPACK4(2,0, 2,1, 2,2, 2,3) : : "r"(w0), "r"(w1), "r"(w2), "r"(w3)); p += 4 * stride;
+    w0 = psp_ulw(p) ^ PSP_PIX_XOR;
+    __asm__ volatile (UNPACK(3, 0, "%0") : : "r"(w0));
+}
