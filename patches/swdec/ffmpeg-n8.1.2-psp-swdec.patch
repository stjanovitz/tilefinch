+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef AVCODEC_PSP_CABAC_H
+#define AVCODEC_PSP_CABAC_H
+
+#include <stdint.h>
+#include "libavutil/attributes.h"
+#include "libavcodec/cabac.h"
+#include "config.h"
+
+#if CABAC_BITS != 16
+#error "psp/cabac.h assumes CABAC_BITS == 16"
+#endif
+
+/* low += (bs[0]<<9) + (bs[1]<<1) - 0xFFFF; bs += 2   (t0/t1 scratch, t1 preloaded with bs[0]) */
+#define PSP_CABAC_REFILL_TAIL(low, bs, t0, t1)               \
+        "lbu   " t0 ", 1(" bs ")\n\t"                        \
+        "sll   " t1 ", " t1 ", 9\n\t"                        \
+        "sll   " t0 ", " t0 ", 1\n\t"                        \
+        "addu  " t1 ", " t1 ", " t0 "\n\t"                   \
+        "addiu " t1 ", " t1 ", -32768\n\t"                   \
+        "addiu " t1 ", " t1 ", -32767\n\t"                   \
+        "addu  " low ", " low ", " t1 "\n\t"                 \
+        "addiu " bs ", " bs ", 2\n\t"
+
+#define get_cabac_inline get_cabac_inline_psp
+static __attribute__((always_inline)) inline int get_cabac_inline_psp(CABACContext *c, uint8_t *const state)
+{
+    int bit, t0, t1, t2;
+    int low = c->low, range = c->range;
+    const uint8_t *bs = c->bytestream;
+
+    __asm__ (
+        ".set push\n\t"
+        ".set noreorder\n\t"
+        ".set nomacro\n\t"
+        "lbu   %[bit], 0(%[state])\n\t"              /* s = *state */
+        "andi  %[t0], %[range], 0xC0\n\t"
+        "sll   %[t0], %[t0], 1\n\t"
+        "addu  %[t0], %[t0], %[bit]\n\t"
+        "addu  %[t0], %[t0], %[tab]\n\t"
+        "lbu   %[t0], %[lps_off](%[t0])\n\t"          /* RangeLPS */
+        "subu  %[range], %[range], %[t0]\n\t"         /* range -= RangeLPS */
+        "sll   %[t1], %[range], 17\n\t"               /* range << (CABAC_BITS+1) */
+        "subu  %[t2], %[t1], %[low]\n\t"
+        "sra   %[t2], %[t2], 31\n\t"                  /* lps_mask */
+        "and   %[t1], %[t1], %[t2]\n\t"
+        "subu  %[low], %[low], %[t1]\n\t"             /* low -= (range<<17) & mask */
+        "subu  %[t0], %[t0], %[range]\n\t"            /* RangeLPS - range */
+        "and   %[t0], %[t0], %[t2]\n\t"
+        "addu  %[range], %[range], %[t0]\n\t"         /* range += (RangeLPS-range) & mask */
+        "xor   %[bit], %[bit], %[t2]\n\t"             /* s ^= mask */
+        "addu  %[t0], %[tab], %[bit]\n\t"
+        "lbu   %[t0], %[mlps_off](%[t0])\n\t"         /* new state */
+        "clz   %[t1], %[range]\n\t"                   /* renorm shift = clz(range) - 23 (range in 1..511) */
+        "andi  %[bit], %[bit], 1\n\t"                 /* bit = s & 1 */
+        "addiu %[t1], %[t1], -23\n\t"
+        "sb    %[t0], 0(%[state])\n\t"
+        "sllv  %[range], %[range], %[t1]\n\t"
+        "sllv  %[low], %[low], %[t1]\n\t"
+        "andi  %[t0], %[low], 0xFFFF\n\t"
+        "bnez  %[t0], 1f\n\t"
+        " lbu  %[t1], 0(%[bs])\n\t"                   /* delay slot: bs[0] (harmless if no refill) */
+        /* refill2: low += ((bs[0]<<9)+(bs[1]<<1)-0xFFFF) << (ctz(low)-16); bs += 2 */
+        "subu  %[t0], $zero, %[low]\n\t"
+        "and   %[t0], %[t0], %[low]\n\t"              /* low & -low */
+        "clz   %[t0], %[t0]\n\t"
+        "lbu   %[t2], 1(%[bs])\n\t"
+        "sll   %[t1], %[t1], 9\n\t"
+        "sll   %[t2], %[t2], 1\n\t"
+        "addu  %[t1], %[t1], %[t2]\n\t"
+        "addiu %[t1], %[t1], -32768\n\t"
+        "addiu %[t1], %[t1], -32767\n\t"              /* x = bytes - 0xFFFF */
+        "addiu %[t2], $zero, 15\n\t"
+        "subu  %[t2], %[t2], %[t0]\n\t"               /* i = 15 - clz(low & -low) = ctz(low) - 16 */
+        "sllv  %[t1], %[t1], %[t2]\n\t"
+        "addu  %[low], %[low], %[t1]\n\t"
+        "addiu %[bs], %[bs], 2\n\t"
+        "1:\n\t"
+        ".set pop\n\t"
+        : [bit]"=&r"(bit), [t0]"=&r"(t0), [t1]"=&r"(t1), [t2]"=&r"(t2),
+          [low]"+&r"(low), [range]"+&r"(range), [bs]"+&r"(bs),
+          "+m"(*state)
+        : [state]"r"(state), [tab]"r"(ff_h264_cabac_tables),
+          [lps_off]"i"(H264_LPS_RANGE_OFFSET),
+          [mlps_off]"i"(H264_MLPS_STATE_OFFSET + 128)
+    );
+    c->low = low;
+    c->range = range;
+    c->bytestream = bs;
+    return bit;
+}
+
+#define get_cabac_bypass get_cabac_bypass_psp
+static __attribute__((always_inline)) inline int get_cabac_bypass_psp(CABACContext *c)
+{
+    int bit, t0, t1;
+    int low = c->low;
+    const uint8_t *bs = c->bytestream;
+
+    __asm__ (
+        ".set push\n\t"
+        ".set noreorder\n\t"
+        ".set nomacro\n\t"
+        "sll   %[low], %[low], 1\n\t"
+        "andi  %[t0], %[low], 0xFFFF\n\t"
+        "bnez  %[t0], 1f\n\t"
+        " lbu  %[t1], 0(%[bs])\n\t"
+        PSP_CABAC_REFILL_TAIL("%[low]", "%[bs]", "%[t0]", "%[t1]")
+        "1:\n\t"
+        "sll   %[t1], %[range], 17\n\t"
+        "slt   %[bit], %[low], %[t1]\n\t"             /* 1 if low < range<<17 (bit 0) */
+        "subu  %[t0], %[low], %[t1]\n\t"
+        "movz  %[low], %[t0], %[bit]\n\t"             /* bit 1: low -= range<<17 */
+        "xori  %[bit], %[bit], 1\n\t"
+        ".set pop\n\t"
+        : [bit]"=&r"(bit), [t0]"=&r"(t0), [t1]"=&r"(t1),
+          [low]"+&r"(low), [bs]"+&r"(bs)
+        : [range]"r"(c->range)
+    );
+    c->low = low;
+    c->bytestream = bs;
+    return bit;
+}
+
+#define get_cabac_bypass_sign get_cabac_bypass_sign_psp
+static __attribute__((always_inline)) inline int get_cabac_bypass_sign_psp(CABACContext *c, int val)
+{
+    int t0, t1;
+    int low = c->low;
+    const uint8_t *bs = c->bytestream;
+
+    __asm__ (
+        ".set push\n\t"
+        ".set noreorder\n\t"
+        ".set nomacro\n\t"
+        "sll   %[low], %[low], 1\n\t"
+        "andi  %[t0], %[low], 0xFFFF\n\t"
+        "bnez  %[t0], 1f\n\t"
+        " lbu  %[t1], 0(%[bs])\n\t"
+        PSP_CABAC_REFILL_TAIL("%[low]", "%[bs]", "%[t0]", "%[t1]")
+        "1:\n\t"
+        "sll   %[t1], %[range], 17\n\t"
+        "subu  %[low], %[low], %[t1]\n\t"             /* low -= range<<17 */
+        "sra   %[t0], %[low], 31\n\t"                 /* mask */
+        "and   %[t1], %[t1], %[t0]\n\t"
+        "addu  %[low], %[low], %[t1]\n\t"             /* low += range & mask */
+        "xor   %[val], %[val], %[t0]\n\t"
+        "subu  %[val], %[val], %[t0]\n\t"             /* (val ^ mask) - mask */
+        ".set pop\n\t"
+        : [t0]"=&r"(t0), [t1]"=&r"(t1),
+          [low]"+&r"(low), [bs]"+&r"(bs), [val]"+&r"(val)
+        : [range]"r"(c->range)
+    );
+    c->low = low;
+    c->bytestream = bs;
+    return val;
+}
+
+#endif /* AVCODEC_PSP_CABAC_H */
diff --git a/libavcodec/psp/h264chroma_psp.c b/libavcodec/psp/h264chroma_psp.c
new file mode 100644
index 0000000..fb3bb6f
--- /dev/null
+++ b/libavcodec/psp/h264chroma_psp.c
@@ -0,0 +1,461 @@
+/*
+ * H.264 chroma motion compensation for the PSP VFPU (8-bit 4:2:0).
+ *
+ *   dst = (A*s[0] + B*s[1] + C*s[stride] + D*s[stride+1] + 32) >> 6
+ *   A+B+C+D = 64, so with the (b-128) representation the rounding constant
+ *   becomes 32 + 128*64 = 8224 and floor(v/64) is a vf2id with imm 17.
+ *
+ * Every source row is converted once (two unaligned words per quad: at +0
+ * and +1) and reused for the two output rows that reference it.  The
+ * destination is 4-byte aligned by construction (chroma partition offsets
+ * are even multiples of 2 pixels only for the 2-wide case, which stays in
+ * C).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#include "config.h"
+#if defined(SWDEC_PSP_ASM) && SWDEC_PSP_ASM
+
+#include <stdint.h>
+#include <stddef.h>
+#include "libavutil/attributes.h"
+#include "libavcodec/h264chroma.h"
+#include "vfpu_util.h"
+
+extern int swdec_psp_level;
+
+/* M700: S700=A S701=B S702=C S703=D ; C710 = K broadcast (8224) ; C720 = 129 broadcast */
+typedef struct { float w[4]; float k[4]; float c129[4]; } __attribute__((aligned(16))) chroma_consts;
+
+/* Load one 8-wide source row (offsets +0 and +1) into matrix m:
+   Cm00 = s[0..3], Cm10 = s[1..4], Cm20 = s[4..7], Cm30 = s[5..8]. */
+#define CH_LOADROW8(m, w0, w1, w2, w3) \
+    "mtv   " w0 ", S" m "00\n\t" \
+    "mtv   " w1 ", S" m "10\n\t" \
+    "mtv   " w2 ", S" m "20\n\t" \
+    "mtv   " w3 ", S" m "30\n\t" \
+    "vc2i.s C" m "00, S" m "00\n\t" \
+    "vc2i.s C" m "10, S" m "10\n\t" \
+    "vc2i.s C" m "20, S" m "20\n\t" \
+    "vc2i.s C" m "30, S" m "30\n\t" \
+    "vi2f.q C" m "00, C" m "00, 24\n\t" \
+    "vi2f.q C" m "10, C" m "10, 24\n\t" \
+    "vi2f.q C" m "20, C" m "20, 24\n\t" \
+    "vi2f.q C" m "30, C" m "30, 24\n\t"
+
+#define CH_LOADROW4(m, w0, w1) \
+    "mtv   " w0 ", S" m "00\n\t" \
+    "mtv   " w1 ", S" m "10\n\t" \
+    "vc2i.s C" m "00, S" m "00\n\t" \
+    "vc2i.s C" m "10, S" m "10\n\t" \
+    "vi2f.q C" m "00, C" m "00, 24\n\t" \
+    "vi2f.q C" m "10, C" m "10, 24\n\t"
+
+/* Full 2-D bilinear for one output quad from rows a (current) / b (next):
+   out = A*Ca(x0) + B*Ca(x1) + C*Cb(x0) + D*Cb(x1) + K  -> C200/C210 */
+#define CH_BILIN(out, tmp, a0, a1, b0, b1) \
+    "vscl.q " out ", " a0 ", S700\n\t" \
+    "vscl.q " tmp ", " a1 ", S701\n\t" \
+    "vadd.q " out ", " out ", " tmp "\n\t" \
+    "vscl.q " tmp ", " b0 ", S702\n\t" \
+    "vadd.q " out ", " out ", " tmp "\n\t" \
+    "vscl.q " tmp ", " b1 ", S703\n\t" \
+    "vadd.q " out ", " out ", " tmp "\n\t" \
+    "vadd.q " out ", " out ", C710\n\t"
+
+/* two output quads with the chains interleaved (5-cycle VFPU latency) */
+#define CH_BILIN2(o1, t1, a0, a1, b0, b1, o2, t2, c0, c1, d0, d1) \
+    "vscl.q " o1 ", " a0 ", S700\n\t"  "vscl.q " o2 ", " c0 ", S700\n\t" \
+    "vscl.q " t1 ", " a1 ", S701\n\t"  "vscl.q " t2 ", " c1 ", S701\n\t" \
+    "vadd.q " o1 ", " o1 ", " t1 "\n\t" "vadd.q " o2 ", " o2 ", " t2 "\n\t" \
+    "vscl.q " t1 ", " b0 ", S702\n\t"  "vscl.q " t2 ", " d0 ", S702\n\t" \
+    "vadd.q " o1 ", " o1 ", " t1 "\n\t" "vadd.q " o2 ", " o2 ", " t2 "\n\t" \
+    "vscl.q " t1 ", " b1 ", S703\n\t"  "vscl.q " t2 ", " d1 ", S703\n\t" \
+    "vadd.q " o1 ", " o1 ", " t1 "\n\t" "vadd.q " o2 ", " o2 ", " t2 "\n\t" \
+    "vadd.q " o1 ", " o1 ", C710\n\t"   "vadd.q " o2 ", " o2 ", C710\n\t"
+#define CH_STORE_PUT2(q1, s1, q2, s2, addr) \
+    "vf2id.q " q1 ", " q1 ", 17\n\t" "vf2id.q " q2 ", " q2 ", 17\n\t" \
+    "vi2uc.q " s1 ", " q1 "\n\t"     "vi2uc.q " s2 ", " q2 "\n\t" \
+    "sv.s  " s1 ", 0(" addr ")\n\t"  "sv.s  " s2 ", 4(" addr ")\n\t"
+#define CH_STORE_AVG2(q1, dq1, s1, q2, dq2, s2, addr) \
+    "vf2id.q " q1 ", " q1 ", 17\n\t" "vf2id.q " q2 ", " q2 ", 17\n\t" \
+    "vi2f.q " q1 ", " q1 ", 23\n\t"  "vi2f.q " q2 ", " q2 ", 23\n\t" \
+    "vadd.q " q1 ", " q1 ", " dq1 "\n\t" "vadd.q " q2 ", " q2 ", " dq2 "\n\t" \
+    "vadd.q " q1 ", " q1 ", C720\n\t"  "vadd.q " q2 ", " q2 ", C720\n\t" \
+    "vf2id.q " q1 ", " q1 ", 22\n\t" "vf2id.q " q2 ", " q2 ", 22\n\t" \
+    "vi2uc.q " s1 ", " q1 "\n\t"     "vi2uc.q " s2 ", " q2 "\n\t" \
+    "sv.s  " s1 ", 0(" addr ")\n\t"  "sv.s  " s2 ", 4(" addr ")\n\t"
+#define CH_LIN2(o1, t1, p1, q1, o2, t2, p2, q2) \
+    "vscl.q " o1 ", " p1 ", S700\n\t"  "vscl.q " o2 ", " p2 ", S700\n\t" \
+    "vscl.q " t1 ", " q1 ", S701\n\t"  "vscl.q " t2 ", " q2 ", S701\n\t" \
+    "vadd.q " o1 ", " o1 ", " t1 "\n\t" "vadd.q " o2 ", " o2 ", " t2 "\n\t" \
+    "vadd.q " o1 ", " o1 ", C710\n\t"   "vadd.q " o2 ", " o2 ", C710\n\t"
+
+/* 1-D: out = A*p + E*q + K  (E in S701) */
+#define CH_LIN(out, tmp, p, q) \
+    "vscl.q " out ", " p ", S700\n\t" \
+    "vscl.q " tmp ", " q ", S701\n\t" \
+    "vadd.q " out ", " out ", " tmp "\n\t" \
+    "vadd.q " out ", " out ", C710\n\t"
+
+/* put: floor(v/64) -> bytes */
+#define CH_STORE_PUT(q, s, addr, off) \
+    "vf2id.q " q ", " q ", 17\n\t" \
+    "vi2uc.q " s ", " q "\n\t" \
+    "sv.s  " s ", " off "(" addr ")\n\t"
+
+/* avg: p = floor(v/64); dst = floor((dst + p + 1)/2); dq holds converted dst (d-128) */
+#define CH_STORE_AVG(q, dq, s, addr, off) \
+    "vf2id.q " q ", " q ", 17\n\t" \
+    "vi2f.q " q ", " q ", 23\n\t" \
+    "vadd.q " q ", " q ", " dq "\n\t" \
+    "vadd.q " q ", " q ", C720\n\t" \
+    "vf2id.q " q ", " q ", 22\n\t" \
+    "vi2uc.q " s ", " q "\n\t" \
+    "sv.s  " s ", " off "(" addr ")\n\t"
+
+static av_always_inline void chroma_mc_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                           int h, int x, int y, int width, int avg)
+{
+    const int A = (8 - x) * (8 - y), B = x * (8 - y), C = (8 - x) * y, D = x * y;
+    chroma_consts cst;
+    cst.k[0] = cst.k[1] = cst.k[2] = cst.k[3] = 32.f + 128.f * 64.f;
+    cst.c129[0] = cst.c129[1] = cst.c129[2] = cst.c129[3] = 129.f;
+
+    if (D) {
+        cst.w[0] = (float) A; cst.w[1] = (float) B; cst.w[2] = (float) C; cst.w[3] = (float) D;
+        __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\tlv.q C720, 32(%0)\n\t" : : "r"(&cst) : "memory");
+        if (width == 8) {
+            /* prime row 0 into M000 */
+            {
+                uint32_t w0 = psp_ulw(src) ^ PSP_PIX_XOR, w1 = psp_ulw(src + 1) ^ PSP_PIX_XOR;
+                uint32_t w2 = psp_ulw(src + 4) ^ PSP_PIX_XOR, w3 = psp_ulw(src + 5) ^ PSP_PIX_XOR;
+                __asm__ volatile (CH_LOADROW8("0", "%0", "%1", "%2", "%3") : : "r"(w0), "r"(w1), "r"(w2), "r"(w3));
+            }
+            for (int i = 0; i < h; i++) {
+                const uint8_t *s1 = src + (i + 1) * stride;
+                uint32_t w0 = psp_ulw(s1) ^ PSP_PIX_XOR, w1 = psp_ulw(s1 + 1) ^ PSP_PIX_XOR;
+                uint32_t w2 = psp_ulw(s1 + 4) ^ PSP_PIX_XOR, w3 = psp_ulw(s1 + 5) ^ PSP_PIX_XOR;
+                uint8_t *d = dst + i * stride;
+                if (i & 1) {
+                    /* current row in M100, next into M000 */
+                    if (!avg) {
+                        __asm__ volatile (
+                            CH_LOADROW8("0", "%0", "%1", "%2", "%3")
+                            CH_BILIN2("C200", "C230", "C100", "C110", "C000", "C010", "C210", "C320", "C120", "C130", "C020", "C030")
+                            CH_STORE_PUT2("C200", "S220", "C210", "S221", "%4")
+                            : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d) : "memory");
+                    } else {
+                        uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR, d1 = psp_lw(d + 4) ^ PSP_PIX_XOR;
+                        __asm__ volatile (
+                            CH_LOADROW8("0", "%0", "%1", "%2", "%3")
+                            CH_LOADROW4("3", "%5", "%6")
+                            CH_BILIN2("C200", "C230", "C100", "C110", "C000", "C010", "C210", "C320", "C120", "C130", "C020", "C030")
+                            CH_STORE_AVG2("C200", "C300", "S220", "C210", "C310", "S221", "%4")
+                            : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d), "r"(d0), "r"(d1) : "memory");
+                    }
+                } else {
+                    if (!avg) {
+                        __asm__ volatile (
+                            CH_LOADROW8("1", "%0", "%1", "%2", "%3")
+                            CH_BILIN2("C200", "C230", "C000", "C010", "C100", "C110", "C210", "C320", "C020", "C030", "C120", "C130")
+                            CH_STORE_PUT2("C200", "S220", "C210", "S221", "%4")
+                            : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d) : "memory");
+                    } else {
+                        uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR, d1 = psp_lw(d + 4) ^ PSP_PIX_XOR;
+                        __asm__ volatile (
+                            CH_LOADROW8("1", "%0", "%1", "%2", "%3")
+                            CH_LOADROW4("3", "%5", "%6")
+                            CH_BILIN2("C200", "C230", "C000", "C010", "C100", "C110", "C210", "C320", "C020", "C030", "C120", "C130")
+                            CH_STORE_AVG2("C200", "C300", "S220", "C210", "C310", "S221", "%4")
+                            : : "r"(w0), "r"(w1), "r"(w2), "r"(w3), "r"(d), "r"(d0), "r"(d1) : "memory");
+                    }
+                }
+            }
+        } else { /* width 4 */
+            {
+                uint32_t w0 = psp_ulw(src) ^ PSP_PIX_XOR, w1 = psp_ulw(src + 1) ^ PSP_PIX_XOR;
+                __asm__ volatile (CH_LOADROW4("0", "%0", "%1") : : "r"(w0), "r"(w1));
+            }
+            for (int i = 0; i < h; i++) {
+                const uint8_t *s1 = src + (i + 1) * stride;
+                uint32_t w0 = psp_ulw(s1) ^ PSP_PIX_XOR, w1 = psp_ulw(s1 + 1) ^ PSP_PIX_XOR;
+                uint8_t *d = dst + i * stride;
+                if (i & 1) {
+                    if (!avg) {
+                        __asm__ volatile (
+                            CH_LOADROW4("0", "%0", "%1")
+                            CH_BILIN("C200", "C230", "C100", "C110", "C000", "C010")
+                            CH_STORE_PUT("C200", "S220", "%2", "0")
+                            : : "r"(w0), "r"(w1), "r"(d) : "memory");
+                    } else {
+                        uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR;
+                        __asm__ volatile (
+                            CH_LOADROW4("0", "%0", "%1")
+                            "mtv %3, S300\n\tvc2i.s C300, S300\n\tvi2f.q C300, C300, 24\n\t"
+                            CH_BILIN("C200", "C230", "C100", "C110", "C000", "C010")
+                            CH_STORE_AVG("C200", "C300", "S220", "%2", "0")
+                            : : "r"(w0), "r"(w1), "r"(d), "r"(d0) : "memory");
+                    }
+                } else {
+                    if (!avg) {
+                        __asm__ volatile (
+                            CH_LOADROW4("1", "%0", "%1")
+                            CH_BILIN("C200", "C230", "C000", "C010", "C100", "C110")
+                            CH_STORE_PUT("C200", "S220", "%2", "0")
+                            : : "r"(w0), "r"(w1), "r"(d) : "memory");
+                    } else {
+                        uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR;
+                        __asm__ volatile (
+                            CH_LOADROW4("1", "%0", "%1")
+                            "mtv %3, S300\n\tvc2i.s C300, S300\n\tvi2f.q C300, C300, 24\n\t"
+                            CH_BILIN("C200", "C230", "C000", "C010", "C100", "C110")
+                            CH_STORE_AVG("C200", "C300", "S220", "%2", "0")
+                            : : "r"(w0), "r"(w1), "r"(d), "r"(d0) : "memory");
+                    }
+                }
+            }
+        }
+    } else if (B + C) {
+        /* one-dimensional: out = A*s[0] + E*s[step] with step = stride (C) or 1 (B) */
+        const int E = B + C;
+        const ptrdiff_t step = C ? stride : 1;
+        cst.w[0] = (float) A; cst.w[1] = (float) E; cst.w[2] = 0.f; cst.w[3] = 0.f;
+        __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\tlv.q C720, 32(%0)\n\t" : : "r"(&cst) : "memory");
+        for (int i = 0; i < h; i++) {
+            const uint8_t *s0 = src + i * stride, *sq = s0 + step;
+            uint8_t *d = dst + i * stride;
+            uint32_t p0 = psp_ulw(s0) ^ PSP_PIX_XOR, q0 = psp_ulw(sq) ^ PSP_PIX_XOR;
+            if (width == 8) {
+                uint32_t p1 = psp_ulw(s0 + 4) ^ PSP_PIX_XOR, q1 = psp_ulw(sq + 4) ^ PSP_PIX_XOR;
+                if (!avg) {
+                    __asm__ volatile (
+                        CH_LOADROW4("0", "%0", "%1")      /* C000 = p0, C010 = q0 */
+                        CH_LOADROW4("1", "%2", "%3")      /* C100 = p1, C110 = q1 */
+                        CH_LIN2("C200", "C230", "C000", "C010", "C210", "C320", "C100", "C110")
+                        CH_STORE_PUT2("C200", "S220", "C210", "S221", "%4")
+                        : : "r"(p0), "r"(q0), "r"(p1), "r"(q1), "r"(d) : "memory");
+                } else {
+                    uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR, d1 = psp_lw(d + 4) ^ PSP_PIX_XOR;
+                    __asm__ volatile (
+                        CH_LOADROW4("0", "%0", "%1")
+                        CH_LOADROW4("1", "%2", "%3")
+                        CH_LOADROW4("3", "%5", "%6")
+                        CH_LIN2("C200", "C230", "C000", "C010", "C210", "C320", "C100", "C110")
+                        CH_STORE_AVG2("C200", "C300", "S220", "C210", "C310", "S221", "%4")
+                        : : "r"(p0), "r"(q0), "r"(p1), "r"(q1), "r"(d), "r"(d0), "r"(d1) : "memory");
+                }
+            } else {
+                if (!avg) {
+                    __asm__ volatile (
+                        CH_LOADROW4("0", "%0", "%1")
+                        CH_LIN("C200", "C230", "C000", "C010")
+                        CH_STORE_PUT("C200", "S220", "%2", "0")
+                        : : "r"(p0), "r"(q0), "r"(d) : "memory");
+                } else {
+                    uint32_t d0 = psp_lw(d) ^ PSP_PIX_XOR;
+                    __asm__ volatile (
+                        CH_LOADROW4("0", "%0", "%1")
+                        "mtv %3, S300\n\tvc2i.s C300, S300\n\tvi2f.q C300, C300, 24\n\t"
+                        CH_LIN("C200", "C230", "C000", "C010")
+                        CH_STORE_AVG("C200", "C300", "S220", "%2", "0")
+                        : : "r"(p0), "r"(q0), "r"(d), "r"(d0) : "memory");
+                }
+            }
+        }
+    } else {
+        /* A == 64: plain copy (put) or average with dst (avg) */
+        for (int i = 0; i < h; i++) {
+            const uint8_t *s0 = src + i * stride;
+            uint8_t *d = dst + i * stride;
+            if (!avg) {
+                *(uint32_t *) d = psp_ulw(s0);
+                if (width == 8) *(uint32_t *) (d + 4) = psp_ulw(s0 + 4);
+            } else {
+                /* rnd_avg32: (a | b) - (((a ^ b) & 0xFEFEFEFE) >> 1) */
+                uint32_t a = psp_lw(d), b = psp_ulw(s0);
+                *(uint32_t *) d = (a | b) - (((a ^ b) & 0xFEFEFEFEu) >> 1);
+                if (width == 8) {
+                    a = psp_lw(d + 4); b = psp_ulw(s0 + 4);
+                    *(uint32_t *) (d + 4) = (a | b) - (((a ^ b) & 0xFEFEFEFEu) >> 1);
+                }
+            }
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Cb and Cr together (2026-10-29): one call per partition for both      */
+/* planes (same vector, so the same weights): the weights are set up     */
+/* once, and each row runs the Cb and Cr chains interleaved, which also  */
+/* gives the 4-wide case two independent chains to hide the VFPU         */
+/* latency. Same arithmetic, so the same bytes as two single-plane calls.*/
+/* Registers: Cb rows M0/M1, Cr rows M4/M5; Cb outputs C200/C210 (temps   */
+/* C220/C230), Cr outputs C600/C610 (temps C620/C630); avg destinations  */
+/* C300..C330; constants M7.                                             */
+/* ------------------------------------------------------------------ */
+#define CH2_PUT2(q1, s1, a1, o1, q2, s2, a2, o2) \
+    "vf2id.q " q1 ", " q1 ", 17\n\t" "vf2id.q " q2 ", " q2 ", 17\n\t" \
+    "vi2uc.q " s1 ", " q1 "\n\t"     "vi2uc.q " s2 ", " q2 "\n\t" \
+    "sv.s  " s1 ", " o1 "(" a1 ")\n\t" "sv.s  " s2 ", " o2 "(" a2 ")\n\t"
+#define CH2_AVG2(q1, dq1, s1, a1, o1, q2, dq2, s2, a2, o2) \
+    "vf2id.q " q1 ", " q1 ", 17\n\t" "vf2id.q " q2 ", " q2 ", 17\n\t" \
+    "vi2f.q " q1 ", " q1 ", 23\n\t"  "vi2f.q " q2 ", " q2 ", 23\n\t" \
+    "vadd.q " q1 ", " q1 ", " dq1 "\n\t" "vadd.q " q2 ", " q2 ", " dq2 "\n\t" \
+    "vadd.q " q1 ", " q1 ", C720\n\t"  "vadd.q " q2 ", " q2 ", C720\n\t" \
+    "vf2id.q " q1 ", " q1 ", 22\n\t" "vf2id.q " q2 ", " q2 ", 22\n\t" \
+    "vi2uc.q " s1 ", " q1 "\n\t"     "vi2uc.q " s2 ", " q2 "\n\t" \
+    "sv.s  " s1 ", " o1 "(" a1 ")\n\t" "sv.s  " s2 ", " o2 "(" a2 ")\n\t"
+/* destination word -> (d-128) quad */
+#define CH2_DST(q, sreg, w) \
+    "mtv   " w ", " sreg "\n\tvc2i.s " q ", " sreg "\n\tvi2f.q " q ", " q ", 24\n\t"
+
+static av_always_inline void chroma2_mc_psp(uint8_t *dcb, uint8_t *dcr,
+                                            const uint8_t *scb, const uint8_t *scr,
+                                            ptrdiff_t stride, int h, int x, int y,
+                                            int width, int avg)
+{
+    const int A = (8 - x) * (8 - y), B = x * (8 - y), C = (8 - x) * y, D = x * y;
+    chroma_consts cst;
+    cst.k[0] = cst.k[1] = cst.k[2] = cst.k[3] = 32.f + 128.f * 64.f;
+    cst.c129[0] = cst.c129[1] = cst.c129[2] = cst.c129[3] = 129.f;
+
+    if (D) {
+        cst.w[0] = (float) A; cst.w[1] = (float) B; cst.w[2] = (float) C; cst.w[3] = (float) D;
+        __asm__ volatile ("lv.q C700, 0(%0)\n\tlv.q C710, 16(%0)\n\tlv.q C720, 32(%0)\n\t" : : "r"(&cst) : "memory");
+        if (width == 8) {
+            {
+                uint32_t b0 = psp_ulw(scb) ^ PSP_PIX_XOR, b1 = psp_ulw(scb + 1) ^ PSP_PIX_XOR;
+                uint32_t b2 = psp_ulw(scb + 4) ^ PSP_PIX_XOR, b3 = psp_ulw(scb + 5) ^ PSP_PIX_XOR;
+                uint32_t r0 = psp_ulw(scr) ^ PSP_PIX_XOR, r1 = psp_ulw(scr + 1) ^ PSP_PIX_XOR;
+                uint32_t r2 = psp_ulw(scr + 4) ^ PSP_PIX_XOR, r3 = psp_ulw(scr + 5) ^ PSP_PIX_XOR;
+                __asm__ volatile (CH_LOADROW8("0", "%0", "%1", "%2", "%3") CH_LOADROW8("4", "%4", "%5", "%6", "%7")
+                                  : : "r"(b0), "r"(b1), "r"(b2), "r"(b3), "r"(r0), "r"(r1), "r"(r2), "r"(r3));
+            }
+            for (int i = 0; i < h; i++) {
+                const uint8_t *sb = scb + (i + 1) * stride, *sr = scr + (i + 1) * stride;
+                uint32_t b0 = psp_ulw(sb) ^ PSP_PIX_XOR, b1 = psp_ulw(sb + 1) ^ PSP_PIX_XOR;
+                uint32_t b2 = psp_ulw(sb + 4) ^ PSP_PIX_XOR, b3 = psp_ulw(sb + 5) ^ PSP_PIX_XOR;
+                uint32_t r0 = psp_ulw(sr) ^ PSP_PIX_XOR, r1 = psp_ulw(sr + 1) ^ PSP_PIX_XOR;
+                uint32_t r2 = psp_ulw(sr + 4) ^ PSP_PIX_XOR, r3 = psp_ulw(sr + 5) ^ PSP_PIX_XOR;
+                uint8_t *db = dcb + i * stride, *dr = dcr + i * stride;
+                uint32_t e0 = 0, e1 = 0, e2 = 0, e3 = 0;
+                if (avg) {
+                    e0 = psp_lw(db) ^ PSP_PIX_XOR; e1 = psp_lw(db + 4) ^ PSP_PIX_XOR;
+                    e2 = psp_lw(dr) ^ PSP_PIX_XOR; e3 = psp_lw(dr + 4) ^ PSP_PIX_XOR;
+                }
+#define CH2_ROW8(CB, NB, CR, NR, STORE) \
+    __asm__ volatile ( \
+        CH_LOADROW8(NB, "%0", "%1", "%2", "%3") CH_LOADROW8(NR, "%4", "%5", "%6", "%7") \
+        CH_BILIN2("C200", "C220", "C" CB "00", "C" CB "10", "C" NB "00", "C" NB "10", \
+                  "C600", "C620", "C" CR "00", "C" CR "10", "C" NR "00", "C" NR "10") \
+        CH_BILIN2("C210", "C230", "C" CB "20", "C" CB "30", "C" NB "20", "C" NB "30", \
+                  "C610", "C630", "C" CR "20", "C" CR "30", "C" NR "20", "C" NR "30") \
+        STORE \
+        : : "r"(b0), "r"(b1), "r"(b2), "r"(b3), "r"(r0), "r"(r1), "r"(r2), "r"(r3), \
+            [db]"r"(db), [dr]"r"(dr), [e0]"r"(e0), [e1]"r"(e1), [e2]"r"(e2), [e3]"r"(e3) : "memory")
+#define CH2_STORE8_PUT \
+    CH2_PUT2("C200", "S220", "%[db]", "0", "C600", "S620", "%[dr]", "0") \
+    CH2_PUT2("C210", "S221", "%[db]", "4", "C610", "S621", "%[dr]", "4")
+#define CH2_STORE8_AVG \
+    CH2_DST("C300", "S300", "%[e0]") CH2_DST("C310", "S310", "%[e1]") \
+    CH2_DST("C320", "S320", "%[e2]") CH2_DST("C330", "S330", "%[e3]") \
+    CH2_AVG2("C200", "C300", "S220", "%[db]", "0", "C600", "C320", "S620", "%[dr]", "0") \
+    CH2_AVG2("C210", "C310", "S221", "%[db]", "4", "C610", "C330", "S621", "%[dr]", "4")
+                if (i & 1) {
+                    if (!avg) CH2_ROW8("1", "0", "5", "4", CH2_STORE8_PUT);
+                    else      CH2_ROW8("1", "0", "5", "4", CH2_STORE8_AVG);
+                } else {
+                    if (!avg) CH2_ROW8("0", "1", "4", "5", CH2_STORE8_PUT);
+                    else      CH2_ROW8("0", "1", "4", "5", CH2_STORE8_AVG);
+                }
+#undef CH2_ROW8
+            }
+        } else { /* width 4 */
+            {
+                uint32_t b0 = psp_ulw(scb) ^ PSP_PIX_XOR, b1 = psp_ulw(scb + 1) ^ PSP_PIX_XOR;
+                uint32_t r0 = psp_ulw(scr) ^ PSP_PIX_XOR, r1 = psp_ulw(scr + 1) ^ PSP_PIX_XOR;
+                __asm__ volatile (CH_LOADROW4("0", "%0", "%1") CH_LOADROW4("4", "%2", "%3")
+                                  : : "r"(b0), "r"(b1), "r"(r0), "r"(r1));
+            }
+            for (int i = 0; i < h; i++) {
+                const uint8_t *sb = scb + (i + 1) * stride, *sr = scr + (i + 1) * stride;
+                uint32_t b0 = psp_ulw(sb) ^ PSP_PIX_XOR, b1 = psp_ulw(sb + 1) ^ PSP_PIX_XOR;
+                uint32_t r0 = psp_ulw(sr) ^ PSP_PIX_XOR, r1 = psp_ulw(sr + 1) ^ PSP_PIX_XOR;
+                uint8_t *db = dcb + i * stride, *dr = dcr + i * stride;
+                uint32_t e0 = 0, e2 = 0;
+                if (avg) { e0 = psp_lw(db) ^ PSP_PIX_XOR; e2 = psp_lw(dr) ^ PSP_PIX_XOR; }
+#define CH2_ROW4(CB, NB, CR, NR, STORE) \
+    __asm__ volatile ( \
+        CH_LOADROW4(NB, "%0", "%1") CH_LOADROW4(NR, "%2", "%3") \
+        CH_BILIN2("C200", "C220", "C" CB "00", "C" CB "10", "C" NB "00", "C" NB "10", \
+                  "C600", "C620", "C" CR "00", "C" CR "10", "C" NR "00", "C" NR "10") \
+        STORE \
+        : : "r"(b0), "r"(b1), "r"(r0), "r"(r1), \
+            [db]"r"(db), [dr]"r"(dr), [e0]"r"(e0), [e2]"r"(e2) : "memory")
+#define CH2_STORE4_PUT CH2_PUT2("C200", "S220", "%[db]", "0", "C600", "S620", "%[dr]", "0")
+#define CH2_STORE4_AVG \
+    CH2_DST("C300", "S300", "%[e0]") CH2_DST("C320", "S320", "%[e2]") \
+    CH2_AVG2("C200", "C300", "S220", "%[db]", "0", "C600", "C320", "S620", "%[dr]", "0")
+                if (i & 1) {
+                    if (!avg) CH2_ROW4("1", "0", "5", "4", CH2_STORE4_PUT);
+                    else      CH2_ROW4("1", "0", "5", "4", CH2_STORE4_AVG);
+                } else {
+                    if (!avg) CH2_ROW4("0", "1", "4", "5", CH2_STORE4_PUT);
+                    else      CH2_ROW4("0", "1", "4", "5", CH2_STORE4_AVG);
+                }
+#undef CH2_ROW4
+            }
+        }
+    } else {
+        /* one-dimensional and copy cases: per plane, sharing nothing worth
+           the code; the single-plane kernel handles them */
+        chroma_mc_psp(dcb, scb, stride, h, x, y, width, avg);
+        chroma_mc_psp(dcr, scr, stride, h, x, y, width, avg);
+    }
+}
+
+static void put_h264_chroma2_mc8_psp(uint8_t *dcb, uint8_t *dcr, const uint8_t *scb, const uint8_t *scr,
+                                     ptrdiff_t stride, int h, int x, int y)
+{ chroma2_mc_psp(dcb, dcr, scb, scr, stride, h, x, y, 8, 0); }
+static void put_h264_chroma2_mc4_psp(uint8_t *dcb, uint8_t *dcr, const uint8_t *scb, const uint8_t *scr,
+                                     ptrdiff_t stride, int h, int x, int y)
+{ chroma2_mc_psp(dcb, dcr, scb, scr, stride, h, x, y, 4, 0); }
+static void avg_h264_chroma2_mc8_psp(uint8_t *dcb, uint8_t *dcr, const uint8_t *scb, const uint8_t *scr,
+                                     ptrdiff_t stride, int h, int x, int y)
+{ chroma2_mc_psp(dcb, dcr, scb, scr, stride, h, x, y, 8, 1); }
+static void avg_h264_chroma2_mc4_psp(uint8_t *dcb, uint8_t *dcr, const uint8_t *scb, const uint8_t *scr,
+                                     ptrdiff_t stride, int h, int x, int y)
+{ chroma2_mc_psp(dcb, dcr, scb, scr, stride, h, x, y, 4, 1); }
+
+static void put_h264_chroma_mc8_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int h, int x, int y)
+{ chroma_mc_psp(dst, src, stride, h, x, y, 8, 0); }
+static void put_h264_chroma_mc4_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int h, int x, int y)
+{ chroma_mc_psp(dst, src, stride, h, x, y, 4, 0); }
+static void avg_h264_chroma_mc8_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int h, int x, int y)
+{ chroma_mc_psp(dst, src, stride, h, x, y, 8, 1); }
+static void avg_h264_chroma_mc4_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int h, int x, int y)
+{ chroma_mc_psp(dst, src, stride, h, x, y, 4, 1); }
+
+av_cold void ff_h264chroma_init_psp(H264ChromaContext *c, int bit_depth)
+{
+    if (bit_depth != 8 || swdec_psp_level < 1)
+        return;
+    c->put_h264_chroma_pixels_tab[0] = put_h264_chroma_mc8_psp;
+    c->put_h264_chroma_pixels_tab[1] = put_h264_chroma_mc4_psp;
+    c->avg_h264_chroma_pixels_tab[0] = avg_h264_chroma_mc8_psp;
+    c->avg_h264_chroma_pixels_tab[1] = avg_h264_chroma_mc4_psp;
+    c->put_h264_chroma2_pixels_tab[0] = put_h264_chroma2_mc8_psp;
+    c->put_h264_chroma2_pixels_tab[1] = put_h264_chroma2_mc4_psp;
+    c->avg_h264_chroma2_pixels_tab[0] = avg_h264_chroma2_mc8_psp;
+    c->avg_h264_chroma2_pixels_tab[1] = avg_h264_chroma2_mc4_psp;
+}
+
+#else
+typedef int swdec_psp_h264chroma_unused;
+#endif
