+#define LFL_PACK1(Q, S, off, base) \
+    "vadd.q " Q ", " Q ", C600\n\t" \
+    "vf2id.q " Q ", " Q ", 23\n\t" \
+    "vi2uc.q " S ", " Q "\n\t" \
+    "sv.s  " S ", " off "(" base ")\n\t"
