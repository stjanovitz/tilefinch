+/* pack the eight quads to bytes: S600..S603 (rows 0-3, px 0-3), S610..S613 (px 4-7) */
+#define HB_PACK() \
+    "vi2uc.q S600, C400\n\tvi2uc.q S601, C410\n\tvi2uc.q S602, C420\n\tvi2uc.q S603, C430\n\t" \
+    "vi2uc.q S610, C500\n\tvi2uc.q S611, C510\n\tvi2uc.q S612, C520\n\tvi2uc.q S613, C530\n\t" \
+    "sv.s  S600, 0(%[d0])\n\tsv.s S601, 0(%[d1])\n\tsv.s S602, 0(%[d2])\n\tsv.s S603, 0(%[d3])\n\t" \
+    "sv.s  S610, 4(%[d0])\n\tsv.s S611, 4(%[d1])\n\tsv.s S612, 4(%[d2])\n\tsv.s S613, 4(%[d3])\n\t"
+/* dst words -> (b-128) quads in C000..C030 (px 0-3 of rows 0-3) and C100..C130 (px 4-7) */
+#define HB_DST() \
