+/* ================================================================== */
+/* 8x8 position functions                                              */
+/* ================================================================== */
+
+/* full-pel copy / average */
+static av_noinline void put_qpel8_mc00_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{
+    for (int y = 0; y < 8; y++, dst += stride, src += stride) {
+        *(uint32_t *) dst = psp_ulw(src);
+        *(uint32_t *) (dst + 4) = psp_ulw(src + 4);
+    }
+}
+static inline uint32_t rnd_avg32(uint32_t a, uint32_t b) { return (a | b) - (((a ^ b) & 0xFEFEFEFEu) >> 1); }
+static av_noinline void avg_qpel8_mc00_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{
+    for (int y = 0; y < 8; y++, dst += stride, src += stride) {
+        *(uint32_t *) dst = rnd_avg32(psp_lw(dst), psp_ulw(src));
+        *(uint32_t *) (dst + 4) = rnd_avg32(psp_lw(dst + 4), psp_ulw(src + 4));
+    }
+}
+
+/* horizontal family */
+static av_noinline void put_qpel8_mc20_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_PUT); }
+static av_noinline void avg_qpel8_mc20_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_AVGDST); }
+static av_noinline void put_qpel8_mc10_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X0); }
+static av_noinline void avg_qpel8_mc10_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X0_DST); }
+static av_noinline void put_qpel8_mc30_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X1); }
+static av_noinline void avg_qpel8_mc30_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_h(dst, stride, src, stride, 8, HM_L2X1_DST); }
+
+/* vertical family */
+static av_always_inline void qpel8_v(uint8_t *dst, ptrdiff_t dstStride, const uint8_t *src, ptrdiff_t srcStride,
+                                     int mode, const float *tmpf)
+{
+    qpel8_v_half(dst, dstStride, src, srcStride, 0, mode, tmpf, 0);
+    qpel8_v_half(dst + 4, dstStride, src + 4, srcStride, 0, mode, tmpf ? tmpf + 4 : 0, 0);
+}
+static av_noinline void put_qpel8_mc02_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_PUT, 0); }
+static av_noinline void avg_qpel8_mc02_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_AVGDST, 0); }
+static av_noinline void put_qpel8_mc01_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW0, 0); }
+static av_noinline void avg_qpel8_mc01_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW0_DST, 0); }
+static av_noinline void put_qpel8_mc03_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW1, 0); }
+static av_noinline void avg_qpel8_mc03_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_v(dst, stride, src, stride, VM_L2ROW1_DST, 0); }
+
+/* diagonal family: halfH (float tmp) averaged with v-lowpass */
+static av_always_inline void qpel8_diag(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                        int hoff, int voff, int avg)
+{
+    float halfH[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) halfH, 32, src + hoff * stride, stride, 8, HM_TMPF);
+    qpel8_v(dst, stride, src + voff, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfH);
+}
+static av_noinline void put_qpel8_mc11_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 0, 0); }
+static av_noinline void put_qpel8_mc31_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 1, 0); }
+static av_noinline void put_qpel8_mc13_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 0, 0); }
+static av_noinline void put_qpel8_mc33_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 1, 0); }
+static av_noinline void avg_qpel8_mc11_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 0, 1); }
+static av_noinline void avg_qpel8_mc31_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 0, 1, 1); }
+static av_noinline void avg_qpel8_mc13_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 0, 1); }
+static av_noinline void avg_qpel8_mc33_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_diag(dst, src, stride, 1, 1, 1); }
+
+/* hv family: raw horizontal sums for rows -2..10 into tmp (13 x 8 floats), then vertical over tmp */
+static av_always_inline void qpel8_hv(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                      int mode, const float *l2f)
+{
+    float tmp[13 * 8 + 8] __attribute__((aligned(16)));
+    qpel8_h((uint8_t *) tmp, 32, src - 2 * stride, stride, 13, HM_RAWF);
+    qpel8_v_half(dst, stride, 0, 0, tmp, mode, l2f, 1);
+    qpel8_v_half(dst + 4, stride, 0, 0, tmp + 4, mode, l2f ? l2f + 4 : 0, 1);
+}
+static av_noinline void put_qpel8_mc22_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_hv(dst, src, stride, VM_PUT, 0); }
+static av_noinline void avg_qpel8_mc22_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride)
+{ LOAD_CONSTS(); qpel8_hv(dst, src, stride, VM_AVGDST, 0); }
+
+/* mc21/mc23: halfH (rows +0 / +1) averaged with hv */
+static av_always_inline void qpel8_hv_h(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int hoff, int avg)
+{
+    float halfH[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) halfH, 32, src + hoff * stride, stride, 8, HM_TMPF);
+    qpel8_hv(dst, src, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfH);
+}
+static av_unused av_noinline void put_qpel8_mc21_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 0, 0); }
+static av_unused av_noinline void put_qpel8_mc23_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 1, 0); }
+static av_unused av_noinline void avg_qpel8_mc21_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 0, 1); }
+static av_unused av_noinline void avg_qpel8_mc23_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_h(dst, src, stride, 1, 1); }
+
+/* mc12/mc32: halfV (columns +0 / +1) averaged with hv */
+static av_always_inline void qpel8_hv_v(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int voff, int avg)
+{
+    float halfV[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_v((uint8_t *) halfV, 32, src + voff, stride, VM_TMPF, halfV);
+    qpel8_hv(dst, src, stride, avg ? VM_L2TMPF_DST : VM_L2TMPF, halfV);
+}
+static av_noinline void put_qpel8_mc12_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 0, 0); }
+static av_noinline void put_qpel8_mc32_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 1, 0); }
+static av_noinline void avg_qpel8_mc12_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 0, 1); }
+static av_noinline void avg_qpel8_mc32_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hv_v(dst, src, stride, 1, 1); }
+
+/* ------------------------------------------------------------------ */
+/* Shared-pass versions of the hv family (2026-10-29). Bit-identical:    */
+/* the same values through the same VFPU steps, computed once.           */
+/*  - mc21/mc23: the half-sample row halfH is the clipped, floored raw   */
+/*    horizontal sum that the hv pass has already computed (rows 0..7 or  */
+/*    1..8 of its tmp), instead of a second horizontal filter;            */
+/*  - 16x16 mc22/21/23/12/32: each 8-wide column filters its 21 source   */
+/*    rows horizontally once for both 8x8 tiles, instead of 13 per tile. */
+/* swdec_mc_reference (validation builds) selects the versions above.    */
+/* ------------------------------------------------------------------ */
+
+/* halfH (8 rows x 8 floats, 32 B stride) = floor(clip(raw/32 + 128.5)) of
+   eight raw rows: exactly what HB_TMPF stores from the same sums */
+static av_noinline void qpel8_halfh_from_raw(float *half, const float *raw)
+{
+    __asm__ volatile (
+        "vzero.q C620\n\t"
+        "lv.q C400, 0(%1)\n\t"   "lv.q C410, 32(%1)\n\t"  "lv.q C420, 64(%1)\n\t"  "lv.q C430, 96(%1)\n\t"
+        "lv.q C500, 16(%1)\n\t"  "lv.q C510, 48(%1)\n\t"  "lv.q C520, 80(%1)\n\t"  "lv.q C530, 112(%1)\n\t"
+        HB_XCLIP() HB_F2ID("0") HB_I2F("0")
+        "sv.q C400, 0(%0)\n\t"   "sv.q C410, 32(%0)\n\t"  "sv.q C420, 64(%0)\n\t"  "sv.q C430, 96(%0)\n\t"
+        "sv.q C500, 16(%0)\n\t"  "sv.q C510, 48(%0)\n\t"  "sv.q C520, 80(%0)\n\t"  "sv.q C530, 112(%0)\n\t"
+        "lv.q C400, 128(%1)\n\t" "lv.q C410, 160(%1)\n\t" "lv.q C420, 192(%1)\n\t" "lv.q C430, 224(%1)\n\t"
+        "lv.q C500, 144(%1)\n\t" "lv.q C510, 176(%1)\n\t" "lv.q C520, 208(%1)\n\t" "lv.q C530, 240(%1)\n\t"
+        HB_XCLIP() HB_F2ID("0") HB_I2F("0")
+        "sv.q C400, 128(%0)\n\t" "sv.q C410, 160(%0)\n\t" "sv.q C420, 192(%0)\n\t" "sv.q C430, 224(%0)\n\t"
+        "sv.q C500, 144(%0)\n\t" "sv.q C510, 176(%0)\n\t" "sv.q C520, 208(%0)\n\t" "sv.q C530, 240(%0)\n\t"
+        : : "r"(half), "r"(raw) : "memory");
+}
+
+/* the vertical pass of one 8x8 hv tile over raw rows tmp (13 rows) */
+static av_always_inline void qpel8_hv_v2(uint8_t *dst, ptrdiff_t stride, const float *tmp,
+                                         int mode, const float *l2f)
+{
+    qpel8_v_half(dst, stride, 0, 0, tmp, mode, l2f, 1);
+    qpel8_v_half(dst + 4, stride, 0, 0, tmp + 4, mode, l2f ? l2f + 4 : 0, 1);
+}
+
+/* kind: 0 = hv (mc22), 1 = halfH rows +hoff (mc21/mc23), 2 = halfV columns +voff (mc12/mc32) */
+static av_always_inline void qpel8_hvfam_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                            int kind, int off, int avg)
+{
+    float tmp[13 * 8 + 8] __attribute__((aligned(16)));
+    float half[8 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    if (kind == 2)
+        qpel8_v((uint8_t *) half, 32, src + off, stride, VM_TMPF, half);
+    qpel8_h((uint8_t *) tmp, 32, src - 2 * stride, stride, 13, HM_RAWF);
+    if (kind == 1)
+        qpel8_halfh_from_raw(half, tmp + (2 + off) * 8);
+    qpel8_hv_v2(dst, stride, tmp,
+                kind ? (avg ? VM_L2TMPF_DST : VM_L2TMPF) : (avg ? VM_AVGDST : VM_PUT),
+                kind ? half : 0);
+}
+static av_noinline void put_qpel8_mc21_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hvfam_v2(dst, src, stride, 1, 0, 0); }
+static av_noinline void put_qpel8_mc23_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hvfam_v2(dst, src, stride, 1, 1, 0); }
+static av_noinline void avg_qpel8_mc21_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hvfam_v2(dst, src, stride, 1, 0, 1); }
+static av_noinline void avg_qpel8_mc23_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) { qpel8_hvfam_v2(dst, src, stride, 1, 1, 1); }
+
+/* one 8-wide column of a 16x16 hv-family block: 21 raw rows, two tiles */
+static av_noinline void qpel16_hvfam_col_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                            int kind, int off, int avg)
+{
+    float tmp[21 * 8 + 8] __attribute__((aligned(16)));
+    float half[8 * 8] __attribute__((aligned(16)));
+    const int mode = kind ? (avg ? VM_L2TMPF_DST : VM_L2TMPF) : (avg ? VM_AVGDST : VM_PUT);
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) tmp, 32, src - 2 * stride, stride, 21, HM_RAWF);
+    for (int t = 0; t < 2; t++) {
+        uint8_t *d = dst + 8 * t * stride;
+        const uint8_t *s = src + 8 * t * stride;
+        if (kind == 1)
+            qpel8_halfh_from_raw(half, tmp + (8 * t + 2 + off) * 8);
+        else if (kind == 2)
+            qpel8_v((uint8_t *) half, 32, s + off, stride, VM_TMPF, half);
+        qpel8_hv_v2(d, stride, tmp + 8 * t * 8, mode, kind ? half : 0);
+    }
+}
+#define MC16_HV2(op, xy, kind, off, avg) \
+static void op##_qpel16_mc##xy##_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) \
+{ \
+    qpel16_hvfam_col_v2(dst, src, stride, kind, off, avg); \
+    qpel16_hvfam_col_v2(dst + 8, src + 8, stride, kind, off, avg); \
+}
+MC16_HV2(put, 22, 0, 0, 0) MC16_HV2(avg, 22, 0, 0, 1)
+MC16_HV2(put, 21, 1, 0, 0) MC16_HV2(avg, 21, 1, 0, 1)
+MC16_HV2(put, 23, 1, 1, 0) MC16_HV2(avg, 23, 1, 1, 1)
+MC16_HV2(put, 12, 2, 0, 0) MC16_HV2(avg, 12, 2, 0, 1)
+MC16_HV2(put, 32, 2, 1, 0) MC16_HV2(avg, 32, 2, 1, 1)
+
+/* 16x16 horizontal and diagonal positions by 8-wide columns: one
+   horizontal call of 16 rows (and one constants load) per column instead
+   of two 8-row calls, then the vertical halves per tile as before. */
+static av_noinline void qpel16_h_col_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int mode)
+{
+    LOAD_CONSTS();
+    qpel8_h(dst, stride, src, stride, 16, mode);
+}
+#define MC16_H2(op, xy, mode) \
+static void op##_qpel16_mc##xy##_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) \
+{ \
+    qpel16_h_col_v2(dst, src, stride, mode); \
+    qpel16_h_col_v2(dst + 8, src + 8, stride, mode); \
+}
+MC16_H2(put, 10, HM_L2X0) MC16_H2(avg, 10, HM_L2X0_DST)
+MC16_H2(put, 20, HM_PUT)  MC16_H2(avg, 20, HM_AVGDST)
+MC16_H2(put, 30, HM_L2X1) MC16_H2(avg, 30, HM_L2X1_DST)
+
+static av_noinline void qpel16_diag_col_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride,
+                                           int hoff, int voff, int avg)
+{
+    float halfH[16 * 8] __attribute__((aligned(16)));
+    LOAD_CONSTS();
+    qpel8_h((uint8_t *) halfH, 32, src + hoff * stride, stride, 16, HM_TMPF);
+    for (int t = 0; t < 2; t++)
+        qpel8_v(dst + 8 * t * stride, stride, src + 8 * t * stride + voff, stride,
+                avg ? VM_L2TMPF_DST : VM_L2TMPF, halfH + 64 * t);
+}
+#define MC16_D2(op, xy, hoff, voff, avg) \
+static void op##_qpel16_mc##xy##_v2(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) \
+{ \
+    qpel16_diag_col_v2(dst, src, stride, hoff, voff, avg); \
+    qpel16_diag_col_v2(dst + 8, src + 8, stride, hoff, voff, avg); \
+}
+MC16_D2(put, 11, 0, 0, 0) MC16_D2(avg, 11, 0, 0, 1)
+MC16_D2(put, 31, 0, 1, 0) MC16_D2(avg, 31, 0, 1, 1)
+MC16_D2(put, 13, 1, 0, 0) MC16_D2(avg, 13, 1, 0, 1)
+MC16_D2(put, 33, 1, 1, 0) MC16_D2(avg, 33, 1, 1, 1)
+
+/* 16x16 = four 8x8 */
+#define MC16(op, xy) \
+static av_unused void op##_qpel16_mc##xy##_psp(uint8_t *dst, const uint8_t *src, ptrdiff_t stride) \
+{ \
+    op##_qpel8_mc##xy##_psp(dst, src, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8, src + 8, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8 * stride, src + 8 * stride, stride); \
+    op##_qpel8_mc##xy##_psp(dst + 8 * stride + 8, src + 8 * stride + 8, stride); \
+}
+#define MC16_ALL(op) \
+    MC16(op, 00) MC16(op, 10) MC16(op, 20) MC16(op, 30) \
+    MC16(op, 01) MC16(op, 11) MC16(op, 21) MC16(op, 31) \
+    MC16(op, 02) MC16(op, 12) MC16(op, 22) MC16(op, 32) \
+    MC16(op, 03) MC16(op, 13) MC16(op, 23) MC16(op, 33)
+MC16_ALL(put)
+MC16_ALL(avg)
+
+av_cold void ff_h264qpel_init_psp(H264QpelContext *c, int bit_depth)
+{
+    if (bit_depth != 8 || swdec_psp_level < 1)
+        return;
+#define SET(op, idx, sz) \
+    c->op##_h264_qpel_pixels_tab[idx][ 0] = op##_qpel##sz##_mc00_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 1] = op##_qpel##sz##_mc10_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 2] = op##_qpel##sz##_mc20_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 3] = op##_qpel##sz##_mc30_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 4] = op##_qpel##sz##_mc01_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 5] = op##_qpel##sz##_mc11_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 7] = op##_qpel##sz##_mc31_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][ 8] = op##_qpel##sz##_mc02_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][12] = op##_qpel##sz##_mc03_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][13] = op##_qpel##sz##_mc13_psp; \
+    c->op##_h264_qpel_pixels_tab[idx][15] = op##_qpel##sz##_mc33_psp;
+    SET(put, 0, 16)
+    SET(put, 1, 8)
+    SET(avg, 0, 16)
+    SET(avg, 1, 8)
+#undef SET
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+    if (swdec_mc_reference) {
+#define SET_HV(op, idx, sz) \
+        c->op##_h264_qpel_pixels_tab[idx][ 1] = op##_qpel##sz##_mc10_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 2] = op##_qpel##sz##_mc20_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 3] = op##_qpel##sz##_mc30_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 5] = op##_qpel##sz##_mc11_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 7] = op##_qpel##sz##_mc31_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][13] = op##_qpel##sz##_mc13_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][15] = op##_qpel##sz##_mc33_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 6] = op##_qpel##sz##_mc21_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][ 9] = op##_qpel##sz##_mc12_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][10] = op##_qpel##sz##_mc22_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][11] = op##_qpel##sz##_mc32_psp; \
+        c->op##_h264_qpel_pixels_tab[idx][14] = op##_qpel##sz##_mc23_psp;
+        SET_HV(put, 0, 16)
+        SET_HV(put, 1, 8)
+        SET_HV(avg, 0, 16)
+        SET_HV(avg, 1, 8)
+#undef SET_HV
+        return;
+    }
+#endif
+#define SET2(op) \
+    c->op##_h264_qpel_pixels_tab[0][ 1] = op##_qpel16_mc10_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 2] = op##_qpel16_mc20_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 3] = op##_qpel16_mc30_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 5] = op##_qpel16_mc11_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 7] = op##_qpel16_mc31_v2; \
+    c->op##_h264_qpel_pixels_tab[0][13] = op##_qpel16_mc13_v2; \
+    c->op##_h264_qpel_pixels_tab[0][15] = op##_qpel16_mc33_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 6] = op##_qpel16_mc21_v2; \
+    c->op##_h264_qpel_pixels_tab[0][ 9] = op##_qpel16_mc12_v2; \
+    c->op##_h264_qpel_pixels_tab[0][10] = op##_qpel16_mc22_v2; \
+    c->op##_h264_qpel_pixels_tab[0][11] = op##_qpel16_mc32_v2; \
+    c->op##_h264_qpel_pixels_tab[0][14] = op##_qpel16_mc23_v2; \
+    c->op##_h264_qpel_pixels_tab[1][ 6] = op##_qpel8_mc21_v2; \
+    c->op##_h264_qpel_pixels_tab[1][ 9] = op##_qpel8_mc12_psp; \
+    c->op##_h264_qpel_pixels_tab[1][10] = op##_qpel8_mc22_psp; \
+    c->op##_h264_qpel_pixels_tab[1][11] = op##_qpel8_mc32_psp; \
+    c->op##_h264_qpel_pixels_tab[1][14] = op##_qpel8_mc23_v2;
+    SET2(put)
+    SET2(avg)
+#undef SET2
+}
+
+#else
+typedef int swdec_psp_h264qpel_unused;
+#endif
diff --git a/libavcodec/psp/vfpu_util.h b/libavcodec/psp/vfpu_util.h
new file mode 100644
index 0000000..b901e21
--- /dev/null
+++ b/libavcodec/psp/vfpu_util.h
@@ -0,0 +1,70 @@
+/*
+ * Shared VFPU conventions for the swdec PSP kernels.
+ *
+ * Pixel bytes enter the VFPU as (b - 128) exactly: the GPR word is XORed
+ * with 0x80808080, moved with mtv, unpacked with vc2i (byte << 24, signed)
+ * and scaled with vi2f 24. Linear filters then only need their rounding
+ * constant adjusted by 128 * (sum of weights).
+ *
+ * Results leave the VFPU with vf2id (floor, saturating) + vi2uc, which
+ * yields clip_uint8(floor(x)) for the >>23 fixed-point convention; the
+ * imm of vf2id absorbs power-of-two divisions (imm = 23 - shift).
+ *
+ * All arithmetic is on integer-valued floats far below 2^24, so vadd/vscl
+ * are exact and no dot-product instruction is used (the VFPU dot product
+ * rounds internally).
+ *
+ * VFPU registers are not known to the compiler; every asm block here is
+ * self-contained (loads its inputs, stores its outputs) except where a
+ * function keeps constants in M700 for its own duration.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#ifndef AVCODEC_PSP_VFPU_UTIL_H
+#define AVCODEC_PSP_VFPU_UTIL_H
+
+#include <stdint.h>
+
+#define PSP_PIX_XOR 0x80808080u
+
+/* unaligned 32-bit load (lwl/lwr) */
+static inline uint32_t psp_ulw(const uint8_t *p)
+{
+    uint32_t w;
+    __asm__ ("ulw %0, 0(%1)" : "=r"(w) : "r"(p) : "memory");
+    return w;
+}
+static inline uint32_t psp_lw(const uint8_t *p)
+{
+    return *(const uint32_t *) p;
+}
+static inline void psp_sw(uint8_t *p, uint32_t w)
+{
+    *(uint32_t *) p = w;
+}
+/* unaligned 32-bit store (swl/swr) */
+static inline void psp_usw(uint8_t *p, uint32_t w)
+{
+    __asm__ volatile ("usw %0, 0(%1)" : : "r"(w), "r"(p) : "memory");
+}
+
+/* Byte->float unpack of a GPR word into a VFPU quad register (string
+   name), via a scratch single S in the same column.  The word must
+   already be XORed with PSP_PIX_XOR. */
+#define VFPU_UNPACK(sreg, qreg, w) \
+    "mtv   " w ", " sreg "\n\t" \
+    "vc2i.s " qreg ", " sreg "\n\t" \
+    "vi2f.q " qreg ", " qreg ", 24\n\t"
+
+/* Float quad -> 4 bytes at 4-byte aligned address (clip(floor(x))). */
+#define VFPU_PACK_STORE(qreg, sreg, addr) \
+    "vf2id.q " qreg ", " qreg ", 23\n\t" \
+    "vi2uc.q " sreg ", " qreg "\n\t" \
+    "sv.s  " sreg ", 0(" addr ")\n\t"
+
+#endif
diff --git a/libavcodec/swdec_pipe.h b/libavcodec/swdec_pipe.h
new file mode 100644
index 0000000..7b9faa6
--- /dev/null
+++ b/libavcodec/swdec_pipe.h
@@ -0,0 +1,134 @@
+/* swdec row pipeline: producer (parser, CPU or Media Engine) / consumer (CPU
+   reconstruction + deblocking) hand-off. See h264_slice.c. */
+#ifndef AVCODEC_SWDEC_PIPE_H
+#define AVCODEC_SWDEC_PIPE_H
+#include <stddef.h>
+struct H264Context;
+struct AVCodecContext;
+extern int swdec_me_enabled;
+struct H264SliceContext;
+/* swdec: a parsed macroblock's motion as its job holds it (the 4x4 block
+   entries of the caches, scan8 layout) */
+typedef struct SwdecChromaMotion {
+    int mb_x, mb_y, mb_xy;
+    const uint16_t *sub_mb_type;
+    const int8_t (*ref_cache)[5 * 8];
+    const int16_t (*mv_cache)[5 * 8][2];
+} SwdecChromaMotion;
+/* the macroblock's complete chroma prediction from the parsed motion
+   (h264_mb.c), scalar, for the Media Engine; 0 when it cannot */
+int ff_swdec_chroma_predict(const struct H264Context *h, const struct H264SliceContext *sl,
+                            const SwdecChromaMotion *m, uint8_t pred[2][64]);
+extern int swdec_me_deblock;
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+extern int swdec_me_tail_cpu;
+#endif
+extern void (*swdec_cpu_flush_row)(const struct H264Context *h, int mb_y);
+extern void (*swdec_me_post_deblock)(void);
+extern void (*swdec_me_aux)(void);
+extern void (*swdec_me_csc_row)(const struct H264Context *h, int mb_row);
+void swdec_pipe_deblock_service(const void *h);
+void swdec_pipe_deblock_flush(const void *h);
+int swdec_pipe_deblock_pending(void);
+void swdec_pipe_slice_begin(void);
+void swdec_pipe_set_parse_done(void);
+int  swdec_pipe_parse_done(void);
+void swdec_pipe_set_tail_pushed(void);
+int  swdec_pipe_tail_pushed(void);
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+extern int swdec_validate_force;
+/* 1: motion-compensation kernels as before the shared-pass hv family
+   (psp/h264qpel_psp.c); read when a decoder is initialised. */
+extern int swdec_mc_reference;
+/* 1: every macroblock on h264_mb.c's generic path, as the CONFIG_SMALL
+   build had it (h264_mb.c). */
+extern int swdec_mb_generic;
+/* 1: fixed-size edge emulation regions as before (h264_mb.c). */
+extern int swdec_edge_full;
+/* 1: chroma MC one plane per call, as before (h264_mb.c). */
+extern int swdec_chroma_split;
+/* 1: chroma prediction stays in reconstruction (h264_slice.c); the
+   parser predicts chroma even without the Media Engine (the bench); the
+   parser stops part-way through rows (the bench). */
+extern int swdec_chroma_cpu, swdec_chroma_force, swdec_chroma_partial;
+/* inter macroblocks whose chroma came from the parser, ones the main core
+   predicted, macroblocks it waited for, its wait loop iterations, rows it
+   claimed the rest of */
+#define SWDEC_CHROMA_STATS 5
+extern unsigned swdec_chroma_stats[SWDEC_CHROMA_STATS];
+/* 1: the PSP's no-op prefetch calls are made, as before (h264_mb.c). */
+extern int swdec_prefetch_calls;
+/* 1: jobs carry the whole parsed caches as before (h264_slice.c). */
+extern int swdec_job_full;
+#endif
+extern int swdec_pipe_bad;
+extern int swdec_pipe_bad_info[6];
+extern int (*swdec_me_run_slice)(struct AVCodecContext *avctx, void *sl);
+int ff_swdec_decode_slice(struct AVCodecContext *avctx, void *arg);
+unsigned swdec_layout_key(void);   /* struct layout fingerprint: callers including h264dec.h must match the library build */
+extern void (*swdec_me_pre_publish)(void);
+extern void (*swdec_cpu_pre_consume)(const struct H264Context *h, int mb_y);
+extern void (*swdec_cpu_post_consume)(void *p, size_t n);
+void  swdec_pipe_set(void *unc);      /* alias of the pipe used by the caller's core (NULL = plain) */
+void *swdec_pipe_get(void);           /* the pipe's plain address */
+void  swdec_pipe_reset(void);
+void  swdec_pipe_consume_all(void *h, void *sl);
+
+/* Diagnostic builds (SWDEC_DIAGNOSTICS) only: one switch for every
+   measurement and test path in the decoder, and the finer flags need it. */
+#if !(defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS) && (defined(SWDEC_SPIN_DIAG) \
+    || (defined(SWDEC_PIPE_VALIDATE) && SWDEC_PIPE_VALIDATE))
+#error "swdec diagnostic flags need SWDEC_DIAGNOSTICS=1"
+#endif
+
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+/* Optional stage clock for component diagnostic builds (NULL until a
+   component installs it: one load and branch per row). CPU marks bracket
+   the parts of reconstructing a published row; ME marks bracket deblocking
+   a row and waiting for the CPU to free a ring buffer. */
+enum {
+    SWDEC_MARK_CPU_PRE = 0,        /* row tables: cache invalidation */
+    SWDEC_MARK_CPU_RECON,          /* macroblock reconstruction */
+    SWDEC_MARK_CPU_BORDER,         /* border backup + deblock publish */
+    SWDEC_MARK_CPU_POST,           /* ring and job cache maintenance */
+    SWDEC_MARK_CPU_ROW_END,
+    SWDEC_MARK_ME_DEBLOCK,
+    SWDEC_MARK_ME_DEBLOCK_END,
+    SWDEC_MARK_ME_WAIT,
+    SWDEC_MARK_ME_WAIT_END
+};
+extern void (*swdec_stage_mark)(int mark);
+#endif
+
+/* CPU spin-waits on the other core. They end when the condition clears or
+   when the Media Engine is declared dead: the component's watchdog stops a
+   stalled ME and clears swdec_me_enabled (me_fail), and a wait on a core
+   that will never answer must not spin the decode worker forever. The rows
+   of that one picture are then left as they are; the slice dispatcher
+   reports the failure and recovery restarts the ME between jobs. A
+   component diagnostic build compiles h264_slice.c with SWDEC_SPIN_DIAG:
+   each wait site then reports once, through swdec_spin_report, when it has
+   spun for more than 2 s. */
+#define SWDEC_ME_ALIVE() (*(volatile int *) &swdec_me_enabled != 0)
+#ifdef SWDEC_SPIN_DIAG
+extern unsigned (*swdec_spin_now_us)(void);
+extern void (*swdec_spin_report)(int site, int prod, int cons, int dprod, int dcons);
+#define SWDEC_SPIN_WHILE(cond, site) do {                                      \
+        static int swdec_spin_said_;                                          \
+        unsigned swdec_spin_n_ = 0;                                           \
+        unsigned swdec_spin_t0_ = swdec_spin_now_us ? swdec_spin_now_us() : 0; \
+        while ((cond) && SWDEC_ME_ALIVE()) {                                  \
+            if (!swdec_spin_said_ && (++swdec_spin_n_ & 4095u) == 0           \
+                && swdec_spin_now_us                                          \
+                && swdec_spin_now_us() - swdec_spin_t0_ > 2000000u) {         \
+                swdec_spin_said_ = 1;                                         \
+                if (swdec_spin_report)                                        \
+                    swdec_spin_report(site, pipe->prod_seq, pipe->cons_seq,   \
+                                      pipe->dprod, pipe->dcons);              \
+            }                                                                 \
+        }                                                                     \
+    } while (0)
+#else
+#define SWDEC_SPIN_WHILE(cond, site) while ((cond) && SWDEC_ME_ALIVE()) { }
+#endif
+#endif
diff --git a/libavcodec/swdec_stages.h b/libavcodec/swdec_stages.h
new file mode 100644
index 0000000..dcaa668
--- /dev/null
+++ b/libavcodec/swdec_stages.h
@@ -0,0 +1,20 @@
+/* swdec: optional per-stage cycle attribution (device profiling aid).
+ * Compiled in with -DSWDEC_STAGE_TIMING=1 and switched at run time via
+ * swdec_stage_on (a load and a branch per macroblock when off); the harness
+ * defines swdec_stage_us[], swdec_stage_on and swdec_stage_now(). */
+#ifndef AVCODEC_SWDEC_STAGES_H
+#define AVCODEC_SWDEC_STAGES_H
+#if defined(SWDEC_STAGE_TIMING) && SWDEC_STAGE_TIMING
+#if !(defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS)
+#error "SWDEC_STAGE_TIMING is a diagnostic build: it needs SWDEC_DIAGNOSTICS=1"
+#endif
+extern unsigned swdec_stage_us[12];
+extern int swdec_stage_on;
+unsigned swdec_stage_now(void);
+#define SWDEC_STAGE_BEGIN(v) unsigned v = swdec_stage_on ? swdec_stage_now() : 0u
+#define SWDEC_STAGE_END(v, i) do { if (swdec_stage_on) swdec_stage_us[i] += swdec_stage_now() - (v); } while (0)
+#else
+#define SWDEC_STAGE_BEGIN(v) do { } while (0)
+#define SWDEC_STAGE_END(v, i) do { } while (0)
+#endif
+#endif
diff --git a/libavcodec/swdec_recon_stats.h b/libavcodec/swdec_recon_stats.h
new file mode 100644
index 0000000..4504a51
--- /dev/null
+++ b/libavcodec/swdec_recon_stats.h
@@ -0,0 +1,59 @@
+/* swdec: main-core reconstruction attribution (validation builds only).
+ *
+ * The PSP's user mode has no cheap cycle counter, so kernels are timed with
+ * the 1 MHz system clock on a sample of macroblocks only: one in
+ * SWDEC_RT_SAMPLE positions of each row, rotating from row to row, and the
+ * component scales the sample by all macroblocks over sampled ones. Each
+ * macroblock row's phases are marked through swdec_recon_mark. Only code
+ * that runs on the main core is hooked; the parser and the Media Engine
+ * never touch these. */
+#ifndef AVCODEC_SWDEC_RECON_STATS_H
+#define AVCODEC_SWDEC_RECON_STATS_H
+#define SWDEC_RT_SAMPLE 8
+enum {
+    SWDEC_RT_LUMA_FULL,   /* luma MC, full-sample positions */
+    SWDEC_RT_LUMA_1D,     /* luma MC, horizontal or vertical interpolation */
+    SWDEC_RT_LUMA_2D,     /* luma MC, two-dimensional positions */
+    SWDEC_RT_CHROMA,      /* chroma MC (both planes) */
+    SWDEC_RT_WEIGHT,      /* weighted prediction */
+    SWDEC_RT_EDGE,        /* edge emulation */
+    SWDEC_RT_IDCT,        /* inverse transforms and residual add */
+    SWDEC_RT_INTRA,       /* intra prediction and its border exchange */
+    SWDEC_RT_MOTION,      /* all inter prediction of the macroblock (holds the
+                             MC, weight and edge buckets) */
+    SWDEC_RT_RESTORE,     /* the parsed job copied back into the slice context */
+    SWDEC_RT_MB,          /* the whole macroblock: restore + reconstruction */
+    SWDEC_RT_COUNT
+};
+enum {
+    SWDEC_RMARK_ROW,          /* row begins: cache maintenance before recon */
+    SWDEC_RMARK_RECON,        /* reconstruction of the row's macroblocks */
+    SWDEC_RMARK_BORDER,       /* border backup and deblock publication */
+    SWDEC_RMARK_POST,         /* cache maintenance after the row */
+    SWDEC_RMARK_ROW_END,
+    SWDEC_RMARK_FLUSH,        /* row flush before publishing (nested) */
+    SWDEC_RMARK_FLUSH_END,
+    SWDEC_RMARK_SPIN,         /* a spin wait on the deblocking queue (nested) */
+    SWDEC_RMARK_SPIN_END,
+    SWDEC_RMARK_TAIL,         /* the slice's last row deblocked on the CPU */
+    SWDEC_RMARK_TAIL_END
+};
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+extern void (*swdec_recon_mark)(int mark);   /* NULL: attribution off */
+extern unsigned (*swdec_rt_now)(void);       /* the component's clock */
+extern int swdec_rt_on;                      /* this macroblock is sampled */
+extern unsigned swdec_rt_us[SWDEC_RT_COUNT], swdec_rt_calls[SWDEC_RT_COUNT];
+extern unsigned swdec_rt_mbs[2];             /* macroblocks: all, sampled */
+/* luma MC calls of every macroblock by block size (16, 8, 4) and quarter-
+   sample position (x + 4 y), and how many of them average (bi-prediction) */
+extern unsigned swdec_qpel_calls[3][16], swdec_qpel_avg;
+#define SWDEC_RT_BEGIN(v) unsigned v = swdec_rt_on ? swdec_rt_now() : 0u
+#define SWDEC_RT_END(v, i) do { if (swdec_rt_on) { \
+        swdec_rt_us[i] += swdec_rt_now() - (v); swdec_rt_calls[i]++; } } while (0)
+#define SWDEC_RMARK(m) do { if (swdec_recon_mark) swdec_recon_mark(m); } while (0)
+#else
+#define SWDEC_RT_BEGIN(v) do { } while (0)
+#define SWDEC_RT_END(v, i) do { } while (0)
+#define SWDEC_RMARK(m) do { } while (0)
+#endif
+#endif
diff --git a/libavcodec/swdec_chroma_rec.h b/libavcodec/swdec_chroma_rec.h
new file mode 100644
index 0000000..3bdb799
--- /dev/null
+++ b/libavcodec/swdec_chroma_rec.h
@@ -0,0 +1,46 @@
+/* swdec: recorded chroma prediction of one macroblock row (validation
+ * builds only), for the chroma-on-the-Media-Engine qualification replay.
+ *
+ * While a row is being recorded, every inter macroblock's chroma
+ * prediction is captured as the operations the reconstruction performed
+ * (bilinear put/avg from a reference position, uni/bi weighting) and the
+ * prediction it produced (both planes, 8x8, before the residual). The
+ * component replays the operations through the CPU kernels and through
+ * scalar kernels on the Media Engine and compares both with the recorded
+ * prediction (src/swdec/swdec_chroma_replay.c). */
+#ifndef AVCODEC_SWDEC_CHROMA_REC_H
+#define AVCODEC_SWDEC_CHROMA_REC_H
+#include <stdint.h>
+#include <stddef.h>
+
+enum { SWDEC_CR_MC, SWDEC_CR_WEIGHT, SWDEC_CR_BIWEIGHT };
+#define SWDEC_CR_PIC 0      /* destination: the macroblock's prediction */
+#define SWDEC_CR_TMP 1      /* destination: the bi-prediction scratch */
+
+typedef struct SwdecChromaOp {
+    uint8_t type, buf, x, y;        /* destination block within the 8x8 */
+    uint8_t w, h, avg, mb;          /* size; MC: average with destination; macroblock index */
+    int16_t cx, cy;                 /* MC: integer chroma position in the reference */
+    uint8_t fx, fy, log2, pad;      /* MC: eighth-sample fraction; weights: denominator */
+    uint8_t tx, ty, pad2[2];        /* bi-weight: the scratch block it reads */
+    int16_t wa[2], wb[2], off[2];   /* weights for Cb, Cr: weight/weightd, weights, offset */
+    const uint8_t *ref[2];          /* MC: reference Cb, Cr planes */
+} SwdecChromaOp;
+
+#define SWDEC_CR_MAX_OPS 384
+#define SWDEC_CR_MAX_MBS 32
+typedef struct SwdecChromaRec {
+    int ops, mbs, overflow, mb_y;
+    int ref_stride, pic_w, pic_h;   /* chroma plane stride and coded size */
+    const void *chroma_ctx, *dsp_ctx, *vdsp_ctx;   /* CPU kernels (H264ChromaContext etc.) */
+    SwdecChromaOp op[SWDEC_CR_MAX_OPS];
+    uint8_t expect[SWDEC_CR_MAX_MBS][2][64];       /* the CPU's prediction, Cb and Cr */
+} SwdecChromaRec;
+
+#if defined(SWDEC_DIAGNOSTICS) && SWDEC_DIAGNOSTICS
+extern int swdec_chroma_rec_on;                    /* the component asks for this row */
+extern SwdecChromaRec swdec_chroma_rec;
+/* replay a record through the CPU's own kernels into out[mb][plane][64] */
+void swdec_chroma_rec_cpu_replay(const SwdecChromaRec *r, uint8_t (*out)[2][64]);
+#endif
+#endif
