+static void h264_v_loop_filter_luma_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    LF_SETUP_AB(alpha, beta);
+    lfl_v_pair(pix, stride, tc0[0], tc0[1]);
+    lfl_v_pair(pix + 8, stride, tc0[2], tc0[3]);
+}
+
+static void h264_h_loop_filter_luma_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, int8_t *tc0)
+{
+    uint32_t tcw = psp_ulw((const uint8_t *) tc0);
+    LF_SETUP_AB(alpha, beta);
+    LFL_SETUP_TC(tcw);
+    for (int g = 0; g < 4; g++, pix += 4 * stride)
