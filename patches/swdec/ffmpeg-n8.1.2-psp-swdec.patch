+static void h264_h_loop_filter_luma_intra_psp(uint8_t *pix, ptrdiff_t stride, int alpha, int beta)
+{
+    LF_SETUP_AB(alpha, beta);
+    LF_SETUP_A2((alpha >> 2) + 2);
+    for (int g = 0; g < 4; g++, pix += 4 * stride)
+        lfl_h_intra_group(pix, stride);
