+#ifdef CONFIG_PROPERTY_FAULT_TRACE
+static const char *property_fault_tag_name(int tag)
+{
+    switch (tag) {
+    case JS_TAG_INT: return "int";
+    case JS_TAG_BOOL: return "bool";
+    case JS_TAG_NULL: return "null";
+    case JS_TAG_UNDEFINED: return "undefined";
+    case JS_TAG_FLOAT64: return "float64";
+    case JS_TAG_STRING: return "string";
+    case JS_TAG_STRING_ROPE: return "string-rope";
+    case JS_TAG_SYMBOL: return "symbol";
+    case JS_TAG_OBJECT: return "object";
+    case JS_TAG_BIG_INT: return "bigint";
+    case JS_TAG_EXCEPTION: return "exception";
+    case JS_TAG_UNINITIALIZED: return "uninitialized";
+    default: return "internal";
+    }
+}
+
+static void trace_property_fault(JSContext *ctx, JSFunctionBytecode *b,
+                                 const uint8_t *pc, int opcode,
+                                 JSValueConst base, JSValueConst key,
+                                 JSAtom atom, const JSValue *stack_base,
+                                 const JSValue *sp, const JSValue *arg_base,
+                                 int arg_count, const JSValue *var_base,
+                                 int var_count)
+{
+    JSRuntime *rt = ctx->rt;
+    char filename_buf[192], function_buf[96], atom_buf[96];
+    const char *filename = "<stripped>";
+    const char *function = "<anonymous>";
+    const char *property = "<computed>";
+    uint32_t pc_offset = (uint32_t)(pc - b->byte_code_buf);
+    int col = 0, line = find_line_num(ctx, b, pc_offset, &col);
+    int i, depth = (int)(sp - stack_base);
+
+    if (rt->property_fault_trace_limit == 0
+        || rt->property_fault_trace_count >= rt->property_fault_trace_limit)
+        return;
+    rt->property_fault_trace_count++;
+    if (b->has_debug && b->debug.filename != JS_ATOM_NULL)
+        filename = JS_AtomGetStr(ctx, filename_buf, sizeof(filename_buf),
+                                 b->debug.filename);
+    if (b->func_name != JS_ATOM_NULL)
+        function = JS_AtomGetStr(ctx, function_buf, sizeof(function_buf),
+                                 b->func_name);
+    if (atom != JS_ATOM_NULL) {
+        property = JS_AtomGetStr(ctx, atom_buf, sizeof(atom_buf), atom);
+    } else if (JS_VALUE_GET_TAG(key) == JS_TAG_INT) {
+        snprintf(atom_buf, sizeof(atom_buf), "%d", JS_VALUE_GET_INT(key));
+        property = atom_buf;
+    } else if (JS_VALUE_GET_TAG(key) == JS_TAG_STRING) {
+        JSString *string = JS_VALUE_GET_STRING(key);
+        size_t written = (size_t)snprintf(atom_buf, sizeof(atom_buf),
+                                          "<string:%u:", string->len);
+        uint32_t at;
+        for (at = 0; at < string->len && at < 40
+             && written + 2 < sizeof(atom_buf); at++) {
+            int ch = string_get(string, at);
+            atom_buf[written++] = ch >= 0x20 && ch < 0x7f ? (char)ch : '?';
+        }
+        atom_buf[written++] = '>';
+        atom_buf[written] = '\0';
+        property = atom_buf;
+    }
+    fprintf(stderr,
+            "quickjs-property-fault seq=%u source=\"%.*s\" line=%d col=%d "
+            "function=\"%.*s\" pc=%u opcode=%d base=%s key=%s property=\"%.*s\" depth=%d\n",
+            rt->property_fault_trace_count, 180, filename, line, col,
+            84, function, pc_offset, opcode,
+            property_fault_tag_name(JS_VALUE_GET_TAG(base)),
+            property_fault_tag_name(JS_VALUE_GET_TAG(key)), 84, property,
+            depth);
+    fprintf(stderr, "quickjs-property-stack top-tags=");
+    for (i = 0; i < 8 && i < depth; i++)
+        fprintf(stderr, "%s%s", i == 0 ? "" : ",",
+                property_fault_tag_name(JS_VALUE_GET_TAG(sp[-1 - i])));
+    fprintf(stderr, " arg-tags=");
+    for (i = 0; i < 8 && i < arg_count; i++)
+        fprintf(stderr, "%s%s", i == 0 ? "" : ",",
+                property_fault_tag_name(JS_VALUE_GET_TAG(arg_base[i])));
+    fprintf(stderr, " arg-values=");
+    for (i = 0; i < 16 && i < arg_count; i++) {
+        int tag = JS_VALUE_GET_TAG(arg_base[i]);
+        fprintf(stderr, "%s%s", i == 0 ? "" : ",",
+                property_fault_tag_name(tag));
+        if (tag == JS_TAG_INT || tag == JS_TAG_BOOL)
+            fprintf(stderr, ":%d", JS_VALUE_GET_INT(arg_base[i]));
+        else if (tag == JS_TAG_FLOAT64)
+            fprintf(stderr, ":%.17g", JS_VALUE_GET_FLOAT64(arg_base[i]));
+        else if (tag == JS_TAG_STRING)
+            fprintf(stderr, ":%u",
+                    JS_VALUE_GET_STRING(arg_base[i])->len);
+    }
+    fprintf(stderr, " var-tags=");
+    for (i = 0; i < 8 && i < var_count; i++)
+        fprintf(stderr, "%s%s", i == 0 ? "" : ",",
+                property_fault_tag_name(JS_VALUE_GET_TAG(var_base[i])));
+    fprintf(stderr, " code=");
+    for (i = -8; i < 8; i++) {
+        int offset = (int)pc_offset + i;
+        if (offset >= 0 && offset < b->byte_code_len)
+            fprintf(stderr, "%s%02x", i == -8 ? "" : ":",
+                    b->byte_code_buf[offset]);
+    }
+    fprintf(stderr, "\n");
+}
+#endif
