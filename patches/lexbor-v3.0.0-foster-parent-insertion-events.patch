diff --git a/source/lexbor/html/tree.h b/source/lexbor/html/tree.h
--- a/source/lexbor/html/tree.h
+++ b/source/lexbor/html/tree.h
@@ -316,10 +316,13 @@ lxb_inline void
 lxb_html_tree_insert_node(lxb_dom_node_t *to, lxb_dom_node_t *node,
                           lxb_html_tree_insertion_position_t ipos)
 {
+    /* Foster-parented insertions report the document's insertion callback
+     * like every other tree-builder insertion, so a caller that journals
+     * parser insertions for MutationObserver sees them too. */
     if (ipos == LXB_HTML_TREE_INSERTION_POSITION_BEFORE) {
-        lxb_dom_node_insert_before_wo_events(to, node);
+        lxb_dom_node_insert_before(to, node);
         return;
     }
 
     lxb_dom_node_insert_child(to, node);
 }
