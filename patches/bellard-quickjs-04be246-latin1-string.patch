 /* create a string from a UTF-8 buffer */
+JSValue JS_NewStringLenLatin1Portable(JSContext *ctx, const uint8_t *buf,
+                                      size_t buf_len)
+{
+    if (buf_len > JS_STRING_LEN_MAX || buf_len > INT_MAX)
+        return JS_ThrowInternalError(ctx, "string too long");
+    return js_new_string8_len(ctx, (const char *)buf, (int)buf_len);
+}
+
+JSValue JS_NewStringLenLatin1UninitializedPortable(JSContext *ctx,
+                                                    size_t len,
+                                                    uint8_t **storage)
+{
+    JSString *str;
+    *storage = NULL;
+    if (len > JS_STRING_LEN_MAX || len > INT_MAX)
+        return JS_ThrowInternalError(ctx, "string too long");
+    if (len == 0)
+        return JS_AtomToString(ctx, JS_ATOM_empty_string);
+    str = js_alloc_string(ctx, (int)len, 0);
+    if (str == NULL)
+        return JS_EXCEPTION;
+    str->u.str8[len] = '\0';
+    *storage = str->u.str8;
+    return JS_MKPTR(JS_TAG_STRING, str);
+}
+
