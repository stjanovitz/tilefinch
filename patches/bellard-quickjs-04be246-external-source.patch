+static JSFunctionSource *js_new_external_source(JSRuntime *rt, uint32_t id,
+                                                uint32_t length)
+{
+    JSFunctionSource *owner = js_malloc_rt(rt, sizeof(*owner));
+    if (!owner) {
+        if (rt->external_source_release)
