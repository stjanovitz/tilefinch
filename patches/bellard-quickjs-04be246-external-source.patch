+static void js_external_source_require(JSRuntime *rt, JSFunctionSource *owner,
+                                       int delta)
+{
+    if (delta > 0) {
+        if (owner->lazy_readers++ == 0 && rt->external_source_pin)
+            rt->external_source_pin(rt->external_source_opaque,
+                                    owner->external_id, 1);
